                    //	, CURVE_AREA_AXIS_START_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0);
                }
            }

            GUI_SetColor(0x008000);
            strcpy(ConvertStr,"Logistic");
            //dc->SetTextColor(RGB(0,0x80,0));
            //dc->SelectObject(fontLogSelect);
            sprintf(StrTemp,": y=%1.3f+(%1.3f-%1.3f)/(1+(x/%1.3f)^%1.3f)"

                    //strTemp.Format(_T(":  y = %1.3f + (%1.3f - %1.3f) / (1 + (x / %1.3f) ^ %1.3f)")
                    , NormalAnalysis.LogisticAnalysis[NormalAnalysis.FilterCurrent].dCoef[3]
                    , NormalAnalysis.LogisticAnalysis[NormalAnalysis.FilterCurrent].dCoef[0]
                    , NormalAnalysis.LogisticAnalysis[NormalAnalysis.FilterCurrent].dCoef[3]
                    , NormalAnalysis.LogisticAnalysis[NormalAnalysis.FilterCurrent].dCoef[2]
                    , NormalAnalysis.LogisticAnalysis[NormalAnalysis.FilterCurrent].dCoef[1]);
            strcat(ConvertStr,StrTemp);
            GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+3);
            //	strTemp = strType + strTemp;
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 3,ETO_CLIPPED,rect, strTemp,NULL) ;

            sprintf(ConvertStr,"R2: %1.3f",NormalAnalysis.LogisticAnalysis[NormalAnalysis.FilterCurrent].dRR);
            GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+20);
            //strTemp.Format(_T("R2:  %1.3f"), NormalAnalysis.logistic_analysis[NormalAnalysis.FilterCurrent].dRR);
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 20,ETO_CLIPPED,rect, strTemp,NULL) ;
            //dc->SelectObject(f2);
            //dc->SetTextColor(RGB(0,0,0));
            GUI_SetColor(0x00);
        }
        else if(BoardInf.KineticPara.Curve==CURVE_LINEAR)
            //else if(CString(BoardInf.curentcurve) == _T("Linear"))
        {
            //strType = _T("Linear");

            float dX1, dX2, dY1, dY2;
            dX1 = dXMin;
            dY1 = dX1 * NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dSlope
                  + NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dIntercept;
            if(dY1 > dYMax)
            {
                dY1 = dYMax;
                dX1 = (dY1 - NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dIntercept)
                      / NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            else if(dY1 < dYMin)
            {
                dY1 = dYMin;
                dX1 = (dY1 - NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dIntercept)
                      / NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }

            dX2 = dXMax;
            dY2 = dX2 * NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dSlope
                  + NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dIntercept;
            if(dY2 > dYMax)
            {
                dY2 = dYMax;
                dX2 = (dY2 - NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dIntercept)
                      / NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            else if(dY2 < dYMin)
            {
                dY2 = dYMin;
                dX2 = (dY2 - NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dIntercept)
                      / NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            rect.x0=CURVE_AREA_AXIS_START_X + (dX1 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
            rect.y0=CURVE_AREA_AXIS_END_Y - (dY1 - dYMin) / (dYMax - dYMin) * dY * 5.0f;
            rect.x1=CURVE_AREA_AXIS_START_X + (dX2 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
            rect.y1=CURVE_AREA_AXIS_END_Y - (dY2 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

            if(rect.y0<CURVE_AREA_AXIS_START_Y)rect.y0=CURVE_AREA_AXIS_START_Y;//lgj180110
            if(rect.y1<CURVE_AREA_AXIS_START_Y)rect.y1=CURVE_AREA_AXIS_START_Y;//lgj180110
            if(rect.y0>CURVE_AREA_AXIS_END_Y)rect.y0=CURVE_AREA_AXIS_END_Y;//lgj180110
            if(rect.y1>CURVE_AREA_AXIS_END_Y)rect.y1=CURVE_AREA_AXIS_END_Y;//lgj180110
            GUI_DrawLine(rect.x0,rect.y0,rect.x1,rect.y1);


            GUI_SetColor(0x008000);
            strcpy(ConvertStr,"Linear");
            //dc->SetTextColor(RGB(0,0x80,0));
            //dc->SelectObject(fontLogSelect);
            sprintf(StrTemp,": y = %1.3f * x + %1.3f"

                    //strTemp.Format(_T(":  y = %1.3f + (%1.3f - %1.3f) / (1 + (x / %1.3f) ^ %1.3f)")
                    , NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dSlope
                    , NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dIntercept);
            strcat(ConvertStr,StrTemp);
            GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+3);
            //	strTemp = strType + strTemp;
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 3,ETO_CLIPPED,rect, strTemp,NULL) ;

            sprintf(ConvertStr,"R2: %1.3f",NormalAnalysis.LinearAnalysis[NormalAnalysis.FilterCurrent].dRR);
            GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+20);
            //strTemp.Format(_T("R2:  %1.3f"), NormalAnalysis.logistic_analysis[NormalAnalysis.FilterCurrent].dRR);
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 20,ETO_CLIPPED,rect, strTemp,NULL) ;
            //dc->SelectObject(f2);
            //dc->SetTextColor(RGB(0,0,0));
            GUI_SetColor(0x00);
        }
        else if(BoardInf.KineticPara.Curve==CURVE_FACTOR)
            //else if(CString(BoardInf.curentcurve) == _T("Factor"))
        {
            //	strType = _T("Factor");
            float dX1, dX2, dY1, dY2;
            dX1 = dXMin;
            dY1 = dX1 * NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            if(dY1 > dYMax)
            {
                dY1 = dYMax;
                dX1 = dY1 / NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            else if(dY1 < dYMin)
            {
                dY1 = dYMin;
                dX1 = dY1 / NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            dX2 = dXMax;
            dY2 = dX2 * NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            if(dY2 > dYMax)
            {
                dY2 = dYMax;
                dX2 = dY2 / NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            else if(dY2 < dYMin)
            {
                dY2 = dYMin;
                dX2 = dY2 / NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }

            rect.x0=CURVE_AREA_AXIS_START_X + (dX1 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
            rect.y0=CURVE_AREA_AXIS_END_Y - (dY1 - dYMin) / (dYMax - dYMin) * dY * 5.0f;
            rect.x1=CURVE_AREA_AXIS_START_X + (dX2 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
            rect.y1=CURVE_AREA_AXIS_END_Y - (dY2 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

            if(rect.y0<CURVE_AREA_AXIS_START_Y)rect.y0=CURVE_AREA_AXIS_START_Y;//lgj180110
            if(rect.y1<CURVE_AREA_AXIS_START_Y)rect.y1=CURVE_AREA_AXIS_START_Y;//lgj180110
            if(rect.y0>CURVE_AREA_AXIS_END_Y)rect.y0=CURVE_AREA_AXIS_END_Y;//lgj180110
            if(rect.y1>CURVE_AREA_AXIS_END_Y)rect.y1=CURVE_AREA_AXIS_END_Y;//lgj180110
            GUI_DrawLine(rect.x0,rect.y0,rect.x1,rect.y1);


            GUI_SetColor(0x008000);
            strcpy(ConvertStr,"Factor");
            //dc->SetTextColor(RGB(0,0x80,0));
            //dc->SelectObject(fontLogSelect);
            sprintf(StrTemp,": y = %1.3f * x"

                    //strTemp.Format(_T(":  y = %1.3f + (%1.3f - %1.3f) / (1 + (x / %1.3f) ^ %1.3f)")
                    , NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dSlope);
            strcat(ConvertStr,StrTemp);
            GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+3);
            //	strTemp = strType + strTemp;
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 3,ETO_CLIPPED,rect, strTemp,NULL) ;

            sprintf(ConvertStr,"R2: %1.3f",NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dRR);
            GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+20);

            GUI_SetColor(0x00);

        }
        else if(BoardInf.KineticPara.Curve==CURVE_PTOP)
            //else if(CString(BoardInf.curentcurve) == _T("PtoP"))
        {
            //strType = _T("Point to point");
            float dX1, dY1;

            for(i = 0; i < nTotal; i++)
            {
                dX1 = NormalAnalysis.PtopAnalysis[NormalAnalysis.FilterCurrent].dX[i];
                dY1 = NormalAnalysis.PtopAnalysis[NormalAnalysis.FilterCurrent].dY[i];
                if(i == 0)
                {
                    rect.x0=CURVE_AREA_AXIS_START_X + (dX1 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
                    rect.y0=CURVE_AREA_AXIS_END_Y - (dY1 - dYMin) / (dYMax - dYMin) * dY * 5.0f;
                }
                else
                {
                    rect.x1=CURVE_AREA_AXIS_START_X + (dX1 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
                    rect.y1=CURVE_AREA_AXIS_END_Y - (dY1 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

                    if(rect.y0<CURVE_AREA_AXIS_START_Y)rect.y0=CURVE_AREA_AXIS_START_Y;//lgj180110
                    if(rect.y1<CURVE_AREA_AXIS_START_Y)rect.y1=CURVE_AREA_AXIS_START_Y;//lgj180110
                    if(rect.y0>CURVE_AREA_AXIS_END_Y)rect.y0=CURVE_AREA_AXIS_END_Y;//lgj180110
                    if(rect.y1>CURVE_AREA_AXIS_END_Y)rect.y1=CURVE_AREA_AXIS_END_Y;//lgj180110
                    GUI_DrawLine(rect.x0,rect.y0,rect.x1,rect.y1);
                    rect.x0=rect.x1;
                    rect.y0=rect.y1;

                }
            }
            GUI_SetColor(0x008000);

            GUI_DispStringAt("Point to point",CURVE_AREA_TEXT_START_X + 20,CURVE_AREA_AXIS_START_Y+3);
            //	strTemp = strType + strTemp;
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 3,ETO_CLIPPED,rect, strTemp,NULL) ;
            GUI_SetColor(0x00);

            //dc->SetTextColor(RGB(0,0x80,0));
            //dc->SelectObject(fontLogSelect);
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X + 20,rectCurve.top + 3,ETO_CLIPPED,rect, strType,NULL) ;
            //dc->SelectObject(f2);
            //dc->SetTextColor(RGB(0,0,0));
        }
        else if(BoardInf.KineticPara.Curve==CURVE_CUBIC)
            //else if(CString(BoardInf.curentcurve) == _T("CubicSpline"))
        {
            //strType = _T("Cubic spline");
            unsigned char bCurveBegin =0;// false;
            float dX0, dY0, ddX;
            ddX = (dXMax - dXMin) /  ANALYSIS_CURVE_POINT_MAX;
            for(i = 0; i <= ANALYSIS_CURVE_POINT_MAX; i++)
            {
                float dSplineX2, dSplineX1; //区间浓度值
                float dSplineY2, dSplineY1; //区间浓度值
                float dSplineM2, dSplineM1; //区间M值
                float dSplineH; //区间间隔

                dX0 = dXMin + ddX * i;
                k = nTotal - 2; //区间号初始化
                for(j = 0; j < nTotal; j++) //找出样条拟合区间
                {
                    if(dX0 < NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].dX[j])
                    {
                        k = j - 1;
                        if(k < 0)
                        {
                            k = 0;
                        }
                        break;
                    }
                }

                dSplineX2 = NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].dX[k + 1];
                dSplineX1 = NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].dX[k];
                dSplineY2 = NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].dY[k + 1];
                dSplineY1 = NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].dY[k];
                dSplineM2 = NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].dM[k + 1];
                dSplineM1 = NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].dM[k];
                dSplineH = NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].dH[k];
                dY0 = ((dSplineX2 - dX0) * (dSplineX2 - dX0) * (dSplineX2 - dX0)) * dSplineM1 / (6 * dSplineH)
                      + ((dX0 - dSplineX1) * (dX0 - dSplineX1) * (dX0 - dSplineX1)) * dSplineM2 / (6 * dSplineH)
                      + (dSplineY1 - dSplineH * dSplineH * dSplineM1 / 6) * (dSplineX2 - dX0) / dSplineH
                      + (dSplineY2 - dSplineH * dSplineH * dSplineM2 / 6) * (dX0 - dSplineX1) / dSplineH;

                if(dY0 < dYMin)
                {
                    continue;
                }

                if(bCurveBegin==0)
                {
                    bCurveBegin = 1;//true;
                    rect.x0=CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
                    rect.y0=CURVE_AREA_AXIS_END_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

                }
                else
                {
                    rect.x1=CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
                    rect.y1=CURVE_AREA_AXIS_END_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

                    if(rect.y0<CURVE_AREA_AXIS_START_Y)rect.y0=CURVE_AREA_AXIS_START_Y;//lgj180110
                    if(rect.y1<CURVE_AREA_AXIS_START_Y)rect.y1=CURVE_AREA_AXIS_START_Y;//lgj180110
                    if(rect.y0>CURVE_AREA_AXIS_END_Y)rect.y0=CURVE_AREA_AXIS_END_Y;//lgj180110
                    if(rect.y1>CURVE_AREA_AXIS_END_Y)rect.y1=CURVE_AREA_AXIS_END_Y;//lgj180110
                    GUI_DrawLine(rect.x0,rect.y0,rect.x1,rect.y1);
                    rect.x0=rect.x1;
                    rect.y0=rect.y1;
                }
            }

            //dc->SetTextColor(RGB(0,0x80,0));
            //dc->SelectObject(fontLogSelect);
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X + 20,rectCurve.top + 3,ETO_CLIPPED,rect, strType,NULL) ;
            //dc->SelectObject(f2);
            //dc->SetTextColor(RGB(0,0,0));

            GUI_SetColor(0x008000);

            GUI_DispStringAt("Cubic Spline",CURVE_AREA_TEXT_START_X + 20,CURVE_AREA_AXIS_START_Y+3);
						#ifdef SOFTWARE_DN
						   
						
						// sprintf(StrTemp,": y = %1.3f * x"

                    //strTemp.Format(_T(":  y = %1.3f + (%1.3f - %1.3f) / (1 + (x / %1.3f) ^ %1.3f)")
                   // , NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dSlope);
           // strcat(ConvertStr,StrTemp);
						sprintf(ConvertStr,"IC50: %1.3f",NormalAnalysis.SplineAnalysis[NormalAnalysis.FilterCurrent].IC50);
            GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X+20,CURVE_AREA_AXIS_START_Y+20);
            //	strTemp = strType + strTemp;
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 3,ETO_CLIPPED,rect, strTemp,NULL) ;

            //sprintf(ConvertStr,"R2: %1.3f",NormalAnalysis.FactorAnalysis[NormalAnalysis.FilterCurrent].dRR);
           // GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+20);
						
						
						#endif
            //	strTemp = strType + strTemp;
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 3,ETO_CLIPPED,rect, strTemp,NULL) ;
            GUI_SetColor(0x00);

        }//else if(BoardInf.KineticPara.Curve==CURVE_CUBIC)
				#ifdef SOFTWARE_DN
         else if(BoardInf.KineticPara.Curve==CURVE_LOGITLOG)//lugj modify 20180604
            //else if(CString(BoardInf.curentcurve) == _T("Linear"))
        {
            //strType = _T("Linear");

            float dX1, dX2, dY1, dY2;
            dX1 = dXMin;
            dY1 = dX1 * NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dSlope
                  + NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept;
            if(dY1 > dYMax)
            {
                dY1 = dYMax;
                dX1 = (dY1 - NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept)
                      / NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            else if(dY1 < dYMin)
            {
                dY1 = dYMin;
                dX1 = (dY1 - NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept)
                      / NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }

            dX2 = dXMax;
            dY2 = dX2 * NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dSlope
                  + NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept;
            if(dY2 > dYMax)
            {
                dY2 = dYMax;
                dX2 = (dY2 - NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept)
                      / NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            else if(dY2 < dYMin)
            {
                dY2 = dYMin;
                dX2 = (dY2 - NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept)
                      / NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dSlope;
            }
            rect.x0=CURVE_AREA_AXIS_START_X + (dX1 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
            rect.y0=CURVE_AREA_AXIS_END_Y - (dY1 - dYMin) / (dYMax - dYMin) * dY * 5.0f;
            rect.x1=CURVE_AREA_AXIS_START_X + (dX2 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
            rect.y1=CURVE_AREA_AXIS_END_Y - (dY2 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

            if(rect.y0<CURVE_AREA_AXIS_START_Y)rect.y0=CURVE_AREA_AXIS_START_Y;//lgj180110
            if(rect.y1<CURVE_AREA_AXIS_START_Y)rect.y1=CURVE_AREA_AXIS_START_Y;//lgj180110
            if(rect.y0>CURVE_AREA_AXIS_END_Y)rect.y0=CURVE_AREA_AXIS_END_Y;//lgj180110
            if(rect.y1>CURVE_AREA_AXIS_END_Y)rect.y1=CURVE_AREA_AXIS_END_Y;//lgj180110
            GUI_DrawLine(rect.x0,rect.y0,rect.x1,rect.y1);


            GUI_SetColor(0x008000);
            strcpy(ConvertStr,"Logit/log");
            //dc->SetTextColor(RGB(0,0x80,0));
            //dc->SelectObject(fontLogSelect);
						if(NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept>=0)
						{
            sprintf(StrTemp,": y = %1.3f * x + %1.3f"

                    //strTemp.Format(_T(":  y = %1.3f + (%1.3f - %1.3f) / (1 + (x / %1.3f) ^ %1.3f)")
                    , NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dSlope
                    , NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept);
						}
						else
						{
							 sprintf(StrTemp,": y = %1.3f * x - %1.3f"

                    //strTemp.Format(_T(":  y = %1.3f + (%1.3f - %1.3f) / (1 + (x / %1.3f) ^ %1.3f)")
                    , NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dSlope
                    , fabs(NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dIntercept));
						}
            strcat(ConvertStr,StrTemp);
            GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+3);
            //	strTemp = strType + strTemp;
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 3,ETO_CLIPPED,rect, strTemp,NULL) ;

            sprintf(ConvertStr,"R2: %1.3f",NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].dRR);
            sprintf(StrTemp,"   IC50: %1.2f",NormalAnalysis.LogitLogAnalysis[NormalAnalysis.FilterCurrent].IC50);
						strcat(ConvertStr,StrTemp);//IC50 待修改
						GUI_DispStringAt(ConvertStr,CURVE_AREA_TEXT_START_X,CURVE_AREA_AXIS_START_Y+20);
            //strTemp.Format(_T("R2:  %1.3f"), NormalAnalysis.logistic_analysis[NormalAnalysis.FilterCurrent].dRR);
            //dc->ExtTextOutW(CURVE_AREA_TEXT_START_X,rectCurve.top + 20,ETO_CLIPPED,rect, strTemp,NULL) ;
            //dc->SelectObject(f2);
            //dc->SetTextColor(RGB(0,0,0));
            GUI_SetColor(0x00);
        }//else if(BoardInf.KineticPara.Curve==CURVE_LOGITLOG)
				#endif
				
				
        //画标准品
//		dc->SelectObject(&penPoint);
        for(i = 0; i < nTotal; i++)
        {
            int nPointX = CURVE_AREA_AXIS_START_X + (CalcuPara.p_dX[i] - dXMin) / (dXMax - dXMin) * dX * 5.0f;
            int nPointY = CURVE_AREA_AXIS_END_Y - (CalcuPara.p_dY[i] - dYMin) / (dYMax - dYMin) * dY * 5.0f;
            int nDX = 4;
            int nDY = 4;

					
					  #ifdef SOFTWARE_DN
				       if(BoardInf.KineticPara.Curve==CURVE_LOGITLOG) 
					     {
								   nPointY = CURVE_AREA_AXIS_END_Y - (CalcuPara.p_dY2[i] - dYMin) / (dYMax - dYMin) * dY * 5.0f;
							 }
				    #endif
				
            GUI_SetColor(GUI_RED);
            //dc->MoveTo(nPointX - nDX, nPointY);
            //dc->LineTo(nPointX + nDX + 1, nPointY);
            GUI_DrawLine(nPointX - nDX, nPointY,nPointX + nDX + 1, nPointY);

            //dc->MoveTo(nPointX, nPointY - nDY);
            //dc->LineTo(nPointX, nPointY + nDY + 1);
            GUI_DrawLine(nPointX, nPointY - nDY,nPointX, nPointY + nDY + 1);
        }


        //delete[] p_dX;
        //delete[] p_dY;
        //free(p_dX);
        //free(p_dY);
        //penAxis.DeleteObject();
        //penPoint.DeleteObject();
        //penCurve.DeleteObject();
        //penTick.DeleteObject();
        //dc->SelectObject(p_penOld);
        //oldCFont=dc->SelectObject(oldCFont);
    }
}



//正常分析质控
void DisplayQC(void)
{
    float temp;
    short i,j;
    GUI_RECT rect;
    //    nCurrentPage


    if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    {
        GUI_SetFont(GUI_FONT_MED);
    }
    else
    {
        GUI_SetFont(GUI_FONT_MED_CH);
    }


    //画表格的边框
    GUI_SetColor(0xe1d8ca);//ok
    rect.x0 = TABLE_QUALITY_START_X;
    rect.y0 = TABLE_QUALITY_START_Y - TITLESBAR_HEIGHT;
    rect.x1 =TABLE_QUALITY_END_X;
    rect.y1=TABLE_QUALITY_END_Y - TITLESBAR_HEIGHT;
    GUI_DrawRect(rect.x0, rect.y0, rect.x1, rect.y1);
    //画表格顶行的背景色
    GUI_SetColor(COLOR_TITLEBAR);
    GUI_FillRect(rect.x0 + 2, rect.y0 + 2, rect.x1 - 2, rect.y0 + 35);    //首行
    //画表格翻页图标的背景色
    GUI_SetColor(0xf4dbb2);
    GUI_FillRect(rect.x0+2, rect.y1-37, rect.x1-2 , rect.y1-2);                //尾行
    //画表格线(5条）
    GUI_SetColor(COLOR_TITLEBAR);
    for(i=rect.x0; i<rect.x1;)
    {
        for(j=0; j<5; j++)
        {
            GUI_DrawPoint(i,rect.y0+37*2+37*j);
            GUI_DrawPoint(i+1,rect.y0+37*2+37*j);
            GUI_DrawPoint(i+2,rect.y0+37*2+37*j);
        }
        i=i+5;
    }
    //画表格的翻页图标
    GUI_DrawBitmap(&bmQcTabFirst_P, TABPAGE_LEFT_START_X, TABPAGE_LEFT_START_Y- TITLESBAR_HEIGHT);
    GUI_DrawBitmap(&bmQcTabPrev_P, TAB_LEFT_START_X, TAB_LEFT_START_Y - TITLESBAR_HEIGHT);
    GUI_DrawBitmap(&bmQcTabNext_P, TAB_RIGHT_START_X, TAB_RIGHT_START_Y - TITLESBAR_HEIGHT);
    GUI_DrawBitmap(&bmQcTabEnd_P, TABPAGE_RIGHT_START_X, TABPAGE_RIGHT_START_Y - TITLESBAR_HEIGHT);

    //画表格顶部的文字
    GUI_SetColor(0xffdddd);//
    rect.x0 = QC_RESULT_COLUMN_NO ;
    rect.y0 = TABLE_QUALITY_START_Y+QUALITY_ROW_TXT_DIS_Y;
    rect.y0=rect.y0 -TITLESBAR_HEIGHT;
    GUI_DispStringAt(STR_TABLE_RECORD_NO[SystemPrameter.SystemLanguage],rect.x0,rect.y0);
    GUI_DispStringAt(REFERENCE_SELECT[SystemPrameter.SystemLanguage][BoardInf.QualityPara.AbsFlag],
                     QC_RESULT_COLUMN_REFERENCE,
                     rect.y0);
    GUI_DispStringAt(QUALITY_TABLE_SD[SystemPrameter.SystemLanguage],
                     QC_RESULT_COLUMN_SD,
                     rect.y0);
    GUI_DispStringAt(QUALITY_TABLE_CV[SystemPrameter.SystemLanguage],
                     QC_RESULT_COLUMN_CV,// + QUALITY_TABLE_CV_START_X[SystemPrameter.SystemLanguage],
                     rect.y0);
    GUI_DispStringAt(QUALITY_TABLE_UPPER_LIMIT[SystemPrameter.SystemLanguage],
                     QC_RESULT_COLUMN_UPPER,
                     rect.y0);
    GUI_DispStringAt(QUALITY_TABLE_LOWER_LIMIT[SystemPrameter.SystemLanguage],
                     QC_RESULT_COLUMN_LOWER,
                     rect.y0);
    GUI_DispStringAt(QUALITY_TABLE_RESULT[SystemPrameter.SystemLanguage],
                     QC_RESULT_COLUMN_RESULT,
                     rect.y0);
    if(BoardInf.QualityResult.nCurrentPageAnalysis>BoardInf.QualityResult.nPageTotalAnalysis)
    {
        BoardInf.QualityResult.nCurrentPageAnalysis=BoardInf.QualityResult.nPageTotalAnalysis;
    }
    if( (BoardInf.QualityResult.nTotal[NormalAnalysis.FilterCurrent] % QC_PAGE_NUMBER)||(BoardInf.QualityResult.nTotal[NormalAnalysis.FilterCurrent]==0) )
    {
        BoardInf.QualityResult.nPageTotalAnalysis = BoardInf.QualityResult.nTotal[NormalAnalysis.FilterCurrent] / QC_PAGE_NUMBER + 1;  //质控分析的页数
    }
    else
    {
        BoardInf.QualityResult.nPageTotalAnalysis = BoardInf.QualityResult.nTotal[NormalAnalysis.FilterCurrent] / QC_PAGE_NUMBER;
    }
    /*
    if(nCurrentSelect>= QC_MAX ||  nCurrentSelect<0) // //只有九个质控品
    {
       nCurrentSelect=0;
    }
    nCurrentPage = nCurrentSelect / QC_PAGE_NUMBER;
    nCurrentSelectPage = nCurrentSelect % QC_PAGE_NUMBER;
    */
    //质控打开时的绘制
//if(QualityParaBack.Enable)
//{

    GUI_SetColor(0x0);
    j=0;
    for (i = 0; i < QC_MAX; i++)
    {
        if(j + 1 > BoardInf.QualityResult.nTotal[NormalAnalysis.FilterCurrent]) //只有九个质控品
        {
            break;
        }
        if(j + 1 > QC_PAGE_NUMBER && BoardInf.QualityResult.nCurrentPageAnalysis == 0) //每页5个
        {
            break;
        }
        if(BoardInf.QualityResult.nTotalQC[NormalAnalysis.FilterCurrent][i]==0)
        {
            continue;
        }
        if(j < QC_PAGE_NUMBER && BoardInf.QualityResult.nCurrentPageAnalysis > 0) //每页5个
        {
            j++;
            continue;
        }



        //显示No
        GUI_SetColor(0x0);
        rect.x0 = QC_RESULT_COLUMN_NO;
        if(j<QC_PAGE_NUMBER)
        {
            rect.y0=PAGE_SELECT_START_Y+2-TITLESBAR_HEIGHT+j*PAGE_SELECT_DIS_Y;
        }
        else
        {
            rect.y0=PAGE_SELECT_START_Y+2-TITLESBAR_HEIGHT+(j-QC_PAGE_NUMBER)*PAGE_SELECT_DIS_Y;
        }
        j++;
        rect.x1 = rect.x0+55;
        rect.y1 =  rect.y0+SELECT_HIGH;
        sprintf(ConvertStr,"%d",i + 1);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);




        //显示吸光度或浓度Target
        temp=BoardInf.QualityResult.dReferenceQC[NormalAnalysis.FilterCurrent][i];
        //temp=QualityParaBack.dTarget[QualityParaBack.AbsFlag][i + QC_PAGE_NUMBER * nCurrentPage];
        if(temp > 1000.0f || temp < -1000.0f)
        {
            sprintf(ConvertStr,"%.3e",temp);
            EConvert(ConvertStr);
        }
        else
        {
            sprintf(ConvertStr,"%1.3f",temp);
        }
        rect.x0 = QC_RESULT_COLUMN_REFERENCE;
        rect.x1 = rect.x0+110;//
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);


        //显示SD
        GUI_SetColor(0x0);
        // temp=QualityParaBack.dSD[QualityParaBack.AbsFlag][i + QC_PAGE_NUMBER * nCurrentPage];
        temp=BoardInf.QualityPara.dSD[NormalAnalysis.FilterCurrent][i ];
        if(temp > 1000.0f || temp < -1000.0f)
        {
            sprintf(ConvertStr,"%.3e",temp);
            EConvert(ConvertStr);
        }
        else
        {
            sprintf(ConvertStr,"%1.3f",temp);
        }
        rect.x0 = QC_RESULT_COLUMN_SD;
        rect.x1 = rect.x0+100;

        GUI_SetColor(0x0);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);



        //CV
        GUI_SetColor(0x0);
        //if(BoardInf.QualityResult.dReferenceQC[NormalAnalysis.FilterCurrent][i]==0)
        if(BoardInf.QualityResult.dReferenceQC[NormalAnalysis.FilterCurrent][i] < CONCENTRATION_VALUE_MIN && BoardInf.QualityResult.dReferenceQC[NormalAnalysis.FilterCurrent][i] > -CONCENTRATION_VALUE_MIN)
        {
            strcpy(ConvertStr,"N.A.");
        }
        else
        {
            temp=BoardInf.QualityPara.dSD[NormalAnalysis.FilterCurrent][i ] /BoardInf.QualityResult.dReferenceQC[NormalAnalysis.FilterCurrent][i];
            //temp=QualityParaBack.dCV[QualityParaBack.AbsFlag][i + QC_PAGE_NUMBER * nCurrentPage];
            //if(temp < CONCENTRATION_VALUE_MIN && temp > -CONCENTRATION_VALUE_MIN)
            //{
            //	  sprintf(ConvertStr,"%1.3f",0.0f); //			     //strcpy(ConvertStr,"N.A.");
            //}
            if(temp > 1000.0f || temp < -1000.0f)
            {
                sprintf(ConvertStr,"%.3e",temp);
                EConvert(ConvertStr);
            }
            else
            {
                sprintf(ConvertStr,"%1.3f",temp);
            }
        }
        rect.x0 = QC_RESULT_COLUMN_CV;
        rect.x1 = rect.x0+100;//
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);


        //Upper limit
        temp=BoardInf.QualityPara.dUpperLimit[BoardInf.QualityPara.AbsFlag][i];
        if(temp > 1000.0f || temp < -1000.0f)
        {
            sprintf(ConvertStr,"%.3e",temp);
            EConvert(ConvertStr);
        }
        else
        {
            sprintf(ConvertStr,"%1.3f",temp);
        }
        rect.x0 = QC_RESULT_COLUMN_UPPER;
        rect.x1 = rect.x0+120;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);


        //Lower limit
        temp=BoardInf.QualityPara.dLowerLimit[BoardInf.QualityPara.AbsFlag][i ];
        if(temp > 1000.0f || temp < -1000.0f)
        {
            sprintf(ConvertStr,"%.3e",temp);
            EConvert(ConvertStr);
        }
        else
        {
            sprintf(ConvertStr,"%1.3f",temp);
        }
        rect.x0 = QC_RESULT_COLUMN_LOWER;
        rect.x1 = rect.x0+100;//
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);


        //Lower limit
        if(BoardInf.QualityResult.bFailed[NormalAnalysis.FilterCurrent][i ])//失败
        {
            GUI_SetColor(0x0000ff);
        }
        else  //成功
        {
            GUI_SetColor(0x00);
        }

        rect.x0 = QC_RESULT_COLUMN_RESULT;
        rect.x1 = rect.x0+100;//
        strcpy(ConvertStr,STR_QUALITY_RESULT[SystemPrameter.SystemLanguage][BoardInf.QualityResult.bFailed[NormalAnalysis.FilterCurrent][i]]);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);


        rect.y0 +=PAGE_SELECT_DIS_Y;
    }

//}

    //4.画页码
    GUI_SetColor(0x0);
    rect.x0=270;
    rect.x1=360;
    rect.y0=TAB_RIGHT_START_Y-10- TITLESBAR_HEIGHT;
    rect.y1=TAB_RIGHT_END_Y+10- TITLESBAR_HEIGHT;

    sprintf(ConvertStr,"%d",BoardInf.QualityResult.nCurrentPageAnalysis + 1);
    strcat(ConvertStr," / ");
    sprintf(StrTemp,"%d",BoardInf.QualityResult.nPageTotalAnalysis);
    strcat(ConvertStr,StrTemp);
    GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
    //if(board_inf.quality_para.bOpened)
    //{
    //   DisplayList(dc);
    //}





//if(ExpEnable==EXP_ENABLE)
//{
//	DisplayExpandEnable();
//}





    /*
    	StretchBlt(DstDC,
    		MAIN_BK_START_X,
    		MAIN_BK_START_Y,
    		MAIN_BK_END_X-MAIN_BK_START_X,
    		MAIN_BK_END_Y-MAIN_BK_START_Y,
    		table_background.hdcMem,
    		0,
    		0,
    		MAIN_BK_END_X-MAIN_BK_START_X,
    		MAIN_BK_END_Y-MAIN_BK_START_Y,
    		SRCCOPY);

    	oldCFont=dc->SelectObject(f[sys_para.wcLanguage]); //2014-8-10项
    	if(sys_para.wcLanguage == CHINESE)
    		dc->ExtTextOutW(QC_RESULT_COLUMN_NO,EDIT_START_Y+62,ETO_CLIPPED,rect,_T("编号 "),NULL) ;
    	else
    		dc->ExtTextOutW(QC_RESULT_COLUMN_NO,EDIT_START_Y+62,ETO_CLIPPED,rect,_T("NO."),NULL) ;
    	dc->ExtTextOutW(QC_RESULT_COLUMN_REFERENCE,EDIT_START_Y+62,ETO_CLIPPED,rect
    		, REFERENCE_SELECT[sys_para.wcLanguage][BoardInf.quality_para.bABS],NULL) ;
    	dc->ExtTextOutW(QC_RESULT_COLUMN_SD,EDIT_START_Y+62,ETO_CLIPPED,rect,_T("SD"),NULL) ;
    	dc->ExtTextOutW(QC_RESULT_COLUMN_CV,EDIT_START_Y+62,ETO_CLIPPED,rect,_T("CV"),NULL) ;

    	if(sys_para.wcLanguage == CHINESE)
    	{
