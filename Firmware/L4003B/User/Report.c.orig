void Report_Scan(void)
{

    if (TouchKey.KeyStatus==0)
    {
        unsigned char i;
        //unsigned short nWavelength=0;
        GUI_PID_STATE TouchState;
        // int xPhys, yPhys;

        GUI_PID_GetState(&TouchState);
        if (TouchState.Pressed)
        {
            if (ExpEnable==0)  //初使状态，没有弹出扩展项
            {
                if ((TouchState.x>ANALYSIS_LOG_SELECT_START_X)&&(TouchState.x<ANALYSIS_LOG_SELECT_END_X) //2014-8-19项
                        &&(TouchState.y>ANALYSIS_LOG_SELECT_START_Y)&&(TouchState.y<ANALYSIS_LOG_SELECT_END_Y)&& (BoardInf.KineticPara .Enable ==0))
                {
                    if(NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcMode != ANALYSIS_MODE_CURVE)  //只有定量分析、标准曲线才有此按钮
                    {
                        return;
                    }
										#ifdef SOFTWARE_DN
					          if( (BoardInf.KineticPara.Curve==CURVE_LOGITLOG)||(BoardInf.KineticPara.Curve==CURVE_CUBIC) )//&&(NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS ) )
						        {
							          ;
						        }
										else
										{
											  ExpEnable=EXP_LOG;
												TouchKey.KeyStatus=1;
												WM_Invalidate(ReportWin);
										}
						        #else
												ExpEnable=EXP_LOG;
												TouchKey.KeyStatus=1;
												WM_Invalidate(ReportWin);
										#endif
                }
                else if ((TouchState.x>ANALYSIS_FILTER_SELECT_START_X)&&(TouchState.x<ANALYSIS_FILTER_SELECT_END_X) //2014-8-19项
                         &&(TouchState.y> ANALYSIS_FILTER_SELECT_START_Y)&&(TouchState.y< ANALYSIS_FILTER_SELECT_END_Y))
                {
                    //单波长不用选
                    if((NormalAnalysis.wcMode != ANALYSIS_MODE_RAWDATA && NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS
                            && NormalAnalysis.wcMode != ANALYSIS_MODE_CURVE && NormalAnalysis.wcMode != ANALYSIS_MODE_INTERPRET
                            && NormalAnalysis.wcMode != ANALYSIS_MODE_QC) || (BoardInf.Filter2Locate==-1) )
                    {
                        return;
                    }
                    ExpEnable=EXP_FILTER;////normal_analysis.bFilterSelect = !normal_analysis.bFilterSelect;
                    TouchKey.KeyStatus=1;
                    WM_Invalidate(ReportWin);//// DisplayAnalysisFilterExpand();
                }
                //加按钮(在动力学用）
                else if((TouchState.x>PLUS_BUTTON_START_X)&&(TouchState.x<PLUS_BUTTON_END_X)
                        &&(TouchState.y>PLUS_BUTTON_START_Y)&&(TouchState.y<PLUS_BUTTON_END_Y) && (NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA
                                || NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE)
                        && BoardInf.KineticPara.Enable)
                {
                    if(NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA)//动力学原始数据整板号
                    {
                        BoardInf.KineticPara.kinetic_reading_current++;
                        if(BoardInf.KineticPara.kinetic_reading_current >= BoardInf.KineticPara.kinetic_readings_analysis)
                        {
                            BoardInf.KineticPara.kinetic_reading_current = 0;
                        }
                    }
                    else  ////动力学曲线当前样本号
                    {
                        if(BoardInf.KineticPara.nCurrentSample >= TUBE_MAX)
                        {
                            BoardInf.KineticPara.nCurrentSample = 0;
                        }
                        else
                        {
                            BoardInf.KineticPara.nCurrentSample++;
                        }
                    }
                    TouchKey.KeyStatus=1;
                    WM_Invalidate(ReportWin);
                }
                //右侧工具栏减(在动力学用）
                else if((TouchState.x>MINUS_BUTTON_START_X)&&(TouchState.x<MINUS_BUTTON_END_X)
                        &&(TouchState.y>MINUS_BUTTON_START_Y)&&(TouchState.y<MINUS_BUTTON_END_Y) && (NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA
                                || NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE)
                        && BoardInf.KineticPara.Enable)
                {
                    //动力学原始数据
                    if(NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA)
                    {
                        if(BoardInf.KineticPara.kinetic_reading_current <= 0)  //动力学原始数据整板号
                        {
                            BoardInf.KineticPara.kinetic_reading_current = BoardInf.KineticPara.kinetic_readings_analysis - 1;
                        }
                        else
                        {
                            BoardInf.KineticPara.kinetic_reading_current--;
                        }
                    }
                    else //动力学曲线
                    {
                        if(BoardInf.KineticPara.nCurrentSample <= 0)   //动力学曲线当前样本号
                        {
                            BoardInf.KineticPara.nCurrentSample = TUBE_MAX;
                        }
                        else
                        {
                            BoardInf.KineticPara.nCurrentSample--;
                        }
                    }
                    TouchKey.KeyStatus=1;
                    WM_Invalidate(ReportWin);
                }
                //上1页
                else if ((TouchState.x>TAB_LEFT_START_X-15)&&(TouchState.x<TAB_LEFT_END_X+15)&&(TouchState.y>TAB_LEFT_START_Y-15)
                         &&(TouchState.y<TAB_LEFT_END_Y+15) &&(NormalAnalysis.wcMode == ANALYSIS_MODE_QC) )
                {
                    if(BoardInf.QualityResult.nCurrentPageAnalysis <= 0 || BoardInf.QualityResult.nPageTotalAnalysis <= 1)
                    {
                        return;
                    }
                    BoardInf.QualityResult.nCurrentPageAnalysis = 0;
                    TouchKey.KeyStatus=1;
                    WM_Invalidate(ReportWin);
                }
                //下1页
                else if ((TouchState.x>TAB_RIGHT_START_X-15)&&(TouchState.x<TAB_RIGHT_END_X+15)&&(TouchState.y>TAB_RIGHT_START_Y-15)
                         &&(TouchState.y<TAB_RIGHT_END_Y+15)&&(NormalAnalysis.wcMode == ANALYSIS_MODE_QC) )
                {
                    if(BoardInf.QualityResult.nCurrentPageAnalysis >=1 || BoardInf.QualityResult.nPageTotalAnalysis <= 1)
                    {
                        return;// 1;
                    }
                    TouchKey.KeyStatus=1;
                    BoardInf.QualityResult.nCurrentPageAnalysis = 1;
                    WM_Invalidate(ReportWin);
                }
                //质控界面 上1页
                else   if ((TouchState.x>TABPAGE_LEFT_START_X-15)&&(TouchState.x<TABPAGE_LEFT_END_X+15)&&(TouchState.y>TABPAGE_LEFT_START_Y-15)
                           &&(TouchState.y<TABPAGE_LEFT_END_Y+15)&&(NormalAnalysis.wcMode == ANALYSIS_MODE_QC) )
                {
                    if(BoardInf.QualityResult.nCurrentPageAnalysis <= 0 || BoardInf.QualityResult.nPageTotalAnalysis <= 1)
                    {
                        return;
                    }
                    BoardInf.QualityResult.nCurrentPageAnalysis = 0;
                    TouchKey.KeyStatus=1;
                    WM_Invalidate(ReportWin);
                }
                //质控界面  下1页
                else if ((TouchState.x>TABPAGE_RIGHT_START_X-15)&&(TouchState.x<TABPAGE_RIGHT_END_X+15)&&(TouchState.y>TABPAGE_RIGHT_START_Y-15)
                         &&(TouchState.y<TABPAGE_RIGHT_END_Y+15)&&(NormalAnalysis.wcMode == ANALYSIS_MODE_QC))
                {
                    if(BoardInf.QualityResult.nCurrentPageAnalysis >=1 || BoardInf.QualityResult.nPageTotalAnalysis <= 1)
                    {
                        return;// 1;
                    }
                    TouchKey.KeyStatus=1;
                    BoardInf.QualityResult.nCurrentPageAnalysis = 1;
                    WM_Invalidate(ReportWin);
                }
            }//if (ExpEnable==0)  //初使状态，没有弹出扩展项
            else //if (ExpEnable)  //初使状态，没有弹出扩展项
            {
                if (ExpEnable==EXP_LOG )
                {
                    if ((TouchState.x>ANALYSIS_LOG_SELECT_START_X - NORMAL_ANLYSIS_LOG_SELECT_WIDTH)&&(TouchState.x<ANALYSIS_LOG_SELECT_START_X)
                            &&(TouchState.y>ANALYSIS_LOG_SELECT_START_Y)&&(TouchState.y<ANALYSIS_LOG_SELECT_END_Y))
                    {
                        unsigned short nStartX=ANALYSIS_LOG_SELECT_START_X - NORMAL_ANLYSIS_LOG_SELECT_WIDTH+20;
                        unsigned char bLogX,bLogY;
                        bLogX=NormalAnalysis.bLogX;
                        bLogY=NormalAnalysis.bLogY;
                        ExpEnable=0;
                        for(i=0; i<4; i++)
                        {
                            if ((TouchState.x>nStartX+i*NORMAL_ANLYSIS_LOG_SELECT_UNIT_WIDTH)&&(TouchState.x<nStartX+(i+1)*NORMAL_ANLYSIS_LOG_SELECT_UNIT_WIDTH) )
                            {
                                NormalAnalysis.bLogX = i/2;//0;
                                NormalAnalysis.bLogY = i%2;//0;

                                DoNormalAnalysis();
                                if(NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrent] != ANALYSIS_SUCCESS)
                                {

                                    TouchKey.KeyStatus=1;
                                    WM_Invalidate(ReportWin);

                                    //增加提示框
                                    strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrent]]);
                                    Prompt_Interface(PROMPT_WARMING);

                                    //MessageBox(ANALYSIS_ERROR_MESSAGE[sys_para.wcLanguage] /*2015-3-16*/[normal_analysis.nAnalysisResult[normal_analysis.wcFilterCurrent]]); //无分析结果
                                    NormalAnalysis.bLogX = bLogX;
                                    NormalAnalysis.bLogY = bLogY;
                                    DoNormalAnalysis();
                                    //m_bMessageBox = true;
                                }
                                break;
                            }

                        }//for(i=0;i<4;i++)
                    }// if ((TouchState.x>ANALYSIS_LOG_SELECT_START_X - NORMAL_ANLYSIS_LOG_SELECT_WIDTH)&&(TouchState.x<ANALYSIS_LOG_SELECT_START_X)
                }//if (ExpEnable==EXP_LOG )
                else if (ExpEnable==EXP_FILTER)
                {
                    ExpEnable=0;
                    if ((TouchState.x>ANALYSIS_FILTER_SELECT_START_X - NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_WIDTH)&&(TouchState.x<ANALYSIS_FILTER_SELECT_START_X)
                            &&(TouchState.y>ANALYSIS_FILTER_SELECT_START_Y)&&(TouchState.y<ANALYSIS_FILTER_SELECT_END_Y))
                    {
                        unsigned short nStartX = ANALYSIS_FILTER_SELECT_START_X - NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_WIDTH+15;
                        //Filter 1&2
                        if ((TouchState.x>nStartX)&&(TouchState.x<nStartX+NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_UNIT_WIDTH)
                                &&(BoardInf.KineticPara.PreProcess<PRE_CALCULATE_MAX)&&(BoardInf.KineticPara.PreProcess>PRE_CALCULATE_NO)		)
                        {

                            if(NormalAnalysis.nAnalysisResult[2] != ANALYSIS_SUCCESS && NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS)
                            {
                                WM_Invalidate(ReportWin);
                                //增加提示框
                                strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[2]]);
                                Prompt_Interface(PROMPT_WARMING);
                            }
                            else
                            {
                                NormalAnalysis.FilterCurrent = 2;
                                WM_Invalidate(ReportWin);

                            }
                        }//if
                        //Filter 1
                        else  if ((TouchState.x>nStartX+NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_UNIT_WIDTH)&&(TouchState.x<nStartX+NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_UNIT_WIDTH*2) )
                        {
                            if(NormalAnalysis.nAnalysisResult[0] != ANALYSIS_SUCCESS && NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS)
                            {
                                WM_Invalidate(ReportWin);

                                //增加提示框
                                strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[0]]);
                                Prompt_Interface(PROMPT_WARMING);
                            }
                            else
                            {
                                NormalAnalysis.FilterCurrent = 0;
                                WM_Invalidate(ReportWin);
                            }
                        }//if
                        //Filter 2
                        else  if ((TouchState.x>nStartX+NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_UNIT_WIDTH*2)&&(TouchState.x<nStartX+NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_UNIT_WIDTH*3) )
                        {
                            if(NormalAnalysis.nAnalysisResult[0] != ANALYSIS_SUCCESS && NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS)
                            {
                                WM_Invalidate(ReportWin);
                                //增加提示框
                                strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[1]]);
                                Prompt_Interface(PROMPT_WARMING);
                            }
                            else
                            {
                                NormalAnalysis.FilterCurrent = 1;
                                WM_Invalidate(ReportWin);
                            }
                        }//if
                        // else
                        // {
                        //	   WM_Invalidate(ReportWin);
                        // }

                    }//	 if ((TouchState.x>ANALYSIS_FILTER_SELECT_START_X - NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_WIDTH)&&(TouchState.x<ANALYSIS_FILTER_SELECT_START_X)
                }// else if (ExpEnable==EXP_FILTER)

                ExpEnable = 0;
                WM_Invalidate(ReportWin);
                TouchKey.KeyStatus = 1;
            }//if (ExpEnable==0)  else if (ExpEnable)
        }//if (TouchKey.KeyStatus)else if (TouchState.Pressed)
    }

}




void Report_Go(void)
{

    if (TouchKey.KeyStatus)
    {
        GUI_PID_STATE TouchState;

        GUI_PID_GetState(&TouchState);
        if (TouchState.Pressed == 0)
        {
            TouchKey.KeyPressDelay++;
            if (TouchKey.KeyPressDelay > TOUCH_RELEASE_DELAY)
            {
                TouchKey.KeyPressDelay = 0;
                TouchKey.KeyStatus = 0;
            }
        }//if (TouchState.Pressed == 0)

        /*
        //增加提示框
        //strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrent]]);
        Prompt_Interface(ANALYSIS_ERROR);

        //MessageBox(ANALYSIS_ERROR_MESSAGE[sys_para.wcLanguage] [normal_analysis.nAnalysisResult[normal_analysis.wcFilterCurrent]]); //无分析结果
        NormalAnalysis.bLogX = bLogX;
        NormalAnalysis.bLogY = bLogY;
        DoNormalAnalysis();



        //增加提示框
        //	strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[2]]);
        Prompt_Interface(ANALYSIS_ERROR);
        //MessageBox(ANALYSIS_ERROR_MESSAGE[sys_para.wcLanguage] [normal_analysis.nAnalysisResult[2]]); //无分析结果

        																	   //增加提示框
        													        // strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[0]]);
        													         Prompt_Interface(ANALYSIS_ERROR);
        					                                       //MessageBox(ANALYSIS_ERROR_MESSAGE[sys_para.wcLanguage][normal_analysis.nAnalysisResult[0]]); //无分析结果
        					                                       //m_bMessageBox = true;


        																	   //增加提示框
        													     //    strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[1]]);
        													         Prompt_Interface(ANALYSIS_ERROR);
        					                                       //MessageBox(ANALYSIS_ERROR_MESSAGE[sys_para.wcLanguage][normal_analysis.nAnalysisResult[1]]); //无分析结果
        	*/
    }//if (TouchKey.KeyStatus)			//m_bMessageBox = true;

