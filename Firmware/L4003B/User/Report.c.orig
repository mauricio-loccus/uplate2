WM_HWIN ReportWin = NULL;       //检测窗体




void RefreshReport(void)
{
    unsigned char i;
    if(BoardInf.KineticPara.Enable)
    {
        for (i = 0; i < GUI_COUNTOF(_aButtonReportKinetic); i++)
        {
            if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
            {
                BUTTON_SetFont(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i), GUI_FONT_BIG);
                BUTTON_SetText(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i), _aButtonReportKinetic[i].acLabelEn);
            }
            else
            {
                BUTTON_SetFont(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i), GUI_FONT_BIG_CH);
                BUTTON_SetText(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i), _aButtonReportKinetic[i].acLabelCh);
            }
            WM_EnableWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i));
        }
        //不显示按钮
        WM_HideWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON));
        WM_HideWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON+1));
    }
    else
    {
        for (i = 0; i < GUI_COUNTOF(_aButtonReport); i++)
        {
            if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
            {
                BUTTON_SetFont(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i), GUI_FONT_BIG);
                BUTTON_SetText(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i), _aButtonReport[i].acLabelEn);
            }
            else
            {
                BUTTON_SetFont(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i), GUI_FONT_BIG_CH);
                BUTTON_SetText(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i), _aButtonReport[i].acLabelCh);
            }

            WM_EnableWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i));
            if( (BoardInf.InterpretPara.Enable==0)&&(i==1) )
            {
                WM_DisableWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i));
            }
            if( (BoardInf.KineticPara.Curve==CURVE_NO)&&( (i==2)||(i==3)) )
            {
                WM_DisableWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i));
            }
            if( (BoardInf.QualityPara.Enable==0)&&(i==4) )
            {
                WM_DisableWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON + i));
            }


        }
        //显示按钮
        WM_ShowWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON));
        WM_ShowWindow(WM_GetDialogItem(ReportWin, ID_REPORT_BUTTON+1));

    }
}


void  DisplayAnalysisFilterExpand(void)
{
    GUI_RECT rect;
//	int i;

    int start_x, start_y, wide, high;

    start_x=ANALYSIS_FILTER_SELECT_START_X - NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_WIDTH;// +10;// 20; //2014-8-18项
    start_y=ANALYSIS_FILTER_SELECT_START_Y - TITLESBAR_HEIGHT;
    wide=NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_UNIT_WIDTH;
    high=20;
    //GUI_DrawBitmap(&bmExpMenuLeft_230_46, start_x, start_y);

    GUI_DrawBitmap(&bmExpMenuLeft_20_46, start_x, start_y);
    GUI_SetColor(COLOR_EXP_PICTURE_FRAME);
    GUI_DrawLine(start_x+20, start_y,start_x+NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_WIDTH,start_y);
    GUI_DrawLine(start_x+20, start_y+45,start_x+NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_WIDTH,start_y+45);
    GUI_SetColor(COLOR_EXP_PICTURE);
    GUI_FillRect(start_x+20, start_y+1,start_x+NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_WIDTH,start_y+44);


    start_x=start_x+15;//17
    start_y=start_y+23;


    //有预计算则为3个选项(最左侧项  Filter 1&2)
    if(BoardInf.KineticPara.PreProcess!=PRE_CALCULATE_NO)
    {
        GUI_SetFont(GUI_FONT_SMALL);
        if(NormalAnalysis.FilterCurrent > 1) //2选中
        {
            GUI_SetColor(COLOR_MODE_SEL_TXT);
        }
        else
        {
            GUI_SetColor(0x068400);
        }
        //第2行
        rect.x0 = start_x;
        rect.y0 = start_y +5;
        rect.x1 = start_x + wide;
        rect.y1 = start_y+ 17;
        GUI_FillRect(rect.x0+2, rect.y0, rect.x1-2, rect.y1 );

        GUI_SetColor(0xb5e3cd);
        if ((BoardInf.KineticPara.PreProcess<PRE_CALCULATE_MAX) && (BoardInf.KineticPara.PreProcess >PRE_CALCULATE_NO ))
            //if(BoardInf.KineticPara.PreProcess<PRE_CALCULATE_MAX)
        {
            strcpy(ConvertStr,PRE_CALCULATE_STR[ BoardInf.KineticPara.PreProcess]);
        }
        else //if (BoardInf.KineticPara.PreProcess == 0)
        {
            if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
            {
                GUI_SetFont(GUI_FONT_SMALL);
            }
            else
            {
                GUI_SetFont(GUI_FONT_MED_CH);
            }
            strcpy(ConvertStr, STR_NO[SystemPrameter.SystemLanguage]);//"Off"
        }
        //   strcpy(ConvertStr,PRE_CALCULATE_STR[BoardInf.KineticPara.PreProcess]);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);

        //第1行
        GUI_SetColor(0x068400);
        rect.y0 = start_y - high;
        rect.y1 = start_y -2;
        if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
        {
            GUI_SetFont(GUI_FONT_MED);
        }
        else
        {
            GUI_SetFont(GUI_FONT_MED_CH);
        }
        strcpy(ConvertStr,SELECT_CONTROL_REPORT_FILTER12[SystemPrameter.SystemLanguage]);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
    }

    //2.第2列(滤光片1)
    start_x+=NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_UNIT_WIDTH;

    if(NormalAnalysis.FilterCurrent ==0)
    {
        GUI_SetColor(COLOR_MODE_SEL_TXT);
    }
    else
    {
        GUI_SetColor(0x068400);
    }
    //底行背景色
    rect.x0 = start_x;
    rect.y0 = start_y +5;
    rect.x1 = start_x + wide;
    rect.y1 = start_y+ 17;
    GUI_FillRect(rect.x0+2, rect.y0, rect.x1-2, rect.y1 );

    //底行文本
    GUI_SetColor(0xb5e3cd);
    if(BoardInf.Filter1Locate<0)
    {
        if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
        {
            GUI_SetFont(GUI_FONT_SMALL);
        }
        else
        {
            GUI_SetFont(GUI_FONT_SMALL_CH);
        }
        GUI_DispStringInRect(STR_NO[SystemPrameter.SystemLanguage], &rect, GUI_TA_LEFT | GUI_TA_VCENTER);//"Off"
        GUI_SetFont(GUI_FONT_SMALL);

    }
    else
    {
        GUI_SetFont(GUI_FONT_SMALL);
        sprintf(ConvertStr,"%d",FilterLun.Filter[BoardInf.Filter1Locate]);
        strcat(ConvertStr,"nm");
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
    }

    //顶行文本
    if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    {
        GUI_SetFont(GUI_FONT_MED);
    }
    else
    {
        GUI_SetFont(GUI_FONT_MED_CH);
    }
    GUI_SetColor(0x068400);
    rect.y0 = start_y - high;
    rect.y1 = start_y -2;
    strcpy(ConvertStr,SELECT_CONTROL_REPORT_FILTER1[SystemPrameter.SystemLanguage]);
    GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);


    //3.第3列(滤光片2)
    start_x+=NORMAL_ANLYSIS_RAWDATA_FILTER_SELECT_UNIT_WIDTH;
    if(NormalAnalysis.FilterCurrent ==1)
    {
        GUI_SetColor(COLOR_MODE_SEL_TXT);
    }
    else
    {
        GUI_SetColor(0x068400);
    }
    //底行背景色
    rect.x0 = start_x;
    rect.y0 = start_y +5;
    rect.x1 = start_x + wide;
    rect.y1 = start_y+ 17;
    GUI_FillRect(rect.x0+2, rect.y0, rect.x1-2, rect.y1 );

    //底行文本
    GUI_SetColor(0xb5e3cd);
    if(BoardInf.Filter2Locate<0)
    {
        if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
        {
            GUI_SetFont(GUI_FONT_SMALL);
        }
        else
        {
            GUI_SetFont(GUI_FONT_SMALL_CH);
        }

        GUI_DispStringInRect(STR_OFF[SystemPrameter.SystemLanguage], &rect, GUI_TA_LEFT | GUI_TA_VCENTER);//"Off"
        GUI_SetFont(GUI_FONT_SMALL);
    }
    else
    {
        GUI_SetFont(GUI_FONT_SMALL);
        sprintf(ConvertStr,"%d",FilterLun.Filter[BoardInf.Filter2Locate]);
        strcat(ConvertStr,"nm");
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
    }

    if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    {
        GUI_SetFont(GUI_FONT_MED);
    }
    else
    {
        GUI_SetFont(GUI_FONT_MED_CH);
    }
    //顶行文本
    GUI_SetColor(0x068400);
    rect.y0 = start_y - high;
    rect.y1 = start_y -2;
    strcpy(ConvertStr,SELECT_CONTROL_REPORT_FILTER2[SystemPrameter.SystemLanguage]);
    GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);


}

void DisplayAnalysisLogExpand(void) //2014-8-19项
{
    GUI_RECT rect;
    unsigned char i;
    //dc->SetTextColor(RGB(0xef,0xf1,0xf7));
    //dc->SetBkMode(TRANSPARENT);

    int start_x,start_y,wide,high;
    int nSel;
//	int nDX,nSel;
    //int nCal;
    start_x=ANALYSIS_LOG_SELECT_START_X - NORMAL_ANLYSIS_LOG_SELECT_WIDTH;// + 10; //2014-8-18项
    start_y=ANALYSIS_LOG_SELECT_START_Y-TITLESBAR_HEIGHT;
    wide=NORMAL_ANLYSIS_LOG_SELECT_UNIT_WIDTH;
    high=40;

//    GUI_DrawBitmap(&bmExpMenuLeft_330_46, start_x, start_y);
    GUI_DrawBitmap(&bmExpMenuLeft_20_46, start_x, start_y);
    GUI_SetColor(COLOR_EXP_PICTURE_FRAME);
    GUI_DrawLine(start_x+20, start_y,start_x+NORMAL_ANLYSIS_LOG_SELECT_WIDTH,start_y);
    GUI_DrawLine(start_x+20, start_y+45,start_x+NORMAL_ANLYSIS_LOG_SELECT_WIDTH,start_y+45);
    GUI_SetColor(COLOR_EXP_PICTURE);
    GUI_FillRect(start_x+20, start_y+1,start_x+NORMAL_ANLYSIS_LOG_SELECT_WIDTH,start_y+44);

    start_x=start_x+20;

    //dc->SetTextColor(RGB(0x00,0x84,0x06));
    GUI_SetColor(0x068400);
    nSel = NormalAnalysis.bLogX * 2 + NormalAnalysis.bLogY;
    for(i = 0; i < 4; i++)
    {
        //填充选中的底色
        GUI_SetColor(COLOR_MODE_SEL_BK);
        if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
        {
            GUI_SetFont(GUI_FONT_MED);
        }
        else
        {
            GUI_SetFont(GUI_FONT_MED_CH);
        }



        if(nSel == i)
        {
            GUI_SetColor(0xe7a362);
            GUI_FillRect(start_x, start_y+3, start_x + wide, start_y+high);
            GUI_SetColor(COLOR_MODE_SEL_TXT);
        }
        else
        {
            GUI_SetColor(0x068400);
        }

        //  CString strTemp = CString(XY_COORDINATES[SystemPrameter.SystemLanguage][i/2]) + _T(" / ") + CString(XY_COORDINATES[SystemPrameter.SystemLanguage][i%2]);
        //	GetClientRect(rect);
        //	dc->ExtTextOutW(start_x + 10,stary_y - 14,ETO_CLIPPED,rect, strTemp,NULL) ;

        rect.x0 = start_x;
        rect.y0 = start_y +3;
        rect.x1 = start_x + wide;
        rect.y1 = start_y + high;

        //start_x += wide;
        //wide = MODE_EXPAND_WIDTH2;

        strcpy(ConvertStr,XY_COORDINATES[SystemPrameter.SystemLanguage][i/2]);
        strcat(ConvertStr, "/");
        strcat(ConvertStr,XY_COORDINATES[SystemPrameter.SystemLanguage][i%2]);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);

        start_x+=NORMAL_ANLYSIS_LOG_SELECT_UNIT_WIDTH;
    }

    //dc->SelectObject(oldCFont);
    //delete dc;
}



void DoNormalAnalysis(void)
{
    int i,j;
    float dTemp;
    unsigned char bHasResult = 1;//true;

    NormalAnalysis.wcModeBack = NormalAnalysis.wcMode;               //备份分析模式
    NormalAnalysis.FilterCurrentBack = NormalAnalysis.FilterCurrent; //备份滤光片选择
    //if(BoardInf.curentcurve[0] != _T('N')) //不进行定量分析

    //1.进行定量分析
    if(BoardInf.KineticPara.Curve>=0) //进行定量分析
    {
        //if(CString(BoardInf.curentcurve) == _T("Linear"))
        if(BoardInf.KineticPara.Curve==CURVE_LINEAR) //进行定量分析
        {
            for(j = 0; j < 3; j++)
            {
                if(NormalAnalysis.nCalibratorCountTotal[j] >= 2)
                {
                    NormalAnalysis.nAnalysisResult[j] = DoLinearAnalysis(j); //线性拟合
                }
                else
                {
                    NormalAnalysis.nAnalysisResult[j] = ANALYSIS_ERROR_CALIBRATOR_NUMBER;
                }
            }
        }

        else if(BoardInf.KineticPara.Curve==CURVE_FACTOR) //进行定量分析
            //else if(CString(BoardInf.curentcurve) == _T("Factor"))
        {
            for(j = 0; j < 3; j++)
            {
                if(NormalAnalysis.nCalibratorCountTotal[j] >= 1)
                {
                    NormalAnalysis.nAnalysisResult[j] = DoFactorAnalysis(j); //比例拟合
                }
                else
                {
                    NormalAnalysis.nAnalysisResult[j] = ANALYSIS_ERROR_CALIBRATOR_NUMBER;
                }
            }
        }

        else if(BoardInf.KineticPara.Curve==CURVE_LOGISTIC) //进行定量分析
            //else if(CString(BoardInf.curentcurve) == _T("Logistic"))
        {
            for(j = 0; j < 3; j++)
            {
                if(NormalAnalysis.nCalibratorCountTotal[j] >= 4)
                {
                    NormalAnalysis.nAnalysisResult[j] = DoLogisticAnalysis(j); //logistic拟合
                }
                else
                {
                    NormalAnalysis.nAnalysisResult[j] = ANALYSIS_ERROR_CALIBRATOR_NUMBER;
                }
            }
        }
        else if(BoardInf.KineticPara.Curve==CURVE_PTOP) //进行定量分析
            //else if(CString(BoardInf.curentcurve) == _T("PtoP"))
        {
            for(j = 0; j < 3; j++)
            {
                if(NormalAnalysis.nCalibratorCountTotal[j] >= 2)
                {
                    NormalAnalysis.nAnalysisResult[j] = DoPtoPAnalysis(j); //点对点拟合
                }
                else
                {
                    NormalAnalysis.nAnalysisResult[j] = ANALYSIS_ERROR_CALIBRATOR_NUMBER;
                }
            }
        }

        else if(BoardInf.KineticPara.Curve==CURVE_CUBIC) //进行定量分析
            //else if(CString(BoardInf.curentcurve) == _T("CubicSpline"))
        {
            for(j = 0; j < 3; j++)
            {
                if(NormalAnalysis.nCalibratorCountTotal[j] >= 3)
                {
                    NormalAnalysis.nAnalysisResult[j] = DoSplineAnalysis(j); //样条函数拟合
                }
                else
                {
                    NormalAnalysis.nAnalysisResult[j] = ANALYSIS_ERROR_CALIBRATOR_NUMBER;
                }
            }
        }
        #ifdef SOFTWARE_DN
				else if(BoardInf.KineticPara.Curve==CURVE_LOGITLOG) //进行定量分析
        {
            for(j = 0; j < 3; j++)
            {
                if(NormalAnalysis.nCalibratorCountTotal[j] >= 3)
                {
                    NormalAnalysis.nAnalysisResult[j] = DoLogitlogAnalysis(j); //Logitlog函数拟合
                }
                else
                {
                    NormalAnalysis.nAnalysisResult[j] = ANALYSIS_ERROR_CALIBRATOR_NUMBER;
                }
            }
        }
				
				
				    for(i = UD_MIN; i <= UD_MAX; i++)
				    {
				       SearchForUD(i);
				    }
				
				
				
				#endif
        //分析OK
        if(NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrentBack] == ANALYSIS_SUCCESS)
        {
            NormalAnalysis.FilterCurrent = NormalAnalysis.FilterCurrentBack;
            if(NormalAnalysis.wcModeBack != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcModeBack != ANALYSIS_MODE_CURVE)
            {
                NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
            }
        }
        else if(NormalAnalysis.nAnalysisResult[2] == ANALYSIS_SUCCESS)
        {
            NormalAnalysis.FilterCurrent = 2;
            if(NormalAnalysis.wcModeBack != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcModeBack != ANALYSIS_MODE_CURVE)
            {
                NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
            }
        }
        else if(NormalAnalysis.nAnalysisResult[0] == ANALYSIS_SUCCESS)
        {
            NormalAnalysis.FilterCurrent = 0;
            if(NormalAnalysis.wcModeBack != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcModeBack != ANALYSIS_MODE_CURVE)
            {
                NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
            }
        }
        else if(NormalAnalysis.nAnalysisResult[1] == ANALYSIS_SUCCESS)
        {
            NormalAnalysis.FilterCurrent = 1;
            if(NormalAnalysis.wcModeBack != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcModeBack != ANALYSIS_MODE_CURVE)
            {
                NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
            }
        }
        else
        {
            NormalAnalysis.wcMode = ANALYSIS_MODE_RAWDATA;
        }
    }//if(BoardInf.KineticPara.Curve>=0) //进行定量分析






//2.定性分析
    if(BoardInf.InterpretPara.Enable) //定性分析
    {
        for(j = 0; j < 3; j++)
        {
            if((BoardInf.InterpretPara.AbsFlag==0) && ((BoardInf.KineticPara.Curve ==CURVE_NO)   //定性分析为浓度,无曲线
                    || (NormalAnalysis.nAnalysisResult[j] != ANALYSIS_SUCCESS)))
            {
                BoardInf.InterpretPara.nAnalysisResult[j] = ANALYSIS_ERROR_NO_CONCENTRATION;
                continue;
            }

            if(j > 0 && BoardInf.Filter2Locate<0)
            {
                BoardInf.InterpretPara.nAnalysisResult[j] = ANALYSIS_ERROR_NO_CONCENTRATION;
                continue;
            }
            
						
						#ifdef SOFTWARE_DN
						    if( (BoardInf.InterpretPara.AbsFlag==0)&&(BoardInf.InterpretPara.Mode=INTER_SPECIAL) )
								{
										BoardInf.InterpretPara.nAnalysisResult[j] = ANALYSIS_SUCCESS;
								}
								else 
								{
									BoardInf.InterpretPara.nAnalysisResult[j] = SearchForNCPC(j);
								}
						#else
                BoardInf.InterpretPara.nAnalysisResult[j] = SearchForNCPC(j);
            #endif
								
            if(BoardInf.InterpretPara.nAnalysisResult[j] == ANALYSIS_SUCCESS)
            {
                for(i = 0; i < TUBE_MAX; i++)
                {
                    bHasResult = 1;
                    BoardInf.InterpretPara.bWeakPos[j][i] = 0;
                    BoardInf.InterpretPara.bPos[j][i] = 0;
                    if(j < 2)
                    {
                        dTemp = dABS[0][j][i];
                    }
                    else if(NormalAnalysis.bPreCalOK[0][i])
                    {
                        dTemp = NormalAnalysis.dPreCal[0][i];
                    }
                    else
                    {
                        bHasResult = 0;
                    }

                    if((BoardInf.InterpretPara.AbsFlag==0) && bHasResult)
                    {
                        dTemp = NormalAnalysis.dConcentration[j][i];

                        if(dTemp < 0.0f)
                        {
                            bHasResult = 0;
                        }
                    }

                    if(bHasResult)
                    {
											  #ifdef SOFTWARE_DN
											        if( (BoardInf.InterpretPara.AbsFlag==0)&&(BoardInf.InterpretPara.Mode=INTER_SPECIAL) )
															{
											                 if(dTemp > BoardInf.InterpretPara.fCoef_DN[1])//阳性条件
																			 {
																				   BoardInf.InterpretPara.bPos[j][i] = 1;
																			 }
																			 else if(dTemp > BoardInf.InterpretPara.fCoef_DN[2])//弱阳性条件
																			 {
																				   BoardInf.InterpretPara.bWeakPos[j][i] = 1;
																			 }
															}
															else
															{
																   if(BoardInf.InterpretPara.GreatFlag)
																		{
																				if(dTemp > BoardInf.InterpretPara.dReference[j])
																				{
																						BoardInf.InterpretPara.bPos[j][i] = 1;
																				}
																				else if(dTemp > BoardInf.InterpretPara.dReference[j] * (1.0f - BoardInf.InterpretPara.fWeakPValue / 100.0f))
																				{
																						BoardInf.InterpretPara.bWeakPos[j][i] = 1;
																				}
																		}
																		else
																		{
																				if(dTemp < BoardInf.InterpretPara.dReference[j])
																				{
																						BoardInf.InterpretPara.bPos[j][i] = 1;
																				}
																				else if(dTemp < BoardInf.InterpretPara.dReference[j] * (1.0f + BoardInf.InterpretPara.fWeakPValue / 100.0f))
																				{
																						BoardInf.InterpretPara.bWeakPos[j][i] = 1;
																				}
																		}//if(BoardInf.InterpretPara.GreatFlag)else
															}
												#else
														 
                        if(BoardInf.InterpretPara.GreatFlag)
                        {
                            if(dTemp > BoardInf.InterpretPara.dReference[j])
                            {
                                BoardInf.InterpretPara.bPos[j][i] = 1;
                            }
                            else if(dTemp > BoardInf.InterpretPara.dReference[j] * (1.0f - BoardInf.InterpretPara.fWeakPValue / 100.0f))
                            {
                                BoardInf.InterpretPara.bWeakPos[j][i] = 1;
                            }
                        }
                        else
                        {
                            if(dTemp < BoardInf.InterpretPara.dReference[j])
                            {
                                BoardInf.InterpretPara.bPos[j][i] = 1;
                            }
                            else if(dTemp < BoardInf.InterpretPara.dReference[j] * (1.0f + BoardInf.InterpretPara.fWeakPValue / 100.0f))
                            {
                                BoardInf.InterpretPara.bWeakPos[j][i] = 1;
                            }
                        }//if(BoardInf.InterpretPara.GreatFlag)else
												#endif
                    }//if(bHasResult)
                }//for(i = 0; i < TUBE_MAX; i++)
            }//if(BoardInf.InterpretPara.nAnalysisResult[j] == ANALYSIS_SUCCESS)
        }//for(j = 0; j < 3; j++)


        if(NormalAnalysis.wcModeBack == ANALYSIS_MODE_INTERPRET || NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA)
        {
            if(BoardInf.InterpretPara.nAnalysisResult[NormalAnalysis.FilterCurrentBack] == ANALYSIS_SUCCESS)
            {
                NormalAnalysis.FilterCurrent = NormalAnalysis.FilterCurrentBack;
                NormalAnalysis.wcMode = ANALYSIS_MODE_INTERPRET;
            }
            else if(BoardInf.InterpretPara.nAnalysisResult[2] == ANALYSIS_SUCCESS)
            {
                NormalAnalysis.FilterCurrent = 2;
                NormalAnalysis.wcMode = ANALYSIS_MODE_INTERPRET;
            }
            else if(BoardInf.InterpretPara.nAnalysisResult[0] == ANALYSIS_SUCCESS)
            {
                NormalAnalysis.FilterCurrent = 0;
                NormalAnalysis.wcMode = ANALYSIS_MODE_INTERPRET;
            }
            else if(BoardInf.InterpretPara.nAnalysisResult[1] == ANALYSIS_SUCCESS)
            {
                NormalAnalysis.FilterCurrent = 1;
                NormalAnalysis.wcMode = ANALYSIS_MODE_INTERPRET;
            }
            else
            {
                NormalAnalysis.wcMode = ANALYSIS_MODE_RAWDATA;
            }
        }//if(NormalAnalysis.wcModeBack == ANALYSIS_MODE_INTERPRET || NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA)
    }//if(BoardInf.InterpretPara.Enable) //定性分析





    //3.质控分析
    if(BoardInf.QualityPara.Enable )
        //if(BoardInf.quality_para.bOpened)
    {
        for(j = 0; j < 3; j++)
        {

            if( (BoardInf.InterpretPara.AbsFlag==0) &&
                    ((BoardInf.KineticPara.Curve==CURVE_NO) || (NormalAnalysis.nAnalysisResult[j] != ANALYSIS_SUCCESS)) )
            {
                BoardInf.QualityResult.nAnalysisResult[j] = ANALYSIS_ERROR_NO_CONCENTRATION;
                //BoardInf.quality_para.nAnalysisResult[j] = ANALYSIS_ERROR_NO_CONCENTRATION;
                continue;
            }

            if( (j > 0 && BoardInf.Filter2Locate<0) )
                //	if(j > 0 && BoardInf.Filter_2[0] == _T('N'))
            {
                BoardInf.QualityResult.nAnalysisResult[j] = ANALYSIS_ERROR_NO_CONCENTRATION;
                continue;
            }

            BoardInf.QualityResult.nAnalysisResult[j] = SearchForQC(j);

            if(BoardInf.QualityResult.nAnalysisResult[j] == ANALYSIS_SUCCESS)
            {
                for(i = 0; i < QC_MAX; i++)
                {
                    if(BoardInf.QualityResult.nTotalQC[j][i] < 1) //必须有QC
                    {
                        continue;
                    }
                    //float dTemp;
                    BoardInf.QualityResult.bFailed[j][i] = 0;

                    if(BoardInf.QualityResult.dReferenceQC[j][i] < BoardInf.QualityPara.dLowerLimit[BoardInf.QualityPara.AbsFlag][i]
                            || BoardInf.QualityResult.dReferenceQC[j][i] > BoardInf.QualityPara.dUpperLimit[BoardInf.QualityPara.AbsFlag][i])
                    {
                        BoardInf.QualityResult.bFailed[j][i] = 1;
                    }
                }
            }//if(BoardInf.QualityResult.nAnalysisResult[j] == ANALYSIS_SUCCESS)
        }//for(j = 0; j < 3; j++)

        if(NormalAnalysis.wcModeBack == ANALYSIS_MODE_QC || NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA)
        {
            if(BoardInf.QualityResult.nAnalysisResult[NormalAnalysis.FilterCurrentBack] == ANALYSIS_SUCCESS)
            {
                NormalAnalysis.FilterCurrent = NormalAnalysis.FilterCurrentBack;
                NormalAnalysis.wcMode = ANALYSIS_MODE_QC;
            }
            else if(BoardInf.QualityResult.nAnalysisResult[2] == ANALYSIS_SUCCESS)
            {
                NormalAnalysis.FilterCurrent = 2;
                NormalAnalysis.wcMode = ANALYSIS_MODE_QC;
            }
            else if(BoardInf.QualityResult.nAnalysisResult[0] == ANALYSIS_SUCCESS)
            {
                NormalAnalysis.FilterCurrent = 0;
                NormalAnalysis.wcMode = ANALYSIS_MODE_QC;
            }
            else if(BoardInf.QualityResult.nAnalysisResult[1] == ANALYSIS_SUCCESS)
            {
                NormalAnalysis.FilterCurrent = 1;
                NormalAnalysis.wcMode = ANALYSIS_MODE_QC;
            }
            else
            {
                NormalAnalysis.wcMode = ANALYSIS_MODE_RAWDATA;
            }
        }//if(NormalAnalysis.wcModeBack == ANALYSIS_MODE_QC || NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA)
    }//if(BoardInf.QualityResult.Enable )




}






void InitNormalAnalysis(void)
{
    int i,j;

    memset(&NormalAnalysis, 0, sizeof(NormalAnalysis));
    NormalAnalysis.wcMode = ANALYSIS_MODE_RAWDATA;
    NormalAnalysis.FilterCurrent = 0; //选择第一滤镜
    //NormalAnalysis.FilterSelect = false;
    //NormalAnalysis.LogSelect = false;
    NormalAnalysis.bLogX = 0;
    NormalAnalysis.bLogY = 0;

    SearchForBlanks();

    for(i = 0; i < FILTER_PLATE_MAX; i++) //减去空白样本
    {
        if(BoardInf.bHasRawData[i]==0)
        {
            continue;
        }

        for(j = 0; j < TUBE_MAX; j++)
        {
            if(BoardInf.Layout.WellType[i] == WELLS_TYPE_BK)//"BK"
            {
                dABS[0][i][j] = 0.0f;
                continue;
            }

            dABS[0][i][j] = dABSInit[0][i][j] - NormalAnalysis.dBlank[0][i];
            if(dABS[0][i][j] < 0.0f)
            {
                dABS[0][i][j] = 0.0f;
            }
        }
    }

    if(BoardInf.Filter2Locate>=0  && BoardInf.KineticPara.PreProcess>=0)
        //if(CString(BoardInf.Filter_2) != _T("No") && BoardInf.KineticPara.PreProcess[0] != _T('N'))
    {
        Preproccessing(0);
    }

    NormalAnalysis.nCalibratorCountTotal[0] = 0;
    NormalAnalysis.nCalibratorCountTotal[1] = 0;
    NormalAnalysis.nCalibratorCountTotal[2] = 0;
    for(i = 0; i < CALIBRATOR_CONCENTRATION_MAX; i++)
    {
        SearchForStandards(i);

        for(j = 0; j < 3; j++)
        {
            if(NormalAnalysis.nCalibratorCount[j][i] > 0)
            {
                NormalAnalysis.nCalibratorCountTotal[j]++;
            }
        }
    }

    if(BoardInf.KineticPara.Curve >=0 || BoardInf.InterpretPara.Enable || BoardInf.QualityPara.Enable )
        //if(BoardInf.curentcurve[0] != _T('N') || BoardInf.interpret_para.bOpened || BoardInf.quality_para.bOpened)
    {
        DoNormalAnalysis();
    }
}



//进行动力学分析
void DoKineticAnalysis(void)
{

    int i,j,k;
    unsigned char bOK,bAfter;
    int nStartBase, nEndBase;
    int nStart,nEnd;
    int nTime ;
    float dTime;




    NormalAnalysis.wcModeBack = NormalAnalysis.wcMode; //备份分析模式
    NormalAnalysis.FilterCurrentBack = NormalAnalysis.FilterCurrent; //备份滤光片选择
    BoardInf.KineticPara.kinetic_readings_analysis = BoardInf.KineticPara.kinetic_readings_practical;
    if(BoardInf.KineticPara.Readings< BoardInf.KineticPara.kinetic_readings_practical)
    {
        BoardInf.KineticPara.kinetic_readings_analysis = BoardInf.KineticPara.Readings;
    }

    if(BoardInf.KineticPara.kinetic_readings_analysis < KINETIC_READINGS_MIN)
    {
        BoardInf.KineticPara.nAnalysisResult[0] = ANALYSIS_ERROR_KINETIC_DATA;
        BoardInf.KineticPara.nAnalysisResult[1] = ANALYSIS_ERROR_KINETIC_DATA;
        BoardInf.KineticPara.nAnalysisResult[2] = ANALYSIS_ERROR_KINETIC_DATA;
        return;
    }

    if(BoardInf.KineticPara.FirstReadings > BoardInf.KineticPara.kinetic_readings_analysis - 1)
    {
        BoardInf.KineticPara.FirstReadings = BoardInf.KineticPara.kinetic_readings_analysis - 1;
    }

    //modify 20171202 start
    //if(BoardInf.KineticPara.EndReadings> BoardInf.KineticPara.kinetic_readings_analysis-BoardInf.KineticPara.FirstReadings  - 1)
    //{
    //BoardInf.KineticPara.EndReadings = BoardInf.KineticPara.kinetic_readings_analysis-BoardInf.KineticPara.FirstReadings  - 1;
    //}
    if(BoardInf.KineticPara.EndReadings> BoardInf.KineticPara.kinetic_readings_analysis - 1)
    {
        BoardInf.KineticPara.EndReadings = BoardInf.KineticPara.kinetic_readings_analysis - 1;
    }
    if(BoardInf.KineticPara.FirstReadings>BoardInf.KineticPara.EndReadings)
    {
        BoardInf.KineticPara.FirstReadings=BoardInf.KineticPara.EndReadings;
    }
    //modify 20171202 end


    bOK = PreCalOK();
    BoardInf.KineticPara.nAnalysisResult[0] = ANALYSIS_SUCCESS;
    BoardInf.KineticPara.nAnalysisResult[1] = ANALYSIS_SUCCESS;
    if(bOK==0)
    {
        BoardInf.KineticPara.nAnalysisResult[2] = ANALYSIS_ERROR_KINETIC_DATA;
    }

    if(BoardInf.KineticPara.BaseLinePoint > BoardInf.KineticPara.kinetic_readings_analysis)
    {
        BoardInf.KineticPara.BaseLinePoint = BoardInf.KineticPara.kinetic_readings_analysis;
    }


    //if(BoardInf.KineticPara.bBeginning)
    if(BoardInf.KineticPara.BaseLineSel==0)//0表示起始点
    {
        nStartBase = 0;
        nEndBase = BoardInf.KineticPara.BaseLinePoint - 1;
    }
    else
    {
        nEndBase = BoardInf.KineticPara.kinetic_readings_analysis - 1;
        nStartBase = nEndBase - BoardInf.KineticPara.BaseLinePoint + 1;
    }

    //Modify start lugj171202
    nStart = BoardInf.KineticPara.FirstReadings;
    //nEnd = BoardInf.KineticPara.kinetic_readings_analysis -  BoardInf.KineticPara.EndReadings - 1;
    nEnd = BoardInf.KineticPara.EndReadings;
    //Modify end

    bAfter = (nStart == 0);
		if(BoardInf.KineticPara.TimeInterval<7)nTime=7;
    else nTime=BoardInf.KineticPara.TimeInterval ;
		if( (BoardInf.ShakeEnable)&&(BoardInf.ShakeMode==SHAKE_EACH) )
		{
			  nTime+=BoardInf.PauseTime+BoardInf.ShakeTime;
		}
			
    if(nTime < KINETIC_TIME_MIN)
    {
        nTime = KINETIC_TIME_MIN;
    }
    dTime = (float)nTime;

    if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_CHANGE)
    {
        for(k = 0; k < TUBE_MAX; k++)
        {
            for(j = 0; j < 3; j++)
            {
                //short nTotal;
                float dBase = 0.0f;
                short m;
                BoardInf.KineticPara.KineticTimeChange[j].bOK[k]=0;
                //BoardInf.KineticPara.kinetic_time_change[j].bOK[k] = false;
                for(m = nStartBase; m <= nEndBase; m++)
                {
                    if(j < 2)
                    {
                        dBase += dABS[m][j][k];
                    } //if(j < 2)
                    else if(BoardInf.KineticPara.bPreCalOK[k])
                    {
                        dBase += NormalAnalysis.dPreCal[m][k];
                    } //else if(BoardInf.KineticPara.bPreCalOK[k])
                } //for(int m = nStartBase; m <= nEndBase; m++)
                if(BoardInf.KineticPara.BaseLinePoint < 1)
                {
                    dBase = 0.0;
                } //BoardInf.KineticPara.nPoints < 1
                else
                {
                    dBase /= ((float)(nEndBase - nStartBase + 1));
                } //BoardInf.KineticPara.nPoints < 1
//				nTotal = nEnd - nStart + 1;

                for(i = nStart; i <= nEnd; i++)
                {
                    if(j < 2)
                    {
                        if((dABS[i][j][k] - dBase) > BoardInf.KineticPara.Change)//?
                        {
                            BoardInf.KineticPara.KineticTimeChange[j].nTime[k] = (i) * nTime;
                            BoardInf.KineticPara.KineticTimeChange[j].bOK[k] = 1;
                            break;
                        } //if((dABS[i][j][k] - dBase) > BoardInf.KineticPara.dChange)
                    } //if(j < 2)
                    else if(BoardInf.KineticPara.bPreCalOK[k])
                    {
                        if((NormalAnalysis.dPreCal[i][k] - dBase) > BoardInf.KineticPara.Change)
                        {
                            BoardInf.KineticPara.KineticTimeChange[j].nTime[k] = (i) * nTime;
                            BoardInf.KineticPara.KineticTimeChange[j].bOK[k] = 1;
                            break;
                        } //if((dABS[i][j][k] - dBase) > BoardInf.KineticPara.dChange)
                    } //else if(BoardInf.KineticPara.bPreCalOK[k])
                } //for(int i = nStart; i <= nEnd; i++)
            } //for(int j = 0; j < 3; j++)
        } //for(int k = 0; k < TUBE_MAX; k++)
    } //if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_CHANGE)

    if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_MAX_RATE
            || BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_MAX_RATE)
    {
        for(k = 0; k < TUBE_MAX; k++)
        {
            for(j = 0; j < 3; j++)
            {
                float dMaxRate = 0.0;
                int nStep = nStart;

                for(i = nStart; i < nEnd; i++) //<=
                {
                    int n1 = i;
                    int n2 = i + 1;
                    float dRate;
                    /*
                    if(bAfter)
                    {
                    	if(i == BoardInf.KineticPara.kinetic_readings_analysis - 1)
                    	{
                    		break;
                    	} //if(i == BoardInf.KineticPara.kinetic_readings_analysis - 1)
                    } //if(bAfter)
                    else
                    {
                    	n1 = i - 1;
                    	n2 = i;
                    } //if(bAfter)
                    */
                    dRate = 0.0;
                    if(j < 2)
                    {
                        dRate = (dABS[n2][j][k] - dABS[n1][j][k]) / dTime;
                    } //if(j < 2)
                    else if(BoardInf.KineticPara.bPreCalOK[k])
                    {
                        dRate = (NormalAnalysis.dPreCal[n2][k] - NormalAnalysis.dPreCal[n1][k]) / dTime;
                    } //else if(BoardInf.KineticPara.bPreCalOK[k])

                    if(dRate > dMaxRate)
                    {
                        dMaxRate = dRate;
                        nStep = n2;//i
                    } //if(dRate > dMaxRate)
                } //for(int i = nStart; i <= nEnd; i++)
                BoardInf.KineticPara.KineticMaxRate[j].dMaxRate[k] = dMaxRate;
                BoardInf.KineticPara.KineticTimeMaxRate[j].nTime[k] = (nStep) * nTime;
            } //for(int j = 0; j < 3; j++)
        } //for(int k = 0; k < TUBE_MAX; k++)
    } //if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_MAX_RATE|| BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_MAX_RATE)


    if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_AVERAGE_RATE)
    {
        for(k = 0; k < TUBE_MAX; k++)
        {
            for(j = 0; j < 3; j++)
            {
                int nTotal = nEnd - nStart;// + 1;
                BoardInf.KineticPara.KineticAverageRate[j].dAverageRate[k] = 0.0;
                if(nTotal<=0)
                {
                    continue;
                }
                for(i = nStart; i < nEnd; i++) //<=
                {
                    int n1 = i;
                    int n2 = i + 1;
                    //	if(bAfter)//第一板开始，First=0
                    //{
                    //if(i == BoardInf.KineticPara.kinetic_readings_analysis - 1)
                    //	{
                    //nTotal--;
                    //	break;
                    //	} //if(i == BoardInf.KineticPara.kinetic_readings_analysis - 1)
                    //	} //if(bAfter)
                    //else
                    //{
                    //n1 = i - 1;
                    //n2 = i;
                    //	} //if(bAfter)
                    if(j < 2)
                    {
                        BoardInf.KineticPara.KineticAverageRate[j].dAverageRate[k]
                        += (dABS[n2][j][k] - dABS[n1][j][k]) / dTime;
                    } //if(j < 2)
                    else if(BoardInf.KineticPara.bPreCalOK[k])
                    {
                        BoardInf.KineticPara.KineticAverageRate[j].dAverageRate[k]
                        += (NormalAnalysis.dPreCal[n2][k] - NormalAnalysis.dPreCal[n1][k]) / dTime;
                    } //else if(BoardInf.KineticPara.bPreCalOK[k])
                } //for(int i = nStart; i <= nEnd; i++)
                if(nTotal>0)
                {
                    BoardInf.KineticPara.KineticAverageRate[j].dAverageRate[k] /= (float)nTotal;
                }
            } //for(int j = 0; j < 3; j++)
        } //for(int k = 0; k < TUBE_MAX; k++)
    } //if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_AVERAGE_RATE)

    if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_MAX_WELL
            || BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_MAX)
    {
        for(k = 0; k < TUBE_MAX; k++)
        {
            for(j = 0; j < 3; j++)
            {
                float dMax = 0.0;
                int nStep = nStart;
                for(i = nStart; i <= nEnd; i++)//<=
                {
                    if(j < 2)
                    {
                        if(dABS[i][j][k] > dMax)
                        {
                            dMax = dABS[i][j][k];
                            nStep = i;
                        } //if(dABS[i][j][k] > dMax)
                    } //if(j < 2)
                    else if(BoardInf.KineticPara.bPreCalOK[k])
                    {
                        if(NormalAnalysis.dPreCal[i][k] > dMax)
                        {
                            dMax = NormalAnalysis.dPreCal[i][k];
                            nStep = i;
                        } //if(NormalAnalysis.dPreCal[i][k] > dMax)
                    } //else if(BoardInf.KineticPara.bPreCalOK[k])
                } //for(int i = nStart; i <= nEnd; i++)
                BoardInf.KineticPara.KineticMaxWell[j].dMaxWell[k] = dMax;
                BoardInf.KineticPara.KineticTimeMax[j].nTime[k] = (nStep) * nTime;
            } //for(int j = 0; j < 3; j++)
        } //for(int k = 0; k < TUBE_MAX; k++)
    } //if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_MAX_WELL|| BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_MAX)

    if(NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrentBack] == ANALYSIS_SUCCESS)
    {
        NormalAnalysis.FilterCurrent = NormalAnalysis.FilterCurrentBack;
        if(NormalAnalysis.wcModeBack != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcModeBack != ANALYSIS_MODE_CURVE)
        {
            NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
        }
    }
    else if(NormalAnalysis.nAnalysisResult[2] == ANALYSIS_SUCCESS)
    {
        NormalAnalysis.FilterCurrent = 2;
        if(NormalAnalysis.wcModeBack != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcModeBack != ANALYSIS_MODE_CURVE)
        {
            NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
        }
    }
    else if(NormalAnalysis.nAnalysisResult[0] == ANALYSIS_SUCCESS)
    {
        NormalAnalysis.FilterCurrent = 0;
        if(NormalAnalysis.wcModeBack != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcModeBack != ANALYSIS_MODE_CURVE)
        {
            NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
        }
    }
    else if(NormalAnalysis.nAnalysisResult[1] == ANALYSIS_SUCCESS)
    {
        NormalAnalysis.FilterCurrent = 1;
        if(NormalAnalysis.wcModeBack != ANALYSIS_MODE_ANALYSIS && NormalAnalysis.wcModeBack != ANALYSIS_MODE_CURVE)
        {
            NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
        }
    }
    else
    {
        NormalAnalysis.wcMode = ANALYSIS_MODE_RAWDATA;
    }

}


void InitKineticAnalysis(void) //动力学分析初始化
{
    int i;

    NormalAnalysis.FilterCurrent = 0; //选择第一滤镜
    //NormalAnalysis.bFilterSelect = false;
    BoardInf.KineticPara.kinetic_reading_current = 0;
    BoardInf.KineticPara.nCurrentSample = 0;

    SearchForBlanks();

    for(i = 0; i < BoardInf.KineticPara.kinetic_readings_practical; i++)
    {
        GetKineticABS(i);
    }

    DoKineticAnalysis();
}



