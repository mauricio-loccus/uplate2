//动力学分析原始曲线
void DisplayKineticCurve(void)
{
    GUI_RECT rect;
    float dTemp;
    float dX,dY;
    int i,j;
    float dXMin, dXMax, dYMin, dYMax;
    float dX0, dY0;
//       int nTotal = BoardInf.KineticPara.kinetic_readings_analysis;


//		float *p_dX = (float *)malloc(sizeof(float) * nTotal);
    //float *p_dY = (float *)malloc(sizeof(float) * nTotal);
    GetAxisLimitsKinetic(&dXMin, &dXMax, &dYMin, &dYMax, CalcuPara.p_dX, CalcuPara.p_dY);


    GUI_SetColor(0x0);

    GUI_DrawLine(CURVE_AREA_AXIS_START_X,CURVE_AREA_AXIS_START_Y,CURVE_AREA_AXIS_START_X,CURVE_AREA_AXIS_END_Y);//画坐标轴垂直线
    GUI_DrawLine(CURVE_AREA_AXIS_START_X,CURVE_AREA_AXIS_END_Y,CURVE_AREA_AXIS_END_X,CURVE_AREA_AXIS_END_Y);//画坐标轴水平线

    //画tick
    dX=(CURVE_AREA_AXIS_END_X-CURVE_AREA_AXIS_LINE_X-CURVE_AREA_AXIS_START_X)/5.0;
    dY=(CURVE_AREA_AXIS_END_Y-CURVE_AREA_AXIS_START_Y-CURVE_AREA_AXIS_LINE_Y)/5.0;
    for(i=0; i<5; i++)
    {
        GUI_DrawLine(CURVE_AREA_AXIS_START_X+dX*(i+1),CURVE_AREA_AXIS_END_Y,CURVE_AREA_AXIS_START_X+dX*(i+1),CURVE_AREA_AXIS_END_Y+CURVE_AREA_AXIS_TICK_Y);//画5条短垂直线
        GUI_DrawLine(CURVE_AREA_AXIS_START_X-CURVE_AREA_AXIS_TICK_X,CURVE_AREA_AXIS_START_Y+CURVE_AREA_AXIS_LINE_Y+dY * i,CURVE_AREA_AXIS_START_X,CURVE_AREA_AXIS_START_Y+CURVE_AREA_AXIS_LINE_Y+ dY * i);//画5条短水平线
    }



    if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    {
        GUI_SetFont(GUI_FONT_MED);
    }
    else
    {
        GUI_SetFont(GUI_FONT_MED_CH);
    }
    GUI_DispStringAt(CURVE_REPORT_ABSORBANCE[SystemPrameter.SystemLanguage],CURVE_AREA_AXIS_START_X + 10,CURVE_AREA_AXIS_START_Y);




    rect.x0 = CURVE_AREA_AXIS_END_X-100;
    rect.x1 = CURVE_AREA_AXIS_END_X;
    rect.y0 = CURVE_AREA_AXIS_END_Y-40;
    rect.y1 = CURVE_AREA_AXIS_END_Y;
    GUI_DispStringInRect(CURVE_REPORT_CYCLE[SystemPrameter.SystemLanguage], &rect, GUI_TA_RIGHT | GUI_TA_VCENTER);




    GUI_SetFont(GUI_FONT_MED);

    //画标签


    for(i = 0; i <= 5; i++)
    {
        //float dTemp;
        //Y Lable
        dTemp = dYMin + (dYMax - dYMin) * (float)i / 5.0f;
        if(dTemp > 10000.0f || dTemp < -10000.0f)
        {
            sprintf(ConvertStr,"%.2e",dTemp);
            EConvert(ConvertStr);
            //strTemp.Format(_T("%.2e"), dTemp);
            //strTemp = strTemp.Left(strTemp.GetLength()-3) + strTemp.Right(1);
        }
        else
        {
            sprintf(ConvertStr,"%1.2f",dTemp);
            //	strTemp.Format(_T("%1.2f"), dTemp);
        }
        rect.x0 = 0;
        rect.x1 = CURVE_AREA_AXIS_START_X - CURVE_AREA_AXIS_TICK_X - 5;
        rect.y0 = CURVE_AREA_AXIS_END_Y- 15 - dY * i;
        rect.y1 = CURVE_AREA_AXIS_END_Y+ 15 - dY * i;
        if(rect.y0<CURVE_AREA_AXIS_START_Y)rect.y0=CURVE_AREA_AXIS_START_Y;//lgj180110
        if(rect.y1<CURVE_AREA_AXIS_START_Y)rect.y1=CURVE_AREA_AXIS_START_Y;//lgj180110
        if(rect.y0>CURVE_AREA_AXIS_END_Y)rect.y0=CURVE_AREA_AXIS_END_Y;//lgj180110
        if(rect.y1>CURVE_AREA_AXIS_END_Y)rect.y1=CURVE_AREA_AXIS_END_Y;//lgj180110
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);




        dTemp = dXMin + (dXMax - dXMin) * (float)i / 5.0f;
        if(dTemp > 10000.0f || dTemp < -10000.0f)
        {
            sprintf(ConvertStr,"%.2e",dTemp);
            EConvert(ConvertStr);
            //strTemp.Format(_T("%.2e"), dTemp);
            //strTemp = strTemp.Left(strTemp.GetLength()-3) + strTemp.Right(1);
        }
        else
        {
            sprintf(ConvertStr,"%1.2f",dTemp);
            //strTemp.Format(_T("%1.2f"), dTemp);

        }

        rect.x0 = CURVE_AREA_AXIS_START_X - 50 + dX * i;
        rect.x1 = CURVE_AREA_AXIS_START_X + 50 + dX * i;
        rect.y0 = CURVE_AREA_AXIS_END_Y + CURVE_AREA_AXIS_TICK_Y;
        rect.y1 =  rect.y0+30;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);

    }



    //画曲线
    if(BoardInf.KineticPara.nCurrentSample >= TUBE_MAX)
    {

        for(j = 0; j < TUBE_MAX; j++)
        {
            GUI_SetColor(RGB_TAB_FOR_WELL[j]);

            for(i = 0; i < BoardInf.KineticPara.kinetic_readings_analysis; i++)
            {
                if(NormalAnalysis.FilterCurrent < 2)
                {
                    CalcuPara.p_dY[i] = dABS[i][NormalAnalysis.FilterCurrent][j];
                } //if(NormalAnalysis.FilterCurrent < 2)
                else if(BoardInf.KineticPara.bPreCalOK[j])
                {
                    CalcuPara.p_dY[i] = NormalAnalysis.dPreCal[i][j];
                } //else if(BoardInf.KineticPara.bPreCalOK[j])
                else
                {
                    break;
                } //else if(BoardInf.KineticPara.bPreCalOK[j])

                //dc->SelectObject(&penCurve[j]);
                //float dX0, dY0, ddX;
//					ddX = (dXMax - dXMin) /  ANALYSIS_CURVE_POINT_MAX;
                dX0 = (float)(i + 1);
                dY0 = CalcuPara.p_dY[i];

                if(i == 0)
                {
                    rect.x0=CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
                    rect.y0=CURVE_AREA_AXIS_END_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

                    //		dc->MoveTo(CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0
                    //	, CURVE_AREA_AXIS_START_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0);
                } //if(i == 0)
                else
                {
                    rect.x1=CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
                    rect.y1=CURVE_AREA_AXIS_END_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

                    if(rect.y0<CURVE_AREA_AXIS_START_Y)rect.y0=CURVE_AREA_AXIS_START_Y;//lgj180110
                    if(rect.y1<CURVE_AREA_AXIS_START_Y)rect.y1=CURVE_AREA_AXIS_START_Y;//lgj180110
                    if(rect.y0>CURVE_AREA_AXIS_END_Y)rect.y0=CURVE_AREA_AXIS_END_Y;//lgj180110
                    if(rect.y1>CURVE_AREA_AXIS_END_Y)rect.y1=CURVE_AREA_AXIS_END_Y;//lgj180110
                    GUI_DrawLine(rect.x0,rect.y0,rect.x1,rect.y1);
                    rect.x0=rect.x1;
                    rect.y0=rect.y1;
                    //dc->LineTo(CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0
                    //, CURVE_AREA_AXIS_START_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0);
                } //if(i == 0)
            } //for(int i = 0; i < BoardInf.KineticPara.kinetic_readings_analysis; i++)
        } //for(int j = 0; j < TUBE_MAX; j++)
    } //if(BoardInf.KineticPara.nCurrentSample >= TUBE_MAX)
    else
    {
        for(i = 0; i < BoardInf.KineticPara.kinetic_readings_analysis; i++)
        {
            if(NormalAnalysis.FilterCurrent < 2)
            {
                CalcuPara.p_dY[i] = dABS[i][NormalAnalysis.FilterCurrent][BoardInf.KineticPara.nCurrentSample];
            } //if(NormalAnalysis.FilterCurrent < 2)
            else if(BoardInf.KineticPara.bPreCalOK[BoardInf.KineticPara.nCurrentSample])
            {
                CalcuPara.p_dY[i] = NormalAnalysis.dPreCal[i][BoardInf.KineticPara.nCurrentSample];
            } //else if(BoardInf.KineticPara.bPreCalOK[j])
            else
            {
                break;
            } //else if(BoardInf.KineticPara.bPreCalOK[])

            GUI_SetColor(RGB_TAB_FOR_WELL[BoardInf.KineticPara.nCurrentSample]);
            //dc->SelectObject(&penCurve[BoardInf.KineticPara.nCurrentSample]);
            //	float dX0, dY0, ddX;
//			ddX = (dXMax - dXMin) /  ANALYSIS_CURVE_POINT_MAX;
            dX0 = (float)(i + 1);
            dY0 = CalcuPara.p_dY[i];

            if(i == 0)
            {
                //dc->MoveTo(CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0
                //	, CURVE_AREA_AXIS_START_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0);
                rect.x0=CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
                rect.y0=CURVE_AREA_AXIS_END_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0f;

            } //if(i == 0)
            else
            {
                //dc->LineTo(CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0
                //	, CURVE_AREA_AXIS_START_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0);
                rect.x1=CURVE_AREA_AXIS_START_X + (dX0 - dXMin) / (dXMax - dXMin) * dX * 5.0f;
                rect.y1=CURVE_AREA_AXIS_END_Y - (dY0 - dYMin) / (dYMax - dYMin) * dY * 5.0f;
                if(rect.y0<CURVE_AREA_AXIS_START_Y)rect.y0=CURVE_AREA_AXIS_START_Y;//lgj180110
                if(rect.y1<CURVE_AREA_AXIS_START_Y)rect.y1=CURVE_AREA_AXIS_START_Y;//lgj180110
                if(rect.y0>CURVE_AREA_AXIS_END_Y)rect.y0=CURVE_AREA_AXIS_END_Y;//lgj180110
                if(rect.y1>CURVE_AREA_AXIS_END_Y)rect.y1=CURVE_AREA_AXIS_END_Y;//lgj180110
                GUI_DrawLine(rect.x0,rect.y0,rect.x1,rect.y1);
                rect.x0=rect.x1;
                rect.y0=rect.y1;
            } //if(i == 0)
        } //for(int i = 0; i < BoardInf.KineticPara.kinetic_readings_analysis; i++)
    } //if(BoardInf.KineticPara.nCurrentSample >= TUBE_MAX)




}

//动力学分析定量分析结果
void DisplayKineticAnalysis(void)
{
    short i,j,x,y;

    GUI_RECT rect;


    //if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    //{
    GUI_SetFont(GUI_FONT_MED);
    //}
    //else
    //{
    //	GUI_SetFont(GUI_FONT_MED_CH);
    //}

    GUI_SetColor(0x0);

    rect.x0 = 37;
    rect.y0 = 130-TITLESBAR_HEIGHT;
    rect.x1 = rect.x0 + NORMAL_ANALYSIS_WELL_WIDTH_DX;
    rect.y1 = rect.y0 + 16;
    for (i = 0; i < 12; i++)
    {
        TwoNumConvertStr(ConvertStr, i+1);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        rect.x0 +=NORMAL_ANALYSIS_WELL_WIDTH_DX;
        rect.x1 += NORMAL_ANALYSIS_WELL_WIDTH_DX;
    }


    rect.x0 = 10;
    rect.y0 = 155 - TITLESBAR_HEIGHT;
    rect.x1 = rect.x0 + 16;
    rect.y1 = rect.y0 + 16;
    for (i = 0; i <8; i++)
    {
        ConvertStr[0] = 'A' + i;
        ConvertStr[1] = 0;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        rect.y0 += 36;
        rect.y1 += 36;
    }






    //if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    // {
    // GUI_SetFont(GUI_FONT_MED);
    // }
    // else
    // {
    //  	 GUI_SetFont(GUI_FONT_MED_CH);
    // }

    x=NORMAL_ANALYSIS_WELL_DATA_START_X; //2014-8-20项
    y=NORMAL_ANALYSIS_WELL_DATA_START_Y-TITLESBAR_HEIGHT;
    for(i = 0; i < 12; i++) //2014-8-20项
    {
        for(j = 0; j < 8; j++)
        {
            short nDX = 0;
            short nDY = 0;
            float dTemp;
            unsigned char bHasResult = 1;
            unsigned char small_font=0;
            GUI_SetFont(GUI_FONT_MED);
            if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_AVERAGE_RATE)
            {
                if(NormalAnalysis.FilterCurrent < 2)
                {
                    dTemp = BoardInf.KineticPara.KineticAverageRate[NormalAnalysis.FilterCurrent].dAverageRate[j * 12 + i];
                }
                else if(BoardInf.KineticPara.bPreCalOK[j * 12 + i])
                {
                    dTemp = BoardInf.KineticPara.KineticAverageRate[NormalAnalysis.FilterCurrent].dAverageRate[j * 12 + i];
                }
                else
                {
                    bHasResult = 0;
                }

            }
            else if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_MAX_RATE)
            {
                if(NormalAnalysis.FilterCurrent < 2)
                {
                    dTemp = BoardInf.KineticPara.KineticMaxRate[NormalAnalysis.FilterCurrent].dMaxRate[j * 12 + i];
                }
                else if(BoardInf.KineticPara.bPreCalOK[j * 12 + i])
                {
                    dTemp = BoardInf.KineticPara.KineticMaxRate[NormalAnalysis.FilterCurrent].dMaxRate[j * 12 + i];
                }
                else
                {
                    bHasResult = 0;
                }
            }
            else if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_MAX_WELL)
            {
                if(NormalAnalysis.FilterCurrent < 2)
                {
                    dTemp = BoardInf.KineticPara.KineticMaxWell[NormalAnalysis.FilterCurrent].dMaxWell[j * 12 + i];
                }
                else if(BoardInf.KineticPara.bPreCalOK[j * 12 + i])
                {
                    dTemp = BoardInf.KineticPara.KineticMaxWell[NormalAnalysis.FilterCurrent].dMaxWell[j * 12 + i];
                }
                else
                {
                    bHasResult = 0;
                }
            }
            else if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_MAX_RATE)
            {
                if(NormalAnalysis.FilterCurrent < 2)
                {
                    dTemp = BoardInf.KineticPara.KineticTimeMaxRate[NormalAnalysis.FilterCurrent].nTime[j * 12 + i];
                }
                else if(BoardInf.KineticPara.bPreCalOK[j * 12 + i])
                {
                    dTemp = BoardInf.KineticPara.KineticTimeMaxRate[NormalAnalysis.FilterCurrent].nTime[j * 12 + i];
                }
                else
                {
                    bHasResult = 0;
                }

            }
            else if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_MAX)
            {
                if(NormalAnalysis.FilterCurrent < 2)
                {
                    dTemp = BoardInf.KineticPara.KineticTimeMax[NormalAnalysis.FilterCurrent].nTime[j * 12 + i];
                }
                else if(BoardInf.KineticPara.bPreCalOK[j * 12 + i])
                {
                    dTemp = BoardInf.KineticPara.KineticTimeMax[NormalAnalysis.FilterCurrent].nTime[j * 12 + i];
                }
                else
                {
                    bHasResult = 0;
                }
            }

            else if(BoardInf.KineticPara.kinetic_analysis_mode == KINETIC_ANALYSIS_TIME_CHANGE)
            {
                if(NormalAnalysis.FilterCurrent < 2)
                {
                    dTemp = BoardInf.KineticPara.KineticTimeChange[NormalAnalysis.FilterCurrent].nTime[j * 12 + i];
                    bHasResult = BoardInf.KineticPara.KineticTimeChange[NormalAnalysis.FilterCurrent].bOK[j * 12 + i];
                }
                else if(BoardInf.KineticPara.bPreCalOK[j * 12 + i])
                {
                    dTemp = BoardInf.KineticPara.KineticTimeChange[NormalAnalysis.FilterCurrent].nTime[j * 12 + i];
                    bHasResult = BoardInf.KineticPara.KineticTimeChange[NormalAnalysis.FilterCurrent].bOK[j * 12 + i];
                }
                else
                {
                    bHasResult = 0;
                }

            }



            if(bHasResult==0)
            {
                strcpy(ConvertStr,"N.A.");
            }
            else if(dTemp>=CONCENTRATION_MAX)
            {
                strcpy(ConvertStr,"N.A.");
            }
            else if(dTemp>99999.0)
            {
                small_font=1;
                nDX = 8;
                nDY = 4;
                sprintf(ConvertStr,"%.1e",dTemp);
                EConvert(ConvertStr);
            }
            else if(dTemp>=1000.0)
            {
                sprintf(ConvertStr,"%d",(int)dTemp);
            }
            else if(dTemp >= 100.0f)
            {
                sprintf(ConvertStr,"%.1f",dTemp);
            }
            else if(dTemp >= 10.0f)
            {
                sprintf(ConvertStr,"%.2f",dTemp);
            }
            else if((dTemp < 10.0f) && (dTemp >=0))
            {
                sprintf(ConvertStr,"%.3f",dTemp);
            }
            else if(dTemp > -10.0f)
            {
                sprintf(ConvertStr,"%.2f",dTemp);
            }
            else if(dTemp > -100.0f)
            {
                sprintf(ConvertStr,"%.1f",dTemp);
            }
            else
            {
                small_font=1;

                sprintf(ConvertStr,"%.1e",dTemp);
                EConvert(ConvertStr);
                nDX = 8;
                nDY = 4;
            }

            if(BoardInf.Layout.WellType[j * 12 + i]==WELLS_TYPE_EP) //board_inf.layout[j * 12 + i + 1].Type
            {
                nDX = 0;
                nDY = 0;
                strcpy(ConvertStr,"EP");
                //  GUI_DispStringAt(ConvertStr,x + 8, y );
                //   GUI_SetColor(0x00);
            }


            if(small_font)
            {
                GUI_SetFont(GUI_FONT_SMALL);
            }
            else
            {
                // if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
                //{
                GUI_SetFont(GUI_FONT_MED);
                //}
                //else
                //{
                //   GUI_SetFont(GUI_FONT_MED_CH);
                //}
            }

            GUI_DispStringAt(ConvertStr,x + nDX,y + nDY-5);
            /*if(NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET)
            {
                GUI_DispStringAt(ConvertStr,x + nDX,y + nDY);
            }
            else
            {
            	GUI_DispStringAt(ConvertStr,x + nDX,y + nDY-5);
            }*/
            GUI_SetColor(0x00);
            y+=NORMAL_ANALYSIS_WELL_HEIGHT_DY;

            //	if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
            //{
            //   GUI_SetFont(GUI_FONT_MED);
            // }
            // else
            // {
            // GUI_SetFont(GUI_FONT_MED_CH);
            // }
        }

        y=NORMAL_ANALYSIS_WELL_DATA_START_Y-TITLESBAR_HEIGHT;
        x+= NORMAL_ANALYSIS_WELL_WIDTH_DX;
    }
}

//显示原始光强
void DisplayRawIntensity(void)
{
    short i,j,x,y;
    GUI_RECT rect;



    //if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    //{
    GUI_SetFont(GUI_FONT_MED);
    //}
    //	else
    //	{
    //	GUI_SetFont(GUI_FONT_MED_CH);
    //	}


    GUI_SetColor(0x0);

    rect.x0 = 37;
    rect.y0 = 130-TITLESBAR_HEIGHT;
    rect.x1 = rect.x0 + NORMAL_ANALYSIS_WELL_WIDTH_DX;
    rect.y1 = rect.y0 + 16;
    for (i = 0; i < 12; i++)
    {
        TwoNumConvertStr(ConvertStr, i+1);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        rect.x0 +=NORMAL_ANALYSIS_WELL_WIDTH_DX;
        rect.x1 += NORMAL_ANALYSIS_WELL_WIDTH_DX;
    }


    rect.x0 = 10;
    rect.y0 = 155 - TITLESBAR_HEIGHT;
    rect.x1 = rect.x0 + 16;
    rect.y1 = rect.y0 + 16;
    for (i = 0; i <8; i++)
    {
        ConvertStr[0] = 'A' + i;
        ConvertStr[1] = 0;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        rect.y0 += 36;
        rect.y1 += 36;
    }



    GUI_SetFont(GUI_FONT_SMALL);


    x=NORMAL_ANALYSIS_WELL_DATA_START_X; //2014-8-20项
    y=NORMAL_ANALYSIS_WELL_DATA_START_Y-TITLESBAR_HEIGHT;
    //x = LAY_SMALL_START_X + LAY_SMALL_RADIUS; //2014-8-17项
    //y = LAY_SMALL_START_Y+ LAY_SMALL_RADIUS;
    for(i = 0; i < 12; i++) //2014-8-20项
    {
        for(j = 0; j < 8; j++)
            //	 for(int j = 0; j < CHANNEL_MAX; j++)
        {
            sprintf(ConvertStr,"%d",nIntensity[0][NormalAnalysis.FilterCurrent][j * 12 + i]);
            //GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
            GUI_DispStringAt(ConvertStr,x,y);
            //int nDX = -3;
            //int nDY = 3;
            //temp.Format(_T("%d"), raw_data.nIntensity[0][NormalAnalysis.FilterCurrent][j * 12 + i]);
            //dc->ExtTextOutW(x + nDX,y + nDY,ETO_CLIPPED,rect,temp,NULL);
            if(j == 0 && i <9)
            {
                sprintf(ConvertStr,"%d",nInputIntensity[0][i]);
                GUI_DispStringAt(ConvertStr,x,y+15);
                //temp.Format(_T("%d"), raw_data.nInputIntensity[0][i]);
                //dc->ExtTextOutW(x + nDX,y + nDY - 10,ETO_CLIPPED,rect,temp,NULL);
            }
            if(j == 1 && i < 9)
            {
                sprintf(ConvertStr,"%d",nBackgroundIntensity[0][i]);
                GUI_DispStringAt(ConvertStr,x,y+15);
                //	temp.Format(_T("%d"), raw_data.nBackgroundIntensity[0][i]);
                //	dc->ExtTextOutW(x + nDX,y + nDY - 10,ETO_CLIPPED,rect,temp,NULL);
            }
            if(j == 7 && i <12) //2015-09-02
            {
                sprintf(ConvertStr,"%d",nIntensity[0][NormalAnalysis.FilterCurrent][ABS_CHANNEL_MAX*12+ i]);
                GUI_DispStringAt(ConvertStr,x,y+15);

                //temp.Format(_T("%d"),  raw_data.nIntensity[0][NormalAnalysis.FilterCurrent][ABS_CHANNEL_MAX*12+ i]);
                //dc->ExtTextOutW(x + nDX,y + nDY - 10,ETO_CLIPPED,rect,temp,NULL);
            }
            y+=NORMAL_ANALYSIS_WELL_HEIGHT_DY;
        }

        y=NORMAL_ANALYSIS_WELL_DATA_START_Y-TITLESBAR_HEIGHT;
        x+= NORMAL_ANALYSIS_WELL_WIDTH_DX;
    }

}
void DisplayRawInter(void)
{
    short i,j,x,y;
    unsigned char small_font=0;
    GUI_RECT rect;

    //if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    //{
    GUI_SetFont(GUI_FONT_MED);
    //}
    //else
    //{
    //	GUI_SetFont(GUI_FONT_MED_CH);
    // }

    GUI_SetColor(0x0);

    rect.x0 = 37;
    rect.y0 = 130-TITLESBAR_HEIGHT;
    rect.x1 = rect.x0 + NORMAL_ANALYSIS_WELL_WIDTH_DX;
    rect.y1 = rect.y0 + 16;
    for (i = 0; i < 12; i++)
    {
        TwoNumConvertStr(ConvertStr, i+1);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        rect.x0 +=NORMAL_ANALYSIS_WELL_WIDTH_DX;
        rect.x1 += NORMAL_ANALYSIS_WELL_WIDTH_DX;
    }


    rect.x0 = 10;
    rect.y0 = 155 - TITLESBAR_HEIGHT;
    rect.x1 = rect.x0 + 16;
    rect.y1 = rect.y0 + 16;
    for (i = 0; i <8; i++)
    {
        ConvertStr[0] = 'A' + i;
        ConvertStr[1] = 0;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        rect.y0 += 36;
        rect.y1 += 36;
    }
    x=NORMAL_ANALYSIS_WELL_DATA_START_X; //2014-8-20项
    y=NORMAL_ANALYSIS_WELL_DATA_START_Y-TITLESBAR_HEIGHT;

    //start
    /*
    for(i=0;i<TUBE_MAX;i++)
    {
      NormalAnalysis.dConcentration[0][i]=0;
      NormalAnalysis.dConcentration[1][i]=0;
    //	  NormalAnalysis.dConcentration[0][i]=0;
    }
    */
    //end

    //if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    //	{

    //	}
    //else
    //{
    //	GUI_SetFont(GUI_FONT_MED_CH);
    //}

    for(i = 0; i < TUBE_MAX_PER_ROW; i++) //12
    {
        for(j = 0; j < TUBE_MAX_PER_COL; j++)//8
        {
            short nDX = 0;
            short nDY = 0;
            float dTemp;
            unsigned char  bHasResult = 1;
            unsigned char  bRed = 0;
            unsigned char nCycle = 0;

            small_font=0;
            GUI_SetFont(GUI_FONT_MED);
            //if(board_inf.curentKinetic[0] == _T('O'))
            if(BoardInf.KineticPara.Enable)
            {
                nCycle = BoardInf.KineticPara.kinetic_reading_current;
            }
            if(NormalAnalysis.FilterCurrent < 2)
            {
                dTemp = dABS[nCycle][NormalAnalysis.FilterCurrent][j * 12 + i];
                if(dTemp >= ABS_RANGE_MAX)
                {
                    bRed = 1;
                }
            }
            else if(NormalAnalysis.bPreCalOK[nCycle][j * 12 + i])
            {
                dTemp = NormalAnalysis.dPreCal[nCycle][j * 12 + i];
            }
            else
            {
                bHasResult = 0;
            }
            if( ((NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS) || ( (NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET) && (BoardInf.InterpretPara.AbsFlag==0)))
                    && bHasResult)
            {
                dTemp = NormalAnalysis.dConcentration[NormalAnalysis.FilterCurrent][j * 12 + i];
                if(dTemp < 0.0f)
                {
                    bHasResult = 0;
                }
            }

            if(bHasResult==0)
            {
                strcpy(ConvertStr,"N.A.");
            }
            //else if((dTemp < 100.0f) && (dTemp > -100.0f))
            else if(dTemp>=CONCENTRATION_MAX)
            {
                strcpy(ConvertStr,"N.A.");
            }
						#ifdef SOFTWARE_DN
						else if( (BoardInf.InterpretPara.AbsFlag==0)&&(dTemp>BoardInf.InterpretPara.fCoef_DN[0])&&(NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET) )//Limit
            {
							  strcpy(ConvertStr,">");
                if(BoardInf.InterpretPara.fCoef_DN[0]>9999.0)
                {
                    small_font=1;
                    nDX = 8;
                    nDY = 4;
                    sprintf(StrTemp,"%.0e",BoardInf.InterpretPara.fCoef_DN[0]);
                    EConvert(StrTemp); 
                }
								else if(BoardInf.InterpretPara.fCoef_DN[0]>=100.0)
                {
                   sprintf(StrTemp,"%d",(int)BoardInf.InterpretPara.fCoef_DN[0]);
                }
                else if(BoardInf.InterpretPara.fCoef_DN[0] >= 10.0f)
                {
                   sprintf(StrTemp,"%.1f",BoardInf.InterpretPara.fCoef_DN[0]);
                }
                else //if(BoardInf.InterpretPara.fCoef_DN[0] < 10.0f)// && (BoardInf.InterpretPara.fCoef_DN[0] >=0))
                {
                   sprintf(StrTemp,"%.2f",BoardInf.InterpretPara.fCoef_DN[0]);
                }
								strcat(ConvertStr,StrTemp);
            }
						#endif
            else if(dTemp>99999.0)
            {
                small_font=1;
                nDX = 8;
                nDY = 4;
                sprintf(ConvertStr,"%.1e",dTemp);
                EConvert(ConvertStr);
            }
            else if(dTemp>=1000.0)
            {
                sprintf(ConvertStr,"%d",(int)dTemp);
            }
            else if(dTemp >= 100.0f)
            {
                sprintf(ConvertStr,"%.1f",dTemp);
            }
            else if(dTemp >= 10.0f)
            {
                sprintf(ConvertStr,"%.2f",dTemp);
            }
            else if((dTemp < 10.0f) && (dTemp >=0))
            {
                sprintf(ConvertStr,"%.3f",dTemp);
            }
            else if(dTemp > -10.0f)
            {
                sprintf(ConvertStr,"%.2f",dTemp);
            }
            else if(dTemp > -100.0f)
            {
                sprintf(ConvertStr,"%.1f",dTemp);
            }
            else
            {
                small_font=1;

                sprintf(ConvertStr,"%.1e",dTemp);
                EConvert(ConvertStr);
                nDX = 8;
                nDY = 4;
            }
						
						GUI_SetColor(0x00);//modify 2018072
//j * 12 + i + 1
            if(BoardInf.Layout.WellType[j * 12 + i]==WELLS_TYPE_EP) //board_inf.layout[j * 12 + i + 1].Type
            {
                nDX = 0;
                nDY = 0;
                strcpy(ConvertStr,"EP");
                //GUI_DispStringAt(ConvertStr,x + 8, y );
            }

            else if(NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET && bHasResult)
            {
                if(BoardInf.InterpretPara.bPos[NormalAnalysis.FilterCurrent][j * 12 + i])
                {
                    strcpy(StrTemp,"++");
                    GUI_SetColor(0x0000ff);
                    GUI_DispStringAt(StrTemp,x + 8, y -10);
                }
                else if(BoardInf.InterpretPara.bWeakPos[NormalAnalysis.FilterCurrent][j * 12 + i])
                {
                    strcpy(StrTemp,"+");
									  GUI_SetColor(0xff0000);
                    //GUI_SetColor(0x00f4f4);
                    GUI_DispStringAt(StrTemp,x + 15, y -10);
                }
            }


            //GUI_SetColor(0x00);//modify 2018072
            //if(NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET)
            //{
            //	nDY += 5;
            //}
            if(bRed)
            {
                GUI_SetColor(0x000094);//超出范围
            }
            //j * 12 + i + 1
            if(BoardInf.Layout.WellType[j * 12 + i]==WELLS_TYPE_EP)//if(temp == _T("EP"))
            {
                GUI_SetColor(0x00);
            }
            if(small_font)
            {
                GUI_SetFont(GUI_FONT_SMALL);
            }
            else
            {
                GUI_SetFont(GUI_FONT_MED);
            }
            if(NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET)
            {
                GUI_DispStringAt(ConvertStr,x + nDX,y + nDY);
            }
            else
            {
                GUI_DispStringAt(ConvertStr,x + nDX,y + nDY-5);
            }
            GUI_SetColor(0x00);
            y+=NORMAL_ANALYSIS_WELL_HEIGHT_DY;

            //if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
            //{
            //   GUI_SetFont(GUI_FONT_MED);
            // }
            // else
            //{
            //   GUI_SetFont(GUI_FONT_MED_CH);
            // }

        }

        y=NORMAL_ANALYSIS_WELL_DATA_START_Y-TITLESBAR_HEIGHT;
        x+= NORMAL_ANALYSIS_WELL_WIDTH_DX;
    }//for(int i = 0; i < 12; i++) //2014-8-20项
    //DisplayDateTime(dc);
}
void DisplayLinearLog(void)
{
	      GUI_RECT rect;
	      float dTemp;
					  GUI_SetColor(COLOR_PICTURE);
            GUI_FillRect(ANALYSIS_LOG_SELECT_START_X, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT,ANALYSIS_LOG_SELECT_START_X+100, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT+45);
            GUI_DrawBitmap(&bmMenuRight_20_46, ANALYSIS_LOG_SELECT_START_X+100, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT);
            GUI_SetColor(COLOR_PAINT_TXT);
            if(NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS || NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE) //定量分析、标准曲线
            {
                rect.x0=ANALYSIS_LOG_SELECT_START_X;
                rect.y0=ANALYSIS_LOG_SELECT_START_Y-TITLESBAR_HEIGHT;
                rect.x1=ANALYSIS_LOG_SELECT_END_X ;//- 8;
                rect.y1=ANALYSIS_LOG_SELECT_END_Y-TITLESBAR_HEIGHT;
                strcpy(ConvertStr,XY_COORDINATES[SystemPrameter.SystemLanguage][NormalAnalysis.bLogX]);
                strcat(ConvertStr," / ");
                strcat(ConvertStr,XY_COORDINATES[SystemPrameter.SystemLanguage][NormalAnalysis.bLogY]);
                GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
            }//if(NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS || NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE)
            else       //定性分析
            {


                if(BoardInf.InterpretPara.GreatFlag)
                {
                    strcpy(ConvertStr,"> ");
                }//
                else
                {
                    strcpy(ConvertStr,"< ");
                }

                dTemp = BoardInf.InterpretPara.dReference[NormalAnalysis.FilterCurrent];
                if(((dTemp < 100.0f && dTemp > 0.01f) || (dTemp > -CONCENTRATION_VALUE_MIN && dTemp < CONCENTRATION_VALUE_MIN))
                        ||((dTemp > -100.0f && dTemp < -0.01f) || (dTemp > -CONCENTRATION_VALUE_MIN && dTemp < CONCENTRATION_VALUE_MIN)))
                {
                    sprintf(StrTemp,"%1.3f",dTemp);
                }
                else
                {
                    sprintf(StrTemp,"%.3e",dTemp);
                    EConvert(ConvertStr);
                }

                strcat(ConvertStr,StrTemp);

                rect.x0=ANALYSIS_LOG_SELECT_START_X;
                rect.y0= ANALYSIS_LOG_SELECT_START_Y+ 20-TITLESBAR_HEIGHT;
                rect.x1=ANALYSIS_LOG_SELECT_END_X;// - 8;
                rect.y1=ANALYSIS_LOG_SELECT_END_Y-3-TITLESBAR_HEIGHT;
                GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);


                rect.x0=ANALYSIS_LOG_SELECT_START_X;
                rect.y0= ANALYSIS_LOG_SELECT_START_Y+3 -TITLESBAR_HEIGHT;
                rect.x1=ANALYSIS_LOG_SELECT_END_X;// - 8;
                rect.y1=ANALYSIS_LOG_SELECT_START_Y + 26-TITLESBAR_HEIGHT;
                GUI_DispStringInRect(CUTOFF_CONDITION[SystemPrameter.SystemLanguage], &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
            }//if(NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS || NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE)
}
void DisplayReportInterface(void)
{
    GUI_RECT rect;
    float dTemp;

    //1.出报告前先初使化
    if(ReportMenu.ReportReady != 4 && ReportMenu.ReportReady)
    {
        ReportMenu.ReportReady=0;
        if(BoardInf.KineticPara.Enable)
        {
            InitKineticAnalysis();
        }
        else
        {
            InitNormalAnalysis();
					  
        }
    }

    GUI_SetColor(COLOR_PAINT_TXT);
    if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    {
        GUI_SetFont(GUI_FONT_BIG);
    }
    else
    {
        GUI_SetFont(GUI_FONT_BIG_CH);
    }
    //2.显示标题栏和右侧工具栏的内容
    if(BoardInf.bHasData)                //有数据
    {
        if(BoardInf.KineticPara.Enable ) //动力学分析(右侧工具栏的内容)
        {
            if((NormalAnalysis.wcMode==ANALYSIS_MODE_RAWDATA)||(NormalAnalysis.wcMode==ANALYSIS_MODE_CURVE) )//原始数据、动力学曲线
            {
                //GUI_DrawBitmap(&bmMenuRight_120_46, QUALITY_OPEN_SELECT_START_X, QUALITY_OPEN_SELECT_START_Y - TITLESBAR_HEIGHT);
                //GUI_DrawBitmap(&bmMenuRight_120_46, ANALYSIS_LOG_SELECT_START_X, ANALYSIS_LOG_SELECT_START_Y - TITLESBAR_HEIGHT);
                GUI_SetColor(COLOR_PICTURE);
                GUI_FillRect(ANALYSIS_LOG_SELECT_START_X, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT,ANALYSIS_LOG_SELECT_START_X+100, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT+45);
                GUI_DrawBitmap(&bmMenuRight_20_46, ANALYSIS_LOG_SELECT_START_X+100, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT);

                GUI_DrawBitmap(&bmMenuPlus_62_37, PLUS_BUTTON_START_X, PLUS_BUTTON_START_Y - TITLESBAR_HEIGHT);
                GUI_DrawBitmap(&bmMenuMinus_62_37, MINUS_BUTTON_START_X, MINUS_BUTTON_START_Y - TITLESBAR_HEIGHT);
                GUI_SetColor(COLOR_PAINT_TXT);
                if(NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA)  //原始数据显示“循环:1”
                {
                    sprintf(ConvertStr,SELECT_REPORT_CYCLE[SystemPrameter.SystemLanguage],BoardInf.KineticPara.kinetic_reading_current+1);
                }
                else if(BoardInf.KineticPara.nCurrentSample < TUBE_MAX)//动力学曲线显示“样本：A1”
                {
                    sprintf(ConvertStr,SELECT_REPORT_SAMPLE_NO[SystemPrameter.SystemLanguage], BoardInf.KineticPara.nCurrentSample / 12 + 'A'
                            , BoardInf.KineticPara.nCurrentSample % 12 + 1);
                }
                else                                  //动力学曲线显示“所有样本”
                {
                    strcpy(ConvertStr,SELECT_REPORT_SAMPLE_ALL[SystemPrameter.SystemLanguage]);
                }
                rect.x0=ANALYSIS_LOG_SELECT_START_X;
                rect.y0=ANALYSIS_LOG_SELECT_START_Y-TITLESBAR_HEIGHT;
                rect.x1= ANALYSIS_LOG_SELECT_END_X;//- 8;
                rect.y1=ANALYSIS_LOG_SELECT_END_Y-TITLESBAR_HEIGHT;
                GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
            }//if((NormalAnalysis.wcMode==ANALYSIS_MODE_RAWDATA)||(NormalAnalysis.wcMode==ANALYSIS_MODE_CURVE) )//
            else if(NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS)////动力学分析结果
            {
                //GUI_DrawBitmap(&bmMenuRight_120_46, QUALITY_OPEN_SELECT_START_X, QUALITY_OPEN_SELECT_START_Y - TITLESBAR_HEIGHT);
                //GUI_DrawBitmap(&bmMenuRight_120_46, ANALYSIS_LOG_SELECT_START_X, ANALYSIS_LOG_SELECT_START_Y - TITLESBAR_HEIGHT);
                GUI_SetColor(COLOR_PICTURE);
                GUI_FillRect(ANALYSIS_LOG_SELECT_START_X, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT,ANALYSIS_LOG_SELECT_START_X+100, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT+45);
                GUI_DrawBitmap(&bmMenuRight_20_46, ANALYSIS_LOG_SELECT_START_X+100, ANALYSIS_LOG_SELECT_START_Y- TITLESBAR_HEIGHT);
                GUI_SetColor(COLOR_PAINT_TXT);
                //按钮第一行"平均“
                rect.x0=ANALYSIS_FILTER_SELECT_START_X;
                rect.y0=ANALYSIS_LOG_SELECT_START_Y+3-TITLESBAR_HEIGHT;
                rect.x1=ANALYSIS_FILTER_SELECT_END_X;
                rect.y1=ANALYSIS_LOG_SELECT_START_Y+ (ANALYSIS_LOG_SELECT_END_Y - ANALYSIS_LOG_SELECT_START_Y) / 2-3-TITLESBAR_HEIGHT;
                strcpy(ConvertStr,KINETIC_ANALYSIS_SELECTION[0][SystemPrameter.SystemLanguage][BoardInf.KineticPara.kinetic_analysis_mode]);
                GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
                //按钮第一行"速率“
                rect.x0=ANALYSIS_FILTER_SELECT_START_X;
                rect.y0=ANALYSIS_LOG_SELECT_START_Y+ (ANALYSIS_LOG_SELECT_END_Y - ANALYSIS_LOG_SELECT_START_Y) / 2+3-TITLESBAR_HEIGHT;
                rect.x1=ANALYSIS_FILTER_SELECT_END_X;
                rect.y1=ANALYSIS_LOG_SELECT_END_Y - 3-TITLESBAR_HEIGHT;
                strcpy(ConvertStr,KINETIC_ANALYSIS_SELECTION[1][SystemPrameter.SystemLanguage][BoardInf.KineticPara.kinetic_analysis_mode]);
                GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
            }//else if(NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS)////定量分析
        }//if(BoardInf.KineticPara.Enable )
        else
        {
            //StretchBlt(DstDC,
            //	ANALYSIS_FILTER_SELECT_START_X,//662
            //	ANALYSIS_FILTER_SELECT_START_Y,//152
            //	ANALYSIS_FILTER_SELECT_END_X - ANALYSIS_FILTER_SELECT_START_X + 1,//783-662+1
            //	ANALYSIS_FILTER_SELECT_END_Y - ANALYSIS_FILTER_SELECT_START_Y + 1,//198-152+1
            //	buttons.hdcMem,
            //	ANALYSIS_FILTER_SELECT_START_X,
            //	ANALYSIS_FILTER_SELECT_START_Y - KINETIC_RAWDATA_SHIFT,
            //	ANALYSIS_FILTER_SELECT_END_X - ANALYSIS_FILTER_SELECT_START_X ,
            //	ANALYSIS_FILTER_SELECT_END_Y - ANALYSIS_FILTER_SELECT_START_Y ,//+1
            //	SRCCOPY);
        } //if(BoardInf.KineticPara.Enable ) else

        //3.以下为正常分析(显示右侧工具栏中的按钮内容）
        //定量分析、标准曲线、定性分析
        if((NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS || NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE
                || NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET)	&& (SystemPrameter.RawIntensity==0) &&(BoardInf.KineticPara.Enable==0))
        {
            //GUI_DrawBitmap(&bmMenuRight_120_46, QUALITY_OPEN_SELECT_START_X, QUALITY_OPEN_SELECT_START_Y - TITLESBAR_HEIGHT);
            //GUI_DrawBitmap(&bmMenuRight_120_46, ANALYSIS_LOG_SELECT_START_X, ANALYSIS_LOG_SELECT_START_Y - TITLESBAR_HEIGHT);
            #ifdef SOFTWARE_DN
					  if( (BoardInf.KineticPara.Curve==CURVE_LOGITLOG)||(BoardInf.KineticPara.Curve==CURVE_CUBIC) )
						{
							  ;
						}
						else 
						{
							   DisplayLinearLog();
						}
						#else
						{
						    DisplayLinearLog();
					  }
						#endif
        }//if((NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS || NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE|| NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET)	&& (SystemPrameter.RawIntensity==0) &&(BoardInf.KineticPara.Enable==0))




        //显示标题名
        if(BoardInf.KineticPara.Enable==0)
        {
            strcpy(ConvertStr,"\"");
            strcat(ConvertStr,BoardInf.Name);
            strcat(ConvertStr,"\" ");
            //strcat(ConvertStr," ");
            strcat(ConvertStr,NORMAL_ANALYSIS_TITLE[SystemPrameter.SystemLanguage][NormalAnalysis.wcMode]);
        }
        else
        {
            strcpy(ConvertStr,"\"");
            strcat(ConvertStr,BoardInf.Name);
            strcat(ConvertStr,"\" ");
            strcat(ConvertStr,KINETIC_ANALYSIS_TITLE[SystemPrameter.SystemLanguage][NormalAnalysis.wcMode]);
        }
        rect.x0=EDIT_START_X+3;//modify
        rect.y0= EDIT_START_Y-TITLESBAR_HEIGHT;
        rect.x1=EDIT_END_X;
        rect.y1=EDIT_END_Y-TITLESBAR_HEIGHT;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);




        //动力学分析和正常分析公用（右侧工具栏）
        //工具栏第一个按钮上半部分(滤光片1)
        rect.x0=ANALYSIS_FILTER_SELECT_START_X;//+SELECT_CONTROL_REPORT_FILTER1_START_X[SystemPrameter.SystemLanguage];//modify
        rect.y0= ANALYSIS_FILTER_SELECT_START_Y-TITLESBAR_HEIGHT;
        rect.x1=ANALYSIS_FILTER_SELECT_END_X;
        rect.y1=ANALYSIS_FILTER_SELECT_START_Y+(ANALYSIS_FILTER_SELECT_END_Y-ANALYSIS_FILTER_SELECT_START_Y)/2-TITLESBAR_HEIGHT;
        if(NormalAnalysis.FilterCurrent == 0)
        {
            GUI_DispStringInRect(SELECT_CONTROL_REPORT_FILTER1[SystemPrameter.SystemLanguage], &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        }
        else if(NormalAnalysis.FilterCurrent == 1)
        {
            GUI_DispStringInRect(SELECT_CONTROL_REPORT_FILTER2[SystemPrameter.SystemLanguage], &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        }
        else
        {
            GUI_DispStringInRect(SELECT_CONTROL_REPORT_FILTER12[SystemPrameter.SystemLanguage], &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        }
        //工具栏第一个按钮下半部分(405nm)
        rect.x0=ANALYSIS_FILTER_SELECT_START_X;//+36;//modify
        rect.y0= ANALYSIS_FILTER_SELECT_START_Y+(ANALYSIS_FILTER_SELECT_END_Y-ANALYSIS_FILTER_SELECT_START_Y)/2-TITLESBAR_HEIGHT;
        rect.x1=ANALYSIS_FILTER_SELECT_END_X;
        rect.y1=ANALYSIS_FILTER_SELECT_END_Y-TITLESBAR_HEIGHT;
        if(NormalAnalysis.FilterCurrent == 0)
        {
            sprintf(ConvertStr,"%d",FilterLun.Filter[BoardInf.Filter1Locate]);
            strcat(ConvertStr,"nm");
            GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        }
        else if(NormalAnalysis.FilterCurrent == 1)
        {
            sprintf(ConvertStr,"%d",FilterLun.Filter[BoardInf.Filter2Locate]);
            strcat(ConvertStr,"nm");
            GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        }
        else
        {
            GUI_DispStringInRect(PRE_CALCULATE_STR[BoardInf.KineticPara.PreProcess], &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        }

        if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
        {
            GUI_SetFont(GUI_FONT_MED);
        }
        else
        {
            GUI_SetFont(GUI_FONT_MED_CH);
        }
    }//if(BoardInf.bHasData)

    //if(ReportMenu.ReportReady == 4) //显示荧光强度
    //{
    //}

    //else
    //显示原始光强
    if(SystemPrameter.RawIntensity && BoardInf.bHasData) //显示荧光强度
    {
        DisplayRawIntensity();

    }//if(SystemPrameter.RawIntensity && BoardInf.bHasData) //显示荧光强度


    //动力学曲线
    else if((NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE) && BoardInf.bHasData && BoardInf.KineticPara.Enable )
    {
        DisplayKineticCurve();
    }
    //动力学分析
    else if((NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS) && BoardInf.bHasData && BoardInf.KineticPara.Enable)
    {
        DisplayKineticAnalysis();
    }

    //3.以下为正常分析
    //原始数据、定量分析、定性分析
    else if((NormalAnalysis.wcMode == ANALYSIS_MODE_RAWDATA || NormalAnalysis.wcMode == ANALYSIS_MODE_ANALYSIS
             || NormalAnalysis.wcMode == ANALYSIS_MODE_INTERPRET) && BoardInf.bHasData ) //&&(BoardInf.KineticPara.Enable==0)
    {
        DisplayRawInter();
    }
    //标准曲线
    else if((NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE) && BoardInf.bHasData && (BoardInf.KineticPara.Enable==0))
    {
        DisplayCurve();
    }
    //质控分析
    else if((NormalAnalysis.wcMode == ANALYSIS_MODE_QC) && BoardInf.bHasData && (BoardInf.KineticPara.Enable==0))
    {
        DisplayQC();
    }


    if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    {
        GUI_SetFont(GUI_FONT_MED);
    }
    else
    {
        GUI_SetFont(GUI_FONT_MED_CH);
    }
    // DisplayDateTime(dc);

    //DiplayButton();





    //InitNormalAnalysis();
    //  DisplayCurve();
}

void _cbReport(WM_MESSAGE * pMsg)
{

    //char str[10];
    WM_HWIN hWin = pMsg->hWin;
//	WM_HWIN hWinFocus;
    BUTTON_Handle hbutton;
    unsigned short i;
    short        xSize;
    short        ySize;
    short NCode, Id;
//	GUI_RECT rect;
    //	int  day_max;
    //hWinFocus = WM_GetFocussedWindow();
    //IdWinFocus = WM_GetId(hWinFocus);

    switch (pMsg->MsgId)
    {
    case WM_CREATE:
    {
        if(BoardInf.KineticPara.Enable)
        {
            for (i = 0; i < GUI_COUNTOF(_aButtonReportKinetic); i++)
            {
                hbutton = BUTTON_CreateEx(_aButtonReportKinetic[i].xPos, _aButtonReportKinetic[i].yPos, _aButtonReportKinetic[i].xSize, _aButtonReportKinetic[i].ySize,
                                          hWin, WM_CF_SHOW, 0, ID_REPORT_BUTTON + i);
                if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
                {
                    BUTTON_SetFont(hbutton, GUI_FONT_BIG);
                    BUTTON_SetText(hbutton, _aButtonReportKinetic[i].acLabelEn);
                }
                else
                {
                    BUTTON_SetFont(hbutton, GUI_FONT_BIG_CH);
                    BUTTON_SetText(hbutton, _aButtonReportKinetic[i].acLabelCh);
                }
                BUTTON_SetTextAlign(hbutton, GUI_TA_HCENTER | GUI_TA_VCENTER);
                BUTTON_SetFocussable(hbutton, 0);
                BUTTON_SetTextColor(hbutton, BUTTON_CI_DISABLED, GUI_GRAY);
                WM_EnableWindow(hbutton);
                //不显示按钮
                if( (i==0)||(i==1) )
                {
                    WM_HideWindow(hbutton);
                }
            }
        }
        else
        {
            for (i = 0; i < GUI_COUNTOF(_aButtonReport); i++)
            {
                hbutton = BUTTON_CreateEx(_aButtonReport[i].xPos, _aButtonReport[i].yPos, _aButtonReport[i].xSize, _aButtonReport[i].ySize,
                                          hWin, WM_CF_SHOW, 0, ID_REPORT_BUTTON +i);
                if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
                {
                    BUTTON_SetFont(hbutton, GUI_FONT_BIG);
                    BUTTON_SetText(hbutton, _aButtonReport[i].acLabelEn);
                }
                else
                {
                    BUTTON_SetFont(hbutton, GUI_FONT_BIG_CH);
                    BUTTON_SetText(hbutton, _aButtonReport[i].acLabelCh);
                }
                BUTTON_SetTextAlign(hbutton, GUI_TA_HCENTER | GUI_TA_VCENTER);
                BUTTON_SetTextColor(hbutton, BUTTON_CI_DISABLED, GUI_GRAY);
                BUTTON_SetFocussable(hbutton, 0);
                //显示按钮
                WM_ShowWindow(hbutton);
                WM_EnableWindow(hbutton);
                if( (BoardInf.InterpretPara.Enable==0)&&(i==1) )
                {
                    WM_DisableWindow(hbutton);
                }


                if( (BoardInf.KineticPara.Curve==CURVE_NO)&&((i==2)||(i==3)) )
                {
                    WM_DisableWindow(hbutton);
                }


                if( (BoardInf.QualityPara.Enable==0)&&(i==4) )
                {
                    WM_DisableWindow(hbutton);
                }


            }
        }

        break;
    }
    //删除按钮
    case WM_DELETE:

        //WM_ShowWindow(ButtonZero[i]);
        break;
        //绘制背景
    case WM_PAINT:
        xSize = WM_GetWindowSizeX(hWin);
        ySize = WM_GetWindowSizeY(hWin);
        //上方第一行
        GUI_SetColor(COLOR_TITLEBAR);
        GUI_FillRect(0, 0, xSize - 1, CONTENTBAR_TITLE_HEIGHT - 1);
        //左方内容栏
        GUI_SetColor(COLOR_CONTENTBAR);
        GUI_FillRect(0, CONTENTBAR_CONTENT_POSY, CONTENTBAR_CONTENT_WIDTH - 1, ySize - 1);
        //右侧工具栏
        GUI_SetColor(COLOR_TOOLSBAR);
        GUI_FillRect(CONTENTBAR_CONTENT_WIDTH, CONTENTBAR_CONTENT_POSY, xSize - 1, ySize - 1);

        //GUI_DrawBitmap(&bmMenuRight_120_46, QUALITY_CONC_SELECT_START_X, QUALITY_CONC_SELECT_START_Y - TITLESBAR_HEIGHT);
        GUI_SetColor(COLOR_PICTURE);
        GUI_FillRect(QUALITY_CONC_SELECT_START_X, QUALITY_CONC_SELECT_START_Y- TITLESBAR_HEIGHT,QUALITY_CONC_SELECT_START_X+100, QUALITY_CONC_SELECT_START_Y- TITLESBAR_HEIGHT+45);
        GUI_DrawBitmap(&bmMenuRight_20_46, QUALITY_CONC_SELECT_START_X+100, QUALITY_CONC_SELECT_START_Y- TITLESBAR_HEIGHT);



        //GUI_DrawBitmap(&bmMenuLeft_101_46, FILTER_1_START_X, FILTER_1_START_Y - TITLESBAR_HEIGHT);
        //GUI_DrawBitmap(&bmMenuLeft_101_46, FILTER_2_START_X, FILTER_2_START_Y - TITLESBAR_HEIGHT);
        //GUI_DrawBitmap(&bmMenuLeft_101_46, MODE_START_X, MODE_START_Y - TITLESBAR_HEIGHT);

        //GUI_DrawBitmap(&bmMenuRight_90_46, FILTER_1_R_START_X, FILTER_1_R_START_Y - TITLESBAR_HEIGHT);
        //GUI_DrawBitmap(&bmMenuRight_90_46, FILTER_2_R_START_X, FILTER_2_R_START_Y - TITLESBAR_HEIGHT);
        //GUI_DrawBitmap(&bmMenuRight_90_46, MODE_R_START_X, MODE_START_Y - TITLESBAR_HEIGHT);


        GUI_SetTextMode(GUI_TM_TRANS);

        GUI_SetColor(COLOR_PAINT_TXT);

        if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
        {
            GUI_SetFont(GUI_FONT_MED);
        }
        else
        {
            GUI_SetFont(GUI_FONT_MED_CH);
        }

        //GUI_DispStringAt(STR_MEASURE_TITLE[SystemPrameter.SystemLanguage], CONTENTBAR_CAPTION_POSX, CONTENTBAR_CAPTION_POSY);//"Measurement parameters"
        /*
        rect.x0=TOOLS1_BUTTON_STARTX;
        rect.y0=TOOLS1_BUTTON_STARTY(0);//+TITLESBAR_HEIGHT;
        rect.x1=TOOLS1_BUTTON_ENDX;
        rect.y1=TOOLS1_BUTTON_ENDY(0);//+TITLESBAR_HEIGHT;
        if(BoardInf.QualityPara.AbsFlag)
        {
        	strcpy(ConvertStr,STR_ABS[SystemPrameter.SystemLanguage]);
           // GUI_DispStringAt(STR_ABS[SystemPrameter.SystemLanguage], CONTENTBAR_CAPTION_POSX, CONTENTBAR_CAPTION_POSY);
        }
        else
        {
        	strcpy(ConvertStr,STR_CONC[SystemPrameter.SystemLanguage]);
        	//GUI_DispStringAt(STR_CONC[SystemPrameter.SystemLanguage], CONTENTBAR_CAPTION_POSX, CONTENTBAR_CAPTION_POSY);
        }
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);


        rect.x0=TOOLS1_BUTTON_STARTX;
        rect.y0=TOOLS1_BUTTON_STARTY(1);//+TITLESBAR_HEIGHT;
        rect.x1=TOOLS1_BUTTON_ENDX;
        rect.y1=TOOLS1_BUTTON_ENDY(1);//+TITLESBAR_HEIGHT;
        if(BoardInf.QualityPara.Enable)
        {
        	strcpy(ConvertStr,STR_OPEN[SystemPrameter.SystemLanguage]);
           // GUI_DispStringAt(STR_ABS[SystemPrameter.SystemLanguage], CONTENTBAR_CAPTION_POSX, CONTENTBAR_CAPTION_POSY);
        }
        else
        {
        	strcpy(ConvertStr,STR_CLOSE[SystemPrameter.SystemLanguage]);
        	//GUI_DispStringAt(STR_CONC[SystemPrameter.SystemLanguage], CONTENTBAR_CAPTION_POSX, CONTENTBAR_CAPTION_POSY);
        }
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
        */

        GUI_SetColor(0x0);


        DisplayReportInterface();


        //if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
        // {
        //     GUI_SetFont(GUI_FONT_MED);
        //}
        /// //else
        // {
        //  	 GUI_SetFont(GUI_FONT_MED_CH);
        // }
        if(ExpEnable==EXP_FILTER)
        {
            DisplayAnalysisFilterExpand();
        }
        else if(ExpEnable==EXP_LOG)
        {
            DisplayAnalysisLogExpand();
        }




        //	if((NormalAnalysis.wcMode == ANALYSIS_MODE_CURVE) && BoardInf.bHasData)



        //GUI_SetFont(GUI_FONT_SMALL);


        break;

    case WM_NOTIFY_PARENT:
    {
        Id = WM_GetId(pMsg->hWinSrc);    // Id of widget
        NCode = pMsg->Data.v;               // Notification code
        if(RemoteInfo_PC.RemoteFlag)
        {
            break;
        }
        if( (KeyPadAsc.UseFlag == KEYPAD_BUSY)||(KeyPadNum.UseFlag == KEYPAD_BUSY)||(PromptMenu.InterfaceStatus==PROMPT_MENU_BUSY) )
        {
            break;
        }
        if(TouchKey.KeyStatus)
        {
            break;
        }
        if (NCode == WM_NOTIFICATION_RELEASED ) //正常分析
        {
            //原始数据
            if( (Id==ID_REPORT_BUTTON0)&& (BoardInf.KineticPara.Enable==0) )
            {
                if(NormalAnalysis.wcMode != ANALYSIS_MODE_RAWDATA)
                {
                    NormalAnalysis.wcMode = ANALYSIS_MODE_RAWDATA;//原始数据
                    WM_Invalidate(ReportWin);
                }
                //Paint
            }
            //定性分析
            else if( (Id==ID_REPORT_BUTTON1)&& (BoardInf.KineticPara.Enable==0) )
            {
                if(NormalAnalysis.wcMode != ANALYSIS_MODE_INTERPRET && BoardInf.InterpretPara.Enable)
                {
                    if(BoardInf.InterpretPara.nAnalysisResult[NormalAnalysis.FilterCurrent] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_INTERPRET;  //定性分析
                        WM_Invalidate(ReportWin);
                    }
                    else if(BoardInf.InterpretPara.nAnalysisResult[(NormalAnalysis.FilterCurrent + 1)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_INTERPRET;  //定性分析
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 1)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else if(BoardInf.InterpretPara.nAnalysisResult[(NormalAnalysis.FilterCurrent + 2)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_INTERPRET;  //定性分析
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 2)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else
                    {
                        strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][BoardInf.InterpretPara.nAnalysisResult[NormalAnalysis.FilterCurrent]]);
                        Prompt_Interface(PROMPT_WARMING);
                    }
                }
                //Paint
            }
            //定量分析   动力学原始数据
            else if(Id==ID_REPORT_BUTTON2)
            {
                //  if(BoardInf.KineticPara.Enable==0)
                //  {
                if(NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS && BoardInf.KineticPara.Enable ==0 && BoardInf.KineticPara.Curve !=CURVE_NO)
                {
                    if(NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrent] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_ANALYSIS;   //定量分析
                        WM_Invalidate(ReportWin);
                    }
                    else if(NormalAnalysis.nAnalysisResult[(NormalAnalysis.FilterCurrent + 1)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_ANALYSIS;  //定量分析
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 1)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else if(NormalAnalysis.nAnalysisResult[(NormalAnalysis.FilterCurrent + 2)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_ANALYSIS;  //定量分析
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 2)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else
                    {

                        strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrent]]);
                        Prompt_Interface(PROMPT_WARMING);
                    }
                }//if(NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS && BoardInf.KineticPara.Enable ==0)
                //	  }// if(BoardInf.KineticPara.Enable==0)
                else  if( (NormalAnalysis.wcMode != ANALYSIS_MODE_RAWDATA)&& BoardInf.KineticPara.Enable)//动力学分析
                {
                    NormalAnalysis.wcMode = ANALYSIS_MODE_RAWDATA;//原始数据

                    WM_Invalidate(ReportWin);
                }
                //Paint
            }
            //标准曲线  动力学分析
            else if(Id==ID_REPORT_BUTTON3)//
            {
                //  if(BoardInf.KineticPara.Enable==0)
                // {
                if( (NormalAnalysis.wcMode != ANALYSIS_MODE_CURVE && BoardInf.KineticPara.Enable ==0)&&(BoardInf.KineticPara.Curve>=0) )
                {
                    if(NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrent] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_CURVE;   //标准曲线
                        WM_Invalidate(ReportWin);
                    }
                    else if(NormalAnalysis.nAnalysisResult[(NormalAnalysis.FilterCurrent + 1)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_CURVE; //标准曲线
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 1)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else if(NormalAnalysis.nAnalysisResult[(NormalAnalysis.FilterCurrent + 2)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_CURVE; //标准曲线
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 2)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else
                    {
                        strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][NormalAnalysis.nAnalysisResult[NormalAnalysis.FilterCurrent]]);
                        Prompt_Interface(PROMPT_WARMING);
                    }
                }//if(NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS && BoardInf.KineticPara.Enable ==0)
                //  }// if(BoardInf.KineticPara.Enable==0)
                else if( (NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS) && BoardInf.KineticPara.Enable)  //动力学分析
                {
                    if(BoardInf.KineticPara.nAnalysisResult[NormalAnalysis.FilterCurrent] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
                        WM_Invalidate(ReportWin);
                    }
                    else if(BoardInf.KineticPara.nAnalysisResult[(NormalAnalysis.FilterCurrent + 1)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 1)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else if(BoardInf.KineticPara.nAnalysisResult[(NormalAnalysis.FilterCurrent + 2)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode = ANALYSIS_MODE_ANALYSIS;
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 2)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else
                    {
                        strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][BoardInf.KineticPara.nAnalysisResult[NormalAnalysis.FilterCurrent]]);
                        Prompt_Interface(PROMPT_WARMING);
                    }
                }//else if( (NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS) && BoardInf.KineticPara.Enable)  //动力学分析
                // ReportMenu.CurrMenu=REPORT_MENU_CURVE;
                //	 NormalAnalysis.wcMode =ANALYSIS_MODE_CURVE;       //标准曲线
                // WM_Invalidate(ReportWin);
                //Paint
            }//  else if(Id==ID_REPORT_BUTTON3)//

            //质控分析   或   动力学曲线
            else if(Id==ID_REPORT_BUTTON4)
            {
                if(NormalAnalysis.wcMode != ANALYSIS_MODE_QC && (BoardInf.KineticPara.Enable==0)&&(BoardInf.QualityPara.Enable ) )//非动力学分析
                {
                    if(BoardInf.QualityResult.nAnalysisResult[NormalAnalysis.FilterCurrent] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode = ANALYSIS_MODE_QC;
                        WM_Invalidate(ReportWin);
                    }
                    else if(BoardInf.QualityResult.nAnalysisResult[(NormalAnalysis.FilterCurrent + 1)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode = ANALYSIS_MODE_QC;
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 1)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else if(BoardInf.QualityResult.nAnalysisResult[(NormalAnalysis.FilterCurrent + 2)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode = ANALYSIS_MODE_QC;
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 2)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else
                    {
                        strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][BoardInf.QualityResult.nAnalysisResult[NormalAnalysis.FilterCurrent]]);
                        Prompt_Interface(PROMPT_WARMING);
                    }
                }//else if(NormalAnalysis.wcMode != ANALYSIS_MODE_QC && (BoardInf.KineticPara.Enable==0)&&(BoardInf.QualityPara.Enable ) )//非动力学分析
                else if(NormalAnalysis.wcMode != ANALYSIS_MODE_CURVE && BoardInf.KineticPara.Enable )//?
                {

                    if(BoardInf.KineticPara.nAnalysisResult[NormalAnalysis.FilterCurrent] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_CURVE;   //定量分析
                        WM_Invalidate(ReportWin);
                    }
                    else if(BoardInf.KineticPara.nAnalysisResult[(NormalAnalysis.FilterCurrent + 1)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_CURVE;  //定量分析
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 1)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else if(BoardInf.KineticPara.nAnalysisResult[(NormalAnalysis.FilterCurrent + 2)%3] == ANALYSIS_SUCCESS)
                    {
                        NormalAnalysis.wcMode =ANALYSIS_MODE_CURVE;  //定量分析
                        NormalAnalysis.FilterCurrent = (NormalAnalysis.FilterCurrent + 2)%3;
                        WM_Invalidate(ReportWin);
                    }
                    else
                    {
                        strcpy(PromptMenu.InputStr,ANALYSIS_ERROR_MESSAGE[SystemPrameter.SystemLanguage][BoardInf.KineticPara.nAnalysisResult[NormalAnalysis.FilterCurrent]]);
                        Prompt_Interface(PROMPT_WARMING);
                    }
                }//else if(NormalAnalysis.wcMode != ANALYSIS_MODE_ANALYSIS && BoardInf.KineticPara.Enable ==0)
            }


            else if (Id == ID_REPORT_BUTTON5)   //工具栏按钮   打印
            {
                PrintFile();
                //加入延时
            }

            else if (Id == ID_REPORT_BUTTON6)   //工具栏按钮  导出报告
            {
                ExportReport_Interface();
                gSystem.TitleButtonEnable=0;
                gSystem.SystemInterface = MI_EXPORT_REPORT;
            }
        }
        break;
    }

    default:
        //		WM_DefaultProc(pMsg);
        break;
    }
}



void SetQCPara2(void)
{
    signed char i;
    for(i = 0; i < QC_MAX; i++)
    {
        if(BoardInf.QualityPara.dTarget[0][i]!=0)  //2015-11-11改
        {
            BoardInf.QualityPara.dCV[0][i] = BoardInf.QualityPara.dSD[0][i] / BoardInf.QualityPara.dTarget[0][i];
        }
        else BoardInf.QualityPara.dCV[0][i] =0;

        if(BoardInf.QualityPara.dTarget[1][i]!=0)  //2015-11-11改
        {
            BoardInf.QualityPara.dCV[1][i] = BoardInf.QualityPara.dSD[1][i] / BoardInf.QualityPara.dTarget[1][i];
        }
        else BoardInf.QualityPara.dCV[1][i] =0;


        BoardInf.QualityPara.dLowerLimit[0][i] = BoardInf.QualityPara.dTarget[0][i] - BoardInf.QualityPara.dSD[0][i] * QC_COEF;
        BoardInf.QualityPara.dLowerLimit[1][i] = BoardInf.QualityPara.dTarget[1][i] - BoardInf.QualityPara.dSD[1][i] * QC_COEF;

        BoardInf.QualityPara.dUpperLimit[0][i] = BoardInf.QualityPara.dTarget[0][i] + BoardInf.QualityPara.dSD[0][i] * QC_COEF;
        BoardInf.QualityPara.dUpperLimit[1][i] = BoardInf.QualityPara.dTarget[1][i] + BoardInf.QualityPara.dSD[1][i] * QC_COEF;
    }
}


