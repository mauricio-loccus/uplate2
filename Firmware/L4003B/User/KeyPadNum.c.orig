void SetNumButtonSkin(void)
{
    BUTTON_SKINFLEX_PROPS   BUTTON_SKI_NORMAL = { { COLOR_BUTTON_DEFAULT, COLOR_BUTTON_DEFAULT, 0Xffffff }, { 0Xffffff, 0XFFffff }, { 0XFfffff, 0XFfffff }, 4 };
    BUTTON_SKINFLEX_PROPS   BUTTON_SKI_PRESS = { { 0x777777, 0x777777, 0x777777 }, { 0x777777, 0x777777 }, { 0x777777, 0x777777 }, 4 };
    BUTTON_SKINFLEX_PROPS   BUTTON_SKI_DISABLE = { { GUI_GRAY, 0xbbbbbb, 0xbbbbbb }, { 0xbbbbbb, 0xbbbbbb }, { 0xbbbbbb, 0xbbbbbb }, 4 };

    BUTTON_SetDefaultSkin(BUTTON_SKIN_FLEX);
    {
        BUTTON_SetSkinFlexProps(&BUTTON_SKI_PRESS, BUTTON_SKINFLEX_PI_PRESSED);
        BUTTON_SetSkinFlexProps(&BUTTON_SKI_NORMAL, BUTTON_SKINFLEX_PI_FOCUSSED);
        BUTTON_SetSkinFlexProps(&BUTTON_SKI_NORMAL, BUTTON_SKINFLEX_PI_ENABLED);
        BUTTON_SetSkinFlexProps(&BUTTON_SKI_DISABLE, BUTTON_SKINFLEX_PI_DISABLED);
    }

}

void _cbKeyPadNum(WM_MESSAGE * pMsg)
{
    WM_HWIN    hWin;
    WM_HWIN    hButton;
    int        Id;
    int        NCode;
    int        xSize;
    int        ySize;
    unsigned char  i;
    //char s_Editbuf[100] = { 0 };
    //char s_Edit[100] = { 0 };
    hWin = pMsg->hWin;
    switch (pMsg->MsgId)
    {
        //???????
    case WM_CREATE:
        SetNumButtonSkin();

        EditMessage = EDIT_CreateEx(EDIT_MESSAGE_POSX, EDIT_MESSAGE_POSY, EDIT_MESSAGE_WIDTH, EDIT_MESSAGE_HEIGHT, hWin, WM_CF_SHOW | WM_CF_STAYONTOP, 0, KEYPAD_ID_EDIT, 8);
        EDIT_SetFont(EditMessage, GUI_FONT_BIG);
        EDIT_EnableBlink(EditMessage, 600, 1);
        //if(KeyPadNum.InputValueStr[0]!='')
        //{
        if(strlen(KeyPadNum.InputValueStr)>0)
        {
            EDIT_SetText(EditMessage, KeyPadNum.InputValueStr);
        }
        //}
        if(KeyPadNum.MenuFlag==NUM_MENUFLAG_2NUM)
        {
            i=2;
        }
        else if(KeyPadNum.MenuFlag==NUM_MENUFLAG_3NUM)
        {
            i=3;
        }
        else if(KeyPadNum.MenuFlag==NUM_MENUFLAG_4NUM)
        {
            i=4;
        }
        else if(KeyPadNum.MenuFlag==NUM_MENU_FLAG)  //float  10时实数e显示不下
        {
            i=9;
        }
        else //if(KeyPadNum.MenuFlag==NUM_MENUFLAG_PASSWORD)
        {
            i=9;
        }

        EDIT_SetMaxLen(EditMessage, i);
        if(strlen(KeyPadNum.InputValueStr)>0)
        {
            EDIT_SetCursorAtChar(EditMessage, sizeof(KeyPadNum.InputValueStr)-1);
            EDIT_SetSel(EditMessage, 0, sizeof(KeyPadNum.InputValueStr)-1);
        }



        for (i = 0; i < GUI_COUNTOF(_aButtonData); i++)
        {
            hButton = BUTTON_CreateEx(_aButtonData[i].xPos, _aButtonData[i].yPos, _aButtonData[i].xSize, _aButtonData[i].ySize,
                                      hWin, WM_CF_SHOW, 0, KEYPAD_NUM_ID_BUTTON + i);

            SetAsciiBUTTONColor(hButton);
            BUTTON_SetFont(hButton, GUI_FONT_BIG);//SIF_Font24);
            BUTTON_SetText(hButton, _aButtonData[i].acLabel);

            if(i==0)
            {
                BUTTON_SetBitmapEx(hButton,BUTTON_BI_UNPRESSED, &bmNumDel,12,15);
            }
            BUTTON_SetTextAlign(hButton, GUI_TA_HCENTER | GUI_TA_VCENTER);

            BUTTON_SetFocussable(hButton, 0);
        }
        BUTTON_SetDefaultSkinClassic();
        WM_SetFocus(EditMessage);

        break;
        //????
    case WM_DELETE:
        WM_DeleteWindow(EditMessage);

        SetButtonSkin();
        KeyPadNum.UseFlag = KEYPAD_NUM_FREE;
        break;
        //????
    case WM_PAINT:

        SetNumButtonSkin();
        xSize = WM_GetWindowSizeX(hWin);
        ySize = WM_GetWindowSizeY(hWin);
        GUI_SetColor(0xffffff);
        GUI_SetColor(0xE5CCBC);//(0xc9c5c1);
        GUI_FillRect(0, 0, xSize - 1, ySize - 1);
        GUI_SetColor(0xd68652);
        GUI_DrawRect(0, 0, xSize - 1, ySize - 1);
        GUI_DrawRect(1,1, xSize - 2, ySize - 2);
        break;

        //????????
    case WM_NOTIFY_PARENT:
        Id = WM_GetId(pMsg->hWinSrc);
        NCode = pMsg->Data.v;
        if(TouchKey.KeyStatus)
        {
            break;
        }
        switch (NCode)
        {
        case WM_NOTIFICATION_RELEASED:
        {
            if(Id==KEYPAD_ID_EDIT)
            {
                KeyPadNum.SelFlag=0;
            }
            else if( (KeyPadNum.SelFlag)&& (Id != KEYPAD_NUM_ID_BUTTON + 8)&&(Id != KEYPAD_NUM_ID_BUTTON + 4) )
            {
                KeyPadNum.SelFlag=0;
                strcpy(KeyPadNum.InputValueStr,"");
                EDIT_SetText(EditMessage, KeyPadNum.InputValueStr);
                //   EDIT_SetSel(EditMessage,-1,-1);
                //EDIT_SetCursorAtChar(EditMessage, sizeof(KeyPadNum.InputValueStr)-1);
            }
            if (_aButtonData[Id - KEYPAD_NUM_ID_BUTTON].FunctionKey == 0)
            {
                if ((Id >= KEYPAD_NUM_ID_BUTTON) && (Id < KEYPAD_NUM_ID_BUTTON + KEYPAD_NUM_BUTTON_MAX))
                {
                    s_Key = _aButtonData[Id - KEYPAD_NUM_ID_BUTTON].acLabel[0];

                    s_Textbuf[0] = s_Key;
                    s_Textbuf[1] = '\0';
                    //if (editflag)MULTIEDIT_AddText(EditMessage, s_Textbuf);
                    //else
                    EDIT_AddKey(EditMessage, s_Textbuf[0]);
                }
            }
            else
            {
                //???
                if (Id == (KEYPAD_NUM_ID_BUTTON + 0))
                {
                    EDIT_AddKey(EditMessage, GUI_KEY_BACKSPACE);
                    break;
                }
                else if (Id == (KEYPAD_NUM_ID_BUTTON + 8))//Enter
                {
                    // flag_Advance_change=1;//fmc160931
                    TouchKey.KeyStatus=1;
                    EDIT_GetText(EditMessage, KeyPadNum.InputValueStr, KEYPAD_NUM_CHAR_MAX);
                    KeyPadNum.ReturnKey = KEYPAD_NUM_RETURN_ENTER;
                    WM_DeleteWindow(KeyPadNumWin);
                }
                else if (Id == (KEYPAD_NUM_ID_BUTTON + 4))//Esc
                {
                    TouchKey.KeyStatus=1;
                    KeyPadNum.ReturnKey = KEYPAD_NUM_RETURN_CANCEL;
                    WM_DeleteWindow(KeyPadNumWin);
                }
            }
            break;
        }
        default:
            break;
        }
    default:
        break;
    }
}


void KeyPadNum_Go(void)
{
    if (TouchKey.KeyStatus)
    {
        GUI_PID_STATE TouchState;

        GUI_PID_GetState(&TouchState);
        if (TouchState.Pressed == 0)
        {
            TouchKey.KeyPressDelay++;
            if (TouchKey.KeyPressDelay > TOUCH_RELEASE_DELAY)
            {
                TouchKey.KeyPressDelay = 0;
                TouchKey.KeyStatus = 0;
            }
        }
    }
}

//	? ? ?: KeyPadNum_Interface
//	????: GUI???
//	?    ?: ?
//	? ? ?: ?
void KeyPadNum_Interface(unsigned char menuflag)
//void KeyPadNum_Interface(unsigned char flag)
{

    if (KeyPadNum.UseFlag != KEYPAD_NUM_FREE)	 
    {
			  WM_DeleteWindow(KeyPadNumWin);
			
        KeyPadNum.ReturnKey=KEYPAD_RETURN_CANCEL;
        return;
    }

    DisplayTitleBar();
    GUI_Delay(5);

    KeyPadNum.SelFlag=1;
    KeyPadNum.MenuFlag = menuflag;

    //if (KeyPadNum.UseFlag == KEYPAD_NUM_FREE)
    //{
    KeyPadNum.UseFlag = KEYPAD_NUM_BUSY;               //???????
    KeyPadNum.ReturnKey = KEYPAD_NUM_RETURN_CANCEL;
    //????
    KeyPadNumWin = WM_CreateWindowAsChild(KEYPAD_POSX, KEYPAD_POSY,KEYPAD_WIDTH, KEYPAD_HEIGHT, WM_HBKWIN, WM_CF_SHOW | WM_CF_STAYONTOP | WM_CF_MEMDEV, _cbKeyPadNum, 0);
    WM_BringToTop(KeyPadNumWin);

    do {
        Usb_check();
        GUI_Delay(5);

        KeyPadNum_Go();
			
		    #ifdef DEBUG_SCREEN
			    KeyProcess();
			  #endif
    } while(KeyPadNum.UseFlag == KEYPAD_NUM_BUSY);
    //}
    //else
    //{
    //KeyPadNum.ReturnKey = KEYPAD_NUM_RETURN_CANCEL;
    //}
}
