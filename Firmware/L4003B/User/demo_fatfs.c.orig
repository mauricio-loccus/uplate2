unsigned char WriteFile_background(char *_ucVolume,unsigned long len,unsigned char picture_flag)
{
    /* 本函数使用的局部变量占用较多，请修改启动文件，保证堆栈空间够用 */
    unsigned char flag_err;
    FRESULT result;
//	FATFS fs;
//	FIL file;
    DIR DirInf;
    uint32_t bw;
    //char path[32];

    flag_err=0;
    // 挂载文件系统
    result = f_mount(&fs, FS_VOLUME_SPI, 0);			// Mount a logical drive
    if (result != FR_OK)
    {
        flag_err=1;
        goto err;
        //	printf("挂载文件系统失败 (%d)\r\n", result);
    }

    // 打开根文件夹
    sprintf(path, "%s/", FS_VOLUME_SPI);
    result = f_opendir(&DirInf, path);
    if (result != FR_OK)
    {
        flag_err=2;
        goto err;
        //printf("打开根目录失败 (%d)\r\n", result);
        //return;
    }


    // 打开文件
    if(picture_flag==BK_LOADING)
    {
        sprintf(path, "%s/Loading.jpg", FS_VOLUME_SPI);
    }
    else  if(picture_flag==BK_LOADING_HELP)
    {
        sprintf(path, "%s/Loading_Help.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_LOGO)
    {
        sprintf(path, "%s/Loading_Logo.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_FILTER)
    {
        sprintf(path, "%s/Loading_Filter.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_BK)
    {
        sprintf(path, "%s/Loading_BK.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_UD)
    {
        sprintf(path, "%s/Loading_UD.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_EP)
    {
        sprintf(path, "%s/Loading_EP.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_NC)
    {
        sprintf(path, "%s/Loading_NC.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_PC)
    {
        sprintf(path, "%s/Loading_PC.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_SD)
    {
        sprintf(path, "%s/Loading_SD.jpg", FS_VOLUME_SPI);
    }
    else if(picture_flag==BK_LOADING_QC)
    {
        sprintf(path, "%s/Loading_QC.jpg", FS_VOLUME_SPI);
    }
    else
    {
        flag_err=2;
        goto err;
    }

    if(f_open(&file, path,  FA_OPEN_EXISTING | FA_WRITE)!=FR_OK)
    {
        if(f_open(&file, path, FA_CREATE_ALWAYS | FA_WRITE)!=FR_OK)
        {
            flag_err=3;
            goto err;
        }
    }

    /* 写一串数据 */
    result = f_write(&file, _ucVolume, len, &bw);
    if (result == FR_OK)
    {
        ;
        //printf("%s 文件写入成功\r\n", path);
    }
    else
    {
        f_close(&file);
        flag_err=3;
        goto err;
        //printf("%s 文件写入失败\r\n", path);
    }

    flag_err=0;
    f_close(&file);
err:

    /* 卸载文件系统 */
    //f_mount(NULL,_ucVolume, 0);
    f_mount(NULL,FS_VOLUME_SPI, 0);
    return flag_err;

}



unsigned char CopyStartupPicture(void)
{
    unsigned char i,flag_err;
    GUI_HMEM hMem;
    char *_acBuffer2;

    flag_err=0;
    hMem=GUI_ALLOC_AllocZero(800*480*3+100);
    _acBuffer2=GUI_ALLOC_h2p(hMem);

    for(i=0; i<11; i++) //这里为2个图片(启动1个，帮助1个)
    {
        //	OSSchedLock(&err);
        if(ReadFileFromUSB_BG(_acBuffer2,i))//读取文件
        {
            //无开机图片文件
            flag_err=1;
            break;
        }
        else if (WriteFile_background(_acBuffer2, file.fsize,i))//写入文件
        {
            flag_err=2;
            break;
        }
    }


    GUI_ALLOC_Free(hMem);
    return flag_err;
}




//U盘初始化
void Usb_Init(void)
{
    //USBH_Init(&USB_OTG_Core,USB_OTG_HS_CORE_ID,&USB_Host,&USBH_MSC_cb,&USRH_cb);
    StartUpPra.EnableUsbCheck=0;
    usbh_CloseMassStorage();
    USBH_Init(&USB_OTG_Core  ,USB_OTG_HS_CORE_ID,&USB_Host  ,&USBH_MSC_cb,&USRH_cb);
    USBH_Init(&USB_OTG_CoreWM,USB_OTG_FS_CORE_ID,&USB_HostWM,&HID_cb     ,&USRH_cbWM);//modify 20180210 two usb


    StartUpPra.EnableUsbCheck=1;
}
//****************************
void Usb_check(void)
{
    //USBH_Process(&USB_OTG_Core, &USB_Host);//

    USBH_Process(&USB_OTG_Core, &USB_Host);//WM HOST 上USB口
    USBH_ProcessWM(&USB_OTG_CoreWM, &USB_HostWM);// WM FS 下USB口 //modify 20180210 two usb

    //if(flag_usb_fs==1)//fmcusb
    //{
    //Prompt_Interface(PROMPT_USB_DISK_ERR);//debug
    //}
    //***********
    if(flag_usb_fs!=2&&flag_usb_hs!=2)
    {
        GUI_CURSOR_Hide();//fmcusb  显示鼠标
    }
    //***********
    if(flag_usb_hs>0||flag_usb_fs>0)
    {
        if(flag_usb_hs==1||flag_usb_fs==1)
        {
            flag_usb_disk_connect=1;
        }
        flag_usb_init=1;
    }
    else
    {
        flag_usb_disk_connect=0;

        if(flag_usb_init==1)
        {   flag_usb_init=0;
            Usb_Init();
        }
    }
}
void check_usb_connect(void)
{
    if (HCD_IsDeviceConnected(&USB_OTG_Core)==0 && HCD_IsDeviceConnected(&USB_OTG_CoreWM)==0)
        flag_usb_disk_connect=0;
    /*
    if (HCD_IsDeviceConnected(&USB_OTG_Core)==0)
    {
    	  flag_usb_disk_connect=0;
    	  flag_usb_hs=0;
    }*/
}


//**************************
//3个结构体： 文件、步骤、选项生成新文件
int GenerateNewFile(void)
{
    //int i,j=0,len,back[6],k;
    //int back_f[6];
    //float back_f[6];
    //const char name1[]="bb.txt",start[]="AS154_S",name[]="NAME:",step[]="STEP:",time[]="TIME:",status[]="STATUS:",option[]="OPTION:",end[]="AS154_E";
    unsigned int ptr=0;
    unsigned char i,j;
    //float f_temp;
//头行
    //板名

    data_buf[ptr++]='S';//以S开头
    //len=strlen(BoardInf.Name);
    for(i=0; i<PROGRAM_NAME_LENGTH; i++)
    {
        data_buf[ptr++]=BoardInf.Name[i];
    }

    //检测
    data_buf[ptr++]=BoardInf.Filter1Locate;
    data_buf[ptr++]=BoardInf.Filter2Locate;
    data_buf[ptr++]=BoardInf.DetectMode;
    //振动
    data_buf[ptr++]=BoardInf.ShakeEnable;
    data_buf[ptr++]=BoardInf.ShakeSpeed;
    data_buf[ptr++]=(BoardInf.ShakeTime>>24)&0xff;
    data_buf[ptr++]=(BoardInf.ShakeTime>>16)&0xff;
    data_buf[ptr++]=(BoardInf.ShakeTime>>8)&0xff;
    data_buf[ptr++]=(BoardInf.ShakeTime)&0xff;
    //定性
    data_buf[ptr++]=BoardInf.InterpretPara.Enable;   //允许定性分析
    data_buf[ptr++]=BoardInf.InterpretPara.AbsFlag;  //采用吸光度

    FloatValue.f_val=BoardInf.InterpretPara.fWeakPValue;  //弱阳性
    data_buf[ptr++]=FloatValue.c_val[0];
    data_buf[ptr++]=FloatValue.c_val[1];
    data_buf[ptr++]=FloatValue.c_val[2];
    data_buf[ptr++]=FloatValue.c_val[3];

    data_buf[ptr++]=BoardInf.InterpretPara.GreatFlag;
    for(i=0; i<3; i++)
    {
        FloatValue.f_val=BoardInf.InterpretPara.fCoef[i];
        data_buf[ptr++]=FloatValue.c_val[0];
        data_buf[ptr++]=FloatValue.c_val[1];
        data_buf[ptr++]=FloatValue.c_val[2];
        data_buf[ptr++]=FloatValue.c_val[3];


    }
#ifdef SOFTWARE_DN
    data_buf[ptr++]=BoardInf.InterpretPara.Mode;
    for(i=0; i<3; i++)
    {
        FloatValue.f_val=BoardInf.InterpretPara.fCoef_DN[i];
        data_buf[ptr++]=FloatValue.c_val[0];
        data_buf[ptr++]=FloatValue.c_val[1];
        data_buf[ptr++]=FloatValue.c_val[2];
        data_buf[ptr++]=FloatValue.c_val[3];


    }
#endif
    //板布局
    for(i=0; i<TUBE_MAX; i++)
    {
        data_buf[ptr++]=BoardInf.Layout.WellType[i];
        data_buf[ptr++]= BoardInf.Layout.Num[i];
    }
    //动力学
    data_buf[ptr++]=BoardInf.KineticPara.Enable;
    data_buf[ptr++]=BoardInf.KineticPara.PreProcess;
    data_buf[ptr++]=BoardInf.KineticPara.Curve;
    data_buf[ptr++]=BoardInf.KineticPara.Readings;

    data_buf[ptr++]=(BoardInf.KineticPara.TimeInterval>>24)&0xff;//32bit
    data_buf[ptr++]=(BoardInf.KineticPara.TimeInterval>>16)&0xff;
    data_buf[ptr++]=(BoardInf.KineticPara.TimeInterval>>8)&0xff;
    data_buf[ptr++]=(BoardInf.KineticPara.TimeInterval)&0xff;
//Para.
    data_buf[ptr++]=BoardInf.KineticPara.kinetic_analysis_mode;
    data_buf[ptr++]=BoardInf.KineticPara.BaseLinePoint;
    data_buf[ptr++]=BoardInf.KineticPara.BaseLineSel;
    data_buf[ptr++]=BoardInf.KineticPara.EndReadings;
    data_buf[ptr++]=BoardInf.KineticPara.FirstReadings;

    FloatValue.f_val=BoardInf.KineticPara.Change;
    // FloatConvertChar(BoardInf.KineticPara.Change,x);
    data_buf[ptr++]=FloatValue.c_val[0];
    data_buf[ptr++]=FloatValue.c_val[1];
    data_buf[ptr++]=FloatValue.c_val[2];
    data_buf[ptr++]=FloatValue.c_val[3];

    //质控
    data_buf[ptr++]=BoardInf.QualityPara.Enable; //??????
    data_buf[ptr++]=BoardInf.QualityPara.AbsFlag; //?????,0????,1?????

    for(i=0; i<2; i++)
    {
        for(j=0; j<QC_MAX; j++)
        {
            FloatValue.f_val=BoardInf.QualityPara.dTarget[i][j];
            data_buf[ptr++]=FloatValue.c_val[0];
            data_buf[ptr++]=FloatValue.c_val[1];
            data_buf[ptr++]=FloatValue.c_val[2];
            data_buf[ptr++]=FloatValue.c_val[3];

            FloatValue.f_val=BoardInf.QualityPara.dSD[i][j];
            data_buf[ptr++]=FloatValue.c_val[0];
            data_buf[ptr++]=FloatValue.c_val[1];
            data_buf[ptr++]=FloatValue.c_val[2];
            data_buf[ptr++]=FloatValue.c_val[3];


            FloatValue.f_val=BoardInf.QualityPara.dCV[i][j];
            data_buf[ptr++]=FloatValue.c_val[0];
            data_buf[ptr++]=FloatValue.c_val[1];
            data_buf[ptr++]=FloatValue.c_val[2];
            data_buf[ptr++]=FloatValue.c_val[3];

            FloatValue.f_val=BoardInf.QualityPara.dUpperLimit[i][j];
            data_buf[ptr++]=FloatValue.c_val[0];
            data_buf[ptr++]=FloatValue.c_val[1];
            data_buf[ptr++]=FloatValue.c_val[2];
            data_buf[ptr++]=FloatValue.c_val[3];

            FloatValue.f_val=BoardInf.QualityPara.dLowerLimit[i][j];
            data_buf[ptr++]=FloatValue.c_val[0];
            data_buf[ptr++]=FloatValue.c_val[1];
            data_buf[ptr++]=FloatValue.c_val[2];
            data_buf[ptr++]=FloatValue.c_val[3];
        }
    }
    data_buf[ptr++]='E';
    return(ptr);
}



//保存程序文件 写3个结构体表，并且更新EEP 程序文件表
u8 SaveProgram(void)
{

//    FRESULT fr;          /* FatFs function common result code */
    UINT bw;         /* File read/write count */
    u8 falg_err;
    FRESULT result;
    int fsize;
    //FATFS fs;
    DIR DirInf;
//	FILINFO FileInf_Usb,FileInf_Spi;
//	uint32_t cnt = 0;
//	char lfname[256];
    //char path_spi[32];//?path_usb[32];


// CurrProgramName.DateTime.Year= SystemTimePra.Year;
//	CurrProgramName.DateTime.Month= SystemTimePra.Month;
//	CurrProgramName.DateTime.Day= SystemTimePra.Day;
//	CurrProgramName.DateTime.Hour= SystemTimePra.Hour;
//	CurrProgramName.DateTime.Min= SystemTimePra.Min;
//	CurrProgramName.DateTime.Sec= SystemTimePra.Sec;
//	if(flag_new_file)                                   //FMC160922 老文件不改
    //   CurrProgramName.ShortCutFlag= SHORTCUT_OPEN;  //FMC160922
//	CurrProgramName.LockFlag= LOCK_OPEN;//FMC160827
    //************************************将3个结构体生成新文件 CurrProgramName.Name
    fsize=GenerateNewFile();

    if(f_mount(&fs_spi, FS_VOLUME_SPI1, 0)!= FR_OK)
    {
        falg_err=4;
        goto err;
    }
    //打开spi根文件夹
    strcpy(path, FS_VOLUME_SPI1);
    result = f_opendir(&DirInf, path);
    if (result != FR_OK)
    {
        falg_err=4;
        goto err;
    }
    strcpy(path, FS_VOLUME_SPI1);
    strcat(path,BoardInf.Name);
    strcat(path,".erf");//fmc160914
    result = f_open(&file_spi, path, FA_CREATE_ALWAYS | FA_WRITE);
    if (result != FR_OK)
    {
        falg_err=4;
        goto err;
    }
    //文件到SPI
    result = f_write(&file_spi, data_buf, fsize, &bw);
    if (result != FR_OK)
    {
        f_close(&file_spi);
        falg_err=4;
        goto err;
    }	   //文件写入失败
    //	f_close(&file_spi);//FS_LOCK 能够控制同时打开文件的个数 3
    //  f_mount(NULL,FS_VOLUME_SPI, 0);

    //if(Write_eep_progrm())
    //	   return 1;
    falg_err=0;
    f_close(&file_spi);
err:
    //f_close(&file_spi);//FS_LOCK 能够控制同时打开文件的个数 3
    f_mount(NULL,FS_VOLUME_SPI, 0);
    return falg_err;
}
//****************************
//删除,CurrProgramName.Name文件  输出0成功
u8 DeleteOneFile(char name[])
{
    /* 本函数使用的局部变量占用较多，请修改启动文件，保证堆栈空间够用 */
    FRESULT result;
//	FATFS fs;
//	char FileName[13];
//	uint8_t i;
    //char path[32];

    /* 挂载文件系统 */
    result = f_mount(&fs, FS_VOLUME_SPI, 0);			/* Mount a logical drive */
    if (result != FR_OK)
        return 1;

    //删除文件

    //sprintf(path, "%s/%s ", FS_VOLUME_SPI1,name);
    sprintf(path, "%s/%s%s ", FS_VOLUME_SPI,name,".erf");
    result = f_unlink(path);
    f_mount(NULL,FS_VOLUME_SPI, 0);	/* 卸载文件系统 */
    if (result != FR_OK&&result != FR_NO_FILE)
        return 5;
//	if(del_eep_progrm())//删除EEP表
//	   return 6;
    return 0;
}


//读取所有程序头文件
unsigned char UsbReadAllProgramHead(void)
{
    UINT  bw;         // File read/write count
    u8 falg_err;
    FRESULT result;
    int i,k;

    DIR DirInf;
    FILINFO FileInf;
    unsigned short cnt = 0;
    unsigned short ptr;

    //char lfname[256];
// char path[32];


    //gSystem.UsbProgramMax=0;
    falg_err=0;

    if (f_mount(&fs, FS_VOLUME_USB, 0) != FR_OK)   // Mount a logical drive
    {
        falg_err=1;
        goto err;
    }
    sprintf(path, "%s/", FS_VOLUME_USB);           //打开根目录
    if (f_opendir(&DirInf, path) != FR_OK)
    {
        falg_err=2;
        goto err;
    }

    //*************************打开子目录
    strcat(path,DIR_USB_PROGRAM_INPUT);  //Items目录下
    if ( f_opendir(&DirInf, path)!= FR_OK)
    {
        falg_err=2;
        goto err;
    }


    FileInf.lfname = lfname;
    FileInf.lfsize = 256;
//    nb=0;


    gSystem.UsbProgramMax=0;
    for (cnt = 0; ; cnt++)
    {
        //清空文件名
        for(i=0; i<PROGRAM_NAME_LENGTH; i++)
        {
            FileInf.fname[i]=0;
        }
        //文件满，正常返回
        if(gSystem.UsbProgramMax>=PROGRAM_MAX)
        {
            return 0;
        }
        //读取根目录下的文件
        result = f_readdir(&DirInf,&FileInf); 		//读取目录项，索引自动下移
        if (result != FR_OK || FileInf.fname[0] == 0)
        {
            //falg_err=3;
            break;//没有文件了，退出
        }
        if (FileInf.fname[0] == '.')
            continue;

        //判断是文件还是目录
        if (FileInf.fattrib & AM_DIR)
        {
            continue;  //目录
        }
        //查找扩展名是否为erf
        for(i=0; i<PROGRAM_NAME_LENGTH; i++)
        {
            if(FileInf.fname[i]=='.')
                break;
        }
        if(FileInf.fname[i+1]!='e'||FileInf.fname[i+2]!='r'||FileInf.fname[i+3]!='f')
        {
            if(FileInf.fname[i+1]!='E'||FileInf.fname[i+2]!='R'||FileInf.fname[i+3]!='F')
            {
                continue;  //不是程序文件
            }
        }

        //打开文件
        strcpy(path, FS_VOLUME_USB1);
        strcat(path,DIR_USB_PROGRAM_INPUT);  //Items目录下
        strcat(path,"/");
        strcat(path,FileInf.fname);
        if (f_open(&file,path, FA_OPEN_EXISTING | FA_READ) !=  FR_OK)
        {
            f_close(&file);/////
            falg_err=4;
            goto err;
        }

        //读取文件
        result = f_read(&file, data_buf,file.fsize , &bw);//file.fsize FILE_HEAD_LENCH
        if (bw > 0)//bw为读取的字节数
        {
            data_buf[bw] = 0;
        }

        f_close(&file);/////////////
        if(data_buf[0]!='S')
        {
            f_close(&file);
            falg_err=5;
            goto err;
        }
        //程序名
        ptr=1;

        //程序名
        k=data_buf[ptr++];
        if( (k>PROGRAM_NAME_LENGTH)||(k<1) )
        {
            f_close(&file);
            falg_err=5;
            goto err;
        }
        for(i=0; i<k; i++)
        {
            UsbProgramName[gSystem.UsbProgramMax].Name[i]=data_buf[ptr++];
        }
        UsbProgramName[gSystem.UsbProgramMax].Name[k]=0;//最后为0表示字符串
        //是否带数据标志
        UsbProgramName[gSystem.UsbProgramMax].HasData=data_buf[ptr++];
        //日期时间值
        UsbProgramName[gSystem.UsbProgramMax].DateTime.Year=data_buf[ptr++];
        UsbProgramName[gSystem.UsbProgramMax].DateTime.Year=ProgramName[gSystem.UsbProgramMax].DateTime.Year<<8;
        UsbProgramName[gSystem.UsbProgramMax].DateTime.Year+=data_buf[ptr++];
        UsbProgramName[gSystem.UsbProgramMax].DateTime.Month=data_buf[ptr++];
        UsbProgramName[gSystem.UsbProgramMax].DateTime.Day=data_buf[ptr++];
        UsbProgramName[gSystem.UsbProgramMax].DateTime.Hour=data_buf[ptr++];
        UsbProgramName[gSystem.UsbProgramMax].DateTime.Min=data_buf[ptr++];
        UsbProgramName[gSystem.UsbProgramMax].DateTime.Sec=data_buf[ptr++];

        //ProgramName[gSystem.UsbProgramMax].BlockAddr=data_buf[ptr++];
        //ProgramName[gSystem.UsbProgramMax].BlockAddr=ProgramName[gSystem.UsbProgramMax].BlockAddr<<8;
        //	ProgramName[gSystem.UsbProgramMax].BlockAddr+=data_buf[ptr++];

        ///if( (ProgramName[gSystem.UsbProgramMax].BlockAddr>FILE_NAND_BLOCK_END)||(ProgramName[gSystem.UsbProgramMax].BlockAddr<1) )
        //{
        //continue;
        //	}
        //if(findflag==0)
        //{
        //if(strcmp(ProgramName[gSystem.UsbProgramMax].Name,"Demo_1")==0)//0表示相同
        // {
        //  gSystem.CurrBlock=ProgramName[gSystem.UsbProgramMax].BlockAddr;
        //  findflag=1;
        // }
        //}
        gSystem.UsbProgramMax++;
        if(gSystem.UsbProgramMax>=PROGRAM_MAX)
        {
            gSystem.UsbProgramMax=PROGRAM_MAX;
            break;
        }







        /*
        for(i=0;i<PROGRAM_NAME_LENGTH;i++)
        {
        	ProgramName[gSystem.UsbProgramMax].Name[i]=data_buf[ptr++];
        }
        //是否带数据标志
        ProgramName[gSystem.UsbProgramMax].HasData=data_buf[ptr++];
        //日期时间值
        ProgramName[gSystem.UsbProgramMax].DateTime.Year=data_buf[ptr++];
        ProgramName[gSystem.UsbProgramMax].DateTime.Month=data_buf[ptr++];
        ProgramName[gSystem.UsbProgramMax].DateTime.Day=data_buf[ptr++];
        ProgramName[gSystem.UsbProgramMax].DateTime.Hour=data_buf[ptr++];
        ProgramName[gSystem.UsbProgramMax].DateTime.Min=data_buf[ptr++];
        ProgramName[gSystem.UsbProgramMax].DateTime.Sec=data_buf[ptr++];
        gSystem.UsbProgramMax++;*/
    }
    //f_close(&file);
    falg_err=0;//正常返回
    //return 0;

err:

    f_mount(NULL,FS_VOLUME_SPI, 0);
    return falg_err;

}





