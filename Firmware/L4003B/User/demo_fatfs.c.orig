    		 Prompt_select(PROMPT_UPDATA_DISCONNECT);
    	  {
    	  	falg_err=11;
    		  goto err;
    	  }
    	 }

    		cent=i*100/page;
    	 if(cent!=0&&cent!=100)
          refresh_PROGBAR(cent);
        GUI_Delay(10);

      }
    	  for(k=0;k<2;k++) //发三次
    		{
    			flag_update_one_ok=0;
    			UART6_Send(CMD_UPDATE_END,0);
