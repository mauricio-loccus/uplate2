    	  {
    	  	falg_err=4;
    		  goto err;
    	  }
    		if(i==page)
    		{
    			for(k=excess;k<512;k++)
    			 data_buf[k]=0xff;
    		}
    	//	Usb_check();
    		if(flag_usb_disk_connect==0)//fmc160928
    		{
    			falg_err=4;
    		  goto err;
    		}
        //发送和接收 SEND_PAGE
    		UART_Send_Buf[5]=i>>8;
    	  UART_Send_Buf[6]=i;
    		//address=page_cent*512;
    		for(m=0;m<512;m++)
    			      UART_Send_Buf[7+m]=data_buf[m];
        for(k=0;k<3;k++) //发三次
    		{
    			flag_update_one_ok=0;
    			UART6_Send(CMD_UPDATE_SEND,0);
