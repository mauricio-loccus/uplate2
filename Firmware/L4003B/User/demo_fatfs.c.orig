//********************************************
//将USB中上位机升级程序转存到SPI中
    u8 Read_write_bin_File(void)
    {
        //#define  SPI_PROGRAM_ADDRESS        13*1024*1024//14 15M存程序
        //#define  PROGRAM_PARAMETES_ADDRESS  15*1024*1024//最后16M存数据
        //#define  SPI_PAGE  4096

        //uint8_t  data_buf[SPI_PAGE];
        FRESULT result;
        DIR DirInf;
        uint32_t bw,i,page,excess,address;
        char falg_err;
        char err=0;
        union data {
            uint8_t size_char[4];
            uint32_t size_long;
        };
        union data program_size;
        uint32_t nb,cent;

        bsp_InitSFlash();
        if(find_update_file_name(0))
        {
            falg_err=1;
            goto err;
        }
        for(i=0; i<32; i++)
            path[i]=0;

        falg_err=0;
        /* 挂载文件系统 */
        result = f_mount(&fs, FS_VOLUME_USB, 0);			/* Mount a logical drive */
        if (result != FR_OK)
        {
            falg_err=1;
            goto err;
        }
        /* 打开根文件夹 */
        sprintf(path, "%s/", FS_VOLUME_USB);
        result = f_opendir(&DirInf, path); 	/* 1: 表示盘符 */
        if (result != FR_OK)
        {
            falg_err=1;
            goto err;
        }
        //*************************打开子目录
        strcat(path,DIR_USB_PROGRAM_UPDATE);  //update目录下
        if ( f_opendir(&DirInf, path)!= FR_OK)
        {
            falg_err=2;
            goto err;
        }

        //strcpy(path, FS_VOLUME_USB);
        //strcat(path,DIR_USB_PROGRAM_UPDATE);  //update目录下
        strcat(path,"/");
        strcat(path,update_file_name);
        result = f_open(&file, path, FA_OPEN_EXISTING | FA_READ);
        if (result !=  FR_OK)
        {
            falg_err=3;
            goto err;
        }

        cent=0;
        // 读取文件
        page=file.fsize/SPI_PAGE;
        excess=file.fsize%SPI_PAGE;

        nb=page;
        address=SPI_PROGRAM_ADDRESS;
        for(i=0; i<page; i++)
        {
            result = f_read(&file, data_buf,SPI_PAGE , &bw);//从USB读数据
            if (result != FR_OK)
            {
                falg_err=4;
                goto err;
            }
            if(flag_usb_disk_connect==0)
            {
                falg_err=5;
                goto err;
            }
            if(sf_WriteBuffer( data_buf,address, SPI_PAGE)==0)//向SPIFLASH写数据
            {
                falg_err=6;
                goto err;
            }
            address=address+SPI_PAGE;

            cent=i*100/page;
            refresh_PROGBAR(cent);
        }
        result = f_read(&file, data_buf,excess, &bw);//剩余小于4K数据
        if (result != FR_OK)
        {
            falg_err=7;
            goto err;
        }


        data_buf[excess]=0xff;//最后一字节清0xFF
        Usb_check();
        GUI_Delay(100);
        if(flag_usb_disk_connect==0)
        {
            falg_err=8;
            goto err;
        }
        if(sf_WriteBuffer( data_buf,address, excess)==0) //向SPIFLASH写尾
        {
            falg_err=9;
            goto err;
        }


        //写6字节参数
        program_size.size_long=file.fsize;
        data_buf[0]=0XAA;
        for(i=0; i<4; i++)
            data_buf[i+1]=program_size.size_char[i];
        data_buf[5]=0XAA;

        address=PROGRAM_PARAMETES_ADDRESS;
        if(sf_WriteBuffer( data_buf,address, 16)==0)
        {
            falg_err=10;
            goto err;
        }
        refresh_PROGBAR(100);


        falg_err=0;
err:
        flag_update_busy=0;
        f_close(&file);           //FS_LOCK 能够控制同时打开文件的个数 3
        f_mount(NULL,FS_VOLUME_SPI, 0);
        return falg_err;
    }



    /*
    *********************************************************************************************************
    *	函 数 名: DemoFatFS
    *	功能说明: FatFS文件系统演示主程序
    *	形    参：无
    *	返 回 值: 无
    *********************************************************************************************************
    */

//***********
    void DemoFatFS(void)
    {
        uint8_t cmd;
        uint8_t ucVolume = 0;

        /* Init Host Library */
#ifdef USE_USB_OTG_FS
        USBH_Init(&USB_OTG_Core,
                  USB_OTG_FS_CORE_ID,
                  &USB_Host,
                  &USBH_MSC_cb,
                  &USRH_cb);
#else
        USBH_Init(&USB_OTG_Core,
                  USB_OTG_HS_CORE_ID,
                  &USB_Host,
                  &USBH_MSC_cb,
                  &USRH_cb);
#endif
        USB_POWER_GPIO_Config();
        /* 打印命令列表，用户可以通过串口操作指令 */
        DispMenu();
        while (1)
        {
            //bsp_Idle();		/* 这个函数在bsp.c文件。用户可以修改这个函数实现CPU休眠和喂狗 */

            USBH_Process(&USB_OTG_Core, &USB_Host);

            //if (comGetChar(COM7, &cmd))	/* 从串口读入一个字符(非阻塞方式) */
            {
                printf("\r\n");
                switch (cmd)
                {
                case '0':
                    return;
                case '1':
                    //	printf("【1 - 显示SD卡根目录文件】\r\n");
                    //ViewRootDir(FS_VOLUME_SD);			/* 显示SD卡根目录下的文件名 */
                    //printf("【1 - 显示NAND Flash根目录文件】\r\n");
                    //ViewRootDir(FS_VOLUME_NAND);		/* 显示U盘根目录下的文件名 */
                    //printf("【1 - 显示U盘根目录文件】\r\n");
                    //ViewRootDir(FS_VOLUME_USB);		/* 显示U盘根目录下的文件名 */
                    //		printf("【1 - 显示SPI根目录文件】\r\n");
                    //		ViewRootDir(FS_VOLUME_SPI	);		/* 显示U盘根目录下的文件名 */
                    break;

                case '2':
                    //	printf("【2 - CreateNewFile】SD卡\r\n");
                    CreateNewFile(FS_VOLUME_SD);	/* 创建一个新文件,写入一个字符串 */
                    //	printf("【2 - CreateNewFile】NAND\r\n");
                    //		CreateNewFile(FS_VOLUME_NAND);	/* 创建一个新文件,写入一个字符串 */
                    //printf("【2 - CreateNewFile】U盘写1K字节\r\n");
                    CreateNewFile_1k(FS_VOLUME_USB);//写1K字节到U盘
                    //	printf("【2 - CreateNewFile】SPI\r\n");
                    //	  CreateNewFile(FS_VOLUME_SPI);//
                    break;

                case '3':
                    //	printf("【3 - ReadFileData】\r\n");
                    ReadFileData(FS_VOLUME_SD);		/* 读取根目录下armfly.txt的内容 */
                    //	ReadFileData(FS_VOLUME_NAND);		/* 读取根目录下armfly.txt的内容 */
                    ReadFileData(FS_VOLUME_USB);		/* 读取根目录下armfly.txt的内容 */
                    ReadFileData(FS_VOLUME_SPI);
                    break;

                case '4':
                    //	printf("【4 - CreateDir】\r\n");
                    CreateDir(FS_VOLUME_SD);		/* 创建目录 */
                    //CreateDir(FS_VOLUME_NAND);		/* 创建目录 */
                    CreateDir(FS_VOLUME_USB);		/* 创建目录 */
                    break;

                case '5':
                    //	printf("【5 - DeleteDirFile】\r\n");
                    DeleteDirFile(FS_VOLUME_SD);	/* 删除目录和文件 */
                    //DeleteDirFile(FS_VOLUME_NAND);	/* 删除目录和文件 */
                    DeleteDirFile(FS_VOLUME_USB);	/* 删除目录和文件 */
                    break;

                case '6':
                    //printf("【6 - TestSpeed】\r\n");
                    WriteFileTest();	/* 速度测试 */
                    break;

                case '7':
                    //printf("【1 - SPI格式化】\r\n");
                    //  FileFormat_spi();//fmc

                    //	printf("Start Format(Low Level) NAND Flash......\r\n");
                    //	NAND_Format();
                    //	printf("NAND Flash Format Ok\r\n");
                    break;

                case 'V':		/* 切换当前盘符 */
                case 'v':
                    if (ucVolume == FS_SD)
                    {
                        ucVolume = FS_NAND;
                    }
                    else if (ucVolume == FS_NAND)
                    {
                        ucVolume = FS_USB;
                    }
                    else
                    {
                        ucVolume = FS_SD;
                    }
                    break;

                default:
                    DispMenu();
                    break;
                }
            }	/* comGetChar(COM1, &cmd) */
        }
    }

