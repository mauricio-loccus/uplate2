unsigned char UsbInputFileData(void)
{
    unsigned short ptr=0;
    unsigned char i,j,page_num;



    //板名
    if(data_buf[ptr++]!='S')//以S开头
    {
        //	gSystem.SystemErrCode|=ERRCODE_NAND_FLASH;
        return RETURN_FALSE;
    }

    j=data_buf[ptr++];
    if( (j>PROGRAM_NAME_LENGTH)||(j<1) )
    {
        return RETURN_FALSE;
    }
    for(i=0; i<j; i++)
    {
        BoardInf.Name[i]=data_buf[ptr++];

    }
    BoardInf.Name[j]=0;
    //len=data_buf[ptr++];
    //for(i=0;i<PROGRAM_NAME_LENGTH;i++)
    //{
    //   BoardInf.Name[i]=data_buf[ptr++];
    //}
    //是否带数据
    BoardInf.bHasData=data_buf[ptr++]-CHAR_ADD;

    BoardInf.DateTime.Year=(data_buf[ptr++]-CHAR_ADD)*(short)1000;
    BoardInf.DateTime.Year+=(data_buf[ptr++]-CHAR_ADD)*(short)100;
    BoardInf.DateTime.Year+=(data_buf[ptr++]-CHAR_ADD)*(short)10;
    BoardInf.DateTime.Year+=(data_buf[ptr++]-CHAR_ADD);

    BoardInf.DateTime.Month=(data_buf[ptr++]-CHAR_ADD)*(short)10;
    BoardInf.DateTime.Month+=(data_buf[ptr++]-CHAR_ADD);
    BoardInf.DateTime.Day=(data_buf[ptr++]-CHAR_ADD)*(short)10;
    BoardInf.DateTime.Day=(data_buf[ptr++]-CHAR_ADD);
    BoardInf.DateTime.Hour=(data_buf[ptr++]-CHAR_ADD)*(short)10;
    BoardInf.DateTime.Hour=(data_buf[ptr++]-CHAR_ADD);
    BoardInf.DateTime.Min=(data_buf[ptr++]-CHAR_ADD)*(short)10;
    BoardInf.DateTime.Min=(data_buf[ptr++]-CHAR_ADD);
    BoardInf.DateTime.Sec=(data_buf[ptr++]-CHAR_ADD)*(short)10;
    BoardInf.DateTime.Sec=(data_buf[ptr++]-CHAR_ADD);


    CurrProgramName.BlockAddr=(data_buf[ptr++]-CHAR_ADD)*(short)1000;
    CurrProgramName.BlockAddr+=(data_buf[ptr++]-CHAR_ADD)*(short)100;
    CurrProgramName.BlockAddr+=(data_buf[ptr++]-CHAR_ADD)*(short)10;
    CurrProgramName.BlockAddr+=(data_buf[ptr++]-CHAR_ADD);

    //if(gSystem.CurrBlock!=CurrProgramName.BlockAddr)
    //{
    // return NAND_FAIL;
    //}
    //;//////////////////lgj171116 debug

    //检测
    BoardInf.Filter1Locate=data_buf[ptr++]-CHAR_ADD;
    if(BoardInf.Filter1Locate>=FILTER_MAX)
    {
        BoardInf.Filter1Locate=FILTER_NO;
    }
    BoardInf.Filter2Locate=data_buf[ptr++]-CHAR_ADD;
    if(BoardInf.Filter2Locate>=FILTER_MAX)
    {
        BoardInf.Filter2Locate=FILTER_NO;
    }
    BoardInf.DetectMode=data_buf[ptr++]-CHAR_ADD;

    //振动
    BoardInf.ShakeEnable=data_buf[ptr++]-CHAR_ADD;
    BoardInf.ShakeSpeed=data_buf[ptr++]-CHAR_ADD;

    BoardInf.ShakeTime=(data_buf[ptr++]-CHAR_ADD)*(int)100000;
    BoardInf.ShakeTime+=(data_buf[ptr++]-CHAR_ADD)*(int)10000;
    BoardInf.ShakeTime+=(data_buf[ptr++]-CHAR_ADD)*(int)1000;
    BoardInf.ShakeTime+=(data_buf[ptr++]-CHAR_ADD)*(int)100;
    BoardInf.ShakeTime+=(data_buf[ptr++]-CHAR_ADD)*(int)10;
    BoardInf.ShakeTime+=(data_buf[ptr++]-CHAR_ADD);
    if(BoardInf.ShakeTime>SHAKE_TIME_MAX)
    {
        BoardInf.ShakeTime=SHAKE_TIME_MAX;
    }
    else  if(BoardInf.ShakeTime<SHAKE_TIME_MIN)
    {
        BoardInf.ShakeTime=SHAKE_TIME_MIN;
    }

    BoardInf.ShakeMode=data_buf[ptr++]-CHAR_ADD;
    //定性
    BoardInf.InterpretPara.Enable=data_buf[ptr++]-CHAR_ADD;   //允许定性分析
    BoardInf.InterpretPara.AbsFlag=data_buf[ptr++]-CHAR_ADD;  //采用吸光度

    //BoardInf.InterpretPara.fWeakPValue=data_buf[ptr++];  //弱阳性
    FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
    FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
    FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
    FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
    FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
    FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
    FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
    FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
    BoardInf.InterpretPara.fWeakPValue=FloatValue.f_val;
    if(BoardInf.InterpretPara.fWeakPValue > WEAK_P_MAX)
    {
        BoardInf.InterpretPara.fWeakPValue= WEAK_P_MAX;
    }
    else if(BoardInf.InterpretPara.fWeakPValue < WEAK_P_MIN)
    {
        BoardInf.InterpretPara.fWeakPValue= WEAK_P_MIN;
    }
    BoardInf.InterpretPara.GreatFlag=data_buf[ptr++]-CHAR_ADD;
    for(i=0; i<3; i++)
    {
        FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
        BoardInf.InterpretPara.fCoef[i]=FloatValue.f_val;
        if(BoardInf.InterpretPara.fCoef[i] > INTERPRET_COEF_MAX)
        {
            BoardInf.InterpretPara.fCoef[i] = INTERPRET_COEF_MAX;
        }
        else if(BoardInf.InterpretPara.fCoef[i] < 0)
        {
            BoardInf.InterpretPara.fCoef[i]=0;
        }


    }
#ifdef SOFTWARE_DN
    BoardInf.InterpretPara.Mode=data_buf[ptr++]-CHAR_ADD;
    if( (BoardInf.InterpretPara.Mode!=SHAKE_FIRST)&&(BoardInf.InterpretPara.Mode!=SHAKE_EACH) )
    {
        BoardInf.InterpretPara.Mode=SHAKE_FIRST;
    }
    for(i=0; i<3; i++)
    {
        FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
        BoardInf.InterpretPara.fCoef_DN[i]=FloatValue.f_val;
        if(BoardInf.InterpretPara.fCoef_DN[i] > INTERPRET_COEF_MAX)
        {
            BoardInf.InterpretPara.fCoef_DN[i] = INTERPRET_COEF_MAX;
        }
        else if(BoardInf.InterpretPara.fCoef_DN[i] < 0)
        {
            BoardInf.InterpretPara.fCoef_DN[i]=0;
        }
    }
#endif
    //板布局
    for(i=0; i<TUBE_MAX; i++)
    {
        BoardInf.Layout.WellType[i]=data_buf[ptr++]-CHAR_ADD;
        if(BoardInf.Layout.WellType[i]>=WELLS_TYPE_MAX)
        {
            BoardInf.Layout.WellType[i]=WELLS_TYPE_UD;
        }
        BoardInf.Layout.Num[i]=data_buf[ptr++]-CHAR_ADD;
        if( (BoardInf.Layout.WellType[i]==WELLS_TYPE_SD)&&(BoardInf.Layout.Num[i]>SD_MAX-1) )
        {
            BoardInf.Layout.Num[i]=SD_MAX-1;
        }
        else if( (BoardInf.Layout.WellType[i]==WELLS_TYPE_QC)&&(BoardInf.Layout.Num[i]>QC_MAX-1) )
        {
            BoardInf.Layout.Num[i]=QC_MAX-1;
        }
    }
    //动力学
    BoardInf.KineticPara.Enable=data_buf[ptr++]-CHAR_ADD;
    BoardInf.KineticPara.PreProcess=data_buf[ptr++]-CHAR_ADD;
    if ((BoardInf.KineticPara.PreProcess>=PRE_CALCULATE_MAX) || (BoardInf.KineticPara.PreProcess <PRE_CALCULATE_NO ))
    {
        BoardInf.KineticPara.PreProcess =PRE_CALCULATE_NO;
    }
    BoardInf.KineticPara.Curve=data_buf[ptr++]-CHAR_ADD;
    if ((BoardInf.KineticPara.Curve>=CURVE_MAX) && (BoardInf.KineticPara.Curve <CURVE_NO))
    {
        BoardInf.KineticPara.Curve =CURVE_NO;
    }
    BoardInf.KineticPara.Readings=data_buf[ptr++]-CHAR_ADD;
    if(BoardInf.KineticPara.Readings > KINETIC_READINGS_MAX)
    {
        BoardInf.KineticPara.Readings = KINETIC_READINGS_MAX;
    }
    else if(BoardInf.KineticPara.Readings < KINETIC_READINGS_MIN)
    {
        BoardInf.KineticPara.Readings = KINETIC_READINGS_MIN;
    }


    BoardInf.KineticPara.TimeInterval=(data_buf[ptr++]-CHAR_ADD)*(int)100000;
    BoardInf.KineticPara.TimeInterval+=(data_buf[ptr++]-CHAR_ADD)*(int)10000;
    BoardInf.KineticPara.TimeInterval+=(data_buf[ptr++]-CHAR_ADD)*(int)1000;
    BoardInf.KineticPara.TimeInterval+=(data_buf[ptr++]-CHAR_ADD)*(int)100;
    BoardInf.KineticPara.TimeInterval+=(data_buf[ptr++]-CHAR_ADD)*(int)10;
    BoardInf.KineticPara.TimeInterval+=(data_buf[ptr++]-CHAR_ADD);
    //BoardInf.KineticPara.TimeInterval=(((unsigned long)data_buf[ptr+0])<<24)+(((unsigned long)data_buf[ptr+1])<<16)+(((unsigned long)data_buf[ptr+2])<<8)+data_buf[ptr+3];
    if(BoardInf.KineticPara.TimeInterval>KINETIC_INTERFAL_TIME_MAX)
    {
        BoardInf.KineticPara.TimeInterval=KINETIC_INTERFAL_TIME_MAX;
    }

//	ptr=ptr+4;
//Para.
    BoardInf.KineticPara.kinetic_analysis_mode=data_buf[ptr++]-CHAR_ADD;
    //if(BoardInf.KineticPara.kinetic_analysis_mode>KINETIC_ANALYSIS_MAX)
    BoardInf.KineticPara.BaseLinePoint=data_buf[ptr++]-CHAR_ADD;
    BoardInf.KineticPara.BaseLineSel=data_buf[ptr++]-CHAR_ADD;
    BoardInf.KineticPara.EndReadings=data_buf[ptr++]-CHAR_ADD;
    BoardInf.KineticPara.FirstReadings=data_buf[ptr++]-CHAR_ADD;
    ChangeReadingsRun();

    FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
    FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
    FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
    FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
    FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
    FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
    FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
    FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
    BoardInf.KineticPara.Change=FloatValue.f_val;
// CharConvertFloat(&x[0],BoardInf.KineticPara.Change);
    if(BoardInf.KineticPara.Change>CONCENTRATION_MAX)
    {
        BoardInf.KineticPara.Change=CONCENTRATION_MAX;
    }
    else if(BoardInf.KineticPara.Change<0)
    {
        BoardInf.KineticPara.Change=0;
    }

//是否带数据
    // data_buf[ptr++]=BoardInf.bHasData;
    BoardInf.bHasRawData[0]=data_buf[ptr++]-CHAR_ADD;
    BoardInf.bHasRawData[1]=data_buf[ptr++]-CHAR_ADD;

    //浓度参数
    for(i=0; i<CALIBRATOR_CONCENTRATION_MAX; i++)
    {
        FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
        FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
        FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
        BoardInf.dConcentration[i]=FloatValue.f_val;
        //CharConvertFloat(&FloatValue.c_val[0],BoardInf.dConcentration[i]);
        if(BoardInf.dConcentration[i]>CONCENTRATION_MAX)
        {
            BoardInf.dConcentration[i]=CONCENTRATION_MAX;
        }
        else if(BoardInf.dConcentration[i]<0)
        {
            BoardInf.dConcentration[i]=0;
        }

    }
    BoardInf.wcCurrentUnit=data_buf[ptr++]-CHAR_ADD;
    if(BoardInf.wcCurrentUnit>=CALIBRATOR_CONCENTRATION_UNIT_MAX)
    {
        BoardInf.wcCurrentUnit=4;//
    }

    //质控
    BoardInf.QualityPara.Enable=data_buf[ptr++]-CHAR_ADD;
    BoardInf.QualityPara.AbsFlag=data_buf[ptr++]-CHAR_ADD;

    for(i=0; i<2; i++)
    {
        for(j=0; j<QC_MAX; j++)
        {
            FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
            BoardInf.QualityPara.dTarget[i][j]=FloatValue.f_val;
            // CharConvertFloat(&x[0],BoardInf.QualityPara.dTarget[i][j]);

            FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
            BoardInf.QualityPara.dSD[i][j]=FloatValue.f_val;
            // CharConvertFloat(&x[0],BoardInf.QualityPara.dSD[i][j]);

            FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
            BoardInf.QualityPara.dCV[i][j]=FloatValue.f_val;
            //CharConvertFloat(&x[0],BoardInf.QualityPara.dCV[i][j]);

            FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
            BoardInf.QualityPara.dUpperLimit[i][j]=FloatValue.f_val;
            // CharConvertFloat(&x[0],BoardInf.QualityPara.dUpperLimit[i][j]);

            FloatValue.c_val[0]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[0]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[1]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[1]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[2]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[2]+=(data_buf[ptr++]-CHAR_ADD);
            FloatValue.c_val[3]=(data_buf[ptr++]-CHAR_ADD)*10;
            FloatValue.c_val[3]+=(data_buf[ptr++]-CHAR_ADD);
            BoardInf.QualityPara.dLowerLimit[i][j]=FloatValue.f_val;
            //CharConvertFloat(&x[0],BoardInf.QualityPara.dLowerLimit[i][j]);
        }
    }
    //lugj modify start 171207
    BoardInf.bHasData=0;      //是否带数据
    BoardInf.bHasRawData[0]=0;
    BoardInf.bHasRawData[1]=0;
    //lugj modify end 171207

    if(data_buf[ptr++]!='E')
    {
        // gSystem.SystemErrCode|=ERRCODE_NAND_FLASH;
        return RETURN_FALSE;
    }

    return RETURN_TRUE;

}
//导入一个文件  CurrProgramName.Name
unsigned char UsbOpenOneFile(void)//u8 Read_Spi_File(void)
{


    uint32_t bw;
    unsigned char falg_err;
    FRESULT result;
    DIR DirInf;
    //char lfname[256];
// char path_usb[32];

    falg_err=0;
    if(f_mount(&fs_usb, FS_VOLUME_USB, 0)!= FR_OK)
    {
        falg_err=1;
        goto err;
    }

    sprintf(path, "%s/", FS_VOLUME_USB);
    if ( f_opendir(&DirInf, path)!= FR_OK)
    {
        falg_err=2;
        goto err;
    }
    //打开子目录
    strcat(path,DIR_USB_PROGRAM_INPUT);

    if ( f_opendir(&DirInf, path)!= FR_OK)
    {
        falg_err=3;
        goto err;
    }
    //sprintf(path_usb, "%s%s%s", FS_VOLUME_USB1,CurrProgramName.Name,".csv");
    //	FileInf_Usb.lfname = lfname;
    // FileInf_Usb.lfsize = 256;
    //sprintf(path_usb, "%s/", DIR_USB_PROGRAM_INPUT);

    strcat(path,"/");
    strcat(path,CurrProgramName.Name);//
    strcat(path,".erf");
    result = f_open(&file_usb,path, FA_OPEN_EXISTING | FA_READ);
    if (result !=  FR_OK)
    {
        falg_err=4;
        goto err;
    }


    result = f_read(&file_usb, data_buf, file_usb.fsize, &bw);//&data_buf
    if (bw > 0)
    {
        // data_buf[bw] = 0;
    }
    //f_close(&file_usb);
    if(UsbInputFileData()==RETURN_FALSE) //出据出错
    {
        // f_close(&file_usb);
        falg_err=5;
        goto err;
    }

    falg_err=0;

err:
    f_close(&file_usb);
    f_mount(NULL,FS_VOLUME_USB, 0);

    return falg_err;
}
//导入一个标准值文件
unsigned char UsbOpenFile_read_data(void)//导入一个标准值文件
{
    char   charbuf[12];
    u16 wi,ci,ni,i,j,k,temp;
    u8 channel=0;
    uint32_t bw;
    unsigned char falg_err=0;
    FRESULT result;
    DIR DirInf;
    char file_name[20]="Sta.txt";

    if(f_mount(&fs_usb, FS_VOLUME_USB, 0)!= FR_OK)
    {
        falg_err=1;
        goto err;
    }

    sprintf(path, "%s/", FS_VOLUME_USB);
    if ( f_opendir(&DirInf, path)!= FR_OK)
    {
        falg_err=2;
        goto err;
    }
    //打开子目录
    /*
    strcat(path,DIR_USB_PROGRAM_INPUT);
    if ( f_opendir(&DirInf, path)!= FR_OK)
    {
    falg_err=3;
    goto err;
    }
    */
    //strcat(path,"/");
    strcat(path,file_name);//
    result = f_open(&file_usb,path, FA_OPEN_EXISTING | FA_READ);
    if (result !=  FR_OK)
    {
        falg_err=4;
        goto err;
    }


    result = f_read(&file_usb, data_buf, file_usb.fsize, &bw);//&data_buf
    if (bw > 0)
    {

        for(i=0; i<8; i++)
        {
            SystemPrameter.AbsCali[i].dABS_flag=0;
            for(j=0; j<9; j++)
            {
                SystemPrameter.AbsCali[i].dABS[j]=-1;
            }
        }
        ni=0;
        ci=0;
        for(i=0; i<12; i++)
        {
            charbuf[i]='\0';
        }
        for(wi=0; wi<bw-1; wi++)
        {
            if((data_buf[wi]==0xA3)&&(data_buf[wi+1]==0xAC))
            {
                if(ni==0)
                {
                    channel=atoi(charbuf)-1;
                    SystemPrameter.AbsCali[channel].dABS_flag=1;
                }
                else  //ni>0
                {
                    SystemPrameter.AbsCali[channel].dABS[ni-1]= atof(charbuf);
                }
                ni++;
                wi=wi+1;
                ci=0;
                for(i=0; i<12; i++)
                {
                    charbuf[i]='\0';
                }
            }
            else if((data_buf[wi]==0x0D)&&(data_buf[wi+1]==0x0A))//((data_buf[wi]==0x20)&&(data_buf[wi]==0x0d)&&(data_buf[wi]==0x0a))
            {
                SystemPrameter.AbsCali[channel].dABS[ni-1]= atof(charbuf);  //最后一个
                ci=0;
                for(i=0; i<12; i++)
                {
                    charbuf[i]='\0';
                }
                wi=wi+1;
                ni=0;
            }
            else
            {
                charbuf[ci]=data_buf[wi];
                ci++;
            }
        }
    }

    falg_err=0;

err:
    f_close(&file_usb);
    f_mount(NULL,FS_VOLUME_USB, 0);

    return falg_err;
}

//**************************
//根据板内容产生写入USB的板文件存入CsvConvertStr
unsigned char SpiGenerateBoardFile(void)
{
    //int i,j=0,len,back[6],k;
    //int back_f[6];
    //float back_f[6];
    //const char name1[]="bb.txt",start[]="AS154_S",name[]="NAME:",step[]="STEP:",time[]="TIME:",status[]="STATUS:",option[]="OPTION:",end[]="AS154_E";
    unsigned int ptr=0;
    unsigned char i,j,k,page_num;
    //char x[4];
//头行
    //板名

    CsvConvertStr[ptr++]='S';//以S开头
    //uint8_t  data_buf[SPI_PAGE]


    //len=strlen(BoardInf.Name);
    j=strlen(&BoardInf.Name[0]);
