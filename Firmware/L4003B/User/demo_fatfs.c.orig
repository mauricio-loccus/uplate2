    else
    {
        //printf("删除armfly.txt失败(错误代码 = %d) 文件只读或目录非空\r\n", result);
    }

    /* 删除文件 speed1.txt */
    for (i = 0; i < 20; i++)
    {
        sprintf(FileName, "%s/Speed%02d.txt", _ucVolume, i);	/* 每写1次，序号递增 */
        result = f_unlink(FileName);
