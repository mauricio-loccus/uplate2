void USB_POWER_GPIO_Config ( void )//输出口配置
{
    /*定义一个GPIO_InitTypeDef类型的结构体*/
    GPIO_InitTypeDef GPIO_InitStructure;


    // 配置 LED1 引脚
    RCC_AHB1PeriphClockCmd( RCC_AHB1Periph_GPIOH, ENABLE );

    GPIO_InitStructure.GPIO_Mode = GPIO_Mode_OUT;
    GPIO_InitStructure.GPIO_OType = GPIO_OType_PP;
    GPIO_InitStructure.GPIO_PuPd = GPIO_PuPd_UP;
    GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;

    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_0;
    GPIO_Init (GPIOA, & GPIO_InitStructure );	//*/

    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_9;
    GPIO_Init (GPIOA, & GPIO_InitStructure );	//*/
    //GPIO_ResetBits ( GPIOA, GPIO_Pin_0 );  =0
    GPIO_SetBits   ( GPIOA, GPIO_Pin_0 );  //=1
    GPIO_SetBits   ( GPIOA, GPIO_Pin_9 );
    /* 配置 LED2 引脚 */
    /*RCC_AHB1PeriphClockCmd( RCC_AHB1Periph_GPIOH, ENABLE );
    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_11;
    GPIO_Init ( macLED2_GPIO_PORT, & GPIO_InitStructure );	*/
}




















//*************************************
unsigned char ReadFile_background(char *ad,unsigned char picture_flag)
{
    // 本函数使用的局部变量占用较多，请修改启动文件，保证堆栈空间够用
    unsigned char flag_err;
    FRESULT result;

    DIR DirInf;
    uint32_t bw;

    //char path[32];
    char tt[2]= {"3:"};
    char *_ucVolume;
    _ucVolume=tt;

    flag_err=0;
    // 挂载文件系统
    if (f_mount(&fs, _ucVolume, 0) != FR_OK)
    {
        flag_err=1;
        goto err;
        //printf("挂载文件系统失败(%d)\r\n", result);
    }

    // 打开根文件夹
    sprintf(path, "%s/", _ucVolume);
    if (f_opendir(&DirInf, path) != FR_OK)// 1: 表示盘符
    {
        flag_err=2;
        goto err;
        //printf("打开根目录失败(%d)\r\n", result);
        //return;
    }

    // 打开文件
//	if(AdvancePra.OemFlag==OEM_AOSHENG)
    if(picture_flag==BK_LOADING)
    {
        sprintf(path, "%s/Loading.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_HELP)
    {
        sprintf(path, "%s/Loading_Help.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_LOGO)
    {
        sprintf(path, "%s/Loading_Logo.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_FILTER)
    {
        sprintf(path, "%s/Loading_Filter.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_BK)
    {
        sprintf(path, "%s/Loading_BK.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_UD)
    {
        sprintf(path, "%s/Loading_UD.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_EP)
    {
        sprintf(path, "%s/Loading_EP.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_NC)
    {
        sprintf(path, "%s/Loading_NC.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_PC)
    {
        sprintf(path, "%s/Loading_PC.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_SD)
    {
        sprintf(path, "%s/Loading_SD.jpg", _ucVolume);
    }
    else if(picture_flag==BK_LOADING_QC)
    {
        sprintf(path, "%s/Loading_QC.jpg", _ucVolume);
    }
    if (f_open(&file, path, FA_OPEN_EXISTING | FA_READ) !=  FR_OK)
    {

        flag_err=3;
        goto err;
        //	printf("Don't Find File : %s\r\n", path);
        //return;
    }

    // 读取文件
    result = f_read(&file,ad, file.fsize, &bw);
    if (bw > 0)
    {
        //buf[bw] = 0;
        //printf("\r\n%s 文件内容 : \r\n%s\r\n", path,buf);
    }
    else
    {
        f_close(&file);
        flag_err=4;
        goto err;
        //	printf("\r\n %s文件内容 : \r\n", path);
    }
    flag_err=0;
    f_close(&file);
err:
    // 关闭文件


    // 卸载文件系统
    f_mount(NULL,_ucVolume, 0);
    return(flag_err);
}





