    			Prompt_select(PROMPT_UPDATA_DISCONNECT);
    	  	falg_err=11;
    		  goto err;
    		}
    		refresh_PROGBAR(1);
    		GUI_Delay(10);
    		for(i=0;i<3;i++)
    	  {
    		    UART6_Send(CMD_UPDATE_START ,0);
