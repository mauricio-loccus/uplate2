    unsigned char SpiSaveSystemPra(void)
    {
        unsigned char i,j;
        unsigned char ptr=0;

        data_buf[ptr++]='S';
        data_buf[ptr++]=SystemPrameter.SystemLanguage;
        data_buf[ptr++]=SystemPrameter.PrintHeaderEnable;
        data_buf[ptr++]=SystemPrameter.DoorOpen;
        for(i=0; i<PRINT_REPORT_CHAR_MAX; i++)
        {
            data_buf[ptr++]=SystemPrameter.StrPrintHeader[i];
        }
        //滤光片参数
        for(i=0; i<FILTER_MAX; i++)
        {
            j=(i<<1);
            data_buf[j+ptr]=(FilterLun.Filter[i]>>8)&0xff;
            ptr++;
            data_buf[j+ptr]=(FilterLun.Filter[i])&0xff;
            ptr++;
        }
        data_buf[ptr++]='E';

        if(sf_WriteBuffer(data_buf,SPI_SYS_ADDRESS,ptr)==0)//向SPIFLASH写数据 SPI_PAGE
        {
            gSystem.SystemErrCode|=ERRCODE_SPI_FLASH;
            return SPI_ERR;
        }
        else
        {
            gSystem.SystemErrCode&=~ERRCODE_SPI_FLASH;
        }
        return SPI_OK;
    }



    unsigned char SpiReadSystemPra(void)
    {
        unsigned char i,j;
        unsigned char ptr=0;

        sf_ReadBuffer( data_buf,SPI_SYS_ADDRESS, 100);//SPI_PAGE
        //{
        //gSystem.SystemErrCode&=~ERRCODE_E2P;
        if(data_buf[ptr++]!='S')
        {
            gSystem.SystemErrCode|=ERRCODE_SPI_FLASH; //出错
            return SPI_ERR;
        }
        SystemPrameter.SystemLanguage=data_buf[ptr++];
        if( (SystemPrameter.SystemLanguage!=LANGUAGE_CH)&&(SystemPrameter.SystemLanguage!=LANGUAGE_EN) )
        {
            SystemPrameter.SystemLanguage=LANGUAGE_EN;
        }

        SystemPrameter.PrintHeaderEnable=data_buf[ptr++];
        if(SystemPrameter.PrintHeaderEnable>1)
        {
            SystemPrameter.PrintHeaderEnable=1;
        }

        SystemPrameter.DoorOpen=data_buf[ptr++];
        for(i=0; i<PRINT_REPORT_CHAR_MAX; i++)
        {
            SystemPrameter.StrPrintHeader[i]=data_buf[ptr++];
        }
        SystemPrameter.StrPrintHeader[PRINT_REPORT_CHAR_MAX-1]=0;

        //滤光片
        for(i=0; i<FILTER_MAX; i++)
        {
            j=(i<<1);
            FilterLun.Filter[i]=data_buf[j+ptr];
            FilterLun.Filter[i]<<=8;
            ptr=ptr+1;
            FilterLun.Filter[i]+=data_buf[j+ptr];
            ptr=ptr+1;
            //检测波长
            if((FilterLun.Filter[i]>WAVELENGTH_MAX)||(FilterLun.Filter[i]<WAVELENGTH_MIN) )
            {
                FilterLun.Filter[i] = 0;
            }
        }
        if(data_buf[ptr]!='E')
        {
            gSystem.SystemErrCode|=ERRCODE_SPI_FLASH; //出错
            return SPI_ERR;
        }
        else
        {
            gSystem.SystemErrCode&=~ERRCODE_SPI_FLASH;
        }
        return SPI_OK;  //0

    }



    u8 SpiReadAbs(void)
    {
        unsigned short ptr=0;
        unsigned char i,j;

        sf_ReadBuffer( data_buf,SPI_ABS_ADDRESS, SPI_PAGE);
        if(data_buf[ptr++]!='S')
        {
            gSystem.SystemErrCode|=ERRCODE_SPI_FLASH; //出错
            return SPI_ERR;
        }
        SystemPrameter.RawIntensity=data_buf[ptr++]; //原始数据

        SystemPrameter.nOrigin=((int)data_buf[ptr]<<24) + ((int)data_buf[ptr+1]<<16)
                               +((int)data_buf[ptr+2]<<8) +  (int)data_buf[ptr+3];          //原点
        //原点范围
        ptr=ptr+4;
        if(SystemPrameter.nOrigin>START_STEP_MAX_NUM)
        {
            SystemPrameter.nOrigin=START_STEP_MAX_NUM;
        }
        else if(SystemPrameter.nOrigin<START_STEP_MIN_NUM)
        {
            SystemPrameter.nOrigin=START_STEP_MIN_NUM;
        }


        SystemPrameter.AbsCaliEnable=data_buf[ptr++];
        for(j=0; j<ABS_CHANNEL_MAX; j++)
        {
            SystemPrameter.AbsCali[j].Count=data_buf[ptr++];
            SystemPrameter.AbsCali[j].dABS_flag=data_buf[ptr++];
            if(SystemPrameter.AbsCali[j].Count>CALIBRATOR_ABS_MAX)
            {
                SystemPrameter.AbsCali[j].Count=CALIBRATOR_ABS_MAX;
            }
            for(i=0; i<CALIBRATOR_ABS_MAX; i++)
            {
                FloatValue.c_val[0]=data_buf[ptr++];
                FloatValue.c_val[1]=data_buf[ptr++];
                FloatValue.c_val[2]=data_buf[ptr++];
                FloatValue.c_val[3]=data_buf[ptr++];
                SystemPrameter.AbsCali[j].dABS[i]=FloatValue.f_val;
                // CharConvertFloat(&FloatValue.c_val[0],SystemPrameter.AbsCali[j].dABS[i]);
                if(SystemPrameter.AbsCali[j].dABS[i]>ABS_VAL_MAX)
                {
                    SystemPrameter.AbsCali[j].dABS[i]=ABS_VAL_MAX;
                }
                else if(SystemPrameter.AbsCali[j].dABS[i]<ABS_VAL_MIN)
                {
                    SystemPrameter.AbsCali[j].dABS[i]=ABS_VAL_MIN;
                }


                FloatValue.c_val[0]=data_buf[ptr++];
                FloatValue.c_val[1]=data_buf[ptr++];
                FloatValue.c_val[2]=data_buf[ptr++];
                FloatValue.c_val[3]=data_buf[ptr++];
                SystemPrameter.AbsCali[j].dABSPractical[i]=FloatValue.f_val;
                //CharConvertFloat(&FloatValue.c_val[0],SystemPrameter.AbsCali[j].dABSPractical[i]);
                if(SystemPrameter.AbsCali[j].dABSPractical[i]>ABS_VAL_MAX)
                {
                    SystemPrameter.AbsCali[j].dABSPractical[i]=ABS_VAL_MAX;
                }
                else if(SystemPrameter.AbsCali[j].dABSPractical[i]<ABS_VAL_MIN)
                {
                    SystemPrameter.AbsCali[j].dABSPractical[i]=ABS_VAL_MIN;
                }
                FloatValue.c_val[0]=data_buf[ptr++];
                FloatValue.c_val[1]=data_buf[ptr++];
                FloatValue.c_val[2]=data_buf[ptr++];
                FloatValue.c_val[3]=data_buf[ptr++];
                SystemPrameter.AbsCali[j].dABSError[i]=FloatValue.f_val;
                //CharConvertFloat(&FloatValue.c_val[0],SystemPrameter.AbsCali[j].dABSError[i]);
                if(SystemPrameter.AbsCali[j].dABSError[i]>ABS_VAL_MAX)
                {
                    SystemPrameter.AbsCali[j].dABSError[i]=ABS_VAL_MAX;
                }
                else if(SystemPrameter.AbsCali[j].dABSError[i]<ABS_VAL_MIN)
                {
                    SystemPrameter.AbsCali[j].dABSError[i]=ABS_VAL_MIN;
                }
            }
        }
        if(data_buf[ptr++]!='E')
        {
            gSystem.SystemErrCode|=ERRCODE_SPI_FLASH; //ERROR
            return SPI_ERR;
        }
        else
        {
            gSystem.SystemErrCode&=~ERRCODE_SPI_FLASH; //OK
        }
        return SPI_OK;
    }
    u8 SpiSaveAbs(void)
    {
        unsigned short ptr=0;
        unsigned char i,j;

        data_buf[ptr++]='S';

        data_buf[ptr++]=SystemPrameter.RawIntensity; //原始数据
        data_buf[ptr++]=(SystemPrameter.nOrigin>>24)&0xff; //原点
        data_buf[ptr++]=(SystemPrameter.nOrigin>>16)&0xff;
        data_buf[ptr++]=(SystemPrameter.nOrigin>>8)&0xff;
        data_buf[ptr++]=(SystemPrameter.nOrigin)&0xff;

        data_buf[ptr++]=SystemPrameter.AbsCaliEnable;
        for(j=0; j<ABS_CHANNEL_MAX; j++)
        {
            data_buf[ptr++]=SystemPrameter.AbsCali[j].Count;
            data_buf[ptr++]=SystemPrameter.AbsCali[j].dABS_flag;
            for(i=0; i<CALIBRATOR_ABS_MAX; i++)
            {
                FloatValue.f_val=SystemPrameter.AbsCali[j].dABS[i];
                //FloatConvertChar(SystemPrameter.AbsCali[j].dABS[i],x);
                data_buf[ptr++]=FloatValue.c_val[0];
                data_buf[ptr++]=FloatValue.c_val[1];
                data_buf[ptr++]=FloatValue.c_val[2];
                data_buf[ptr++]=FloatValue.c_val[3];

                FloatValue.f_val=SystemPrameter.AbsCali[j].dABSPractical[i];
                //FloatConvertChar(SystemPrameter.AbsCali[j].dABSPractical[i],x);
                data_buf[ptr++]=FloatValue.c_val[0];
                data_buf[ptr++]=FloatValue.c_val[1];
                data_buf[ptr++]=FloatValue.c_val[2];
                data_buf[ptr++]=FloatValue.c_val[3];

                FloatValue.f_val=SystemPrameter.AbsCali[j].dABSError[i];
                //FloatConvertChar(SystemPrameter.AbsCali[j].dABSError[i],x);
                data_buf[ptr++]=FloatValue.c_val[0];
                data_buf[ptr++]=FloatValue.c_val[1];
                data_buf[ptr++]=FloatValue.c_val[2];
                data_buf[ptr++]=FloatValue.c_val[3];
            }
            //memcpy(&(SystemPrameter.AbsCali[SystemPrameter.nChannelCurrent]), &AbsCali, sizeof(ABS_CAL));
            //SystemPrameter.nChannelCurrent = (SystemPrameter.nChannelCurrent + 1) % ABS_CHANNEL_MAX;
        }
        data_buf[ptr++]='E';

        if(sf_WriteBuffer( data_buf,SPI_ABS_ADDRESS, SPI_PAGE)==0)     //写一页数据
        {
            gSystem.SystemErrCode|=ERRCODE_SPI_FLASH;                  //出错
            return SPI_ERR;
        }
        else
        {
            gSystem.SystemErrCode&=~ERRCODE_SPI_FLASH;                 //
        }
        return SPI_OK;
    }


//获得升级程序文件名 0上位机1下位机
    char find_update_file_name(unsigned char cent)
    {
        char *name1="AS112H",*name2="AS112L";
        // UINT bw;
        u8 falg_err,nb,i;
        FRESULT result;
        DIR DirInf;
        FILINFO FileInf_Usb;
        uint32_t cnt = 0;
        // char lfname[256];
        // char path_usb[32];

        falg_err=0;
        //挂载文件
        if(f_mount(&fs_usb, FS_VOLUME_USB, 0)!= FR_OK)
        {
            falg_err=1;  //失败
            goto err;
        }
        //打开主目录
        sprintf(path, "%s/", FS_VOLUME_USB);
        if (f_opendir(&DirInf, path)!= FR_OK)
        {
            falg_err=2;
            goto err;
        }
        //打开子目录
        strcat(path,DIR_USB_PROGRAM_UPDATE);

        if(f_opendir(&DirInf, path)!= FR_OK)
        {
            falg_err=3;  //失败
            goto err;
        }
        //读取当前文件夹下的文件和目录
        FileInf_Usb.lfname = lfname;
        FileInf_Usb.lfsize = 256;
        nb=0;
        for (cnt = 0; ; cnt++)
        {
            result = f_readdir(&DirInf,&FileInf_Usb); 		// 读取目录项，索引会自动下移
            if (result != FR_OK || FileInf_Usb.fname[0] == 0)
            {
                falg_err=4; //0
                break;//没有文件 读完
            }
            if (FileInf_Usb.fname[0] == '.')
                continue;

            //判断是文件还是子目录
            if (FileInf_Usb.fattrib & AM_DIR)
                continue;  //目录
            nb=0;
            if( strncmp(FileInf_Usb.fname,name1,6)==0&&cent==0)
            {
                for(i=0; i<20; i++)
                {
                    update_file_name[i]=FileInf_Usb.fname[i];
                    if(update_file_name[i]=='.')
                        nb=i;
                }
                if(update_file_name[nb+1]=='b'||update_file_name[nb+1]=='B')
                {
                    falg_err=0;
                    goto err;
                    //return 0;
                }
            }
            if( strncmp(FileInf_Usb.fname,name2,6)==0&&cent==1)
            {
                for(i=0; i<20; i++)
                {
                    update_file_name[i]=FileInf_Usb.fname[i];
                    if(update_file_name[i]=='.')
                        nb=i;
                }
                if(update_file_name[nb+1]=='b'||update_file_name[nb+1]=='B')
                {
                    //return 0;
                    falg_err=0;
                    goto err;
                }
            }
        }
        falg_err=5;
err:
        //************************

        // f_close(&file_usb);
        f_mount(NULL,FS_VOLUME_USB, 0);
        return falg_err;
    }


