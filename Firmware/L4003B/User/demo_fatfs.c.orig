    uint8_t i;
    char path[32];

    /* 挂载文件系统 */
    result = f_mount(&fs, _ucVolume, 0);			/* Mount a logical drive */
    if (result != FR_OK)
    {
        //	printf("挂载文件系统失败 (%d)\r\n", result);
    }


    /* 删除目录/Dir1 【因为还存在目录非空（存在子目录)，所以这次删除会失败】*/
    sprintf(path, "%s/Dir1", _ucVolume);
    result = f_unlink(path);
    if (result == FR_OK)
    {
        //printf("删除目录%s成功\r\n", path);
    }
