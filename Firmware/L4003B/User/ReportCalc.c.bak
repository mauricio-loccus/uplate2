//计算正常分析的预处理结果
//NormalAnalysis.dPreCal   NormalAnalysis.dPreCalOk
void Preproccessing(unsigned char wcCycle) //2014-8-12项
{
	int i,j;
	//CString strTemp = CString(BoardInf.KineticPara.PreProcess);
	//if(strTemp == _T("No") || !BoardInf.bHasRawData[1])
	if(BoardInf.Filter2Locate<0  ||  BoardInf.KineticPara.PreProcess ==PRE_CALCULATE_NO)
	{
		return;
	}

	for(i = 0; i < 12; i++)
	{
		for(j = 0; j < 8; j++)
		{
			NormalAnalysis.bPreCalOK[wcCycle][j * 12 + i] = 1;
			if(BoardInf.KineticPara.PreProcess == 0) //"M1-M2
			{
				NormalAnalysis.dPreCal[wcCycle][j * 12 + i] = dABS[wcCycle][0][j * 12 + i] - dABS[wcCycle][1][j * 12 + i];
			}
			else if(BoardInf.KineticPara.PreProcess == 1) //"M1/M2
			{
				if(dABS[wcCycle][1][j * 12 + i] > CONCENTRATION_VALUE_MIN || dABS[wcCycle][1][j * 12 + i] < -CONCENTRATION_VALUE_MIN)
				{
					NormalAnalysis.dPreCal[wcCycle][j * 12 + i] = dABS[wcCycle][0][j * 12 + i] / dABS[wcCycle][1][j * 12 + i];
				}
				else
				{
					NormalAnalysis.bPreCalOK[wcCycle][j * 12 + i] = 0;
				}
			}
			else if(BoardInf.KineticPara.PreProcess == 2) //"M1+M2
			{
				NormalAnalysis.dPreCal[wcCycle][j * 12 + i] = dABS[wcCycle][0][j * 12 + i] + dABS[wcCycle][1][j * 12 + i];
			}
			else if(BoardInf.KineticPara.PreProcess == 3) //"M1*M2
			//else if(strTemp == _T("M1*M2"))
			{
				NormalAnalysis.dPreCal[wcCycle][j * 12 + i] = dABS[wcCycle][0][j * 12 + i] * dABS[wcCycle][1][j * 12 + i];
			}
			//else if(strTemp == _T("M1/M2"))
			else if(BoardInf.KineticPara.PreProcess == 4) //"M2-M1"
			//else if(strTemp == _T("M2-M1"))
			{
				NormalAnalysis.dPreCal[wcCycle][j * 12 + i] = dABS[wcCycle][1][j * 12 + i] - dABS[wcCycle][0][j * 12 + i];
			}
			else if(BoardInf.KineticPara.PreProcess == 5) //"M2/M1"
			//else if(strTemp == _T("M2/M1"))
			{
				if(dABS[wcCycle][0][j * 12 + i] > CONCENTRATION_VALUE_MIN || dABS[wcCycle][0][j * 12 + i] < -CONCENTRATION_VALUE_MIN)
				{
					NormalAnalysis.dPreCal[wcCycle][j * 12 + i] = dABS[wcCycle][1][j * 12 + i] / dABS[wcCycle][0][j * 12 + i];
				}
				else
				{
					NormalAnalysis.bPreCalOK[wcCycle][j * 12 + i] = 0;//false;
				}
			}
		}
	}
}

void GetKineticABS(unsigned char wcCycle)
{
	int i,j;
	
	for(i = 0; i < FILTER_PLATE_MAX; i++) //减去空白样本
	{
		if(BoardInf.bHasRawData[i]==0)
		{
			continue;
		}

		for(j = 0; j < TUBE_MAX; j++)
		{
		    if( BoardInf.Layout.WellType[i] ==WELLS_TYPE_BK)//"SD"
		
			//if(CString(board_inf.layout[j + 1].Type) == _T("BK"))
			{
				dABS[wcCycle][i][j] = 0.0f;
				continue;
			}

			dABS[wcCycle][i][j] = dABSInit[wcCycle][i][j] - NormalAnalysis.dBlank[wcCycle][i];
			if(dABS[wcCycle][i][j] < 0.0f)
			{
				dABS[wcCycle][i][j] = 0.0f;
			}
		}
	}

	if(BoardInf.Filter2Locate>=0  && BoardInf.KineticPara.PreProcess>0)
	//if(CString(board_inf.Filter_2) != _T("No") && board_inf.preCalculate[0] != _T('N'))
	{
		Preproccessing(wcCycle);
	}
}



int DoFactorAnalysis(unsigned char  wcCurrentFilter)
{
	int i,j;
	int nTotal = NormalAnalysis.nCalibratorCountTotal[wcCurrentFilter];
	//float *p_dX = (float *)malloc(sizeof(float) * nTotal);
	//float *p_dY = (float *)malloc(sizeof(float) * nTotal);  
	int nErrorCode = ANALYSIS_SUCCESS;
	unsigned char bHasResult;
	float dTemp;
	int n = 0;
	float dYAverage = 0.0;
	float dXAverage = 0.0;


	if(NormalAnalysis.bLogX) //对数坐标
	{
	//	free(p_dX);
	//	free(p_dY);
		nErrorCode = ANALYSIS_ERROR_DISABLE_LOG_CONCENTRATION;
		return nErrorCode;
	}

	for(i = 0; i < CALIBRATOR_CONCENTRATION_MAX; i++)
	{
		if(NormalAnalysis.nCalibratorCount[wcCurrentFilter][i] > 0)
		{
			   CalcuPara.p_dY[n] = NormalAnalysis.dCalibratorABS[wcCurrentFilter][i];
			   CalcuPara.p_dX[n] = BoardInf.dConcentration[i];

			if(NormalAnalysis.bLogY) //对数坐标
			{
				if(CalcuPara.p_dY[n] <= 0.0f)
				{
					//free(p_dX);
          //free(p_dY);
					nErrorCode = ANALYSIS_ERROR_LOGY_FAIL;
					return nErrorCode;
				}
				else
				{
					CalcuPara.p_dY[n] = log10(CalcuPara.p_dY[n]);
				}
			}
			n++;
		}
	}

	dYAverage = 0.0f;
	dXAverage = 0.0f;
	for(i = 0; i < nTotal; i++)
	{
		dYAverage += CalcuPara.p_dY[i];
		dXAverage += CalcuPara.p_dX[i];
	}

	NormalAnalysis.FactorAnalysis[wcCurrentFilter].dSlope = dYAverage / dXAverage;
	if(NormalAnalysis.FactorAnalysis[wcCurrentFilter].dSlope == 0.0f)
	{
		  //free(p_dX);
      //free(p_dY);
		return ANALYSIS_ERROR_FITTING_FAIL;
	}

	for(i = 0; i < 12; i++) //2014-8-20项
	{
		for(j = 0; j < 8; j++)
		{
			//float dTemp;
			if(wcCurrentFilter < 2)
			{
				dTemp = dABS[0][wcCurrentFilter][j * 12 + i];
			}
			else if(NormalAnalysis.bPreCalOK[0][j * 12 + i])
			{
				dTemp = NormalAnalysis.dPreCal[0][j * 12 + i];
			}
			else
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = -1.0f;
				continue;
			}

			bHasResult =1;// true;

			if(NormalAnalysis.bLogY)
			{
				if(dTemp <= 0.0f)
				{
					bHasResult = 0;//false; 
				}
				else
				{
					dTemp = log10(dTemp);
				}
			}
			dTemp /= NormalAnalysis.FactorAnalysis[wcCurrentFilter].dSlope;

			if(bHasResult==0)
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = -1.0;
			}
			else if(NormalAnalysis.bLogX)
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = pow(10.0, dTemp);
			}
			else if(dTemp < 0.0f)
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = 0.0;
			}
			else
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = dTemp;
			}
		}
	}

//	free(p_dX);
	//free(p_dY);
	return ANALYSIS_SUCCESS;
}


int DoLinearAnalysis(unsigned char  wcCurrentFilter)
{
	
	int i,j;
	int nTotal = NormalAnalysis.nCalibratorCountTotal[wcCurrentFilter];
//	float *p_dX = (float *)malloc(sizeof(float) * nTotal);
	//float *p_dY = (float *)malloc(sizeof(float) * nTotal);  
  
	float dTemp;
 //   int nSeg,k;
	unsigned char bHasResult;
	int nErrorCode = ANALYSIS_SUCCESS;
	int n = 0;

	for(i = 0; i < CALIBRATOR_CONCENTRATION_MAX; i++)
	{
		if(NormalAnalysis.nCalibratorCount[wcCurrentFilter][i] > 0)
		{
			   CalcuPara.p_dY[n] = NormalAnalysis.dCalibratorABS[wcCurrentFilter][i];
			   CalcuPara.p_dX[n] = BoardInf.dConcentration[i];

			if(NormalAnalysis.bLogX) //对数坐标
			{
				if(CalcuPara.p_dX[n] <= 0.0f)
				{
					//free(p_dX);
          //free(p_dY);

					nErrorCode = ANALYSIS_ERROR_LOGX_FAIL;
					return nErrorCode;
				}
				else
				{
					CalcuPara.p_dX[n] = log10(CalcuPara.p_dX[n]);
				}
			}


			if(NormalAnalysis.bLogY) //对数坐标
			{
				if(CalcuPara.p_dY[n] <= 0.0f)
				{
					//free(p_dX);
          //free(p_dY);
					nErrorCode = ANALYSIS_ERROR_LOGY_FAIL;
					return nErrorCode;
				}
				else
				{
					CalcuPara.p_dY[n] = log10(CalcuPara.p_dY[n]);
				}
			}
			n++;
		}
	}
		
    LsmCreate(CalcuPara.p_dX, CalcuPara.p_dY, nTotal);
	//LinearEquationCreate(p_dX, p_dY, nTotal);
	//p_lsmFitting->Create(p_dX, p_dY, nTotal);
	//NormalAnalysis.linear_analysis[wcCurrentFilter].dRR = p_lsmFitting->GetRR(nErrorCode);
	NormalAnalysis.LinearAnalysis[wcCurrentFilter].dRR = LsmGetRR(&nErrorCode);
	if(nErrorCode != ANALYSIS_SUCCESS)
	{
		   //free(p_dX);
       //free(p_dY);
//		   free(m_pXLsm);
		 //  free(m_pYLsm);
		return nErrorCode;
	}
    
	//NormalAnalysis.linear_analysis[wcCurrentFilter].dSlope = p_lsmFitting->GetSlope(nErrorCode);
	NormalAnalysis.LinearAnalysis[wcCurrentFilter].dSlope= LsmGetSlope(&nErrorCode);
	if(nErrorCode != ANALYSIS_SUCCESS || NormalAnalysis.LinearAnalysis[wcCurrentFilter].dSlope == 0.0f)
	{
		 //  free(p_dX);
      // free(p_dY);
//		   free(m_pXLsm);
		 //  free(m_pYLsm);
		   return nErrorCode;
	}
    NormalAnalysis.LinearAnalysis[wcCurrentFilter].dIntercept=LsmGetIntercept(&nErrorCode);
	//NormalAnalysis.linear_analysis[wcCurrentFilter].dIntercept = p_lsmFitting->GetIntercept(nErrorCode);
	if(nErrorCode != ANALYSIS_SUCCESS)
	{
	 	 //  free(p_dX);
      // free(p_dY);
//		   free(m_pXLsm);
		//   free(m_pYLsm);
		   return nErrorCode;
	}

	for(i = 0; i < 12; i++) //2014-8-20项
	{
		for(j = 0; j < 8; j++)
		{
			//float dTemp;
			if(wcCurrentFilter < 2)
			{
				dTemp = dABS[0][wcCurrentFilter][j * 12 + i];
			}
			else if(NormalAnalysis.bPreCalOK[0][j * 12 + i])
			{
				dTemp = NormalAnalysis.dPreCal[0][j * 12 + i];
			}
			else
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = -1.0f;
				continue;
			}

			bHasResult =1;// true;

			if(NormalAnalysis.bLogY)
			{
				if(dTemp <= 0.0f)
				{
					bHasResult = 0;//false; 
				}
				else
				{
					dTemp = log10(dTemp);
				}
			}

			dTemp = (dTemp - NormalAnalysis.LinearAnalysis[wcCurrentFilter].dIntercept)
				/ NormalAnalysis.LinearAnalysis[wcCurrentFilter].dSlope;

			if(bHasResult==0)
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = -1.0f;
			}
			else if(NormalAnalysis.bLogX)
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = pow(10.0f, dTemp);
			}
			else if(dTemp < 0.0f)
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = 0.0;
			}
			else
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = dTemp;
			}
		}
	}

     //  free(p_dX);
     //  free(p_dY);
//		   free(m_pXLsm);
		 //  free(m_pYLsm);
	
	return nErrorCode;
	
}



int DoPtoPAnalysis(unsigned char wcCurrentFilter)
{
	int i,j,k;
	int nTotal = NormalAnalysis.nCalibratorCountTotal[wcCurrentFilter];
	//float *p_dX = (float *)malloc(sizeof(float) * nTotal);
//	float *p_dY = (float *)malloc(sizeof(float) * nTotal);  
  
	float dTemp;
 //   int nSeg,k;
	unsigned char bHasResult;
	int nErrorCode = ANALYSIS_SUCCESS;
	int n = 0;
	int nSeg;
	float dX1, dY1, dX2, dY2;
	float dSlope1;


	for(i = 0; i < CALIBRATOR_CONCENTRATION_MAX; i++)
	{
		if(NormalAnalysis.nCalibratorCount[wcCurrentFilter][i] > 0)
		{
			CalcuPara.p_dY[n] = NormalAnalysis.dCalibratorABS[wcCurrentFilter][i];
			CalcuPara.p_dX[n] = BoardInf.dConcentration[i];

			if(NormalAnalysis.bLogX) //对数坐标
			{
				if(CalcuPara.p_dX[n] <= 0.0f)
				{
				  //free(p_dX);
					//free(p_dY);
					nErrorCode = ANALYSIS_ERROR_LOGX_FAIL;
					return nErrorCode;
				}
				else
				{
					CalcuPara.p_dX[n] = log10(CalcuPara.p_dX[n]);
				}
			}

			if(NormalAnalysis.bLogY) //对数坐标
			{
				if(CalcuPara.p_dY[n] <= 0.0f)
				{
				//	free(p_dX);
					//free(p_dY);
					nErrorCode = ANALYSIS_ERROR_LOGY_FAIL;
					return nErrorCode;
				}
				else
				{
					CalcuPara.p_dY[n] = log10(CalcuPara.p_dY[n]);
				}
			}
			n++;
		}
	}

	for(i = 0; i < nTotal; i++) //排序
	{
		for(j = i + 1; j < nTotal; j++)
		{
			//float dTemp;
			if(CalcuPara.p_dY[j] < CalcuPara.p_dY[i])
			{
				dTemp = CalcuPara.p_dY[j];
				CalcuPara.p_dY[j] = CalcuPara.p_dY[i];
				CalcuPara.p_dY[i] = dTemp;

				dTemp = CalcuPara.p_dX[j];
				CalcuPara.p_dX[j] = CalcuPara.p_dX[i];
				CalcuPara.p_dX[i] = dTemp;
			}
		}
	}

	for(i = 0; i < nTotal; i++)
	{
		NormalAnalysis.PtopAnalysis[wcCurrentFilter].dY[i] = CalcuPara.p_dY[i];
		NormalAnalysis.PtopAnalysis[wcCurrentFilter].dX[i] = CalcuPara.p_dX[i];
	}

	for(i = 0; i < 12; i++) //2014-8-20项
	{
		for(j = 0; j < 8; j++)
		{
			//float dTemp;
			if(wcCurrentFilter < 2)
			{
				dTemp = dABS[0][wcCurrentFilter][j * 12 + i];
			}
			else if(NormalAnalysis.bPreCalOK[0][j * 12 + i])
			{
				dTemp = NormalAnalysis.dPreCal[0][j * 12 + i];
			}
			else
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = -1.0f;
				continue;
			}

			bHasResult = 1;//

			if(NormalAnalysis.bLogY)
			{
				if(dTemp <= 0.0f)
				{
					bHasResult = 0; 
				}
				else
				{
					dTemp = log10(dTemp);
				}
			}

			nSeg = NormalAnalysis.nCalibratorCountTotal[wcCurrentFilter] - 1;
			for(k = 0; k < NormalAnalysis.nCalibratorCountTotal[wcCurrentFilter]; k++)
			{ 
				if(dTemp < NormalAnalysis.PtopAnalysis[wcCurrentFilter].dY[k])
				{
					nSeg = k;
					break;
				}
			}

			if(nSeg < 1)
			{
				nSeg = 1;
			}

			//float dX1, dY1, dX2, dY2;
			dX1 = NormalAnalysis.PtopAnalysis[wcCurrentFilter].dX[nSeg - 1];
			dY1 = NormalAnalysis.PtopAnalysis[wcCurrentFilter].dY[nSeg - 1];
			dX2 = NormalAnalysis.PtopAnalysis[wcCurrentFilter].dX[nSeg];
			dY2 = NormalAnalysis.PtopAnalysis[wcCurrentFilter].dY[nSeg];
			if(dX1 == dX2 || dY1 == dY2)
			{
				bHasResult = 0;
			}
			else
			{
				dSlope1 = (dX2 - dX1) / (dY2 - dY1);
				dTemp = dSlope1 * (dTemp - dY1) + dX1;
				if(NormalAnalysis.bLogX)
				{
					dTemp = pow(10.0, dTemp);
				}
				else if(dTemp < 0.0f)
				{
					dTemp = 0.0f;
				}
			}

			if(bHasResult==0)
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = -1.0f;
			}
			else
			{
				NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = dTemp;
			}
		}
	}

	//free(p_dX);
	//free(p_dY);
	return ANALYSIS_SUCCESS;
}


