	int n = 0;

	float dTemp1;

	for(i = 0; i < CALIBRATOR_CONCENTRATION_MAX; i++)
	{
		if(NormalAnalysis.nCalibratorCount[wcCurrentFilter][i] > 0)
		{
			//NormalAnalysis.dCalibratorABS[NormalAnalysis.FilterCurrent][0]=196;
			   CalcuPara.p_dY[n] = NormalAnalysis.dCalibratorABS[wcCurrentFilter][i];
			   CalcuPara.p_dX[n] = BoardInf.dConcentration[i];
			   if(NormalAnalysis.bLogX) //对数坐标//lgj170831
			   {
			      if(CalcuPara.p_dX[n] <= 1.0f)//<= lgj170831
			      {
				    	 // free(p_dX);
               // free(p_dY);

				        nErrorCode = ANALYSIS_ERROR_LOG_CONCENTRATION;
				        return nErrorCode;
			      }
			      else
			      {
				           CalcuPara.p_dX[n] = log10(CalcuPara.p_dX[n]);
			      }
			   }

			if(NormalAnalysis.bLogY) //对数坐标
			{
				if(CalcuPara.p_dY[n] <= 0.0f)
				{
					//free(p_dX);
          //free(p_dY);
					nErrorCode = ANALYSIS_ERROR_LOGY_FAIL;
					return nErrorCode;
				}
				else
				{
					CalcuPara.p_dY[n] = log10(CalcuPara.p_dY[n]);
				}
			}
			n++;
		}
	}

	
	//SearchForPlateLimits(wcCurrentFilter, &dYMin, &dYMax);
	//SetYMax(dYMax);
	//SetYMin(dYMin);
	//bool b1 = LogisticCreate(valueX, valueY, 5);

	CalcuPara.p_dY[0]=196.4592;//NormalAnalysis.dCalibratorABS[wcCurrentFilter][0];
    CalcuPara.p_dY[1]=225.7828;//NormalAnalysis.dCalibratorABS[wcCurrentFilter][1];
	CalcuPara.p_dY[2]=350.0000;//NormalAnalysis.dCalibratorABS[wcCurrentFilter][2];
	CalcuPara.p_dY[3]=450;//NormalAnalysis.dCalibratorABS[wcCurrentFilter][3];
	CalcuPara.p_dY[4]=550;//NormalAnalysis.dCalibratorABS[wcCurrentFilter][4];

	//p_dY[0]=NormalAnalysis.dCalibratorABS[wcCurrentFilter][0];
 //   p_dY[1]=NormalAnalysis.dCalibratorABS[wcCurrentFilter][1];
//	p_dY[2]=NormalAnalysis.dCalibratorABS[wcCurrentFilter][2];
//	p_dY[3]=NormalAnalysis.dCalibratorABS[wcCurrentFilter][3];
//	p_dY[4]=NormalAnalysis.dCalibratorABS[wcCurrentFilter][4];

	CalcuPara.p_dX[0]=BoardInf.dConcentration[0];
    CalcuPara.p_dX[1]=BoardInf.dConcentration[1];
	CalcuPara.p_dX[2]=BoardInf.dConcentration[2];
	CalcuPara.p_dX[3]=BoardInf.dConcentration[3];
	CalcuPara.p_dX[4]=BoardInf.dConcentration[4];




		//valueX[0] = 1.0;valueX[1] = 2.0;valueX[2] = 3.0;valueX[3] = 4.0; valueX[4] = 5.0;
	//valueY[0] = 10; valueY[1] = 12; valueY[2] = 23; valueY[3] = 50.0;valueY[4] = 62.0;


	nErrorCode = LogisticCreate(CalcuPara.p_dX, CalcuPara.p_dY, nTotal);
	if(nErrorCode == ANALYSIS_SUCCESS)
	{
		GetCoef(NormalAnalysis.LogisticAnalysis[wcCurrentFilter].dCoef);
		NormalAnalysis.LogisticAnalysis[wcCurrentFilter].dRR=LogisticGetRR();
		NormalAnalysis.bLogX = 0;////

		for(i = 0; i < 12; i++) //2014-8-20项
		{
			for(j = 0; j < 8; j++)
			{
			//	float dTemp;
				if(wcCurrentFilter < 2)
				{
					dTemp = dABS[0][wcCurrentFilter][j * 12 + i];
				}
				else if(NormalAnalysis.bPreCalOK[0][j * 12 + i])
				{
					dTemp = NormalAnalysis.dPreCal[0][j * 12 + i];
				}
				else
				{
					NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = -1.0;
					continue;
				}

				bHasResult = 1;
				dTemp1 = dTemp;

				if(NormalAnalysis.bLogY)
				{
					if(dTemp1 <= 0.0f)
					{
						bHasResult = 0; 
					}
					else
					{
						dTemp1 = log10(dTemp);
					}
				}

				dTemp = ((log10((dTemp1 - NormalAnalysis.LogisticAnalysis[wcCurrentFilter].dCoef[0])
					/ (NormalAnalysis.LogisticAnalysis[wcCurrentFilter].dCoef[3] - dTemp1)))
					/ NormalAnalysis.LogisticAnalysis[wcCurrentFilter].dCoef[1])
					+ log10(NormalAnalysis.LogisticAnalysis[wcCurrentFilter].dCoef[2]);
				dTemp1 = pow(10.0f, dTemp);
				dTemp = pow(10.0f, dTemp1);
				if(dTemp > CONCENTRATION_MAX)
				{
					dTemp = CONCENTRATION_MAX;
				}

				if(bHasResult==0)
				{
					NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = -1.0;
				}
				else
				{
					NormalAnalysis.dConcentration[wcCurrentFilter][j * 12 + i] = dTemp;
				}
			}
		}
	}
	//free(p_dX);
  //free(p_dY);
//	free(m_pX);
 // free(m_pY);
	//free(m_pXInit);
//  free(m_pYInit);
//	free(m_pXLsm);
 // free(m_pYLsm);
	return nErrorCode;
}


