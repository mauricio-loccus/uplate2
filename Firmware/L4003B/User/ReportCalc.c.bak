ABS_CAL_PARA AbsCalPara;



void GetAxisMin(float *dX)
{
	int nX;
	if(*dX >= 0.0f)
	{
		nX = (int)(*dX);
	}
	else
	{
		nX = (int)(*dX - 1);
	}

	if(nX < -10 && nX >= -20) //负坐标
	{
		nX = ((nX - 1) / 2) * 2;
	}
	else if(nX < -20 && nX >= -100)
	{
		if(nX % 5 != 0)
		{
			nX = ((nX - 5) / 5) * 5;
		}
	}
	else if(nX < -100 && nX >= -1000)
	{
		if(nX % 10 != 0)
		{
			nX = ((nX - 10) / 10) * 10;
		}
	}
	else if(nX < -1000)
	{
		if(nX % 100 != 0)
		{
			nX = ((nX - 100) / 100) * 100;
		}
	}

	if(nX <= 20 && nX > 10) //正坐标
	{
		nX = (nX / 2) * 2;
	}
	else if(nX <= 100 && nX > 20)
	{
		if(nX % 5 != 0)
		{
			nX = (nX / 5) * 5;
		}
	}
	else if(nX <= 1000 && nX > 100)
	{
		if(nX % 10 != 0)
		{
			nX = (nX / 10) * 10;
		}
	}
	else if(nX > 1000)
	{
		if(nX % 100 != 0)
		{
			nX = (nX / 100) * 100;
		}
	}

	if(*dX >= 0.0f && *dX <= 10.0f)
	{
		nX = (int)(*dX * 10.0f) - 1;
		*dX = (float)nX / 10.0f;
	}
	else if(*dX >= -10.0f && *dX < 0.0f)
	{
		nX = (int)(*dX * 10.0f) - 2;
		*dX = (float)nX / 10.0f;
	}
	else
	{
		*dX = (float)nX;
	}
}

void GetAxisMax(float *dX)
{
	int nX;
	if(*dX >= 0.0f)
	{
		nX = (int)(*dX + 1);
	}
	else
	{
		nX = (int)(*dX);
	}

	if(nX > 10 && nX <= 20) //正坐标
	{
		nX = ((nX + 1) / 2) * 2;
	}
	else if(nX > 20 && nX <= 100)
	{
		if(nX % 5 != 0)
		{
			nX = ((nX + 5) / 5) * 5;
		}
	}
	else if(nX > 100 && nX <= 1000)
	{
		if(nX % 10 != 0)
		{
			nX = ((nX + 10) / 10) * 10;
		}
	}
	else if(nX > 1000)
	{
		if(nX % 100 != 0)
		{
			nX = ((nX + 100) / 100) * 100;
		}
	}

	if(nX >= -20 && nX < -10) //负坐标
	{
		nX = (nX / 2) * 2;
	}
	else if(nX < -20 && nX >= -100)
	{
		if(nX % 5 != 0)
		{
			nX = (nX / 5) * 5;
		}
	}
	else if(nX < -100 && nX >= -1000)
	{
		if(nX % 10 != 0)
		{
			nX = (nX / 10) * 10;
		}
	}
	else if(nX < -1000)
	{
		if(nX % 100 != 0)
		{
			nX = (nX / 100) * 100;
		}
	}

	if(*dX >= 0.0f && *dX <= 10.0f)
	{
		nX = (int)(*dX * 10.0f) + 1;
		*dX = (float)nX / 10.0f;
	}
	else if(*dX >= -10.0f && *dX < 0.0f)
	{
		nX = (int)(*dX * 10.0f);
		*dX = (float)nX / 10.0f;
	}
	else
	{
		*dX = (float)nX;
	}
}

void GetAxisLimits(float *dXMin, float *dXMax, float *dYMin, float *dYMax, float *p_dX, float *p_dY)
{
	int i,n = 0;
	for(i = 0; i < CALIBRATOR_CONCENTRATION_MAX; i++)
	{
		if(NormalAnalysis.nCalibratorCount[NormalAnalysis.FilterCurrent][i] > 0)
		{
			p_dY[n] = NormalAnalysis.dCalibratorABS[NormalAnalysis.FilterCurrent][i];
			p_dX[n] = BoardInf.dConcentration[i];

			if(NormalAnalysis.bLogY) //对数坐标
			{
				p_dY[n] = log10(p_dY[n]);
			}
			if(NormalAnalysis.bLogX) //对数坐标
			{
				p_dX[n] = log10(p_dX[n]);
			}
			n++;
		}
	}

	*dXMin = p_dX[0];
	*dYMin = p_dY[0];
	*dXMax = p_dX[0];
	*dYMax = p_dY[0];
	for(i = 0; i < n; i++)
	{
		if(p_dX[i] > *dXMax)
		{
			*dXMax = p_dX[i];
		}

		if(p_dY[i] > *dYMax)
		{
			*dYMax = p_dY[i];
		}

		if(p_dX[i] < *dXMin)
		{
			*dXMin = p_dX[i];
		}

		if(p_dY[i] < *dYMin)
		{
			*dYMin = p_dY[i];
		}
	}

	if(BoardInf.KineticPara.Curve==CURVE_LOGISTIC)
	//if(CString(BoardInf.curentcurve) == _T("Logistic"))
	{
		*dYMin = NormalAnalysis.LogisticAnalysis[NormalAnalysis.FilterCurrent].dCoef[0];
		*dYMax = NormalAnalysis.LogisticAnalysis[NormalAnalysis.FilterCurrent].dCoef[3];
	}

	GetAxisMin(dXMin);
	GetAxisMin(dYMin);
	GetAxisMax(dXMax);
	GetAxisMax(dYMax);
}


void GetAxisLimitsKinetic(float *dXMin, float *dXMax, float *dYMin, float *dYMax, float *p_dX, float *p_dY)
{
	 unsigned char bCompared = 0;
	 unsigned char i,j;

	*dXMin = 1;
	*dYMin = 0.0;
	*dXMax = BoardInf.KineticPara.kinetic_readings_analysis;
	*dYMax = 0.0;

	

	for( i = 0; i < BoardInf.KineticPara.kinetic_readings_analysis; i++)
	{
		p_dX[i] = i + 1;
		if(BoardInf.KineticPara.nCurrentSample >= TUBE_MAX)
		{
			for(j = 0; j < TUBE_MAX; j++)
			{
				if(NormalAnalysis.FilterCurrent < 2)
				{
					p_dY[i] = dABS[i][NormalAnalysis.FilterCurrent][j];
					if(bCompared==0)
					{
						*dYMin = p_dY[i];
						bCompared = 1;
						*dYMax = p_dY[i];
					} //if(!bCompared)
					else if(*dYMin > p_dY[i])
					{
						*dYMin = p_dY[i];
					} //else if(dYMin > p_dY[i])
					else if(*dYMax < p_dY[i])
					{
						*dYMax = p_dY[i];
					} //else if(dYMax < p_dY[i])
				} //if(normal_analysis.wcFilterCurrent < 2)
				else if(BoardInf.KineticPara.bPreCalOK[j])
				{
					p_dY[i] = NormalAnalysis.dPreCal[i][j];
					if(bCompared==0)
					{
						*dYMin = p_dY[i];
						*dYMax = p_dY[i];
						bCompared = 1;
					} //if(!bCompared)
					else if(*dYMin > p_dY[i])
					{
						*dYMin = p_dY[i];
					} //else if(dYMin > p_dY[i])
					else if(*dYMax < p_dY[i])
					{
						*dYMax = p_dY[i];
					} //else if(dYMax < p_dY[i])
				} //else if(BoardInf.KineticPara.bPreCalOK[j])
			} //for(int j = 0; j < TUBE_MAX; j++)
		} //if(BoardInf.KineticPara.nCurrentSample >= TUBE_MAX)
		else
		{
			if(NormalAnalysis.FilterCurrent < 2)
			{
				p_dY[i] = dABS[i][NormalAnalysis.FilterCurrent][BoardInf.KineticPara.nCurrentSample];
				if(bCompared==0)
				{
					*dYMin = p_dY[i];
					bCompared = 1;
					*dYMax = p_dY[i];
				} //if(!bCompared)
				else if(*dYMin > p_dY[i])
				{
					*dYMin = p_dY[i];
				} //else if(dYMin > p_dY[i])
				else if(*dYMax < p_dY[i])
				{
					*dYMax = p_dY[i];
				} //else if(dYMax < p_dY[i])
			} //if(normal_analysis.wcFilterCurrent < 2)
			else if(BoardInf.KineticPara.bPreCalOK[BoardInf.KineticPara.nCurrentSample])
			{
				p_dY[i] = NormalAnalysis.dPreCal[i][BoardInf.KineticPara.nCurrentSample];
				if(bCompared==0)
				{
					*dYMin = p_dY[i];
					*dYMax = p_dY[i];
					bCompared = 1;
				} //if(!bCompared)
				else if(*dYMin > p_dY[i])
				{
					*dYMin = p_dY[i];
				} //else if(dYMin > p_dY[i])
				else if(*dYMax < p_dY[i])
				{
					*dYMax = p_dY[i];
				} //else if(dYMax < p_dY[i])
			} //else if(BoardInf.KineticPara.bPreCalOK[j])
		} //if(BoardInf.KineticPara.nCurrentSample >= TUBE_MAX)
	} //for(int i = 0; i < BoardInf.KineticPara.kinetic_readings_analysis; i++)

	GetAxisMin(dXMin);
	GetAxisMin(dYMin);
	GetAxisMax(dXMax);
	GetAxisMax(dYMax);
}



unsigned char PreCalOK(void)
{
	unsigned char  bOK = 0;
	int i,j;
	for(j = 0; j < TUBE_MAX; j++)
	{
		BoardInf.KineticPara.bPreCalOK[j] = 1;
		for(i = 0; i < BoardInf.KineticPara.kinetic_readings_analysis; i++)
		{
			if(NormalAnalysis.bPreCalOK[i][j]==0)
			{
				BoardInf.KineticPara.bPreCalOK[j] = 0;
				break;
			}
		} 

		bOK |= BoardInf.KineticPara.bPreCalOK[j];
	}

	return bOK;
}




//Blank为所有设为BK的孔的数据平均值
//void SearchForBlanks(void)
void SearchForBlanks(void)
{
	int k,i,nCycles = 1;

	if(BoardInf.KineticPara.Enable)  //开启动力学
	{
		nCycles = BoardInf.KineticPara.kinetic_readings_practical;
	}

	for(k = 0; k < nCycles; k++)
	{
		NormalAnalysis.nBlankCount[k][0] = 0; //是否包含空白
		NormalAnalysis.nBlankCount[k][1] = 0; 

		NormalAnalysis.dBlank[k][0] = 0.0; //空白样本初始化
		NormalAnalysis.dBlank[k][1] = 0.0;

		for(i = 0; i < TUBE_MAX; i++)
		{
			if(BoardInf.Layout.WellType[i] == WELLS_TYPE_BK)//"BK"
			{
				if(BoardInf.Filter2Locate>=0 && BoardInf.bHasRawData[1])
				{
					NormalAnalysis.nBlankCount[k][1]++;
					NormalAnalysis.dBlank[k][1] += dABSInit[k][1][i];
				}

				NormalAnalysis.nBlankCount[k][0]++;
				NormalAnalysis.dBlank[k][0] += dABSInit[k][0][i];
			}
		}

		for(i = 0; i < FILTER_PLATE_MAX; i++)
		{
			if(NormalAnalysis.nBlankCount[k][i] > 0)
			{
				NormalAnalysis.dBlank[k][i] /= NormalAnalysis.nBlankCount[k][i];
			}
		}
	}
}

void SearchForStandards(unsigned char nStandard)
{
	unsigned char i;
//	CString strTemp;
	//strTemp.Format(_T("%02d"), nStandard + 1);
	NormalAnalysis.nCalibratorCount[0][nStandard] = 0; //是否包含标准浓度
	NormalAnalysis.nCalibratorCount[1][nStandard] = 0;
	NormalAnalysis.nCalibratorCount[2][nStandard] = 0;
	NormalAnalysis.dCalibratorABS[0][nStandard] = 0.0; //标准浓度初始化
	NormalAnalysis.dCalibratorABS[1][nStandard] = 0.0;
	NormalAnalysis.dCalibratorABS[2][nStandard] = 0.0;

	for(i = 0; i < TUBE_MAX; i++)
	{
		if( (BoardInf.Layout.WellType[i] ==WELLS_TYPE_SD) && (BoardInf.Layout.Num[i] == nStandard) )//"SD"
		{
			if(BoardInf.Filter2Locate>=0  && BoardInf.KineticPara.PreProcess>=0 && BoardInf.bHasRawData[1])
			//if(BoardInf.Filter_2[0] != _T('N') && BoardInf.KineticPara.PreProcess[0] != _T('N') && BoardInf.bHasRawData[1]) //预计算
			{
				if(NormalAnalysis.bPreCalOK[0][i])
				{
					NormalAnalysis.nCalibratorCount[2][nStandard]++;
					NormalAnalysis.dCalibratorABS[2][nStandard] += NormalAnalysis.dPreCal[0][i];
				}
			}

			if(BoardInf.Filter2Locate>=0 && BoardInf.bHasRawData[1])
			{
				NormalAnalysis.nCalibratorCount[1][nStandard]++;
				NormalAnalysis.dCalibratorABS[1][nStandard] += dABS[0][1][i];
			}

			NormalAnalysis.nCalibratorCount[0][nStandard]++;
			NormalAnalysis.dCalibratorABS[0][nStandard] += dABS[0][0][i];
		}
	}

	for(i = 0; i < 3; i++)
	{
		if(NormalAnalysis.nCalibratorCount[i][nStandard] > 0)
		{
			NormalAnalysis.dCalibratorABS[i][nStandard] /= NormalAnalysis.nCalibratorCount[i][nStandard];
		}
	}
}


int SearchForNCPC(signed char wcCurrentFilter)
{
	int i;

	BoardInf.InterpretPara.nTotalNC[wcCurrentFilter] = 0;
	BoardInf.InterpretPara.nTotalPC[wcCurrentFilter] = 0;
	BoardInf.InterpretPara.dReferenceNC[wcCurrentFilter] = 0;
	BoardInf.InterpretPara.dReferencePC[wcCurrentFilter] = 0;

	for(i = 0; i < TUBE_MAX; i++)
	{
		if(BoardInf.Layout.WellType[i]==WELLS_TYPE_NC)//"NC"
		//if(BoardInf.layout[i + 1].Type[0] ==  _T('N'))
		{
			if(BoardInf.InterpretPara.AbsFlag )
			//if(BoardInf.interpret_para.bABS)
			{
				if(wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[0][i])//第3个滤光片为预计算的结果
				{
					BoardInf.InterpretPara.nTotalNC[wcCurrentFilter]++;
					BoardInf.InterpretPara.dReferenceNC[wcCurrentFilter] += NormalAnalysis.dPreCal[0][i];
				} //if(wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i])
				else if(wcCurrentFilter <= 1)
				{
					BoardInf.InterpretPara.nTotalNC[wcCurrentFilter]++;
					BoardInf.InterpretPara.dReferenceNC[wcCurrentFilter] += dABS[0][wcCurrentFilter][i];
				} //else if(wcCurrentFilter <= 1)
			} //if(BoardInf.interpret_para.bABS)
			else
			{
				if(NormalAnalysis.dConcentration[wcCurrentFilter][i] >= 0.0f)
				{
					if((wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i]) || (wcCurrentFilter <= 1))
					{
						BoardInf.InterpretPara.nTotalNC[wcCurrentFilter]++;
						BoardInf.InterpretPara.dReferenceNC[wcCurrentFilter] += NormalAnalysis.dConcentration[wcCurrentFilter][i];
					} //if((wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i]) || (wcCurrentFilter <= 1))
				} //if(NormalAnalysis.dConcentration[wcCurrentFilter][i] >= 0.0)
			} //if(BoardInf.interpret_para.bABS)
		} //if(BoardInf.layout[i + 1].Type[0] ==  _T('N'))

		if(BoardInf.Layout.WellType[i]==WELLS_TYPE_PC)
		//if(BoardInf.layout[i + 1].Type[0] ==  _T('P'))
		{
			//if(BoardInf.interpret_para.bABS)
			if(BoardInf.InterpretPara.AbsFlag )
			{
				if(wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[0][i])
				{
					BoardInf.InterpretPara.nTotalPC[wcCurrentFilter]++;
					BoardInf.InterpretPara.dReferencePC[wcCurrentFilter] += NormalAnalysis.dPreCal[0][i];
				} //if(wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i])
				else if(wcCurrentFilter <= 1)
				{
					BoardInf.InterpretPara.nTotalPC[wcCurrentFilter]++;
					BoardInf.InterpretPara.dReferencePC[wcCurrentFilter] += dABS[0][wcCurrentFilter][i];
				} //if(wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i])
			} //if(BoardInf.interpret_para.bABS)
			else
			{
				if(NormalAnalysis.dConcentration[wcCurrentFilter][i] >= 0.0f)
				{
					if((wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i]) || (wcCurrentFilter <= 1))
					{
						BoardInf.InterpretPara.nTotalPC[wcCurrentFilter]++;
						BoardInf.InterpretPara.dReferencePC[wcCurrentFilter] += NormalAnalysis.dConcentration[wcCurrentFilter][i];
					} //if((wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i]) || (wcCurrentFilter <= 1))
				} //if(NormalAnalysis.dConcentration[wcCurrentFilter][i] >= 0.0)
			} //if(BoardInf.interpret_para.bABS)
		} //if(BoardInf.layout[i + 1].Type[0] ==  _T('P'))
	} //for(int i = 0; i < TUBE_MAX; i++)

	if(BoardInf.InterpretPara.nTotalPC[wcCurrentFilter] < 1)
	{
		return ANALYSIS_ERROR_NO_PC;
	}

	if(BoardInf.InterpretPara.nTotalNC[wcCurrentFilter] < 1)
	{
		return ANALYSIS_ERROR_NO_NC;
	}

	BoardInf.InterpretPara.dReferencePC[wcCurrentFilter] /= BoardInf.InterpretPara.nTotalPC[wcCurrentFilter];  //阳性对照
	BoardInf.InterpretPara.dReferenceNC[wcCurrentFilter] /= BoardInf.InterpretPara.nTotalNC[wcCurrentFilter];  //阴性对照
	BoardInf.InterpretPara.dReference[wcCurrentFilter]                     
	= BoardInf.InterpretPara.fCoef[0] * BoardInf.InterpretPara.dReferenceNC[wcCurrentFilter]
	+ BoardInf.InterpretPara.fCoef[1] * BoardInf.InterpretPara.dReferencePC[wcCurrentFilter]
	+ BoardInf.InterpretPara.fCoef[2];
	return ANALYSIS_SUCCESS;
}

int SearchForQC(unsigned char wcCurrentFilter)
{
	int i,j,k;
	float dX[TUBE_MAX];
	float dTemp;

	BoardInf.QualityResult.nTotal[wcCurrentFilter] = 0;
	//BoardInf.quality_para.nTotal[wcCurrentFilter] = 0;
	for(j = 0; j < QC_MAX; j++)
	{
		BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j] = 0;
		BoardInf.QualityResult.dReferenceQC[wcCurrentFilter][j] = 0;
		BoardInf.QualityResult.bReferenceOK[wcCurrentFilter][j] = 1;
		//CString strTemp;
		//strTemp.Format(_T("%02d"), j + 1);
		

		for(i = 0; i < TUBE_MAX; i++)
		{
			if( (BoardInf.Layout.WellType[i]==WELLS_TYPE_QC) && (BoardInf.Layout.Num[i]==j) )
			//if(BoardInf.layout[i + 1].Type[0] ==  _T('Q') && CString(BoardInf.layout[i + 1].Num) == strTemp)
			{
				BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j]++;
				if(BoardInf.QualityPara.AbsFlag)
				{
					if(wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[0][i])
					{
						BoardInf.QualityResult.dReferenceQC[wcCurrentFilter][j] += NormalAnalysis.dPreCal[0][i];
						dX[BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j] - 1] = NormalAnalysis.dPreCal[0][i];
					} //if(wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i])
					else if(wcCurrentFilter > 1 && (NormalAnalysis.bPreCalOK[0][i]==0))
					{
						BoardInf.QualityResult.bReferenceOK[wcCurrentFilter][j] = 0;
					} //else if(wcCurrentFilter > 1 && !NormalAnalysis.bPreCalOK[i])
					else if(wcCurrentFilter <= 1)
					{
						BoardInf.QualityResult.dReferenceQC[wcCurrentFilter][j] += dABS[0][wcCurrentFilter][i];
						dX[BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j] - 1] = dABS[0][wcCurrentFilter][i];
					} //else if(wcCurrentFilter <= 1)
				} //if(BoardInf.interpret_para.bABS)
				else
				{
					if(NormalAnalysis.dConcentration[wcCurrentFilter][i] >= 0.0f)
					{
						if((wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i]) || (wcCurrentFilter <= 1))
						{
							BoardInf.QualityResult.dReferenceQC[wcCurrentFilter][j] += NormalAnalysis.dConcentration[wcCurrentFilter][i];
							dX[BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j] - 1] = NormalAnalysis.dConcentration[wcCurrentFilter][i];
						} //if((wcCurrentFilter > 1 && NormalAnalysis.bPreCalOK[i]) || (wcCurrentFilter <= 1))
						else
						{
							BoardInf.QualityResult.bReferenceOK[wcCurrentFilter][j] = 0;
						}
					} //if(NormalAnalysis.dConcentration[wcCurrentFilter][i] >= 0.0)
					else
					{
						BoardInf.QualityResult.bReferenceOK[wcCurrentFilter][j] = 0;
					} //if(NormalAnalysis.dConcentration[wcCurrentFilter][i] >= 0.0)
				} //if(BoardInf.interpret_para.bABS)
			} //if(BoardInf.layout[i + 1].Type[0] ==  _T('Q') && CString(BoardInf.layout[i + 1].Num) == strTemp)
		} //for(int i = 0; i < TUBE_MAX; i++)

		if(BoardInf.QualityResult.bReferenceOK[wcCurrentFilter][j]==0)
		{
			return ANALYSIS_ERROR_NO_QC_RESULT;
		} //if(!BoardInf.quality_para.bReferenceOK[wcCurrentFilter][j])

		if(BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j])
		{
			BoardInf.QualityResult.nTotal[wcCurrentFilter]++; //总的质控数
		}

		if(BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j])
		{
			BoardInf.QualityResult.dReferenceQC[wcCurrentFilter][j] /= BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j];
			if(BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j] >0)// 1)lgj170925
			{
				dTemp = 0.0;
				for(k = 0; k < BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j]; k++)
				{
					dTemp += (dX[k] - BoardInf.QualityResult.dReferenceQC[wcCurrentFilter][j])
						* (dX[k] - BoardInf.QualityResult.dReferenceQC[wcCurrentFilter][j]);
				}
				BoardInf.QualityPara.dSD[wcCurrentFilter][j] = pow( dTemp
					/ (BoardInf.QualityResult.nTotalQC[wcCurrentFilter][j] - 0), 0.5);//-1
			}
			else
			{
				BoardInf.QualityPara.dSD[wcCurrentFilter][j] = 0.0;
			}
		} //if(BoardInf.quality_para.nTotalQC[wcCurrentFilter][j])
	} //for(int j = 0; j < QC_MAX; j++)

	if(BoardInf.QualityResult.nTotal[wcCurrentFilter] < 1)
	{
		return ANALYSIS_ERROR_NO_QC;
	}

	return ANALYSIS_SUCCESS;
}



//2015-09-08 根据检测数据计算Abs,9channel在这里修改
//双通道nChannel=2,单通道nChannel=1,nCycle=0-99

void GetResultABS(unsigned char nChannel, unsigned char nCycle)
{
	float dCoef;
	unsigned short i,j,k;
  unsigned char* pChar = UartInfo.RevData;// + 4;

	if(nChannel == 2)
	{
		k = 0;
		
		//读取输入光强和本底光强
		for(i = 0; i < CHANNEL_MAX; i++)
		{
			nInputIntensity[0][i] = (unsigned int)(pChar[324 + k]) * 65536                               //第1通道－输入光强324=12*9*3
				+ (unsigned int)pChar[324 + k + 1] * 256 + (unsigned int)pChar[324 + k + 2];
			

			nInputIntensity[1][i] = (unsigned int)(pChar[378 + 324 + k]) * 65536                    //第2通道－输入光强
				+ (unsigned int)pChar[378 + 324+ k + 1] * 256 + (unsigned int)pChar[378 + 324 + k + 2];
		
			nBackgroundIntensity[0][i] = (unsigned int)(pChar[351 + k]) * 65536                  //第1通道－本底光强
				+ (unsigned int)pChar[351 + k + 1] * 256 + (unsigned int)pChar[351 + k + 2];

			nBackgroundIntensity[1][i] = (unsigned int)(pChar[378 + 351 + k]) * 65536           //第2通道－本底光强
				+ (unsigned int)pChar[378 + 351 + k + 1] * 256 + (unsigned int)pChar[378 + 351 + k + 2];

			if(nInputIntensity[0][i] <=  nBackgroundIntensity[0][i]) //输入光强非负
			{
				nInputIntensity[0][i] = nBackgroundIntensity[0][i] + 1;
			}

			if(nInputIntensity[1][i] <=  nBackgroundIntensity[1][i]) //输入光强非负
			{
				nInputIntensity[1][i] =nBackgroundIntensity[1][i] + 1;
			}

			k += 3;
		}


		//读取96孔板的光强
		for(i = 0; i < 12; i++)
		{
			k = 0;

			for(j = 0; j < CHANNEL_MAX; j++)
			{
				
				nIntensity[nCycle][0][j * 12 + i] = (unsigned int)pChar[i*27+k] * 65536
					+ (unsigned int) pChar[i*27+k+1] * 256 + (unsigned int)pChar[i*27+k+2];
				nIntensity[nCycle][1][j * 12 + i] = (unsigned int)pChar[378 + i*27+k] * 65536
					+ (unsigned int) pChar[378 + i*27+k+1] * 256	+ (unsigned int)pChar[378 + i*27+k+2];

				if(nIntensity[nCycle][0][j * 12 + i] <=  nBackgroundIntensity[0][j])
				{
					nIntensity[nCycle][0][j * 12 + i] = nBackgroundIntensity[0][j] + 1;
				}
				if(nIntensity[0][1][j * 12 + i] <= nBackgroundIntensity[1][j])
				{
					nIntensity[0][1][j * 12 + i] =  nBackgroundIntensity[1][j] + 1;
				}

				k += 3;
			}
		}

		//将光强转化为吸光度
		for(i = 0; i < 12; i++)
		{
			k = 0;

			for(j = 0; j < ABS_CHANNEL_MAX; j++)
			{
				//nInputIntensity[0][CHANNEL_MAX]为输入参比通道,nIntensity[nCycle][0][j * 12 + CHANNEL_MAX]为输出参比通道
				//光强校准公式＝（（输出参比-本底）/（输入参比－本底））*输入光强
				dCoef=(nIntensity[nCycle][0][ABS_CHANNEL_MAX * 12 + i]-nBackgroundIntensity[0][ABS_CHANNEL_MAX])/(float)(nInputIntensity[0][ABS_CHANNEL_MAX]-nBackgroundIntensity[0][j]);
				dABS[nCycle][0][j * 12 + i] = log10((float)((nInputIntensity[0][j]*dCoef) - nBackgroundIntensity[0][j])
					/ (float)(nIntensity[nCycle][0][j * 12 + i] - nBackgroundIntensity[0][j]));
				if(dABS[nCycle][0][j * 12 + i] < 0)
				{
					dABS[nCycle][0][j * 12 + i] = 0;
				}
				dABSInit[nCycle][0][j * 12 + i] = dABS[nCycle][0][j * 12 + i];


				dCoef= (float)(nIntensity[nCycle][1][ABS_CHANNEL_MAX * 12 +i]-nBackgroundIntensity[1][ABS_CHANNEL_MAX])/(float)(nInputIntensity[1][ABS_CHANNEL_MAX]-nBackgroundIntensity[1][j]);
				dABS[nCycle][1][j * 12 + i] = log10((float)((nInputIntensity[1][j] * dCoef) - nBackgroundIntensity[1][j])
					/ (float)(nIntensity[nCycle][1][j * 12 + i] - nBackgroundIntensity[1][j]));
				if(dABS[nCycle][1][j * 12 + i] < 0)
				{
					dABS[nCycle][1][j * 12 + i] = 0;
				}
				dABSInit[nCycle][1][j * 12 + i] = dABS[nCycle][1][j * 12 + i];
				k += 3;
			}
		}
		BoardInf.bHasData = 1;
		BoardInf.bHasRawData[0] = 1;
		BoardInf.bHasRawData[1] = 1;
	}
	else
	{
		k = 0;
		for(i = 0; i < CHANNEL_MAX; i++)
		{
			nInputIntensity[0][i] = (unsigned int)(pChar[324 + k]) * 65536
				+ (unsigned int)pChar[324 + k + 1] * 256 + (unsigned int)pChar[324 + k + 2];

			nBackgroundIntensity[0][i] = (unsigned int)(pChar[351 + k]) * 65536
				+ (unsigned int)pChar[351 + k + 1] * 256 + (unsigned int)pChar[351 + k + 2];

			if(nInputIntensity[0][i] <=  nBackgroundIntensity[0][i]) //输入光强非负
			{
				nInputIntensity[0][i] = nBackgroundIntensity[0][i] + 1;
			}
			k += 3;
		}
		//读取96孔板的光强
		for(i = 0; i < 12; i++)
		{
			k = 0;

			for(j = 0; j < CHANNEL_MAX; j++)
			{
				nIntensity[nCycle][0][j * 12 + i] = (unsigned int)pChar[i*27+k] * 65536
					+ (unsigned int) pChar[i*27+k+1] * 256 + (unsigned int)pChar[i*27+k+2];

				if(nIntensity[nCycle][0][j * 12 + i] <= nBackgroundIntensity[0][j])
				{
					nIntensity[nCycle][0][j * 12 + i] =  nBackgroundIntensity[0][j] + 1;
				}

				k += 3;
			}
		}
		for(i = 0; i < 12; i++)
		{
			for(j = 0; j < ABS_CHANNEL_MAX; j++)
			{
				//光强校准公式＝（（输出参比-本底）/（输入参比－本底））*输入光强
				dCoef=(float)(nIntensity[nCycle][0][ABS_CHANNEL_MAX * 12 + i]-nBackgroundIntensity[0][ABS_CHANNEL_MAX])/(float)(nInputIntensity[0][ABS_CHANNEL_MAX]-nBackgroundIntensity[0][j]);
				dABS[nCycle][0][j * 12 + i] = log10((float)((nInputIntensity[0][j] * dCoef) - nBackgroundIntensity[0][j])
					/ (float)(nIntensity[nCycle][0][j * 12 + i] - nBackgroundIntensity[0][j]));

				if(dABS[nCycle][0][j * 12 + i] < 0)
				{
					dABS[nCycle][0][j * 12 + i] = 0;
				}
				dABSInit[nCycle][0][j * 12 + i] = dABS[nCycle][0][j * 12 + i];
			}
		}

		BoardInf.bHasData = 1;
		BoardInf.bHasRawData[0] = 1;
		BoardInf.bHasRawData[1] = 0;
	}
}


//AbsCalPara.dABS吸光度>=0
void GetCalibrationPara(void)
{
	int i,j,k;
	memcpy(AbsCalPara.dABS[0], SystemPrameter.AbsCali[BoardInf.Filter1Locate].dABS, sizeof(float) * CALIBRATOR_ABS_MAX);
	//memcpy(AbsCalPara.dABS[0], SystemPrameter.AbsCali[BoardInf.Filter1Locate].dABSPractical, sizeof(float) * CALIBRATOR_ABS_MAX);///
	memcpy(AbsCalPara.dABSError[0], SystemPrameter.AbsCali[BoardInf.Filter1Locate].dABSError, sizeof(float) * CALIBRATOR_ABS_MAX);
	if(BoardInf.Filter2Locate >= 0)
	{
		memcpy(AbsCalPara.dABS[1], SystemPrameter.AbsCali[BoardInf.Filter2Locate].dABS, sizeof(float) * CALIBRATOR_ABS_MAX);
	//	memcpy(AbsCalPara.dABS[1], SystemPrameter.AbsCali[BoardInf.Filter1Locate].dABSPractical, sizeof(float) * CALIBRATOR_ABS_MAX);///
		memcpy(AbsCalPara.dABSError[1], SystemPrameter.AbsCali[BoardInf.Filter2Locate].dABSError, sizeof(float) * CALIBRATOR_ABS_MAX);
	}

	AbsCalPara.nCount[0] = 0;
	for(i = 0; i < CALIBRATOR_ABS_MAX; i++)
	{
		if(AbsCalPara.dABS[0][i] < 0)
		{
			break;
		}

		AbsCalPara.nCount[0]++;
	}

	AbsCalPara.nCount[1] = 0;
	if(BoardInf.Filter2Locate >= 0)
	{
		for(i = 0; i < CALIBRATOR_ABS_MAX; i++)
		{
			if(AbsCalPara.dABS[1][i] < 0)
			{
				break;
			}

			AbsCalPara.nCount[1]++;
		}
	}
 //对设定的标准吸光度进行排序
	for(i = 0; i < 2; i++)
	{
		for(j =0; j < AbsCalPara.nCount[i] - 1; j++)
		{
			for(k = j + 1; k < AbsCalPara.nCount[i]; k++)
			{
				float dTemp;
				if(AbsCalPara.dABS[i][j] > AbsCalPara.dABS[i][k])
				{
					dTemp = AbsCalPara.dABS[i][j];
					AbsCalPara.dABS[i][j] = AbsCalPara.dABS[i][k];
					AbsCalPara.dABS[i][k] = dTemp;

					dTemp = AbsCalPara.dABSError[i][j];
					AbsCalPara.dABSError[i][j] = AbsCalPara.dABSError[i][k];
					AbsCalPara.dABSError[i][k] = dTemp; 
				}
			}
		}
	}
	
}


//吸光度校准,对,在dABSInit中校准完后再符值给dABS
void MakeABSCalibration(void)
{
	
	int i,j,k ;

//	memcpy(dABSInitBack, dABSInit, sizeof(float) * TUBE_MAX);

	for(i = 0; i < FILTER_PLATE_MAX; i++)
	{
		if((BoardInf.bHasRawData[i]==0) || AbsCalPara.nCount[i] < 1)
		{
			continue;
		} //if(!BoardInf.bHasRawData[i] || AbsCalPara.nCount[i] < 1)
		for(j = 0; j < TUBE_MAX; j++)
		{
			for(k = 0; k < BoardInf.KineticPara.kinetic_readings_practical; k++)
			{
				int nPos,m;
				float dError;
				if(AbsCalPara.nCount[i] < 2)
				{
					dABSInit[k][i][j] -= AbsCalPara.dABSError[i][0];
				} //if(AbsCalPara.nCount[i] < 2)
				else
				{
					nPos = AbsCalPara.nCount[i];
					for(m = 0; m < AbsCalPara.nCount[i]; m++)
					{
						if(dABSInit[k][i][j] < AbsCalPara.dABS[i][m])
						{
							nPos = m;
							break;
						} //if(dABSInit[k][i][j] < AbsCalPara.dABS[i][m])
					} //for(int m = 0; m < AbsCalPara.nCount[i]; m++)

					if(nPos <= 0)
					{
						nPos = 1;
					} //if(nPos <= 0)
					else if(nPos >= AbsCalPara.nCount[i])
					{
						nPos = AbsCalPara.nCount[i] - 1;
					} //else if(nPos >= AbsCalPara.nCount[i])

					dError = (dABSInit[k][i][j] - AbsCalPara.dABS[i][nPos - 1]) / (AbsCalPara.dABS[i][nPos] - AbsCalPara.dABS[i][nPos - 1])
						* (AbsCalPara.dABSError[i][nPos] - AbsCalPara.dABSError[i][nPos - 1]) + AbsCalPara.dABSError[i][nPos - 1];
					dABSInit[k][i][j] -= dError;
				} //if(AbsCalPara.nCount[i] < 2)
			} //for(int k = 0; k < BoardInf.kinetic_para.kinetic_readings_practical; k++)
		} //for(int j = 0; j < TUBE_MAX; j++)
	} //for(int i = 0; i < FILTER_PLATE_MAX; i++)

	//	if(!remote_info_PAD.bRemote) 
	//if(!remote_info_PAD.bRemote && !remote_info_PC.bRemote) 
	//{
		memcpy(dABS, dABSInit, sizeof(float) * FILTER_PLATE_MAX * TUBE_MAX * KINETIC_READINGS_MAX);
	//}
}

