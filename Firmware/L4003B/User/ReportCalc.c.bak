void SearchForPlateLimits(unsigned char wcCurrentFilter, float *dYMin, float *dYMax)
{
	unsigned char bInit = 0;
	unsigned short i;
	float dTemp;
	
	for(i = 0; i < TUBE_MAX; i++)
	{
		if(BoardInf.Layout.WellType[i] >=WELLS_TYPE_MAX) 
		{
			continue;
		}
		if(wcCurrentFilter < 2)
		{
			dTemp = dABS[0][NormalAnalysis.FilterCurrent][i];
		}
		else if(NormalAnalysis.bPreCalOK[0][i])
		{
			dTemp = NormalAnalysis.dPreCal[0][i];
		}
		else
		{
			continue;
		}

		if(NormalAnalysis.bLogY)
		{
			if(dTemp <= 0.0f)
			{
				continue;;
			}
			else
			{
				dTemp = log10(dTemp);
			}
		}

		if(bInit==0)
		{
			*dYMin = dTemp;
			*dYMax = dTemp;
			bInit = 1;
		}
		else if(*dYMin > dTemp)
		{
			*dYMin = dTemp;
		}
		else if(*dYMax < dTemp)
		{
			*dYMax = dTemp;
		}
	}
}


int DoLogisticAnalysis(unsigned char wcCurrentFilter)
{
	int i,j;
	int nTotal = NormalAnalysis.nCalibratorCountTotal[wcCurrentFilter];
	//float *p_dX = (float *)malloc(sizeof(float) * nTotal);
