#ifndef _EXPORT_REPORT_H
   #define _EXPORT_REPORT_H

#define EXPORT_DISX           150 //列间距
#define EXPORT_DISY           65  //行间距离

#define EXPORT_TXT_DISX       40 //文本列间距
#define EXPORT_TXT_DISY       8  //文本行间距离

//导出报告,CHECK1原始数据
#define EXPORT_CHECK1_STARTX  110 
#define EXPORT_CHECK1_ENDX    170
#define EXPORT_CHECK1_STARTY  145 //128
#define EXPORT_CHECK1_ENDY    205

#define EXPORT_CHECK1_POSX    (EXPORT_CHECK1_STARTX+EXPORT_TXT_DISX) 
#define EXPORT_CHECK1_POSY    (EXPORT_CHECK1_STARTY+EXPORT_TXT_DISY)


//CHECK2定量分析
#define EXPORT_CHECK2_STARTX  (EXPORT_CHECK1_STARTX+EXPORT_DISX)   
#define EXPORT_CHECK2_ENDX    (EXPORT_CHECK1_ENDX+EXPORT_DISX)
#define EXPORT_CHECK2_STARTY  (EXPORT_CHECK1_STARTY) 
#define EXPORT_CHECK2_ENDY    (EXPORT_CHECK1_ENDY)

#define EXPORT_CHECK2_POSX    (EXPORT_CHECK2_STARTX+EXPORT_TXT_DISX) 
#define EXPORT_CHECK2_POSY    (EXPORT_CHECK2_STARTY+EXPORT_TXT_DISY)

//CHECK3定性分析
#define EXPORT_CHECK3_STARTX  (EXPORT_CHECK1_STARTX+EXPORT_DISX*2)   
#define EXPORT_CHECK3_ENDX    (EXPORT_CHECK1_ENDX+EXPORT_DISX*2)
#define EXPORT_CHECK3_STARTY  (EXPORT_CHECK1_STARTY) 
#define EXPORT_CHECK3_ENDY    (EXPORT_CHECK1_ENDY)

#define EXPORT_CHECK3_POSX    (EXPORT_CHECK3_STARTX+EXPORT_TXT_DISX) 
#define EXPORT_CHECK3_POSY    (EXPORT_CHECK3_STARTY+EXPORT_TXT_DISY)

//CHECK4质控分析
#define EXPORT_CHECK4_STARTX  (EXPORT_CHECK1_STARTX)   
#define EXPORT_CHECK4_ENDX    (EXPORT_CHECK1_ENDX+EXPORT_DISX)
#define EXPORT_CHECK4_STARTY  (EXPORT_CHECK1_STARTY+EXPORT_DISY) 
#define EXPORT_CHECK4_ENDY    (EXPORT_CHECK1_ENDY+EXPORT_DISY)

#define EXPORT_CHECK4_POSX    (EXPORT_CHECK4_STARTX+EXPORT_TXT_DISX) 
#define EXPORT_CHECK4_POSY    (EXPORT_CHECK4_STARTY+EXPORT_TXT_DISY)




	
void ExportReportFunction(void);
void ExportReport_Interface(void);
void ExportReport_Scan(void);
void ExportReport_Go(void);

#endif




