#define STEP_NAME_LENGTH        10					   //步骤名长度
#define STEPNODE_MAX            100				       //步骤节点最大值
typedef struct PROGRAM_STEP
{
	char            Name[STEP_NAME_LENGTH];           // 步骤名
	unsigned char   Holes;							  // 孔位
	unsigned  int   MixingTime;						  //混合时间
	unsigned  int   MagneticTime;					  //吸磁时间
	unsigned  int   WaitTime;					      //等待时间
	unsigned  int   Volume;							  //容量
	unsigned char   MixingSpeed;				      //混合速度
	int             Temperature;				      //温度
	//float           MixingPosition;				      //混合速度  4*5
	//float           MixingAmplitude;                  // 混合幅度
	//float           MagneticPosition;				  //吸磁位置
	//float           MagneticSpeedUpDown;				  //向下吸磁速度
	//float           MagneticFludeTime;				  //向上吸磁速度
	unsigned char           MixingPosition;				      //混合速度  4*5
	unsigned char           MixingAmplitude;                  // 混合幅度
	unsigned char           MagneticPosition;				  //吸磁位置
	unsigned char           MagneticSpeedUpDown;				  //向下吸磁速度
	unsigned char           MagneticFludeTime;				  //向上吸磁速度
	
//	PROGRAMSTEP     *next;
}PROGRAMSTEP;
extern PROGRAMSTEP ProgramStep[];
extern char New_File_Name[PROGRAM_NAME_LENGTH];
extern PROGRAMSTEP CurrProgramStep;
//3.3程序选项
//3.3.1程序选项-宏定义
//1)加热方式宏定义
enum HEAT_TYPE
{
	HEATING_ACTION = 0,     //加热动作同步
	FIRST_HEATING,        //先加热后动作
	HEATION_LOW_DESTNATION, //加热到低于目标温度
	//HEATING_PREVIOUS_STEP, //加热提前的步骤数
};
//2)冷却参数宏定义
enum COOLING_TYPE
{
	COOLING_ACTION,      //降温动作同步
	FIRST_COOLING,      //先降温再动作
	COOLING_HIGH_DESTNATION, //降温到目标温度开始动作
};
//3)吸磁方式
enum MAGNATIC_TYPE
{
	HOVER,              //悬停吸磁
	ROCIPROCATE,        //往复吸磁
	SEGMENTATION,       //分段吸磁
};

//3.3.2程序选项-变量定义
//1)加热参数
typedef struct HEATING_PRA
{
	unsigned char  Type;                   //加热方式
	unsigned short DestnationTemper;       //目标温度lgj160921
	unsigned short LowerTemper;            //低于目标温度数(精度为1度)
	
	unsigned char  HeatingPreviousStepEn;  //使能加热提前的步数
	unsigned char  HeatingPreviousStep;    //加热提前的步数
}HEATINGPRA;
                       
//2)冷却参数
typedef struct COOLING_PRA
{
	unsigned char   FanEnable;             //降渐风扇是否启用
	unsigned char   Type;                  //降温类型
	unsigned short  DestnationTemper;      //降温目标温度   lgj160921
  unsigned char  HighTemper;             //降温高于目标温度(精度为1度)
}COOLINGPRA;      

//3)吸磁方式设置
typedef struct MAGNATIC_PRA
{
	unsigned char  Type;				           //吸磁方式
	unsigned char  SegNum;				         //往复吸磁时的分段数
}MAGNATICPRA;
//extern MAGNATICPRA MagnaticPra;        //吸磁参数 

//3.3程序选项结构体-总览
typedef struct PROGRAM_OPTION
{
	char              HeatEnable[TEMP_CHANNEL_NUM];    // 加热是否开启 
	HEATINGPRA        HeatPra;                         // 升温参数
	COOLINGPRA        CoolingPra;                      // 降温参数
	MAGNATICPRA       MagnaticPra;                     // 吸磁参数
}PROGRAMOPTION;
extern PROGRAMOPTION ProgramOption;
extern PROGRAMOPTION ProgramOption_back;
//3.程序管理模块-总览
typedef struct PROGRAM_FILE
{
	//PROGRAMNAME     *Name;              //程序名
	
	unsigned char    ProgramEndStep;    //程序的总步数
	//PROGRAMSTEP     *Step;              //程序节

	//PROGRAMOPTION   *Option;            //程序选项
}PROGRAMFILE;
extern PROGRAMFILE ProgramFile;


