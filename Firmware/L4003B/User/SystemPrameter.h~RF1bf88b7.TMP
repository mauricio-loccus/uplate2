//2.2)运动参数
typedef struct
{
	MOTION_PRAMETER  MotionPrameter;					             //运动参数
	//温度校准参数
	unsigned short  TempAdjLow[TEMP_CHANNEL_NUM];          //40度温度校准
	unsigned short  TempAdjHigh[TEMP_CHANNEL_NUM];         //100度温度校准
	//零位校准参数
	unsigned short  LevelZeroOffset;								       //水平电机零位校准偏移量   
	unsigned short  MagneticZeroOffset;							       //磁棒电机零位校准偏移量
	unsigned short  MagneticRodZeroOffSet;						     //磁棒套电机零位校准偏移量
	//行程校准
	unsigned short  LevelSetValue;								       //行程理论值
	unsigned short LevelPraValue;								   //行程实际值
	//加热孔位
	unsigned char HeatCrackHole;						   //加热裂解孔位  AS153=1、2孔,AS154=1孔,AS155=1、2、3孔
	unsigned char HeatWashHole;							   //加热洗脱孔位  AS153=9孔，AS154=4、5、6孔可选,AS155=7孔

	//OEM标志
	unsigned char  OemFlag;                               //0表示ALLSHENG，1表示中性
}ADVANCE_PRAMETER;
