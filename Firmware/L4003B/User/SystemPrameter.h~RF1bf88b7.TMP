	RUNNING_TEMPER_CMD,
	RUNNING_MOVETO_MIXING,
	RUNNING_MOVETO_MIXING_CMD,
	RUNNING_MOVETO_MIXING_OK,
	RUNNING_MIXING,
	RUNNING_MIXING_CMD,  //0x0a
	RUNNING_MOVETO_MAGNETIC,
	RUNNING_MOVETO_MAGNETIC_CMD,
	RUNNING_MOVETO_MAGNETIC_OK,
	RUNNING_MAGNETIC,
	RUNNING_MAGNETIC_CMD,  //0x0a0f
	RUNNING_MOVETO_WAIT,
	RUNNING_MOVETO_WAIT_CMD,
	RUNNING_MOVETO_WAIT_OK,
	RUNNING_WAIT,
	RUNNING_OVER,
};

