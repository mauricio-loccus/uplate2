//1.1.故障报警宏定义
enum ERRCODE                  //故障代码列表
{
	ERRCODE_E2P = 0x0001,       //E2PROM故障
	
	ERRCODE_RTC = 0x0002,          //RTC故障
	ERRCODE_NANDFLASH = 0x0004,  //NANDFLASH故障
	ERRCODE_SDRAM = 0x0008,       //SDRAM故障
	ERRCODE_UART = 0x0010,         //UART故障

	ERRCODE_MOTOR_LEVEL = 0x0100,         //水平电机故障
	ERRCODE_MOTOR_MAGNETIC = 0x0200,         //磁棒故障
	ERRCODE_MOTOR_MAGNETIC_ROD = 0x0400,    //磁棒套故障

	ERRCODE_ADVANCE = 0x0800,      //高级参数丢失故障
	ERRCODE_PROGRAM = 0x1000,         //程序文件损坏
	ERRCODE_TEMP_FAN = 0x2000,    //冷却风扇驱动电路损坏
	ERRCODE_SHAKE_LOCK=0x4000,    //刹车锁电路损坏
	ERRCODE_EXHAUST_FAN = 0x8000,    //排气风扇驱动电路损坏
	
	
	//ERRCODE_ADVANCE=0x00010000,          //高级参数丢失
  ERRCODE_UART_CMD=0x00020000,         //串口命令响应失败
	ERRCODE_UART_ACTTION=0x00040000,     //串口动作响应失败
	ERRCODE_ADJ_TEMP=0x00080000,         //校温参数丢失
};

