{
	RUN_STATUS_STOP=0,
	RUN_STATUS_RUN_READY,
	RUN_STATUS_RUNNING,
	RUN_STATUS_PAUSE,
	
	RUN_STATUS_OVER_WAIT,//运行结束，发回原点命令
	RUN_STATUS_STOP_WAIT,//运行人为结束，发回原点命令
	RUN_STATUS_OVER,//电机已经回到原点
};
