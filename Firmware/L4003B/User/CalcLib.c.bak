int GaussianElimination(int n)
{
	int nStart = CalcuPara.N - n,i,j;
	double dMax = CalcuPara.aa[0][nStart];
	int nMax = 0;

	for(i = 0; i < n; i++) //找出最大系数
	{
        if(dMax < CalcuPara.aa[i][nStart])
		{
            dMax = CalcuPara.aa[i][nStart];
			nMax = i;
		}
	}

	if(nMax != n - 1) //交换
	{
 	    double dTemp;
        for(i = nStart; i < CalcuPara.N; i++)
		{
            dTemp = CalcuPara.aa[nMax][i];
			CalcuPara.aa[nMax][i] = CalcuPara.aa[n - 1][i];
			CalcuPara.aa[n - 1][i] = dTemp;
		}

		dTemp = CalcuPara.bb[nMax];
		CalcuPara.bb[nMax] = CalcuPara.bb[n - 1];
		CalcuPara.bb[n - 1] = dTemp;
	}

	for(i = 0; i < n - 1; i++) //消去
	{
		double dTemp = CalcuPara.aa[i][nStart];
		if(CalcuPara.aa[n - 1][nStart] == 0.0f)
		{
            return ANALYSIS_ERROR;
		}
        for(j = nStart; j < CalcuPara.N; j++)
		{
            CalcuPara.aa[i][j] -= CalcuPara.aa[n - 1][j] / CalcuPara.aa[n - 1][nStart] * dTemp;
		}

		CalcuPara.bb[i] -= CalcuPara.bb[n - 1] / CalcuPara.aa[n - 1][nStart] * dTemp;
	}

	if(n > 2) //递归
	{
        return GaussianElimination(n - 1);
	}
	else
	{
		return ANALYSIS_SUCCESS;
	}
}





//创建线性方程，得到x,y，及Total
int LinearEquationCreate(double* a1, double* b1, int N1)
{
	int i;
	if(NULL == a1 || NULL == b1 || N1<2)
	{
		return ANALYSIS_ERROR;
	}

	CalcuPara.N = N1;
	if(CalcuPara.N > 1)
	{
		for(i = 0; i < CalcuPara.N; i++)
		{
		    memcpy(CalcuPara.aa[i], a1 + (i * CalcuPara.N), sizeof(double) * CalcuPara.N);
		}
		memcpy(CalcuPara.bb, b1, sizeof(double) * CalcuPara.N);

		return GaussianElimination(CalcuPara.N);
	}

	return ANALYSIS_ERROR;
}

int LinearEquationGetSolution(double* x1)
{
	int i,j;
	double dTemp;
	for(i = 0; i < CalcuPara.N; i++)
	{
		if(i == 0)
		{
			if(CalcuPara.aa[i][CalcuPara.N - 1] == 0.0f)
			{
				return ANALYSIS_ERROR;
			}
            x1[CalcuPara.N - 1] = CalcuPara.bb[i] / CalcuPara.aa[i][CalcuPara.N - 1]; 
			continue;
		}
		dTemp = CalcuPara.bb[i];
		for(j = CalcuPara.N - 1; j > CalcuPara.N -1 - i; j--)
		{
            dTemp -= (CalcuPara.aa[i][j] * x1[j]);
		}

		if(CalcuPara.aa[i][CalcuPara.N - 1 - i] == 0.0f)
		{
			return ANALYSIS_ERROR;
		}
		x1[CalcuPara.N - 1 - i] = dTemp / CalcuPara.aa[i][CalcuPara.N - 1 - i];
	}
	 
	return ANALYSIS_SUCCESS;
}


//矩阵函数开始
double *GetComplement(double *val,double *a2, int n, int nx, int ny)
	{
		//double *d_tmp1  = new double[(n-1) * (n-1)];
	   // double *d_tmp1= (double *)malloc(sizeof(double) *(n-1) * (n-1));
		double *d_tmp1;
		int i,j;
		
    d_tmp1=val;
		if(a2 == NULL || nx > n || ny > n || nx <1 || ny<1)
		{
			return NULL;
		}				

		
		for(i=0; i<(nx-1); i++ )
		{
			for(j=0; j<(ny-1); j++)
				d_tmp1[i*(n-1)+j] = a2[i*n + j];
			for(j=(ny-1); j<(n-1); j++)
				d_tmp1[i*(n-1) + j] = a2[i*n + j+1];
		}
	
		for(i=(nx-1); i<(n-1); i++ )
		{
			for(j=0; j<(ny-1); j++)
				d_tmp1[i*(n-1) + j] = a2[(i+1)*n + j];
			for(j=(ny-1); j<(n-1); j++)
				d_tmp1[i*(n-1) + j] = a2[(i+1)*n + j + 1];
		}
		return CalcuPara.d_tmp1;				
	}

	double CalculateDeterminantN(double *a2, int n)
	{	
		double ret = 0;	
		
       // double *a3 = new double[(n-1)*(n-1)];
		//double *a3 = (double *)malloc(sizeof(double) * (n-1)*(n-1));
		int i;

		if(a2 == NULL ||  n<2 )
		{
			//return NULL;
			return 0;//lgj170729
		}	

		
		if(n == 2)
		{
		//	double ret1;
			//ret1 = a2[0][0]*a2[1][1] - a2[0][1]*a2[1][0];
			//ret1=a2[0]*a2[3]-ret-a2[1]*a2[2];
			//ret1=a2[0]*a2[3];
			ret=a2[0]*a2[3]-a2[1]*a2[2];
			//ret = a2[0]*a2[3] - a2[1]*a2[2];
			return (ret);	
		}	
		else if(n> 2)
		{			
			 double a3[3*3];
			//double *a3 = new double[(n-1)*(n-1)];
			for(i=0; i<n; i++)
			{
				//Log.e("wenqg", "i= " + i +", n is " + n);
				GetComplement(a3,a2, n, 1, i+1);//lgj171202,CalcuPara.a5
				ret += a2[i] *pow(-1.0, (1+i+1)) * CalculateDeterminantN(a3, n-1);//CalcuPara.a5
				//Log.e("wenqg", "n= " + n +", ret n is "+ ret);
			}
			//Log.e("wenqg", "total return is " + ret );
			return ret;				
		}
		else
			return ret;
	}

	double *getInverseMatrix(double *val,double *a2, int n)//逆矩阵
	{	
		double *p;
		double d1 = 0;

   // double a4[4*4];
	  //double *a5 = (double *)malloc(sizeof(double) * 2*2);
	//	double *a3 = (double *)malloc(sizeof(double) * n*n);
		//double *a4 = (double *)malloc(sizeof(double) * (n-1)*(n-1));

		
		//double *a5 = new double[2*2];
		//double *a3 = new double[n * n];
		//double *a4 = new double[(n-1)*(n-1)];
		int i,j;
    p=val;
		if(a2 == NULL ||  n<2 )
		{
			return NULL;
		}

		
		if(2 == n)
		{
			d1 = CalculateDeterminantN(a2, n);
			
			if(0 == d1)
			{
				return NULL;
			}
			
			//double *a5 = new double[2*2];
			p[0] = a2[3];
			p[1] = -a2[1];
			p[2] = -a2[2];
			p[3] = a2[0];
			
			for(i=0; i<2; i++)
			{
				for(j=0; j<2; j++)
				{
					p[i*2+j] /= d1;
				}
			}			
      //memcpy(p,a5,2*2);			
			//free(a4);
			return p;
		}

		//double *a3 = new double[n * n];
		//double *a4 = new double[(n-1)*(n-1)];
		d1=CalculateDeterminantN(a2, n);
		if(0 == d1)
		{
			return NULL;
		}
		
		for(i=0; i<n; i++)
		{
			for(j=0; j<n; j++)
			{	
				GetComplement(CalcuPara.a4,a2, n, j+1, i+1);
				p[i*n+j] = pow(-1.0, i+1+j+1) * CalculateDeterminantN(CalcuPara.a4, n-1); 
				p[i*n+j] /= d1;
			}			
		}
		
	
		return p;
	}

	//Matrix: mxn; Matrix: nxk 	
	double *MatrixMulty(double* val, double* a1, int m, int n, double* b1, int k)
	{	
	//	double* d1 = new double[m * k];
		double *d1;
	
		//double *d1= (double *)malloc(sizeof(double) * m*k);
		int i,l,j;

    d1=val;
		if(NULL == a1 || NULL == b1 || m<1 || n<1 || k<1 )
		{
			return NULL;
		}

		
		for(i=0; i<m; i++)
		{
			for(j=0; j<k; j++)
			{	d1[i*k + j] = 0.0;
				for(l=0; l<n; l++)
				{
					d1[i*k + j] += a1[i*n+l] * b1[l*k+j];
				}
			}
		}
		return d1;
	}	
	
	double *MatrixReverse(double *val,double* a1, int m, int n)
	{
		double *d2;
		
		int i,j;
		
		d2=val;
		//double* d2 = new double[n * m];
   // double *d2= (double *)malloc(sizeof(double) * n*m);
		if(NULL == a1 || m<1 || n<1)
		{
			return NULL;
		}

		
		for(i=0; i<n; i++)
		{
			for(j=0; j<m; j++)
				d2[i*m + j] = a1[i + j*n];
		}
		return d2;
	}
//矩阵函数结束

//最小二乘法开始
int LsmCreate(double* pX, double* pY, int nTotal)
{
	//m_pXLsm = NULL;
	//m_pYLsm = NULL;
	CalcuPara.m_nTotal = 0;

	if(NULL == pX || NULL == pY || nTotal<2)
	{
		return -1;
	}

	//m_pXLsm = new double[nTotal];
	//m_pYLsm = new double[nTotal];
	{
//	    m_pXLsm= (double *)malloc(sizeof(double) *nTotal);
	  //  m_pYLsm= (double *)malloc(sizeof(double) *nTotal);
	}

	CalcuPara.m_nTotal = nTotal;
	memcpy(CalcuPara.m_pXLsm, pX, nTotal * sizeof(double));
	memcpy(CalcuPara.m_pYLsm, pY, nTotal * sizeof(double));
	return 0;
}

double GetAverageX(void)
{
	double dAverage = 0.0;
  int i;

	for(i = 0; i < CalcuPara.m_nTotal; i++)
	{
        dAverage += CalcuPara.m_pXLsm[i];
	}

	return (dAverage / (double)CalcuPara.m_nTotal);
}

double GetAverageY(void)
{
	double dAverage = 0.0f;
	int i;

	for(i = 0; i < CalcuPara.m_nTotal; i++)
	{
        dAverage += CalcuPara.m_pYLsm[i];
	}

	return (dAverage / (double)CalcuPara.m_nTotal);
}

double GetAverageXX(void)
{
	int i;
	double dAverage = 0.0;

	for(i = 0; i < CalcuPara.m_nTotal; i++)
	{
        dAverage += (CalcuPara.m_pXLsm[i] * CalcuPara.m_pXLsm[i]);
	}

	return (dAverage / (double)CalcuPara.m_nTotal);
}

double GetAverageYY(void)
{
	int i;
	double dAverage = 0.0;

	for(i = 0; i < CalcuPara.m_nTotal; i++)
	{
        dAverage += (CalcuPara.m_pYLsm[i] * CalcuPara.m_pYLsm[i]);
	}

	return (dAverage / (double)CalcuPara.m_nTotal);
}

double GetAverageXY(void)
{
	double dAverage = 0.0;
	int i;

	for(i = 0; i < CalcuPara.m_nTotal; i++)
	{
        dAverage += (CalcuPara.m_pYLsm[i] * CalcuPara.m_pXLsm[i]);
	}

	return (dAverage / (double)CalcuPara.m_nTotal);
}

double LsmGetRR(int* nErrorCode) //相关系数
{
	double dTemp, dTemp1;
	dTemp = GetAverageXY() - GetAverageX() * GetAverageY();
	dTemp *= dTemp;
	dTemp1 = ((GetAverageXX() - GetAverageX() * GetAverageX()) * (GetAverageYY() - GetAverageY() * GetAverageY()));

	*nErrorCode = ANALYSIS_SUCCESS;
	if(dTemp1 != 0.0f)
	{
	    dTemp /= dTemp1;
	}
	else
	{
	    *nErrorCode = ANALYSIS_ERROR_FITTING_FAIL;
	}

	return dTemp;
}

double LsmGetSlope(int* nErrorCode) //斜率
{
	double dTemp, dTemp1;
	dTemp = GetAverageXY() - GetAverageX() * GetAverageY();
	dTemp1 = (GetAverageXX() - GetAverageX() * GetAverageX());
	*nErrorCode = ANALYSIS_SUCCESS;
	if(dTemp1 != 0.0f)
	{
	    dTemp /= dTemp1;
	}
	else
	{
	    *nErrorCode = ANALYSIS_ERROR_FITTING_FAIL;
	}
	return dTemp;
}

double LsmGetIntercept(int* nErrorCode) //截距
{
	return GetAverageY() - LsmGetSlope(nErrorCode) * GetAverageX();
}
//最小二乘法结束



//四参数开始
void GetCoef(double* dCoef)
{
	dCoef[0] = CalcuPara.a;
	dCoef[1] = CalcuPara.b;
	dCoef[2] = CalcuPara.c;
	dCoef[3] = CalcuPara.d;
}

double GetY(double dX)
{
	double dTemp = pow((dX / CalcuPara.c), CalcuPara.b);
	return (CalcuPara.d + (CalcuPara.a - CalcuPara.d) / (1 + dTemp));
}

//void LogisticGetRR(double *dRR)
double LogisticGetRR(void)
{
	double dTemp = 0.0f;
	double dTemp1 = 0.0f;
	int i;
	for(i = 0; i < CalcuPara.m_nTotal; i++)
	{
        dTemp += ((CalcuPara.m_pY[i] - GetY(CalcuPara.m_pX[i])) * (CalcuPara.m_pY[i] - GetY(CalcuPara.m_pX[i])));
        dTemp1 += ((CalcuPara.m_pY[i] - CalcuPara.m_dYAverage) * (CalcuPara.m_pY[i] - CalcuPara.m_dYAverage));
	}

	return (1 - dTemp / dTemp1);
}



double GetDYDA(double dX)
{
	double dTemp = pow((dX / CalcuPara.c), CalcuPara.b);
	return (1.0f / (1 + dTemp));
}

void SetYMin(double dYMin)
{
    CalcuPara.m_dYMin = dYMin;
}

void SetYMax(double dYMax)
{
    CalcuPara.m_dYMax = dYMax;
}

double GetDYDD(double dX)
{
	double dTemp = pow((dX / CalcuPara.c), CalcuPara.b);
	return (1.0f - 1.0f / (1 + dTemp));
}

double GetDYDC(double dX)
{
	double dTemp = pow((dX / CalcuPara.c), CalcuPara.b);
	return ((CalcuPara.b / CalcuPara.c) * ((CalcuPara.a - CalcuPara.d) / ((1 + dTemp) * (1 + dTemp))) * dTemp);
}

double GetDYDB(double dX)
{
	double dTemp = pow((dX / CalcuPara.c), CalcuPara.b);
	return -((dTemp) * (log(dX / CalcuPara.c)) * ((CalcuPara.a - CalcuPara.d) / ((1 + dTemp) * (1 + dTemp))));
}

unsigned char GetInitBC()
{
	int i;
	int nErrorCode;
	double dTemp;

	for(i = 0; i < CalcuPara.m_nTotal; i++)
	{
        CalcuPara.m_pXInit[i] = log10(CalcuPara.m_pX[i]);
		    CalcuPara.m_pYInit[i] = log10((CalcuPara.m_pY[i] - CalcuPara.a) / (CalcuPara.d - CalcuPara.m_pY[i]));
	}

//	CLeastSquareMethod* pLSM = new CLeastSquareMethod;
	LsmCreate(CalcuPara.m_pXInit, CalcuPara.m_pYInit, CalcuPara.m_nTotal);
	
	CalcuPara.b = LsmGetSlope(&nErrorCode);
	if(nErrorCode != ANALYSIS_SUCCESS)
	{	//printf("GetInitBC return 111!\n");	
       // return false;
	    return ANALYSIS_ERROR;
	}
    
	dTemp = LsmGetIntercept(&nErrorCode);
	if(nErrorCode != ANALYSIS_SUCCESS)
	{
	//	printf("GetInitBC return 222!\n");
      //  return false;
		return ANALYSIS_ERROR;
	}

	CalcuPara.c = pow(10.0, -dTemp / CalcuPara.b);
	//return true;
	return ANALYSIS_SUCCESS;
}

