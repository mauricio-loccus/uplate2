			    return ANALYSIS_ERROR;
			 }

			  if(MatrixMulty(CalcuPara.H,CalcuPara.JReserve, 4, CalcuPara.m_nTotal, CalcuPara.J, 4)==NULL) //J的转置*J
			  {	
			      return ANALYSIS_ERROR;
			  }
			 //H_lm= (double *)malloc(sizeof(double) *4*4);


            for (i = 0; i < 4; i++)
            {
                for (j = 0; j < 4; j++)
                {
                    if (i == j)
                        CalcuPara.H_lm[i*4+j] = CalcuPara.H[i*4+j] + lamda;
                    else 
						 CalcuPara.H_lm[i*4+j] = CalcuPara.H[i*4+j];
                }
            }
           

		
       // if(getInverseMatrix(CalcuPara.a2,(double *)CalcuPara.H_lm, 4)==NULL)//逆
			 if(getInverseMatrix(CalcuPara.a2,CalcuPara.H_lm, 4)==NULL)//逆
			 {	
			    return ANALYSIS_ERROR;
			 }
			 if(MatrixMulty(CalcuPara.a3,CalcuPara.a2, 4, 4, CalcuPara.JReserve,CalcuPara. m_nTotal)==NULL)//矩阵相乘
			 {	
			      return ANALYSIS_ERROR;
			 }
			 if(MatrixMulty(CalcuPara.dp,CalcuPara.a3, 4, CalcuPara.m_nTotal,CalcuPara.dc, 1)==NULL)//矩阵相乘
			 {	
			     return ANALYSIS_ERROR;
			 }
			
            for (i = 0; i < 4; i++)
            {
                CalcuPara.value[i + 1] = CalcuPara.dp[i*1+0];
            }

			
		//r2= (double *)malloc(sizeof(double) *xs);
           // r2 = new double[xs];
            for (zk = 0; zk < xs; zk++)
            {
                double rss = 0;
                double tss = 0;

                CalcuPara.a_lm = CalcuPara.a + ck * CalcuPara.value[1];
                CalcuPara.b_lm = CalcuPara.b + ck * CalcuPara.value[2];
                CalcuPara.c_lm = CalcuPara.c + ck * CalcuPara.value[3];
                CalcuPara.d_lm = CalcuPara.d + ck * CalcuPara.value[4];


                for (i = 0; i < CalcuPara.m_nTotal; i++)
                {
                   dTemp = pow((CalcuPara.m_pX[i] / CalcuPara.c_lm), CalcuPara.b_lm);
                    CalcuPara.ycal_lm[i] = CalcuPara.d_lm + (CalcuPara.a_lm - CalcuPara.d_lm) / (1 + dTemp);
                }

                for (i = 0; i < CalcuPara.m_nTotal; i++)
                {
                    rss += (pow((CalcuPara.m_pY[i] - CalcuPara.ycal_lm[i]), 2));
                    tss += (pow((CalcuPara.m_pY[i] - CalcuPara.m_dYAverage), 2));
                }
                if (tss == 0)
                    CalcuPara.r2[zk] = 0;
                else if (rss == 0)
                    CalcuPara.r2[zk] = 1;
                else 
					          CalcuPara.r2[zk] = 1 - rss / tss;

                ck = ck / 2;
            }//for (zk = 0; zk < xs; zk++)

			
            col = 0;
			
			      row = CalcuPara.r2[0];
            for (i = 1; i < xs; i++)
            {
                if (row < CalcuPara.r2[i])
                {
                    row = CalcuPara.r2[i];
                    col = i;
                }
            }//for (i = 1; i < xs; i++)
			
            dcol = pow(2.0, col);
			
            CalcuPara.a_lm = CalcuPara.a + CalcuPara.value[1] * (1 / dcol);
            CalcuPara.b_lm = CalcuPara.b + CalcuPara.value[2] * (1 / dcol);
            CalcuPara.c_lm = CalcuPara.c + CalcuPara.value[3] * (1 / dcol);
            CalcuPara.d_lm = CalcuPara.d + CalcuPara.value[4] * (1 / dcol);

            for (i = 0; i < CalcuPara.m_nTotal; i++)
                CalcuPara.dc_lm[i] = CalcuPara.m_pY[i] - CalcuPara.ycal_lm[i];//Y的差值

            if (row > rr2)
            {
                lamda = lamda / 4;
                rr2 = row;
                CalcuPara.a = CalcuPara.a_lm;
                CalcuPara.b = CalcuPara.b_lm;
                CalcuPara.c = CalcuPara.c_lm;
                CalcuPara.d = CalcuPara.d_lm;
                upJ = 1;
            }
            else
            {
                upJ = 0;
                lamda = lamda * 4;
            }

            if ((lamda > 10000000000) || (lamda < 0.0000000001))
            {
                break;
            }
            if (rr2 == 1)
            {
                break;
            }
            //if ((fabs(std - row) < 0.0000001f) && (row != 0))
						if ((fabs(std - row) < 0.0000001f) && (row != 0))
                re = re + 1;
            else 
				       re = 0;

            if (re == 6)
                break;

            std = row;
            if (it > 500)
            {
                xs = 10;
            }
        }
		return ANALYSIS_SUCCESS;
}

unsigned char LogisticCreate(double* pX, double* pY, int nTotal)
{
		
	    int min;
	    double d_tmp;
		 int i,j;
		 double Min , Max;

	  //   m_pX= (double *)malloc(sizeof(double) *nTotal);
       //  m_pY= (double *)malloc(sizeof(double) *nTotal);
	    // m_pXInit= (double *)malloc(sizeof(double) *nTotal);
      //   m_pYInit= (double *)malloc(sizeof(double) *nTotal);

	     CalcuPara.m_nTotal = nTotal;

		
        if(nTotal <= 4)
	    {
		       return ANALYSIS_ERROR;
	    }

	



		for(i = 0; i < CalcuPara.m_nTotal; i++)
		{
			min = i;
			for(j = i+1; j < CalcuPara.m_nTotal; j++)
			{
				if(pX[j] < pX[min])
				{
					min = j;
				}
			}
			
			if(min == i)
			{
				continue;
			}
			
			d_tmp = pX[i];
			pX[i] = pX[min];
			pX[min] = d_tmp;
			
			d_tmp = pY[i];
			pY[i] = pY[min];
			pY[min] = d_tmp;			
		}//for(i = 0; i < m_nTotal; i++)	
	
		memcpy(CalcuPara.m_pX, pX, nTotal * sizeof(double));
		memcpy(CalcuPara.m_pY, pY, nTotal * sizeof(double));
			

		Min = CalcuPara.m_pY[0], Max = CalcuPara.m_pY[0];
		
		for(i = 1; i < CalcuPara.m_nTotal; i++)
		{
			if(Min > CalcuPara.m_pY[i])
			{
				Min = CalcuPara.m_pY[i];
			}
			
			if(Max < CalcuPara.m_pY[i])
			{
				Max = CalcuPara.m_pY[i];
			}
		}	

		if(Min <= 0)
		{
			return ANALYSIS_ERROR;//false;
		}

//IMPORTANT NOTE:		
//wenqg, 20170306 16:30		
		if(CalcuPara.m_pX[0] == 0)
		{
			CalcuPara.m_pX[0] = CalcuPara.m_pX[1] * 0.001f;
		}
//add end	

		SetYMin(Min);
		SetYMax(Max);	
		
		return InitPara();
		//}
}

	double LogisticCalculateXValue(double f)
	{
		double d_t1 = (f - CalcuPara.a) / (CalcuPara.d - f);
		double t1 = log10(d_t1) / CalcuPara.b + log10(CalcuPara.c);
		t1 = pow(10.0, t1);
		return t1;
	}
//四参数结束




//三次样条开始
unsigned char InitSplinePara(void)
{
	int i,j,k;
	for(i = 0; i < CalcuPara.m_nTotal - 1; i++)
	{
		CalcuPara.m_dH[i] = CalcuPara.m_pXSpline[i + 1] - CalcuPara.m_pXSpline[i];
		CalcuPara.m_dDerivative[i] = (CalcuPara.m_pYSpline[i + 1] - CalcuPara.m_pYSpline[i]) / CalcuPara.m_dH[i];
	}
	CalcuPara.m_dH[ CalcuPara.m_nTotal - 1] = 0;

	for(i = 1; i < CalcuPara.m_nTotal -1; i++)
	{
        CalcuPara.m_dMiu[i] = CalcuPara.m_dH[i - 1] / (CalcuPara.m_dH[i -1] + CalcuPara.m_dH[i]);
        CalcuPara.m_dLamda[i] = CalcuPara.m_dH[i] / (CalcuPara.m_dH[i -1] + CalcuPara.m_dH[i]);
		CalcuPara.m_dD[i - 1] = 6.0f * (CalcuPara.m_dDerivative[i] - CalcuPara.m_dDerivative[i - 1]) / (CalcuPara.m_pXSpline[i + 1] - CalcuPara.m_pXSpline[i - 1]);
	}		

	CalcuPara.m_dM[0] = 0.0f;
	CalcuPara.m_dM[CalcuPara.m_nTotal - 1] = 0.0f;
	if(CalcuPara.m_nTotal == 3)
	{
        CalcuPara.m_dM[1] = CalcuPara.m_dD[0] / 2.0f;
	}
	else //4个以上点需解方程
	{
        for(i = 0; i < CalcuPara.m_nTotal - 2; i ++)
		{
			for(j = 0; j < CalcuPara.m_nTotal - 2; j++)
			{
				k = i * (CalcuPara.m_nTotal - 2) + j;
				CalcuPara.m_dAB[k] = 0.0;
        if(i == 0)
				{
          if(j == 0)
					{
						CalcuPara.m_dAB[k] = 2.0;
					} //if(j == 0)
					else if(j == 1)
					{
						CalcuPara.m_dAB[k] = CalcuPara.m_dLamda[1];
					} //else if(j == 1)
				} //if(i == 0)
				else if(i == CalcuPara.m_nTotal - 3)
				{
                    if(j == CalcuPara.m_nTotal - 3)
					{
						CalcuPara.m_dAB[k] = 2.0f;
					} //if(j == m_nTotal - 3)
					else if(j == CalcuPara.m_nTotal - 4)
					{
						CalcuPara.m_dAB[k] = CalcuPara.m_dMiu[CalcuPara.m_nTotal - 2];
					} //else if(j == m_nTotal - 4)
				} //else if(i == m_nTotal - 3)
				else
				{
                    if(j == i - 1)
					{
						CalcuPara.m_dAB[k] = CalcuPara.m_dMiu[i + 1];
					} //if(j == i - 1)
					else if(j == i)
					{
						CalcuPara.m_dAB[k] = 2.0f;
					} //else if(j == i)
					else if(j == i + 1)
					{
						CalcuPara.m_dAB[k] = CalcuPara.m_dLamda[i + 1];
					} //else if(j == i + 1)
				} //else if(i == m_nTotal - 3)
			} //for(int j = 0; j < m_nTotal - 2; j++)
		} //for(int i = 0; i < m_nTotal - 2; i ++)

//		CLinearEquation* p_LE = new CLinearEquation;
		if(LinearEquationCreate(CalcuPara.m_dAB, CalcuPara.m_dD, CalcuPara.m_nTotal - 2))
		{
//			delete p_LE;
			return ANALYSIS_ERROR;//false;
		}
		else
		{
			int tmp = LinearEquationGetSolution((double*)(CalcuPara.m_dM + 1));
			if(0 != tmp)
			{
//				delete p_LE;
				return ANALYSIS_ERROR;//false;
			}
//			delete p_LE;
		}
	} //if(m_nTotal == 3)

	return ANALYSIS_SUCCESS;//true;
}

void GetM(double* dM)
{
	if(NULL == dM)
	{
		return;
	}
	memcpy(dM, CalcuPara.m_dM, sizeof(double) * SPLINE_POINT_MAX);
}

void GetH(double* dH)
{
	if(NULL == dH)
	{
		return;
	}
	memcpy(dH, CalcuPara.m_dH, sizeof(double) * SPLINE_POINT_MAX);
}

unsigned char SplineCreate(double* pX, double* pY, int nTotal)
{
	if(NULL == pX || NULL==pY || nTotal<3)
	{
		return ANALYSIS_ERROR;//false;
	}
	{
		int min;
	  double d_tmp;
		int i,j;
		//m_pXSpline= (double *)malloc(sizeof(double) *nTotal);
	//	m_pYSpline= (double *)malloc(sizeof(double) *nTotal);
	//m_pXSpline = new double[nTotal];
	//m_pYSpline = new double[nTotal];
	CalcuPara.m_nTotal = nTotal;
	CalcuPara.loopCount = 30;


	
	


	for(i = 0; i < CalcuPara.m_nTotal; i++)
	{
			min = i;
			for(j = i+1; j < CalcuPara.m_nTotal; j++)
			{
				if(pX[j] < pX[min])
				{
					min = j;
				}
			}
			
			if(min == i)
			{
				continue;
			}
			
			d_tmp = pX[i];
			pX[i] = pX[min];
			pX[min] = d_tmp;
			
			d_tmp = pY[i];
			pY[i] = pY[min];
			pY[min] = d_tmp;			
	}

	memcpy(CalcuPara.m_pXSpline, pX, nTotal * sizeof(double));
	memcpy(CalcuPara.m_pYSpline, pY, nTotal * sizeof(double));
	}
	return InitSplinePara();
}

 double SplineCalculateYValue(double dx)
	{
		int i= 0; 
		double h = 0.0; double res = 0.0;
		for(i=0; i<(CalcuPara.m_nTotal-1); i++)
		{
			if(CalcuPara.m_pXSpline[i] <= dx && CalcuPara.m_pXSpline[i+1] >= dx)
			{
				break;
			}
		}
		//Log.e("wenqg", "i is " +i);
		if(i < (CalcuPara.m_nTotal-1))
		{
			h = CalcuPara.m_pXSpline[i+1] - CalcuPara.m_pXSpline[i];
			res = (CalcuPara.m_pXSpline[i+1] - dx)*(CalcuPara.m_pXSpline[i+1] - dx)*(CalcuPara.m_pXSpline[i+1] -dx)*CalcuPara.m_dM[i]/6/h;
			res -= (CalcuPara.m_pXSpline[i] - dx)*(CalcuPara.m_pXSpline[i] - dx)*(CalcuPara.m_pXSpline[i] - dx)*CalcuPara.m_dM[i+1]/6/h;
			res += (CalcuPara.m_pYSpline[i] - h*h*CalcuPara.m_dM[i]/6)*(CalcuPara.m_pXSpline[i+1] -dx)/h;
			res -= (CalcuPara.m_pYSpline[i+1] - h*h*CalcuPara.m_dM[i+1]/6)*(CalcuPara.m_pXSpline[i] -dx)/h;
			//Log.e("wenqg", "res is " + res);
			return res;
		}
		return 0;
	}

double  ErFenFa_CalculateXValue(double dy)
 {
	 //找d值的区间
	 int pos = -1; //int flag = -1;
	 int i;
	 for(i=0; i<(CalcuPara.m_nTotal-1);i++)
	 {			
		 if((dy -CalcuPara.m_pYSpline[i])* (dy - CalcuPara.m_pYSpline[i+1]) < 0)
			{
				pos = i;
				break;
		 } 			
	 }
	 if(pos < 0)
	 {	
		 return 0;
	 }

	 {
	 double x1 =  CalcuPara.m_pXSpline[pos];
	 double x2 =  CalcuPara.m_pXSpline[pos+1];
	 double dMid = 0;double x = 0;
	 double dFa = 0, dFb = 0; int Count = 0;
	 
	 for(Count=0; Count < CalcuPara.loopCount; Count++)
	 {
		 x = (x1+x2)/2;
		 dMid = SplineCalculateYValue(x);
		 if(abs(dy-dMid) < pow(10.0, -6))
			{
				break;
			}

		 dFa = SplineCalculateYValue(x1);
		 dFb = SplineCalculateYValue(x2);			
		 if((dFa - dy) * (dMid - dy) < 0)
			{
				x2 = x;
		 }			
		 else if((dFb - dy) * (dMid - dy) < 0)
			{
				x1 = x;
			}
		 else
		 {	
			 x = 0;	
			 break;
		 }				
	 }
	
//	 Log.e("wenqg", "ErFenFa: x is " + x +", loopCount is " + Count);
	 return x;
	  }
 }

 double calculateDerivative(double dx)
 {
	 int i= 0;
	 double dTemp = 0;

	 for(i=0; i<(CalcuPara.m_nTotal-1); i++)
	 {
		 if(CalcuPara.m_pXSpline[i] <= dx && CalcuPara.m_pXSpline[i+1] >= dx)
			{
				break;
			}
	 }

	 
	 if(i < (CalcuPara.m_nTotal-1))
	 {
		 dTemp -= (CalcuPara.m_pXSpline[i+1] -dx) * (CalcuPara.m_pXSpline[i+1] -dx) *CalcuPara.m_dM[i]/2/CalcuPara.m_dH[i];
		 dTemp += (CalcuPara.m_pXSpline[i] -dx) * (CalcuPara.m_pXSpline[i] -dx) *CalcuPara.m_dM[i+1]/2/CalcuPara.m_dH[i];
		 dTemp += (CalcuPara.m_dH[i] * CalcuPara.m_dM[i]/6 - CalcuPara.m_pYSpline[i]/CalcuPara.m_dH[i]);
		 dTemp += (CalcuPara.m_pYSpline[i+1]/CalcuPara.m_dH[i] - CalcuPara.m_dH[i] * CalcuPara.m_dM[i+1]/6);
	 }
	 return dTemp;
 }

 double NewTonCalculateXValue(double dy)
 {
	 int i;

	 //找d值的区间
	 int pos = -1; //int flag = -1;
	 for(i=0; i<(CalcuPara.m_nTotal-1);i++)
	 {			
		 if((dy -CalcuPara.m_pYSpline[i])* (dy - CalcuPara.m_pYSpline[i+1]) < 0)
			{
				pos = i;
				break;
		 } 			
	 }
	 if(pos < 0)
	 {	
		 return 0;
	 }
	 {
	 double p0 = CalcuPara.m_pXSpline[pos], p = 0, dTemp = 0;
	 int Count = 0;
	
	 for(Count=0; Count < CalcuPara.loopCount; Count++)
	 {
		 dTemp = calculateDerivative(p0);
		 if(0 == dTemp)
			{
				p = 0;
				break;
			}

		 p = p0 - (SplineCalculateYValue(p0)-dy)/calculateDerivative(p0);			
		 if(abs((p-p0)/p) < pow(10.0, -6))
			{
				break;
			}
		 else
			 p0 = p;		
	 }
	  
//	 Log.e("wenqg", "NewTon: x is " + p +", loopCount is " + Count);
	 return p;
	 }
 }

 double GeXianFaCalculateXValue(double dy)
 {
	 //找d值的区间
	 int pos = -1,i;
	 for(i=0; i<(CalcuPara.m_nTotal-1);i++)
	 {			
		 if((dy -CalcuPara.m_pYSpline[i])* (dy - CalcuPara.m_pYSpline[i+1]) < 0)
			{
				pos = i;
				break;
		 } 			
	 }
	 if(pos < 0)
	 {	
		 return 0;
	 }

	 {
	   double p0 = CalcuPara.m_pXSpline[pos], p1 = CalcuPara.m_pXSpline[pos+1], q0 = 0, q1 = 0, p = 0;
	   int Count = 0;
	
	 q0 = SplineCalculateYValue(p0) - dy;
	 q1 = SplineCalculateYValue(p1) - dy;
	
	 for(Count=0; Count < CalcuPara.loopCount; Count++)
	 {
		 if(q1 == q0)
			{
				p = 0;
				break;
			}

		 p = p1 - q1*(p1-p0)/(q1-q0);			
		 if(abs((p-p1)) < pow(10.0, -6))
			{
				break;
			}
		 else
			{
				p0 = p1;
				q0 = q1;
				p1 = p;
				q1 = SplineCalculateYValue(p) - dy;
		 }					
	 }
	 
	 return p;
	  }
 }

 void setLoopCount(int value)
 {
	 if(value <= 10)
	 {
		 CalcuPara.loopCount = 10;
	 }
	 else
	 {
		 CalcuPara.loopCount = value;
	 }
 }




