}

void FilterSet_Interface(void)
{
	
	unsigned char i;
	TouchKey.KeyStatus=1;
	ExpEnable = 0;
	for(i=0;i<FILTER_MAX;i++)
	{
	      FilterVal[i]=FilterLun.Filter[i];
	}

	FilterWin = WM_CreateWindowAsChild(CONTENTBAR_POSX, CONTENTBAR_POSY, CONTENTBAR_WIDTH, CONTENTBAR_HEIGHT, WM_HBKWIN, WM_CF_SHOW | WM_CF_STAYONTOP | WM_CF_MEMDEV, _cbFilter, 0);
	WM_BringToTop(FilterWin);
}



void FilterSet_Scan(void)
{
	if (TouchKey.KeyStatus==0)
	{
	  GUI_PID_STATE TouchState;
		
	  GUI_PID_GetState(&TouchState);

	if (TouchState.Pressed)
	{
		if (ExpEnable==0)  //初使状态，没有弹出扩展项
		{
			if ((TouchState.x >= FILTER_LUN_1_START_X) && (TouchState.x <= FILTER_LUN_1_END_X) &&
				(TouchState.y >= FILTER_LUN_1_START_Y) && (TouchState.y <= FILTER_LUN_1_END_Y))
			{
				ExpEnable = EXP_FILTER_LUN_1;
			}
			else if ((TouchState.x >= FILTER_LUN_2_START_X) && (TouchState.x <= FILTER_LUN_2_END_X) &&
				(TouchState.y >= FILTER_LUN_2_START_Y) && (TouchState.y <= FILTER_LUN_2_END_Y))
			{
				ExpEnable = EXP_FILTER_LUN_2;
			}
			else if ((TouchState.x >= FILTER_LUN_3_START_X) && (TouchState.x <= FILTER_LUN_3_END_X) &&
				(TouchState.y >= FILTER_LUN_3_START_Y) && (TouchState.y <= FILTER_LUN_3_END_Y))
			{
				ExpEnable = EXP_FILTER_LUN_3;
			}
			else if ((TouchState.x >= FILTER_LUN_4_START_X) && (TouchState.x <= FILTER_LUN_4_END_X) &&
				(TouchState.y >= FILTER_LUN_4_START_Y) && (TouchState.y <= FILTER_LUN_4_END_Y))
			{
				ExpEnable = EXP_FILTER_LUN_4;
			}
			else if ((TouchState.x >= FILTER_LUN_5_START_X) && (TouchState.x <= FILTER_LUN_5_END_X) &&
				(TouchState.y >= FILTER_LUN_5_START_Y) && (TouchState.y <= FILTER_LUN_5_END_Y))
			{
				ExpEnable = EXP_FILTER_LUN_5;
			}
			else if ((TouchState.x >= FILTER_LUN_6_START_X) && (TouchState.x <= FILTER_LUN_6_END_X) &&
				(TouchState.y >= FILTER_LUN_6_START_Y) && (TouchState.y <= FILTER_LUN_6_END_Y))
			{
				ExpEnable = EXP_FILTER_LUN_6;
			}
			else if ((TouchState.x >= FILTER_LUN_7_START_X) && (TouchState.x <= FILTER_LUN_7_END_X) &&
				(TouchState.y >= FILTER_LUN_7_START_Y) && (TouchState.y <= FILTER_LUN_7_END_Y))
			{
				ExpEnable = EXP_FILTER_LUN_7;
			}
			else if ((TouchState.x >= FILTER_LUN_8_START_X) && (TouchState.x <= FILTER_LUN_8_END_X) &&
				(TouchState.y >= FILTER_LUN_8_START_Y) && (TouchState.y <= FILTER_LUN_8_END_Y))
			{
				ExpEnable = EXP_FILTER_LUN_8;
			}
			if(ExpEnable>0)
			{
				  TouchKey.KeyStatus = 1;
					WM_Invalidate(FilterWin);
			}//if(ExpEnable>0)
		}//	if (ExpEnable==0)  //初使状态，没有弹出扩展项
		
	 }//if (TouchState.Pressed)
	}//if (TouchKey.KeyStatus==0)
	
}


void FilterSet_Go(void)
{
	unsigned short nWavelength=0;
	if (TouchKey.KeyStatus)
	{
	  GUI_PID_STATE TouchState;

	  GUI_PID_GetState(&TouchState);
		if (TouchState.Pressed == 0)
		{
			TouchKey.KeyPressDelay++;
			if (TouchKey.KeyPressDelay > TOUCH_RELEASE_DELAY)
			{
				TouchKey.KeyPressDelay = 0;
				TouchKey.KeyStatus = 0;
			}
		}
  }//	if (TouchKey.KeyStatus)
	
			if(ExpEnable>0)
			{
					strcpy(KeyPadNum.InputValueStr,"");
					if(FilterVal[ExpEnable-1]>=WAVELENGTH_MIN)
					{
					    sprintf(KeyPadNum.InputValueStr,"%d",FilterVal[ExpEnable-1]);
					}
					KeyPadNum_Interface(NUM_MENUFLAG_3NUM);
					if (KeyPadNum.ReturnKey == KEYPAD_NUM_RETURN_ENTER)
					{
					if(KeyPadNum.InputValueStr[0]!=0)
					{
             nWavelength= atoi(KeyPadNum.InputValueStr);
			       if(nWavelength > WAVELENGTH_MAX)
			       {
                    nWavelength = WAVELENGTH_MAX;
			       }
			       else if(nWavelength < WAVELENGTH_MIN)
			       {
                    nWavelength = WAVELENGTH_MIN;
			       }
				     FilterVal[ExpEnable-1]=nWavelength;
					}
					else 
					{
						FilterVal[ExpEnable-1]=0;
					}
				}
				  ExpEnable=0;
							TouchKey.KeyStatus = 1;
          WM_Invalidate(FilterWin);
			}//if(ExpEnable>0)
		
	
}
