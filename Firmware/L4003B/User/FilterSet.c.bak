};
static unsigned char ExpEnable;  

static unsigned short FilterVal[FILTER_MAX];                //系统语言



WM_HWIN FilterWin = NULL;       //检测窗体


int Adjust(float Color, float Factor, int IntensityMax, float Gamma)
{
	  int v;
    if(Color == 0.0)
    {
        return 0;
    }
    else
    {
        v= (int) (IntensityMax * pow(Color * Factor, Gamma));
		    if(v>255)v=255;
		    return(v);
    } 
} 



void WavelengthToRGB(int Wavelength) //波长转RGB
{
    float Gamma = 0.8;
    int IntensityMax = 255; 

    float Blue;
    float Green;
    float Red;
    float factor; 

    if(Wavelength >= 380 && Wavelength <= 439)
    {
        Red = -(float)(Wavelength - 440) / (float)(440 - 350);
        Green = 0.0;
        Blue = 1.0;
    }
    else if(Wavelength >= 440 && Wavelength <= 489)
    {
        Red = 0.0;
        Green = (float)(Wavelength - 440) / (float)(490 - 440);
        Blue = 1.0;
    }
    else if(Wavelength >= 490 && Wavelength <= 509)
    {
        Red = 0.0;
        Green = 1.0;
        Blue = -(float)(Wavelength - 510) / (float)(510 - 490);
    }
    else if(Wavelength >= 510 && Wavelength <= 579)
    { 
        Red = (float)(Wavelength - 510) / (float)(580 - 510);
        Green = 1.0;
        Blue = 0.0;
    }
    else if(Wavelength >= 580 && Wavelength <= 644)
    {
        Red = 1.0;
        Green = -(float)(Wavelength - 645) / (float)(645 - 580);
        Blue = 0.0;
    }
    else if(Wavelength >= 645 && Wavelength <= 780)
    {
        Red = 1.0;
        Green = 0.0;
        Blue = 0.0;
    }
    else
    {
        Red = 0.0;
        Green = 0.0;
        Blue = 0.0;
    } 

    if(Wavelength >= 350 && Wavelength <= 419)
    {
        factor = 0.3f + 0.7f*(float)(Wavelength - 380) / (float)(420 - 380);
    }
    else if(Wavelength >= 420 && Wavelength <= 700)
    {
       factor = 1.0f;
    }
    else if(Wavelength >= 701 && Wavelength <= 780)
    {
        factor = 0.3f + 0.7f*(float)(780 - Wavelength) / (780 - 700);
    }
    else
    {
        factor = 0.0f;
    } 
   
	ColorRGB.r = Adjust(Red, factor, IntensityMax, Gamma);
	ColorRGB.g = Adjust(Green, factor, IntensityMax, Gamma);
	ColorRGB.b= Adjust(Blue, factor, IntensityMax, Gamma);    

	if( (Wavelength >= 340)&&(Wavelength < 380) )
	{
		 ColorRGB.r=255;
		 ColorRGB.g=0;
		 ColorRGB.b =255;
	}
} 
//0没有相同的数,1有相同的数
unsigned char CalcFilterSame(void)
{
     unsigned char i,j;
	
		 for(i = 0; i < 7; i++)
		 {
				if(  (FilterVal[i]<WAVELENGTH_MIN)||(FilterVal[i]>WAVELENGTH_MAX)  )
				{
                  continue;
				}
        for(j = i + 1; j < 8; j++)
				{
          if( (FilterVal[i] == FilterVal[j])&&(FilterVal[i] >0) )
					{
                  return 1; //有相同的数
						      //break;
					}
				}
			}
		  return 0;
}





