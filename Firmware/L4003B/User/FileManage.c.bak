const char STR_NAND_FULL[LANGUAGE_TYPES][RUN_ERROR_CHAR_MAX] = {"NandFlsh is full.", "存贮已满。"}; //2015-3-16




union  FLOAT_VAL FloatValue;

TASK_MANAGE  TaskManage;

