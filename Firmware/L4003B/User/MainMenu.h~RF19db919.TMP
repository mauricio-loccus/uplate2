
//上层工具栏位置定义
#define TOOLS0_BUTTON_WIDTH  80
#define TOOLS0_BUTTON_HEIGHT  34


#define TOOLS0_BUTTON_DISX                   (100)
#define TOOLS0_BUTTON_STARTX(i)        (310+i*TOOLS0_BUTTON_DISX)       //710
#define TOOLS0_BUTTON_STARTY            9                      //80
#define TOOLS0_BUTTON_ENDX(i)            (310+TOOLS0_BUTTON_WIDTH+i*TOOLS0_BUTTON_DISX)
#define TOOLS0_BUTTON_ENDY                (TOOLS0_BUTTON_STARTY+TOOLS0_BUTTON_HEIGHT)                       //114

#define TOOLS0_BUTTON_POSX(i)            TOOLS0_BUTTON_STARTX(i)  
#define TOOLS0_BUTTON_POSY               TOOLS0_BUTTON_STARTY

//TOUCH位置定义


#define TOOLS0_BUTTON_TS_STARTX(i)       (TOOLS0_BUTTON_STARTX(i)-5)
#define TOOLS0_BUTTON_TS_STARTY          (TOOLS0_BUTTON_STARTY+TITLESBAR_HEIGHT-5)                      //80
#define TOOLS0_BUTTON_TS_ENDX(i)            (TOOLS0_BUTTON_ENDX(i) +5 )
#define TOOLS0_BUTTON_TS_ENDY                (TOOLS0_BUTTON_ENDY+TITLESBAR_HEIGHT+5)                       //114



//右侧工具栏位置定义
#define TOOLS1_BUTTON_WIDTH   120
#define TOOLS1_BUTTON_HEIGHT  40
#define TOOLS1_BUTTON_DISY         60
//最右侧的5个按钮位置定义
