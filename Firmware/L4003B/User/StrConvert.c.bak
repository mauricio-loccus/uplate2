//函数名:char *PraDisConvertStr(char *val,unsigned short t)
//功能:实际行程转化为字符串
//输入值: 1)t:实际行程值
//返回值:字符串指针  char *val为返回的字符串指针
char *PraDisConvertStr(char *val,unsigned short t)
{
	 char *p;
	 unsigned char h,l;
	 p=val;
	
	h=t/100;
	l=t%100;

  

		       if(h>=100)*val++=h/100+'0';
           if(h>=10)*val++=h%100/10+'0';
            *val++=h%10+'0';
	         *val++='.';
		       *val++=l/10+'0';
           *val++=l%10+'0';
		     

   *val++=0;
   return p;
}

