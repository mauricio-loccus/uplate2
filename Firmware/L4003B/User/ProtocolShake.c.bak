#include "MainTask.h"

const char  STR_SHAKE[LANGUAGE_TYPES][10] = {"Shake","振动"};
const char  STR_SPEED[LANGUAGE_TYPES][10] = {"Speed","速度"};
const char STR_TIME[LANGUAGE_TYPES][10] = {"Time","时间"};
const char STR_SHAKE_TITLE[LANGUAGE_TYPES][30] = {"Shaking parameters","振动参数"};


const BUTTON_DATA _aButtonProtocolShake[] =
{
	{ TOOLS1_BUTTON_POSX, TOOLS1_BUTTON_POSY(3), TOOLS1_BUTTON_WIDTH, TOOLS1_BUTTON_HEIGHT, "Ok", "确认" },
	{ TOOLS1_BUTTON_POSX, TOOLS1_BUTTON_POSY(4), TOOLS1_BUTTON_WIDTH, TOOLS1_BUTTON_HEIGHT, "Back", "返回" },
};


enum
{
	EXP_SHAKE = 1,
	EXP_SPEED,
	EXP_TIME_HOUR,
	EXP_TIME_MIN,
	EXP_TIME_SEC,
};
static unsigned char ExpEnable;


static unsigned char ShakeEnable;  //开启振动功能
static unsigned char ShakeSpeed ;  //振动速度
static unsigned long ShakeTime;    //振动时间

WM_HWIN ProtocolShakeWin = NULL;                //数字键盘 


//显示振动扩展项
void DisplayShakeExpand(void)
{
	GUI_RECT rect;
	unsigned char i;

	short start_x, start_y, wide, high;

  	//字体
	if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
	{
			 GUI_SetFont(GUI_FONT_BIG);
	}
	else
	{
			GUI_SetFont(GUI_FONT_BIG_CH);
	}
	
	start_x = FILTER_1_EXPAND_START_X ;
	start_y = FILTER_1_EXPAND_START_Y - TITLESBAR_HEIGHT;
 	wide = SHAKE_ENABLE_WIDTH;
	high = 40;
	
	//GUI_DrawBitmap(&bmExpMenuRight_135_46, FILTER_1_EXPAND_START_X, FILTER_1_EXPAND_START_Y - TITLESBAR_HEIGHT);
	GUI_SetColor(COLOR_EXP_PICTURE_FRAME);
	GUI_DrawLine(start_x, start_y,start_x+115,start_y);
	GUI_DrawLine(start_x, start_y+45,start_x+115,start_y+45);
	GUI_SetColor(COLOR_EXP_PICTURE);
	GUI_FillRect(start_x, start_y+1,start_x+115,start_y+44);
	GUI_DrawBitmap(&bmExpMenuRight_20_46, start_x+115, start_y);
	
	start_x += 3;
	start_y += 3;


	
	for (i = 0; i<2; i++)
	{
		//填充选中的底色
		GUI_SetColor(COLOR_SHAKE_BK);
		
		//填充选中的文字-白色
		if (((ShakeEnable == 0) && (i == 0)) || ((ShakeEnable) && (i == 1)))
		{
			GUI_FillRect(start_x, start_y, start_x + wide, start_y + high);
			GUI_SetColor(COLOR_SHAKE_TXT);
		}

		if (i == 0)
		{
			strcpy(ConvertStr, STR_CLOSE[SystemPrameter.SystemLanguage]);//"Off");
		}
		else
		{
			strcpy(ConvertStr, STR_OPEN[SystemPrameter.SystemLanguage]);//"On");
		}
		rect.x0 = start_x;
		rect.y0 = start_y - 1;
		rect.x1 = start_x + wide;
		rect.y1 = start_y + high;

		start_x += wide;
		wide = SHAKE_ENABLE_WIDTH;

		GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
	}
}


void DisplaySpeedExpand(void)
{
	GUI_RECT rect;
	unsigned char i;

	short start_x, start_y, wide, high;

	//字体
	if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
	{
			 GUI_SetFont(GUI_FONT_BIG);
	}
	else
	{
			GUI_SetFont(GUI_FONT_BIG_CH);
	}
	//背景图
	start_x = SPEED_EXPAND_START_X ;
	start_y = SPEED_EXPAND_START_Y  - TITLESBAR_HEIGHT;
	wide = SHAKE_SPEED_WIDTH;
	high = 40;
	//GUI_DrawBitmap(&bmExpMenuRight_180_46, SPEED_EXPAND_START_X, SPEED_EXPAND_START_Y - TITLESBAR_HEIGHT);
	GUI_SetColor(COLOR_EXP_PICTURE_FRAME);
	GUI_DrawLine(start_x, start_y,start_x+180,start_y);
	GUI_DrawLine(start_x, start_y+45,start_x+180,start_y+45);
	GUI_SetColor(COLOR_EXP_PICTURE);
	GUI_FillRect(start_x, start_y+1,start_x+180,start_y+44);
	GUI_DrawBitmap(&bmExpMenuRight_20_46, start_x+180, start_y);
	
	start_x +=3;
	start_y += 3;
	for (i = 0; i < 3; i++)
	{
		if (i == 1)
		{
			 wide = SHAKE_SPEED_WIDTH1;
		}
		else
		{
			 wide = SHAKE_SPEED_WIDTH;
		}

		//填充选中的底色
		GUI_SetColor(COLOR_SHAKE_BK);
		
		//填充选中的文字-白色
		if (ShakeSpeed == i)
		{
			GUI_FillRect(start_x, start_y, start_x + wide, start_y + high);
			GUI_SetColor(COLOR_SHAKE_TXT);
		}

		if (i == 0)
		{
			strcpy(ConvertStr, STR_SHAKE_SPEED_SLOW[SystemPrameter.SystemLanguage]);//"Off");
		}
		else if(i==1)
		{
			strcpy(ConvertStr, STR_SHAKE_SPEED_NORMAL[SystemPrameter.SystemLanguage]);//"On");
		}
		else
		{
			strcpy(ConvertStr, STR_SHAKE_SPEED_FAST[SystemPrameter.SystemLanguage]);//"On");
		}
		rect.x0 = start_x;
		rect.y0 = start_y - 1;
		rect.x1 = start_x + wide;
		rect.y1 = start_y + high;

		start_x += wide;
    GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
	}
}



//显示振动时间
void DisplayShakeTime(void)
{
	short start_x, stary_y, wide, high;
	unsigned char i;

	GUI_RECT rect;


	start_x = TIMESHAKE_R_START_X;
	stary_y = TIMESHAKE_R_START_Y +3 - TITLESBAR_HEIGHT;
	wide = 35;
	high = 40;
	for (i = 0; i < 3; i++)
	{
		if (ShakeEnable)
		{
			GUI_SetColor(COLOR_PAINT_TXT);
		}
		else
		{
			GUI_SetColor(COLOR_TXT_DISABLE);//灰色
		}

		if (((ExpEnable == EXP_TIME_HOUR) && (i == 0)) ||
			((ExpEnable == EXP_TIME_MIN) && (i == 1)) ||
			((ExpEnable == EXP_TIME_SEC) && (i == 2)))
		{
			GUI_SetColor(COLOR_SHAKE_TIME_BK);
			GUI_FillRect(start_x + 3, stary_y, start_x + wide - 3, stary_y + high);
			GUI_SetColor(GUI_WHITE);
		}
		if (i == 0)
		{
			TwoNum2ConvertStr(ConvertStr, ShakeTime / 3600);

		}
		else if (i == 1)
		{
			TwoNum2ConvertStr(ConvertStr,ShakeTime % 3600 / 60);
		}
		else
		{
			TwoNum2ConvertStr(ConvertStr, ShakeTime % 60);
		}
		rect.x0 = start_x;
		rect.x1 = start_x + wide;
		rect.y0 = stary_y;
		rect.y1 = stary_y + high;
		GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);

		//显示":"
		if (i < 2)
		{
		   rect.x0 = rect.x1;
		   rect.x1 = rect.x0 + 5;
		   GUI_DispStringInRect(":", &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
		}
		start_x += SHAKE_TIME_WIDTH;
	}
}

	
