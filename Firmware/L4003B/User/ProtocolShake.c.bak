		}
		break;

	case WM_NOTIFY_PARENT:
	{
							 Id = WM_GetId(pMsg->hWinSrc);    // Id of widget 
							 NCode = pMsg->Data.v;               // Notification code 
		            if( (KeyPadAsc.UseFlag == KEYPAD_BUSY)||(KeyPadNum.UseFlag == KEYPAD_BUSY)||(PromptMenu.InterfaceStatus==PROMPT_MENU_BUSY) )
			       {
				        break;
			       }
						 if(TouchKey.KeyStatus)
						 {
							  break;
						 }
							 if (NCode == WM_NOTIFICATION_RELEASED)
							 {
								 if (Id == ID_SHAKE_BUTTON0)   //工具栏第5个按钮  Cancel
								 {
									 BoardInf.ShakeEnable = ShakeEnable;
									 BoardInf.ShakeSpeed= ShakeSpeed;
									 BoardInf.ShakeTime = ShakeTime;
									 
								//	 BoardInf.ShakeEnable = ShakeEnable;
									// BoardInf.ShakeSpeed= ShakeSpeed;
								//	 BoardInf.ShakeTime = ShakeTime;
                 //  E2pSaveShakePra();    //这里不用保存
							
									 gSystem.SystemInterface = MI_PROTOCOL;
									 gSystem.TitleButtonEnable = 1;
									 TouchKey.KeyStatus=1;
									 WM_DeleteWindow(ProtocolShakeWin);
									 WM_ShowWindow(ProtocolWin); 
								 }
								 else if (Id == ID_SHAKE_BUTTON1)   //工具栏第5个按钮  Cancel
								 {
									  gSystem.SystemInterface = MI_PROTOCOL;
									  gSystem.TitleButtonEnable = 1;
									 TouchKey.KeyStatus=1;
									  WM_DeleteWindow(ProtocolShakeWin);
									  WM_ShowWindow(ProtocolWin);
								 }
							 }
							 break;
	}

	default:
		//		WM_DefaultProc(pMsg);
		break;
	}
}






void ProtocolShake_Scan(void)
{
	if(TouchKey.KeyStatus==0)
	{
	  GUI_PID_STATE TouchState;
	
	  GUI_PID_GetState(&TouchState);
	  if (TouchState.Pressed)
	  {
		  if (ExpEnable == 0)  //初使状态，没有弹出扩展项
		  {
				if ((TouchState.x >= FILTER_1_R_START_X) && (TouchState.x <= FILTER_1_R_END_X) &&
					 (TouchState.y >= FILTER_1_R_START_Y) && (TouchState.y <= FILTER_1_R_END_Y))
				{
					 TouchKey.KeyStatus = 1;
					 ExpEnable = EXP_SHAKE;
					 WM_Invalidate(ProtocolShakeWin);
				}
				else if ((TouchState.x >= FILTER_2_R_START_X) && (TouchState.x <= FILTER_2_R_END_X) &&
					  (TouchState.y >= FILTER_2_R_START_Y) && (TouchState.y <= FILTER_2_R_END_Y))
				{
						if (ShakeEnable)
						{
							TouchKey.KeyStatus = 1;
							ExpEnable = EXP_SPEED;
							WM_Invalidate(ProtocolShakeWin);
						}
				
				}
				else if ((TouchState.x >= TIMESHAKE_R_START_X) && (TouchState.x <= TIMESHAKE_R_END_X) &&
						(TouchState.y >= TIMESHAKE_R_START_Y) && (TouchState.y <= TIMESHAKE_R_END_Y) && (ShakeEnable))
				{
						if ((TouchState.x >= TIMESHAKE_R_START_X) && (TouchState.x < TIMESHAKE_R_START_X + SHAKE_TIME_WIDTH))
						{
							 ExpEnable = EXP_TIME_HOUR;
							 TouchKey.KeyStatus = 1;
							 WM_Invalidate(ProtocolShakeWin);
						}
				    else if ((TouchState.x >= TIMESHAKE_R_START_X + SHAKE_TIME_WIDTH) && (TouchState.x < TIMESHAKE_R_START_X + SHAKE_TIME_WIDTH * 2))
				    {
						   ExpEnable = EXP_TIME_MIN;
						   TouchKey.KeyStatus = 1;
						   WM_Invalidate(ProtocolShakeWin);
				    }
				    else if ((TouchState.x >= TIMESHAKE_R_START_X + SHAKE_TIME_WIDTH * 2) && (TouchState.x < TIMESHAKE_R_START_X + SHAKE_TIME_WIDTH * 3))
				    {
							ExpEnable = EXP_TIME_SEC;
							TouchKey.KeyStatus = 1;
							WM_Invalidate(ProtocolShakeWin);
				    }
			   }
		  }//if (ExpEnable == 0)  //初使状态，没有弹出扩展项
		  else if (ExpEnable == EXP_SHAKE)
		  {
			    ExpEnable = 0;
			    if ((TouchState.x >= FILTER_1_EXPAND_START_X) && (TouchState.x <= FILTER_1_EXPAND_START_X + SHAKE_ENABLE_WIDTH) &&
				     (TouchState.y >= FILTER_1_EXPAND_START_Y) && (TouchState.y <= FILTER_1_EXPAND_END_Y))
			   {
				    //关闭振动
				    ShakeEnable = 0;
			   }
			   else if ((TouchState.x >= FILTER_1_EXPAND_START_X + SHAKE_ENABLE_WIDTH) && (TouchState.x <= FILTER_1_EXPAND_START_X + SHAKE_ENABLE_WIDTH * 2) &&
				         (TouchState.y >= FILTER_1_EXPAND_START_Y) && (TouchState.y <= FILTER_1_EXPAND_END_Y))
			   {
				    //开启振动
				    ShakeEnable = 1;
			   }
		     TouchKey.KeyStatus = 1;
			   WM_Invalidate(ProtocolShakeWin);
		  }//else if (ExpEnable == EXP_SHAKE)
		  else if (ExpEnable == EXP_SPEED)
		  {
			   ExpEnable = 0;
			   if ((TouchState.x >= FILTER_2_EXPAND_START_X) && (TouchState.x <= SPEED_EXPAND_START_X + SHAKE_SPEED_WIDTH * 2 + SHAKE_SPEED_WIDTH1) &&
				    (TouchState.y >= FILTER_2_EXPAND_START_Y) && (TouchState.y <= FILTER_2_EXPAND_END_Y))
			   {
				     if ((TouchState.x >= SPEED_EXPAND_START_X) && (TouchState.x < SPEED_EXPAND_START_X + SHAKE_SPEED_WIDTH))
				     {
							   ShakeSpeed = SHAKE_SPEED_SLOW;
						 }
						 else if ((TouchState.x >= SPEED_EXPAND_START_X + SHAKE_SPEED_WIDTH) && (TouchState.x < SPEED_EXPAND_START_X + SHAKE_SPEED_WIDTH + SHAKE_SPEED_WIDTH1))
						 {
							   ShakeSpeed = SHAKE_SPEED_NORMAL;
						 }
						 else if ((TouchState.x >= SPEED_EXPAND_START_X + SHAKE_SPEED_WIDTH + SHAKE_SPEED_WIDTH1) && (TouchState.x < SPEED_EXPAND_START_X + SHAKE_SPEED_WIDTH * 2 + SHAKE_SPEED_WIDTH1))
						 {
								 ShakeSpeed = SHAKE_SPEED_FAST;
						 }
				 }
			   TouchKey.KeyStatus = 1;
			   WM_Invalidate(ProtocolShakeWin);
		 }//else if (ExpEnable == EXP_SPEED)
	 }//if (TouchState.Pressed)
 }//if(TouchKey.KeyStatus==0)
}

void ProtocolShake_Go(void)
{
  unsigned long time_val;
	if(TouchKey.KeyStatus)
	{
		 
		 GUI_PID_STATE TouchState;
	   GUI_PID_GetState(&TouchState);
	
		 if (TouchState.Pressed == 0)
		 {
			  TouchKey.KeyPressDelay++;
			  if (TouchKey.KeyPressDelay > TOUCH_RELEASE_DELAY)
			  {
				  TouchKey.KeyPressDelay = 0;
				  TouchKey.KeyStatus = 0;
			  }
		 }
	}

		if (ExpEnable==EXP_TIME_HOUR)
		{
			 TouchKey.KeyStatus = 1;
			
			 TwoNum2ConvertStr(KeyPadNum.InputValueStr, ShakeTime / 3600);
			 KeyPadNum_Interface(NUM_MENUFLAG_2NUM);
			 if (KeyPadNum.ReturnKey == KEYPAD_NUM_RETURN_ENTER)
			 {
						  time_val=atoi(KeyPadNum.InputValueStr);
						  if(time_val>99)time_val=99;
              ShakeTime=ShakeTime%3600+(long)time_val*3600;
			 }
			 ExpEnable = 0;
			 TouchKey.KeyStatus = 1;
			 WM_Invalidate(ProtocolShakeWin);
		}//if (ExpEnable==EXP_TIME_HOUR)
					
		else if (ExpEnable==EXP_TIME_MIN)
		{
					TwoNum2ConvertStr(KeyPadNum.InputValueStr, ShakeTime % 3600/60);
					KeyPadNum_Interface(NUM_MENUFLAG_2NUM);

					if (KeyPadNum.ReturnKey == KEYPAD_NUM_RETURN_ENTER)
					{
						 time_val=atoi(KeyPadNum.InputValueStr);
						 if(time_val>59)time_val=59;
             ShakeTime=ShakeTime/3600*3600+(long)time_val*60+ShakeTime%60;
					}

					ExpEnable = 0;
					TouchKey.KeyStatus = 1;
					WM_Invalidate(ProtocolShakeWin);
		 }//else if (ExpEnable==EXP_TIME_MIN)
		 else if (ExpEnable == EXP_TIME_SEC)
		 {
					TwoNum2ConvertStr(KeyPadNum.InputValueStr, ShakeTime % 60);
					KeyPadNum_Interface(NUM_MENUFLAG_2NUM);

					if (KeyPadNum.ReturnKey == KEYPAD_NUM_RETURN_ENTER)
					{
						   time_val=atoi(KeyPadNum.InputValueStr);
						   if(time_val>59)time_val=59;
               ShakeTime=ShakeTime/60*60+time_val;
					}

					ExpEnable = 0;
					TouchKey.KeyStatus = 1;
					WM_Invalidate(ProtocolShakeWin);
		 }//else if (ExpEnable == EXP_TIME_SEC)
}

void ProtocolShake_Interface(void)
{
	ExpEnable = 0;
	ShakeEnable = BoardInf.ShakeEnable;
	ShakeSpeed = BoardInf.ShakeSpeed;
	ShakeTime = BoardInf.ShakeTime;
	
	ProtocolShakeWin = WM_CreateWindowAsChild(CONTENTBAR_POSX, CONTENTBAR_POSY, CONTENTBAR_WIDTH, CONTENTBAR_HEIGHT, WM_HBKWIN, WM_CF_SHOW | WM_CF_STAYONTOP | WM_CF_MEMDEV, _cbProtocolShake, 0);
	WM_BringToTop(ProtocolShakeWin);
}
