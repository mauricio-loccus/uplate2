	case WM_PAINT:

		//	GUI_SetColor(COLOR_SYSTEMTIME_LINE);
		//GUI_DrawHLine(LINE_SYSTEMTIME_POSY, LINE_SYSTEMTIME_STARTX, LINE_SYSTEMTIME_ENDX);
