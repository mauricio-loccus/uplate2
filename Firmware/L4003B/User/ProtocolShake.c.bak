			}
			else if(ShakeSpeed==SHAKE_SPEED_NORMAL)
			{
				strcpy(ConvertStr, STR_SHAKE_SPEED_NORMAL[SystemPrameter.SystemLanguage]);//slow
			}
			else if(ShakeSpeed==SHAKE_SPEED_FAST)
			{
				strcpy(ConvertStr, STR_SHAKE_SPEED_FAST[SystemPrameter.SystemLanguage]);//slow
			}
			
			//}
			//GUI_DispStringAt(ConvertStr, FILTER_1_START_X + 105, FILTER_2_START_Y + 12 - TITLESBAR_HEIGHT);
		//}
		//else
		//{
		//	strcpy(ConvertStr, STR_CLOSE[SystemPrameter.SystemLanguage]);//"Off");
		//}
		GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);
	   
		DisplayShakeTime();


