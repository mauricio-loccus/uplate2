void DisplayInterExpand(void)
{
    unsigned char i;
    short start_x, start_y, wide, high;
    GUI_RECT rect;

	
    start_x = INTERPRET_EXPAND1_START_X ;
    start_y = INTERPRET_EXPAND1_START_Y - TITLESBAR_HEIGHT;

    //GUI_DrawBitmap(&bmExpMenuRight_135_46, INTERPRET_EXPAND1_START_X, INTERPRET_EXPAND1_START_Y - TITLESBAR_HEIGHT);
    GUI_SetColor(COLOR_EXP_PICTURE_FRAME);
    GUI_DrawLine(start_x, start_y,start_x+125,start_y);
    GUI_DrawLine(start_x, start_y+45,start_x+125,start_y+45);
    GUI_SetColor(COLOR_EXP_PICTURE);
    GUI_FillRect(start_x, start_y+1,start_x+125,start_y+44);
    GUI_DrawBitmap(&bmExpMenuRight_20_46, start_x+125, start_y);

    start_x += 3;
    start_y += 3;


    wide = INTER_SEL_WIDTH;
    high = 40;
    for (i = 0; i<2; i++)
    {
        //填充选中的底色
        GUI_SetColor(COLOR_SHAKE_BK);
        if (i == 0)
        {
            strcpy(ConvertStr, STR_CLOSE[SystemPrameter.SystemLanguage]);//"Off");
        }
        else
        {
            strcpy(ConvertStr, STR_OPEN[SystemPrameter.SystemLanguage]);//"On");
        }

        //填充选中的文字-白色
        if (((BoardInfTemp.InterpretPara.Enable == 0) && (i == 0)) || ((BoardInfTemp.InterpretPara.Enable) && (i == 1)))
        {
            GUI_FillRect(start_x, start_y, start_x + wide, start_y + high);
            GUI_SetColor(COLOR_SHAKE_TXT);
        }

        rect.x0 = start_x;
        rect.y0 = start_y - 1;
        rect.x1 = start_x + wide;
        rect.y1 = start_y + high;

        start_x += wide;
        wide = INTER_SEL_WIDTH;

        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
    }
}


void DisplayConcAbsExpand(void)
{
    unsigned char i;
    //char str[10];
    GUI_RECT rect;

    int start_x, start_y, wide, high;

    start_x = INTERPRET_EXPAND2_START_X ;
    start_y = INTERPRET_EXPAND2_START_Y - TITLESBAR_HEIGHT;
    //GUI_DrawBitmap(&bmExpMenuRight_135_46, INTERPRET_EXPAND2_START_X, INTERPRET_EXPAND2_START_Y - TITLESBAR_HEIGHT);
    GUI_SetColor(COLOR_EXP_PICTURE_FRAME);
    GUI_DrawLine(start_x, start_y,start_x+125,start_y);
    GUI_DrawLine(start_x, start_y+45,start_x+125,start_y+45);
    GUI_SetColor(COLOR_EXP_PICTURE);
    GUI_FillRect(start_x, start_y+1,start_x+125,start_y+44);
    GUI_DrawBitmap(&bmExpMenuRight_20_46, start_x+125, start_y);

    start_x += 3;
    start_y += 3;

    wide = INTER_SEL_WIDTH;
    high = 40;
    for (i = 0; i<2; i++)
    {
        //填充选中的底色
        GUI_SetColor(COLOR_SHAKE_BK);
        if (i == 0)
        {
            strcpy(ConvertStr, STR_ABS[SystemPrameter.SystemLanguage]);//"ABS");
        }
        else
        {
            strcpy(ConvertStr,STR_CONC[SystemPrameter.SystemLanguage]);// "Conc.");
        }

        //填充选中的文字-白色
        if (((BoardInfTemp.InterpretPara.AbsFlag) && (i == 0)) || ((BoardInfTemp.InterpretPara.AbsFlag==0) && (i == 1)))//注:这里i==0为吸光度
        {
            GUI_FillRect(start_x, start_y, start_x + wide, start_y + high);
            GUI_SetColor(COLOR_SHAKE_TXT);
        }

        rect.x0 = start_x;
        rect.y0 = start_y - 1;
        rect.x1 = start_x + wide;
        rect.y1 = start_y + high;

        start_x += wide;
        wide = INTER_SEL_WIDTH;

        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
    }
}


//显示定性模式扩展
void DisplayInterModeExpand(void)
{
    GUI_RECT rect;
    short i;
    short start_x, start_y, wide, high;

    start_x=SPEED_EXPAND_START_X  +KINETIC_PARA_POS_START;
    start_y = INTERPRET_2_R_START_Y - TITLESBAR_HEIGHT;
    wide = INTER_MODE_EXPAND_WIDTH1;
    high = 40;
    GUI_SetColor(COLOR_EXP_PICTURE_FRAME);
    GUI_DrawLine(start_x, start_y,start_x+INTER_MODE_EXPAND_WIDTH,start_y);
    GUI_DrawLine(start_x, start_y+45,start_x+INTER_MODE_EXPAND_WIDTH,start_y+45);
    GUI_SetColor(COLOR_EXP_PICTURE);
    GUI_FillRect(start_x, start_y+1,start_x+INTER_MODE_EXPAND_WIDTH,start_y+44);
    GUI_DrawBitmap(&bmExpMenuRight_20_46, start_x+INTER_MODE_EXPAND_WIDTH, start_y);

    start_x += 3;
    start_y += 3;
    for (i = 0; i<2; i++)
    {
        //填充选中的底色
        GUI_SetColor(COLOR_MODE_SEL_BK);
        if (i == 0)
        {
            strcpy(ConvertStr, STR_INTER_MODE[SystemPrameter.SystemLanguage][0]);//"普通"
        }
        else
        {
            strcpy(ConvertStr,STR_INTER_MODE[SystemPrameter.SystemLanguage][1] );//"特殊"
        }

        //填充选中的文字-白色
        //填充选中的文字-白色
        if (((BoardInfTemp.InterpretPara.Mode == INTER_NORMAL) && (i == 0)) || ((BoardInfTemp.InterpretPara.Mode == INTER_SPECIAL) && (i == 1)))
        {
            GUI_FillRect(start_x+3, start_y+3, start_x +3+ wide, start_y-3+high);
            GUI_SetColor(COLOR_MODE_SEL_TXT);
            //GUI_DrawCircle(RUNMENU_CIRCLE_POSX(i), RUNMENU_CIRCLE_POSY, RUNMENU_CIRCLE_RADIUS);
        }

        rect.x0 = start_x;
        rect.y0 = start_y - 1;
        rect.x1 = start_x + wide;
        rect.y1 = start_y + high;

        start_x += wide;
        wide = INTER_MODE_EXPAND_WIDTH2;

        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
    }


}

//flag==DISPLAY_HEAD只显示Mode,DISPLAY_ALL为显示所有
void DisplayInterDN(unsigned char flag)
{
	    GUI_RECT rect;
			float f_temp;
	
	    
	    GUI_DrawBitmap(&bmMenuLeft_101_46, FILTER_2_START_X+KINETIC_PARA_POS_START, INTERPRET_2_R_START_Y - TITLESBAR_HEIGHT);//定性模式
      GUI_DrawBitmap(&bmMenuRight_90_46, FILTER_2_R_START_X+KINETIC_PARA_POS_START, INTERPRET_2_R_START_Y - TITLESBAR_HEIGHT);
	

        if (BoardInfTemp.InterpretPara.Enable)
        {
            GUI_SetColor(COLOR_PAINT_TXT);
        }
        else
        {
            GUI_SetColor(COLOR_TXT_DISABLE);//灰色
        }
				
	    //定性模式左侧项
       rect.x0 = FILTER_2_START_X+20+KINETIC_PARA_POS_START;
       rect.y0 = INTERPRET_2_R_START_Y - TITLESBAR_HEIGHT;
       rect.x1 = FILTER_2_END_X+KINETIC_PARA_POS_START;
       rect.y1 = INTERPRET_2_R_END_Y - TITLESBAR_HEIGHT;
       strcpy(ConvertStr,STR_MODE[SystemPrameter.SystemLanguage]);//定性模式
       GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);
	
			  //定性模式右侧项
        rect.x0 = FILTER_2_START_X+110+KINETIC_PARA_POS_START;
        rect.y0 = INTERPRET_2_R_START_Y - TITLESBAR_HEIGHT;
        rect.x1 = FILTER_2_END_X+110+KINETIC_PARA_POS_START;
        rect.y1 = INTERPRET_2_R_END_Y - TITLESBAR_HEIGHT;
        strcpy(ConvertStr,STR_INTER_MODE[SystemPrameter.SystemLanguage][BoardInfTemp.InterpretPara.Mode]);
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_LEFT | GUI_TA_VCENTER);
				
				
		if(flag==DISPLAY_ALL)
		{
				//颜色
        if (ExpEnable == EXP_LIMIT)
        {
            GUI_SetColor(0x000000);
        }
        else
        {
            GUI_SetColor(COLOR_TITLEBAR);
        }
        GUI_FillRect(INTERPRET_EDIT_COEF1_START_X_DN, INTERPRET_EDIT_COEF1_START_Y_DN - TITLESBAR_HEIGHT, INTERPRET_EDIT_COEF1_END_X_DN, INTERPRET_EDIT_COEF1_END_Y_DN - TITLESBAR_HEIGHT);



        if (ExpEnable == EXP_POS)
        {
            GUI_SetColor(0x000000);
        }
        else
        {
            GUI_SetColor(COLOR_TITLEBAR);
        }
        GUI_FillRect(INTERPRET_EDIT_COEF2_START_X_DN, INTERPRET_EDIT_COEF2_START_Y_DN - TITLESBAR_HEIGHT, INTERPRET_EDIT_COEF2_END_X_DN, INTERPRET_EDIT_COEF2_END_Y_DN - TITLESBAR_HEIGHT);


				if (ExpEnable == EXP_WEAK_POS)
        {
            GUI_SetColor(0x000000);
        }
        else
        {
            GUI_SetColor(COLOR_TITLEBAR);
        }
        GUI_FillRect(INTERPRET_EDIT_COEF3_START_X_DN, INTERPRET_EDIT_COEF3_START_Y_DN - TITLESBAR_HEIGHT, INTERPRET_EDIT_COEF3_END_X_DN, INTERPRET_EDIT_COEF3_END_Y_DN - TITLESBAR_HEIGHT);

				
				GUI_SetColor(GUI_BLACK);      //黑色
				rect.x0 = 20;
        rect.y0 = INTERPRET_EDIT_COEF1_START_Y_DN - TITLESBAR_HEIGHT;
        rect.x1 = INTERPRET_EDIT_COEF1_START_X_DN-5;
        rect.y1 = INTERPRET_EDIT_COEF1_END_Y_DN - TITLESBAR_HEIGHT;
        GUI_DispStringInRect(STR_INTERPRET_LIMIT_DN[SystemPrameter.SystemLanguage], &rect, GUI_TA_RIGHT | GUI_TA_VCENTER);
				
				
				rect.y0 = INTERPRET_EDIT_COEF2_START_Y_DN - TITLESBAR_HEIGHT;
				rect.y1 = INTERPRET_EDIT_COEF2_END_Y_DN - TITLESBAR_HEIGHT;
				GUI_DispStringInRect(STR_INTERPRET_POS_DN[SystemPrameter.SystemLanguage], &rect, GUI_TA_RIGHT | GUI_TA_VCENTER);
				
				
				rect.y0 = INTERPRET_EDIT_COEF3_START_Y_DN - TITLESBAR_HEIGHT;
				rect.y1 = INTERPRET_EDIT_COEF3_END_Y_DN - TITLESBAR_HEIGHT;
				GUI_DispStringInRect(STR_INTERPRET_WEAK_POS_DN[SystemPrameter.SystemLanguage], &rect, GUI_TA_RIGHT | GUI_TA_VCENTER);
				
      
				//颜色定义
				if (BoardInfTemp.InterpretPara.Enable)
        {
            GUI_SetColor(COLOR_PAINT_TXT);  
        }
        else
        {
            GUI_SetColor(COLOR_TXT_DISABLE);//灰色
        }
				
				
        //定性显示1
				f_temp = BoardInfTemp.InterpretPara.fCoef_DN[0];
        if (f_temp > 1000)
        {
            sprintf(ConvertStr,"%.2e",f_temp);
            EConvert(ConvertStr);
        }
        else
        {
            sprintf(ConvertStr, "%.2f", f_temp);
        }

        rect.x0 = INTERPRET_EDIT_COEF1_START_X_DN;
        rect.y0 = INTERPRET_EDIT_COEF1_START_Y_DN - TITLESBAR_HEIGHT;
        rect.x1 = INTERPRET_EDIT_COEF1_END_X_DN-5;
        rect.y1 = INTERPRET_EDIT_COEF1_END_Y_DN - TITLESBAR_HEIGHT;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_RIGHT | GUI_TA_VCENTER);

				//定性显示2
				f_temp = BoardInfTemp.InterpretPara.fCoef_DN[1];
        if (f_temp > 1000)
        {
            sprintf(ConvertStr,"%.2e",f_temp);
            EConvert(ConvertStr);
        }
        else
        {
            sprintf(ConvertStr, "%.2f", f_temp);
        }

        rect.x0 = INTERPRET_EDIT_COEF2_START_X_DN;
        rect.y0 = INTERPRET_EDIT_COEF2_START_Y_DN - TITLESBAR_HEIGHT;
        rect.x1 = INTERPRET_EDIT_COEF2_END_X_DN-5;
        rect.y1 = INTERPRET_EDIT_COEF2_END_Y_DN - TITLESBAR_HEIGHT;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_RIGHT | GUI_TA_VCENTER);
				
				//定性显示3
				f_temp = BoardInfTemp.InterpretPara.fCoef_DN[2];
        if (f_temp > 1000)
        {
            sprintf(ConvertStr,"%.2e",f_temp);
            EConvert(ConvertStr);
        }
        else
        {
            sprintf(ConvertStr, "%.2f", f_temp);
        }

        rect.x0 = INTERPRET_EDIT_COEF3_START_X_DN;
        rect.y0 = INTERPRET_EDIT_COEF3_START_Y_DN - TITLESBAR_HEIGHT;
        rect.x1 = INTERPRET_EDIT_COEF3_END_X_DN-5;
        rect.y1 = INTERPRET_EDIT_COEF3_END_Y_DN - TITLESBAR_HEIGHT;
        GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_RIGHT | GUI_TA_VCENTER);
		}				   
}

