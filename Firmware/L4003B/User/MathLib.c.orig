		int min;
		float d_tmp;
		for(int i = 0; i < m_nTotal; i++)
		{
			min = i;
			for(int j = i+1; j < m_nTotal; j++)
			{
				if(pX[j] < pX[min])
				{
					min = j;
				}
			}
			
			if(min == i)
			{
				continue;
			}
			
			d_tmp = pX[i];
			pX[i] = pX[min];
			pX[min] = d_tmp;
			
			d_tmp = pY[i];
			pY[i] = pY[min];
			pY[min] = d_tmp;			
		}		
//		for(int i = 0; i < m_nTotal; i++)
//		{
//			Log.e("wenqg", "i:" + i +", x: " + pX[i] +", y:" +pY[i]);
//		}		
		memcpy(m_pX, pX, nTotal * sizeof(float));
		memcpy(m_pY, pY, nTotal * sizeof(float));
				
		float Min = m_pY[0], Max = m_pY[0];
		for(int i = 1; i < m_nTotal; i++)
		{
			if(Min > m_pY[i])
			{
				Min = m_pY[i];
			}
			
			if(Max < m_pY[i])
			{
				Max = m_pY[i];
			}
		}	

		if(Min <= 0)
		{
			return false;
		}
//IMPORTANT NOTE:		
//wenqg, 20170306 16:30		
		if(m_pX[0] == 0)
		{
			m_pX[0] = m_pX[1] * 0.001;
		}
//add end	

		SetYMin(Min);
		SetYMax(Max);	
		return InitPara();
}

