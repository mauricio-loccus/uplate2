//矩阵函数开始
float *GetComplement(float *a2, int n, int nx, int ny)
	{
		if(a2 == NULL || nx > n || ny > n || nx <1 || ny<1)
		{
			return NULL;
		}				

		float *d_tmp1  = new float[(n-1) * (n-1)];
		for(int i=0; i<(nx-1); i++ )
		{
			for(int j=0; j<(ny-1); j++)
				d_tmp1[i*(n-1)+j] = a2[i*n + j];
			for(int j=(ny-1); j<(n-1); j++)
				d_tmp1[i*(n-1) + j] = a2[i*n + j+1];
		}
	
		for(int i=(nx-1); i<(n-1); i++ )
		{
			for(int j=0; j<(ny-1); j++)
				d_tmp1[i*(n-1) + j] = a2[(i+1)*n + j];
			for(int j=(ny-1); j<(n-1); j++)
				d_tmp1[i*(n-1) + j] = a2[(i+1)*n + j + 1];
		}

		return d_tmp1;				
	}

	float CalculateDeterminantN(float *a2, int n)
	{	
		if(a2 == NULL ||  n<2 )
		{
			return NULL;
		}	

		float ret = 0;	
		if(n == 2)
		{
			//ret = a2[0][0]*a2[1][1] - a2[0][1]*a2[1][0];
			//return ret;
			ret = a2[0]*a2[3] - a2[1]*a2[2];
			return ret;	
		}	
		else if(n> 2)
		{			
			float *a3 = new float[(n-1)*(n-1)];
			for(int i=0; i<n; i++)
			{
				//Log.e("wenqg", "i= " + i +", n is " + n);
				a3 = GetComplement(a2, n, 1, i+1);
				ret += a2[i] *pow(-1.0, (1+i+1)) * CalculateDeterminantN(a3, n-1);
				//Log.e("wenqg", "n= " + n +", ret n is "+ ret);
			}
			//Log.e("wenqg", "total return is " + ret );
			return ret;				
		}
		else
			return ret;
	}

	float *getInverseMatrix(float *a2, int n)//逆矩阵
	{	
		if(a2 == NULL ||  n<2 )
		{
			return NULL;
		}

		float d1 = 0;
		if(2 == n)
		{
			d1 = CalculateDeterminantN(a2, n);
			if(0 == d1)
			{
				return NULL;
			}
			
			float *a5 = new float[2*2];
			a5[0] = a2[3];
			a5[1] = -a2[1];
			a5[2] = -a2[2];
			a5[3] = a2[0];
			
			for(int i=0; i<2; i++)
			{
				for(int j=0; j<2; j++)
				{
					a5[i*2+j] /= d1;
				}
			}				
			return a5;
		}

		float *a3 = new float[n * n];
		float *a4 = new float[(n-1)*(n-1)];
		d1 = CalculateDeterminantN(a2, n);
		if(0 == d1)
		{
			return NULL;
		}
		
		for(int i=0; i<n; i++)
		{
			for(int j=0; j<n; j++)
			{	
				a4 = GetComplement(a2, n, j+1, i+1);
				a3[i*n+j] = pow(-1.0, i+1+j+1) * CalculateDeterminantN(a4, n-1);
				a3[i*n+j] /= d1;
			}			
		}
		return a3;
	}

	//Matrix: mxn; Matrix: nxk 	
	float *MatrixMulty(float* a1, int m, int n, float* b1, int k)
	{	
		if(NULL == a1 || NULL == b1 || m<1 || n<1 || k<1 )
		{
			return NULL;
		}

		float* d1 = new float[m * k];
		for(int i=0; i<m; i++)
		{
			for(int j=0; j<k; j++)
			{	d1[i*k + j] = 0.0;
				for(int l=0; l<n; l++)
				{
					d1[i*k + j] += a1[i*n+l] * b1[l*k+j];
				}
			}
		}
		return d1;
	}	
	
	float *MatrixReverse(float* a1, int m, int n)
	{
		if(NULL == a1 || m<1 || n<1)
		{
			return NULL;
		}

		float* d2 = new float[n * m];
		for(int i=0; i<n; i++)
		{
			for(int j=0; j<m; j++)
				d2[i*m + j] = a1[i + j*n];
		}
		return d2;
	}
//矩阵函数结束

//最小二乘法开始
int LsmCreate(float* pX, float* pY, int nTotal)
{
	m_pXLsm = NULL;
	m_pYLsm = NULL;
	m_nTotal = 0;

	if(NULL == pX || NULL == pY || nTotal<2)
	{
		return -1;
	}

	m_pXLsm = new float[nTotal];
	m_pYLsm = new float[nTotal];
	m_nTotal = nTotal;
	memcpy(m_pXLsm, pX, nTotal * sizeof(float));
	memcpy(m_pYLsm, pY, nTotal * sizeof(float));
	return 0;
}

float GetAverageX(void)
{
	float dAverage = 0.0;

	for(int i = 0; i < m_nTotal; i++)
	{
        dAverage += m_pXLsm[i];
	}

	return (dAverage / (float)m_nTotal);
}

float GetAverageY(void)
{
	float dAverage = 0.0;

	for(int i = 0; i < m_nTotal; i++)
	{
        dAverage += m_pYLsm[i];
	}

	return (dAverage / (float)m_nTotal);
}

float GetAverageXX(void)
{
	float dAverage = 0.0;

	for(int i = 0; i < m_nTotal; i++)
	{
        dAverage += (m_pXLsm[i] * m_pXLsm[i]);
	}

	return (dAverage / (float)m_nTotal);
}

float GetAverageYY(void)
{
	float dAverage = 0.0;

	for(int i = 0; i < m_nTotal; i++)
	{
        dAverage += (m_pYLsm[i] * m_pYLsm[i]);
	}

	return (dAverage / (float)m_nTotal);
}

float GetAverageXY(void)
{
	float dAverage = 0.0;

	for(int i = 0; i < m_nTotal; i++)
	{
        dAverage += (m_pYLsm[i] * m_pXLsm[i]);
	}

	return (dAverage / (float)m_nTotal);
}

float LsmGetRR(int* nErrorCode) //相关系数
{
	float dTemp, dTemp1;
	dTemp = GetAverageXY() - GetAverageX() * GetAverageY();
	dTemp *= dTemp;
	dTemp1 = ((GetAverageXX() - GetAverageX() * GetAverageX()) * (GetAverageYY() - GetAverageY() * GetAverageY()));

	*nErrorCode = ANALYSIS_SUCCESS;
	if(dTemp1 != 0.0)
	{
	    dTemp /= dTemp1;
	}
	else
	{
	    *nErrorCode = ANALYSIS_ERROR_FITTING_FAIL;
	}

	return dTemp;
}

float LsmGetSlope(int* nErrorCode) //斜率
{
	float dTemp, dTemp1;
	dTemp = GetAverageXY() - GetAverageX() * GetAverageY();
	dTemp1 = (GetAverageXX() - GetAverageX() * GetAverageX());
	*nErrorCode = ANALYSIS_SUCCESS;
	if(dTemp1 != 0.0)
	{
	    dTemp /= dTemp1;
	}
	else
	{
	    *nErrorCode = ANALYSIS_ERROR_FITTING_FAIL;
	}
	return dTemp;
}

float LsmGetIntercept(int* nErrorCode) //截距
{
	return GetAverageY() - LsmGetSlope(nErrorCode) * GetAverageX();
}
//最小二乘法结束



//四参数开始
void GetCoef(float* dCoef)
{
	dCoef[0] = a;
	dCoef[1] = b;
	dCoef[2] = c;
	dCoef[3] = d;
}

float GetY(float& dX)
{
	float dTemp = pow((dX / c), b);
	return (d + (a - d) / (1 + dTemp));
}

//void LogisticGetRR(float& dRR)
float LogisticGetRR()
{
	float dTemp = 0.0;
	float dTemp1 = 0.0;
	for(int i = 0; i < m_nTotal; i++)
	{
        dTemp += ((m_pY[i] - GetY(m_pX[i])) * (m_pY[i] - GetY(m_pX[i])));
        dTemp1 += ((m_pY[i] - m_dYAverage) * (m_pY[i] - m_dYAverage));
	}

	return (1 - dTemp / dTemp1);
}



float GetDYDA(float& dX)
{
	float dTemp = pow((dX / c), b);
	return (1.0 / (1 + dTemp));
}

void SetYMin(float dYMin)
{
    m_dYMin = dYMin;
}

void SetYMax(float dYMax)
{
    m_dYMax = dYMax;
}

float GetDYDD(float& dX)
{
	float dTemp = pow((dX / c), b);
	return (1.0 - 1.0 / (1 + dTemp));
}

float GetDYDC(float& dX)
{
	float dTemp = pow((dX / c), b);
	return ((b / c) * ((a - d) / ((1 + dTemp) * (1 + dTemp))) * dTemp);
}

float GetDYDB(float& dX)
{
	float dTemp = pow((dX / c), b);
	return -((dTemp) * (log(dX / c)) * ((a - d) / ((1 + dTemp) * (1 + dTemp))));
}

bool GetInitBC()
{
	for(int i = 0; i < m_nTotal; i++)
	{
        m_pXInit[i] = log10(m_pX[i]);
		m_pYInit[i] = log10((m_pY[i] - a) / (d - m_pY[i]));
	}

//	CLeastSquareMethod* pLSM = new CLeastSquareMethod;
	LsmCreate(m_pXInit, m_pYInit, m_nTotal);
	int nErrorCode;
	b = LsmGetSlope(&nErrorCode);
	if(nErrorCode != ANALYSIS_SUCCESS)
	{	printf("GetInitBC return 111!\n");	
        return false;
	}
    
	float dTemp = LsmGetIntercept(&nErrorCode);
	if(nErrorCode != ANALYSIS_SUCCESS)
	{
		printf("GetInitBC return 222!\n");
        return false;
	}

	c = pow(10.0, -dTemp / b);
	return true;
}

bool InitPara()
{
	//查找y的最大/最小值
    m_dYAverage = 0.0;
	for(int i = 0; i < m_nTotal; i++)
	{
		m_dYAverage += m_pY[i];
	}
	m_dYAverage /= m_nTotal;//Y的均值

	d = (m_dYMax + m_dYMin) / 2 + (m_dYMax - m_dYMin) * 1.1 / 2;//d的初值
    a = m_dYMin -  m_dYMin * 0.1;//a的初值
    bool bFlag = GetInitBC();
	if(!bFlag)
	{	printf("InitPara return 000!\n");
		//Sleep(2000);
		return false;
	}

	    float lamda = 0.01;//设定搜索方向的变化量
        int Ndata = m_nTotal;
        int Nparams = 4;
        int upJ = 1;//是否更新雅克比矩阵的标志位
        float rr2 = 0;
        float std = 0;
        int re = 0;//重复次数
        int xs = 1;//下山法的偏移量
        int it;
        float row = 0;

		J = new float[m_nTotal*4];
		dc = new float[m_nTotal*1];
        ycal_lm = new float[m_nTotal];
        dc_lm = new float[m_nTotal];

        for (it = 1; it < 2200; it++)
        {
            if (upJ == 1)
            {
                for (int i = 0; i < m_nTotal; i++)
                {
                    J[i*4 + 0] = 0;//将雅克比矩阵初始化
                    J[i*4 + 1] = 0;
                    J[i*4 + 2] = 0;
                    J[i*4 + 3] = 0;
                }

                for (int i = 0; i < m_nTotal; i++)
                {
                    J[i*4 + 0] = GetDYDA(m_pX[i]);//四个偏导参数值
					//if (_isnan(J[i*4 + 0]))
					if(abs(J[i*4 + 0]) >= INT_MAX)
                       J[i*4 + 0] = 0;

                    J[i*4 + 1] = GetDYDB(m_pX[i]);
	//				if (_isnan(J[i*4 + 1]))
					if(abs(J[i*4 + 1]) >= INT_MAX)
                        J[i*4 + 1] = 0;

                    J[i*4 + 2] = GetDYDC(m_pX[i]);
					//if (_isnan(J[i*4 + 2]))
					if(abs(J[i*4 + 2]) >= INT_MAX)
                        J[i*4 + 2] = 0;
                    J[i*4 + 3] = GetDYDD(m_pX[i]);
//                    if (_isnan(J[i*4 + 3]))
					if(abs(J[i*4 + 3]) >= INT_MAX)
                        J[i*4 + 3] = 0;
                }

                for (int i = 0; i < m_nTotal; i++)
                    dc[i*1+0] = m_pY[i] - GetY(m_pX[i]);//Y的差值
            }
			
             float* JReserve = MatrixReverse(J, m_nTotal, 4);//转置
			 if(NULL == JReserve)
			 {	printf("InitPara return 111!\n");
				//Sleep(2000);
				return false;
			 }
            float* H = MatrixMulty(JReserve, 4, m_nTotal, J, 4); //J的转置*J
			if(NULL == H)
			 {	printf("InitPara return 222!\n");
				//Sleep(2000);
				return false;
			 }

			float *H_lm = new float[4*4];
            for (int i = 0; i < 4; i++)
            {
                for (int j = 0; j < 4; j++)
                {
                    if (i == j)
                        H_lm[i*4+j] = H[i*4+j] + lamda;
                    else 
						 H_lm[i*4+j] = H[i*4+j];
                }
            }
           
            float* a2 = getInverseMatrix((float *)H_lm, 4);//逆
			if(NULL == a2)
			 {	printf("InitPara return 333!\n");
				//Sleep(2000);
				return false;
			 }

            float* a3 = MatrixMulty(a2, 4, 4, JReserve, m_nTotal);//矩阵相乘
			if(NULL == a3)
			{	printf("InitPara return 444!\n");
				//Sleep(2000);
				return false;
			}

            float* dp = MatrixMulty(a3, 4, m_nTotal,dc, 1);//矩阵相乘
			if(NULL == dp)
			 {	printf("InitPara return 555!\n");
				//Sleep(2000);
				return false;
			 }
            float value[8];// = new float[8];
            for (int i = 0; i < 4; i++)
            {
                value[i + 1] = dp[i*1+0];
            }
 
            float  ck = 1;
            r2 = new float[xs];
            for (int zk = 0; zk < xs; zk++)
            {
                float rss = 0;
                float tss = 0;

                a_lm = a + ck * value[1];
                b_lm = b + ck * value[2];
                c_lm = c + ck * value[3];
                d_lm = d + ck * value[4];


                for (int i = 0; i < m_nTotal; i++)
                {
                    float dTemp = pow((m_pX[i] / c_lm), b_lm);
                    ycal_lm[i] = d_lm + (a_lm - d_lm) / (1 + dTemp);
                }

                for (int i = 0; i < m_nTotal; i++)
                {
                    rss += (pow((m_pY[i] - ycal_lm[i]), 2));
                    tss += (pow((m_pY[i] - m_dYAverage), 2));
                }
                if (tss == 0)
                    r2[zk] = 0;
                else if (rss == 0)
                    r2[zk] = 1;
                else 
					r2[zk] = 1 - rss / tss;

                ck = ck / 2;
            }

            int col = 0;
			row = r2[0];
            for (int i = 1; i < xs; i++)
            {
                if (row < r2[i])
                {
                    row = r2[i];
                    col = i;
                }
            }
            float dcol = pow(2.0, col);
            a_lm = a + value[1] * (1 / dcol);
            b_lm = b + value[2] * (1 / dcol);
            c_lm = c + value[3] * (1 / dcol);
            d_lm = d + value[4] * (1 / dcol);

            for (int i = 0; i < m_nTotal; i++)
                dc_lm[i] = m_pY[i] - ycal_lm[i];//Y的差值

            if (row > rr2)
            {
                lamda = lamda / 4;
                rr2 = row;
                a = a_lm;
                b = b_lm;
                c = c_lm;
                d = d_lm;
                upJ = 1;
            }
            else
            {
                upJ = 0;
                lamda = lamda * 4;
            }

            if ((lamda > 10000000000) || (lamda < 0.0000000001))
            {
                break;
            }
            if (rr2 == 1)
            {
                break;
            }
            if ((fabs(std - row) < 0.0000001) && (row != 0))
                re = re + 1;
            else 
				re = 0;

            if (re == 6)
                break;

            std = row;
            if (it > 500)
            {
                xs = 10;
            }
        }
		return true;
}

bool LogisticCreate(float* pX, float* pY, int nTotal)
{
	if(NULL == pX || NULL == pY || nTotal <= 4)
	{
		printf("Create return 111!\n");
		return false;
	}

