int LinearEquationGetSolution(float* x1)
{
	for(int i = 0; i < N; i++)
	{
		if(i == 0)
		{
			if(aa[i][N - 1] == 0.0)
			{
				return ANALYSIS_ERROR;
			}
            x1[N - 1] = bb[i] / aa[i][N - 1]; 
			continue;
		}
		float dTemp = bb[i];
		for(int j = N - 1; j > N -1 - i; j--)
		{
            dTemp -= (aa[i][j] * x1[j]);
		}

		if(aa[i][N - 1 - i] == 0.0)
		{
			return ANALYSIS_ERROR;
		}
		x1[N - 1 - i] = dTemp / aa[i][N - 1 - i];
	}
	 
	return ANALYSIS_SUCCESS;
}

int GaussianElimination(int n)
{
	int nStart = N - n;
	float dMax = aa[0][nStart];
	int nMax = 0;

	for(int i = 0; i < n; i++) //找出最大系数
	{
        if(dMax < aa[i][nStart])
		{
            dMax = aa[i][nStart];
			nMax = i;
		}
	}

	if(nMax != n - 1) //交换
	{
 	    float dTemp;
        for(int i = nStart; i < N; i++)
		{
            dTemp = aa[nMax][i];
			aa[nMax][i] = aa[n - 1][i];
			aa[n - 1][i] = dTemp;
		}

		dTemp = bb[nMax];
		bb[nMax] = bb[n - 1];
		bb[n - 1] = dTemp;
	}

	for(int i = 0; i < n - 1; i++) //消去
	{
		float dTemp = aa[i][nStart];
		if(aa[n - 1][nStart] == 0.0)
		{
            return ANALYSIS_ERROR;
		}
        for(int j = nStart; j < N; j++)
		{
            aa[i][j] -= aa[n - 1][j] / aa[n - 1][nStart] * dTemp;
		}

		bb[i] -= bb[n - 1] / aa[n - 1][nStart] * dTemp;
	}

	if(n > 2) //递归
	{
        return GaussianElimination(n - 1);
	}
	else
	{
		return ANALYSIS_SUCCESS;
	}
}

//三次样条开始
bool InitSplinePara()
{
	for(int i = 0; i < m_nTotal - 1; i++)
	{
		m_dH[i] = m_pXSpline[i + 1] - m_pXSpline[i];
		m_dDerivative[i] = (m_pYSpline[i + 1] - m_pYSpline[i]) / m_dH[i];
	}
	m_dH[ m_nTotal - 1] = 0;

	for(int i = 1; i < m_nTotal -1; i++)
	{
        m_dMiu[i] = m_dH[i - 1] / (m_dH[i -1] + m_dH[i]);
        m_dLamda[i] = m_dH[i] / (m_dH[i -1] + m_dH[i]);
		m_dD[i - 1] = 6.0 * (m_dDerivative[i] - m_dDerivative[i - 1]) / (m_pXSpline[i + 1] - m_pXSpline[i - 1]);
	}		

	m_dM[0] = 0.0;
	m_dM[m_nTotal - 1] = 0.0;
	if(m_nTotal == 3)
	{
        m_dM[1] = m_dD[0] / 2.0;
	}
	else //4个以上点需解方程
	{
        for(int i = 0; i < m_nTotal - 2; i ++)
		{
			for(int j = 0; j < m_nTotal - 2; j++)
			{
				int k = i * (m_nTotal - 2) + j;
				m_dAB[k] = 0.0;
                if(i == 0)
				{
                    if(j == 0)
					{
						m_dAB[k] = 2.0;
					} //if(j == 0)
					else if(j == 1)
					{
						m_dAB[k] = m_dLamda[1];
					} //else if(j == 1)
				} //if(i == 0)
				else if(i == m_nTotal - 3)
				{
                    if(j == m_nTotal - 3)
					{
						m_dAB[k] = 2.0;
					} //if(j == m_nTotal - 3)
					else if(j == m_nTotal - 4)
					{
						m_dAB[k] = m_dMiu[m_nTotal - 2];
					} //else if(j == m_nTotal - 4)
				} //else if(i == m_nTotal - 3)
				else
				{
                    if(j == i - 1)
					{
						m_dAB[k] = m_dMiu[i + 1];
					} //if(j == i - 1)
					else if(j == i)
					{
						m_dAB[k] = 2.0;
					} //else if(j == i)
					else if(j == i + 1)
					{
						m_dAB[k] = m_dLamda[i + 1];
					} //else if(j == i + 1)
				} //else if(i == m_nTotal - 3)
			} //for(int j = 0; j < m_nTotal - 2; j++)
		} //for(int i = 0; i < m_nTotal - 2; i ++)

//		CLinearEquation* p_LE = new CLinearEquation;
		if(LinearEquationCreate(m_dAB, m_dD, m_nTotal - 2))
		{
//			delete p_LE;
			return false;
		}
		else
		{
			int tmp = LinearEquationGetSolution((float*)(m_dM + 1));
			if(0 != tmp)
			{
//				delete p_LE;
				return false;
			}
//			delete p_LE;
		}
	} //if(m_nTotal == 3)

	return true;
}

void GetM(float* dM)
{
	if(NULL == dM)
	{
		return;
	}
	memcpy(dM, m_dM, sizeof(float) * SPLINE_POINT_MAX);
}

void GetH(float* dH)
{
	if(NULL == dH)
	{
		return;
	}
	memcpy(dH, m_dH, sizeof(float) * SPLINE_POINT_MAX);
}

bool SplineCreate(float* pX, float* pY, int nTotal)
{
	if(NULL == pX || NULL==pY || nTotal<3)
	{
		return false;
	}

	m_pXSpline = new float[nTotal];
	m_pYSpline = new float[nTotal];
	m_nTotal = nTotal;
	loopCount = 30;

	int min;
	float d_tmp;
	for(int i = 0; i < m_nTotal; i++)
	{
			min = i;
			for(int j = i+1; j < m_nTotal; j++)
			{
				if(pX[j] < pX[min])
				{
					min = j;
				}
			}
			
			if(min == i)
			{
				continue;
			}
			
			d_tmp = pX[i];
			pX[i] = pX[min];
			pX[min] = d_tmp;
			
			d_tmp = pY[i];
			pY[i] = pY[min];
			pY[min] = d_tmp;			
	}

	memcpy(m_pXSpline, pX, nTotal * sizeof(float));
	memcpy(m_pYSpline, pY, nTotal * sizeof(float));
	return InitSplinePara();
}

 float SplineCalculateYValue(float dx)
	{
		int i= 0; 
		float h = 0.0; float res = 0.0;
		for(i=0; i<(m_nTotal-1); i++)
		{
			if(m_pXSpline[i] <= dx && m_pXSpline[i+1] >= dx)
			{
				break;
			}
		}
		//Log.e("wenqg", "i is " +i);
		if(i < (m_nTotal-1))
		{
			h = m_pXSpline[i+1] - m_pXSpline[i];
			res = (m_pXSpline[i+1] - dx)*(m_pXSpline[i+1] - dx)*(m_pXSpline[i+1] -dx)*m_dM[i]/6/h;
			res -= (m_pXSpline[i] - dx)*(m_pXSpline[i] - dx)*(m_pXSpline[i] - dx)*m_dM[i+1]/6/h;
			res += (m_pYSpline[i] - h*h*m_dM[i]/6)*(m_pXSpline[i+1] -dx)/h;
			res -= (m_pYSpline[i+1] - h*h*m_dM[i+1]/6)*(m_pXSpline[i] -dx)/h;
			//Log.e("wenqg", "res is " + res);
			return res;
		}
		return 0;
	}

float  ErFenFa_CalculateXValue(float dy)
 {
	 //找d值的区间
	 int pos = -1; //int flag = -1;
	 for(int i=0; i<(m_nTotal-1);i++)
	 {			
		 if((dy -m_pYSpline[i])* (dy - m_pYSpline[i+1]) < 0)
			{
				pos = i;
				break;
		 } 			
	 }
	 if(pos < 0)
	 {	
		 return 0;
	 }

	 float x1 =  m_pXSpline[pos];
	 float x2 =  m_pXSpline[pos+1];
	 float dMid = 0;float x = 0;
	 float dFa = 0, dFb = 0; int Count = 0;
	 for(Count=0; Count < loopCount; Count++)
	 {
		 x = (x1+x2)/2;
		 dMid = SplineCalculateYValue(x);
		 if(abs(dy-dMid) < pow(10.0, -6))
			{
				break;
			}

		 dFa = SplineCalculateYValue(x1);
		 dFb = SplineCalculateYValue(x2);			
		 if((dFa - dy) * (dMid - dy) < 0)
			{
				x2 = x;
		 }			
		 else if((dFb - dy) * (dMid - dy) < 0)
			{
				x1 = x;
			}
		 else
		 {	
			 x = 0;	
			 break;
		 }				
	 }
//	 Log.e("wenqg", "ErFenFa: x is " + x +", loopCount is " + Count);
	 return x;
 }

 float calculateDerivative(float dx)
 {
	 int i= 0;
	 for(i=0; i<(m_nTotal-1); i++)
	 {
		 if(m_pXSpline[i] <= dx && m_pXSpline[i+1] >= dx)
			{
				break;
			}
	 }

	 float dTemp = 0;
	 if(i < (m_nTotal-1))
	 {
		 dTemp -= (m_pXSpline[i+1] -dx) * (m_pXSpline[i+1] -dx) *m_dM[i]/2/m_dH[i];
		 dTemp += (m_pXSpline[i] -dx) * (m_pXSpline[i] -dx) *m_dM[i+1]/2/m_dH[i];
		 dTemp += (m_dH[i] * m_dM[i]/6 - m_pYSpline[i]/m_dH[i]);
		 dTemp += (m_pYSpline[i+1]/m_dH[i] - m_dH[i] * m_dM[i+1]/6);
	 }
	 return dTemp;
 }

 float NewTonCalculateXValue(float dy)
 {
	 //找d值的区间
	 int pos = -1; //int flag = -1;
	 for(int i=0; i<(m_nTotal-1);i++)
	 {			
		 if((dy -m_pYSpline[i])* (dy - m_pYSpline[i+1]) < 0)
			{
				pos = i;
				break;
		 } 			
	 }
	 if(pos < 0)
	 {	
		 return 0;
	 }

	 float p0 = m_pXSpline[pos], p = 0, dTemp = 0;
	 int Count = 0;
	 for(Count=0; Count < loopCount; Count++)
	 {
		 dTemp = calculateDerivative(p0);
		 if(0 == dTemp)
			{
				p = 0;
				break;
			}

		 p = p0 - (SplineCalculateYValue(p0)-dy)/calculateDerivative(p0);			
		 if(abs((p-p0)/p) < pow(10.0, -6))
			{
				break;
			}
		 else
			 p0 = p;		
	 }
//	 Log.e("wenqg", "NewTon: x is " + p +", loopCount is " + Count);
	 return p;
 }

 float GeXianFaCalculateXValue(float dy)
 {
	 //找d值的区间
	 int pos = -1;
	 for(int i=0; i<(m_nTotal-1);i++)
	 {			
		 if((dy -m_pYSpline[i])* (dy - m_pYSpline[i+1]) < 0)
			{
				pos = i;
				break;
		 } 			
	 }
	 if(pos < 0)
	 {	
		 return 0;
	 }

	 float p0 = m_pXSpline[pos], p1 = m_pXSpline[pos+1], q0 = 0, q1 = 0, p = 0;
	 q0 = SplineCalculateYValue(p0) - dy;
	 q1 = SplineCalculateYValue(p1) - dy;
	 int Count = 0;
	 for(Count=0; Count < loopCount; Count++)
	 {
		 if(q1 == q0)
			{
				p = 0;
				break;
			}

		 p = p1 - q1*(p1-p0)/(q1-q0);			
		 if(abs((p-p1)) < pow(10.0, -6))
			{
				break;
			}
		 else
			{
				p0 = p1;
				q0 = q1;
				p1 = p;
				q1 = SplineCalculateYValue(p) - dy;
		 }					
	 }
	 return p;
 }

 void setLoopCount(int value)
 {
	 if(value <= 10)
	 {
		 loopCount = 10;
	 }
	 else
	 {
		 loopCount = value;
	 }
 }



