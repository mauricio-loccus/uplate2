/*全局变量
 Filter1Locate = BoardInf.Filter1Locate;
	 Filter2Locate = BoardInf.Filter2Locate;
	 DetectMode = BoardInf.DetectMode;
*/
#include "MainTask.h"

const char STR_MEASURE_FILTER[LANGUAGE_TYPES][15] = {"  filter", "滤光片"};
const char STR_MEASURE_MODE[LANGUAGE_TYPES][15] = {"Mode", "测量模式"};
const char STR_MEASURE_FILTER1[LANGUAGE_TYPES][15] = {"Filter 1", "滤光片1"};
const char STR_MEASURE_FILTER2[LANGUAGE_TYPES][15] = {"Filter 2", "滤光片2"};
const char STR_MEASURE_TITLE[LANGUAGE_TYPES][30] = {"Measurement parameters", "测量参数"};



const BUTTON_DATA _aButtonProtocolMeasure[] =
{
    { TOOLS1_BUTTON_POSX, TOOLS1_BUTTON_POSY(3), TOOLS1_BUTTON_WIDTH, TOOLS1_BUTTON_HEIGHT, "Ok", "确认" },
    { TOOLS1_BUTTON_POSX, TOOLS1_BUTTON_POSY(4), TOOLS1_BUTTON_WIDTH, TOOLS1_BUTTON_HEIGHT, "Back", "返回" },

};

//ExpEnable的值定义
enum
{
    EXP_FILTER1=1,
    EXP_FILTER2,
    EXP_MODE,
};
static unsigned char ExpEnable;
static signed char Filter1Locate;               //第1个滤光片
static signed char Filter2Locate;               //辐滤光片
static unsigned char DetectMode;                //检测模式


WM_HWIN ProtocolMeasureWin = NULL;       //检测窗体

//显示滤片片1扩展
void DisplayFilter1Expand(void)
{
    GUI_RECT rect;

    unsigned char i;
    short start_x, start_y, wide, high;
    start_x = FILTER_1_EXPAND_START_X ;
    start_y = FILTER_1_EXPAND_START_Y - TITLESBAR_HEIGHT;
    wide = 39; //43  39+3=42
    high = 11; //46
    //GUI_DrawBitmap(&bmExpMenuRight_400_46, FILTER_1_EXPAND_START_X, FILTER_1_EXPAND_START_Y - TITLESBAR_HEIGHT);
    GUI_SetColor(COLOR_EXP_PICTURE_FRAME);
    GUI_DrawLine(start_x, start_y,start_x+380,start_y);
    GUI_DrawLine(start_x, start_y+45,start_x+380,start_y+45);
    GUI_SetColor(COLOR_EXP_PICTURE);
    GUI_FillRect(start_x, start_y+1,start_x+380,start_y+44);
    GUI_DrawBitmap(&bmExpMenuRight_20_46, start_x+380, start_y);

    start_x += 3;
    start_y += 31;

    //字体
    //if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    //{
    GUI_SetFont(GUI_FONT_SMALL);
    //}
    //else
    //{
    //		GUI_SetFont(GUI_FONT_SMALL_CH);
    //}

    for (i = 0; i<8; i++)
    {
        if (i == Filter1Locate  && FilterLun.Filter[i]!=0)  //选中的扩展项
        {
            //填充选中的底色
            GUI_SetColor(COLOR_FILTER_SEL_BK);
            GUI_FillRect(start_x, FILTER_1_EXPAND_START_Y + 3 - TITLESBAR_HEIGHT, start_x + wide, FILTER_1_EXPAND_START_Y + 43 - TITLESBAR_HEIGHT);

            //填充选中的文字-白色
            GUI_SetColor(COLOR_FILTER_SEL_TXT);
            //最下方的数字
            OneNumConvertStr(ConvertStr, i+1);
            rect.x0 = start_x ;
            rect.y0 = start_y-1;
            rect.x1 = start_x + wide;
            rect.y1 = start_y+15;
            GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);


            //最上方的波长
            rect.x0 = start_x;
            rect.y0 = start_y - 25;
            rect.x1 = start_x + wide;
            rect.y1 = start_y - 25 + high;
            FilterConvertStr(ConvertStr, FilterLun.Filter[i]);
            GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);

            //中间nm
            rect.y0 = start_y - 15;
            rect.y1 = start_y - 15 + high;
            GUI_DispStringInRect("nm", &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);
            start_x += 42;
        }//if (i == BoardInf.Filter1Locate && SystemPrameter.FilterWavelength[i]!=0)  //选中的扩展项
        else
        {
            //填充选中文字的底色
            GUI_SetColor(COLOR_FILTER_NUM_BK);
            GUI_FillRect(start_x, start_y, start_x + wide, start_y + high);

            //填充最下方选中的文字
            GUI_SetColor(COLOR_FILTER_NUM_TXT);
            OneNumConvertStr(ConvertStr, i + 1);
            rect.x0 = start_x;
            rect.y0 = start_y;
            rect.x1 = start_x + wide;
            rect.y1 = start_y + high;
            GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);




            GUI_SetColor(COLOR_FILTER_NUM_BK);
            if (FilterLun.Filter[i] != 0)  //显示波长
            {
                rect.x0 = start_x;
                rect.y0 = start_y-25;
                rect.x1 = start_x + wide;
                rect.y1 = start_y-25 + high;
                FilterConvertStr(ConvertStr, FilterLun.Filter[i]);
                GUI_DispStringInRect(ConvertStr, &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);


                rect.y0 = start_y - 15;
                rect.y1 = start_y - 15 + high;
                GUI_DispStringInRect("nm", &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);

            }
            else
            {
                rect.x0 = start_x;
                rect.y0 = start_y - 25;
                rect.x1 = start_x + wide;
                rect.y1 = start_y - 25 + high;
                if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
                {
                    GUI_SetFont(GUI_FONT_SMALL);
                }
                else
                {
                    GUI_SetFont(GUI_FONT_SMALL_CH);
                }
                GUI_DispStringInRect(STR_OFF[SystemPrameter.SystemLanguage], &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);//"off"
                GUI_SetFont(GUI_FONT_SMALL);
            }
            start_x += 42;
        }
    }

    if (Filter1Locate>=0)  //有选中的滤光片,直接显示字
    {
        GUI_SetColor(COLOR_FILTER_SEL_BK);
    }
    else                  //无选中的滤光片，选画背景再显示字
    {

        GUI_SetColor(COLOR_FILTER_SEL_BK);
        GUI_FillRect(start_x, FILTER_1_R_START_Y + 3 - TITLESBAR_HEIGHT, start_x + 39, FILTER_1_R_START_Y + 43 - TITLESBAR_HEIGHT);
        GUI_SetColor(COLOR_FILTER_SEL_TXT);
    }
    if(SystemPrameter.SystemLanguage==LANGUAGE_EN)
    {
        GUI_SetFont(GUI_FONT_SMALL);
    }
    else
    {
        GUI_SetFont(GUI_FONT_SMALL_CH);
    }
    rect.x0 = start_x;
    rect.x1 = start_x + wide;
    rect.y0 = start_y-25;
    rect.y1 = start_y + high-25;
    GUI_DispStringInRect(STR_OFF[SystemPrameter.SystemLanguage], &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);           //"off"

    rect.y0 = start_y + high-25;
    rect.y1 = start_y + high * 2-25;
    GUI_DispStringInRect(STR_MEASURE_FILTER[SystemPrameter.SystemLanguage], &rect, GUI_TA_HCENTER | GUI_TA_VCENTER);//"filter"
}

