####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/uPlate2Screens/bin || mkdir -p $(INSTALL_ROOT)/opt/uPlate2Screens/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/uPlate2Screens/bin/uPlate2Screens.app
	
	-$(QINSTALL) uPlate2Screens.app $(INSTALL_ROOT)/opt/uPlate2Screens/bin/uPlate2Screens.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/uPlate2Screens/bin/uPlate2Screens.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/uPlate2Screens/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

