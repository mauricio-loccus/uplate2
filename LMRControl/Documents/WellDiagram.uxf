    <panel_attributes>&lt;&lt;Well&gt;&gt; : Class
--
_Row : Integer_
_Col : Integer_
_Type : WellType_
_ID : Integer_
_StdValue : Float_
_RawValue : Float_
_PostValue : Variant_
--
{Properties}

- Type : WellType {Composite}
- Row : Integer
- Col : Integer
- ID : Integer
- StdValue : Float
- RawValue : Float
- PostValue : Float
- Interpret : Character = '+', '-', 'G'
--
Well(well : const Well&amp;)

operator &lt;(w : const Well&amp;) : Boolean
operator &gt;(w : const Well&amp;) : Boolean
operator ==(w : const Well&amp;) : Boolean
operator !=(w : const Well&amp;) : Boolean
--
{Private}

getType() : WellType
setType(type : WellType)
getRow() : Integer
setRow(row : Integer)
getCol() : Integer
setCol(col : Integer)
getId() : Integer
setId(id : Integer)
getStdValue() : Float
setStdValue(value : Float)
getRawValue() : Float
setRawValue(value : Float)
getPostValue() : Variant
setPostValue(value : Variant)
